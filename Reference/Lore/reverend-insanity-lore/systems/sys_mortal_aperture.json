  "claims": [
    {
      "text": "Immortal Gu have an overbearing aura and cannot be stored in mortal apertures. Spring Autumn Cicada can barely be kept there only because of its weakened state.",
      "chapters": [
        429
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "sys_immortal_gu",
        "gu_spring_autumn_cicada"
      ]
    },
    {
      "text": "A rank three mortal aperture cannot store Immortal Gu under ordinary rules.",
      "chapters": [
        494
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt"
    },
    {
      "text": "Fixed Immortal Travel at peak state likewise cannot be stored in a mortal aperture.",
      "chapters": [
        596
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "gu_fixed_immortal_travel"
      ]
    },
    {
      "text": "Within each rank, stage shows on the aperture walls. Initial stage is light membrane, middle stage water membrane, upper stage stone membrane, and peak stage crystal membrane.",
      "chapters": [
        230
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "stage-walls",
      "text_origin": "source_excerpt"
    },
    {
      "text": "Crossing into Gu Immortal realm breaks the mortal aperture so an immortal aperture can form.",
      "chapters": [
        609
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "shattered-for-ascension",
      "text_origin": "source_excerpt",
      "mentions": [
        "sys_gu_immortal"
      ]
    },
    {
      "text": "Gu Masters shatter their aperture to ascend, drawing heaven and earth qi.",
      "chapters": [
        626
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "shattered-for-ascension",
      "text_origin": "source_excerpt",
      "mentions": [
        "fac_gu_masters"
      ]
    },
    {
      "text": "Mortal apertures are not easy to devour and combine. After ascension, the immortal aperture is a small world, and worlds can be devouring each other for great gain.",
      "chapters": [
        610
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "hard-to-devour",
      "text_origin": "source_excerpt"
    },
    {
      "text": "Opening, talent grades, and the primeval sea sit on Aperture. Broader essence economy sits on aperture and primeval essence. The post-ascension small world sits on Immortal Aperture.",
