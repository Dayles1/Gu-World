  "claims": [
    {
      "text": "Tie family is called a super clan with thousands of years of legacy that still stands strong. In Southern Border it ranks as a first-class powerhouse, and Gu Yue clan cannot compare with it.",
      "chapters": [
        182
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "fac_tie_clan",
        "reg_southern_border",
        "fac_gu_yue_clan"
      ]
    },
    {
      "text": "If an inheritance involves a rank six Gu Immortal, all of the super clans in Southern Border would go crazy over it.",
      "chapters": [
        325
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "rank-six-stakes",
      "text_origin": "source_excerpt",
      "mentions": [
        "sys_gu_immortal"
      ]
    },
    {
      "text": "Any strong or affluent first-class clan, or super clan, engages in slave business.",
      "chapters": [
        329
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "slave-trade-footing",
      "text_origin": "source_excerpt"
    },
    {
      "text": "At most, large or super clans choose to nurture a few enslavement path Gu Masters for war purposes. A middle-sized clan cannot afford to feed one.",
