        "char_blazing_glory_lightning_brilliance",
        "char_northern_dark_ice_soul",
        "char_carefree_wisdom_heart"
      ]
    },
    {
      "text": "Broader set rules sit on Ten Extreme Physique.",
      "chapters": [],
      "certainty": "inferred",
      "confidence": "C",
      "verification": "no_citation",
      "source_id": "src_sagaofgu",
      "section": "intro",
