  "claims": [
    {
      "text": "With the coagulation of the primeval sea after the Awakening Ceremony, new students are rank one Gu Masters, starting at initial stage.",
      "chapters": [
        7
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "sys_awakening_ceremony",
        "fac_gu_masters"
      ]
    },
    {
      "text": "Gu Masters are divided into nine ranks of great realms, and each great realm has four small realms: initial, middle, upper, and peak stage.",
      "chapters": [
        230
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt"
    },
    {
      "text": "Gu Masters at rank one produce green copper primeval essence.",
      "chapters": [
        22
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt"
    },
    {
      "text": "A D grade talent raised for three years can become a rank one senior Gu Master and form family foundation.",
      "chapters": [
        4
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "sys_d_grade",
        "sys_gu_master"
      ]
    },
    {
      "text": "Among the five mortal ranks, rank one and two are beginners.",
      "chapters": [
        275
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt"
    },
    {
      "text": "Initial stage has light membrane aperture walls. Middle stage has water membrane walls. Upper stage has stone membrane walls. Peak stage has crystal membrane walls.",
      "chapters": [
        230
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
