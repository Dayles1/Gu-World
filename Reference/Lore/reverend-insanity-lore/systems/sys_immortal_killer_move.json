  "claims": [
    {
      "text": "Immortal killer moves use Immortal Gu as the core to activate powerful methods.",
      "chapters": [
        942
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "sys_immortal_gu"
      ]
    },
    {
      "text": "They are also described as the fusion of many types of dao marks: an effect or great power formed from varying sources.",
      "chapters": [
        821
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt"
    },
    {
      "text": "At rank six and above, their market price in treasure yellow heaven is far less than Immortal Gu recipes, while ordinary mortal killer moves price higher than mortal Gu recipes of the same rank.",
      "chapters": [
        667
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "sys_gu_recipe",
        "sys_mortal_gu"
      ]
    },
    {
      "text": "Obtaining an immortal killer move from a Gu Immortal inheritance is treated as a rare and dangerous prize, not an ordinary purchase.",
      "chapters": [
        589
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "inheritance-rarity",
      "text_origin": "source_excerpt",
      "mentions": [
        "sys_gu_immortal"
      ]
    },
    {
      "text": "Hei Lou Lan develops an immortal killer move using Divert Disaster Immortal Gu as the core, pairing it with mortal Gu so the attack is more concentrated and precise. Fang Yuan’s Myriad Self is named as an immortal killer move in the same battle stretch.",
      "chapters": [
        685
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "core-immortal-gu",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_hei_lou_lan",
        "gu_divert_disaster_immortal_gu",
        "char_fang_yuan",
        "move_myriad_self"
      ]
    },
    {
      "text": "Investigative and battlefield forms that sit at immortal grade are covered on Investigative Killer Move and Battlefield Killer Move. Mortal grade combinations are covered on Mortal Killer Move. Killer moves as Gu combinations in general are covered on killer moves.",
