        "reg_central_continent",
        "sys_heavenly_dao"
      ]
    },
    {
      "text": "After two-heavens forces join Heavenly Court, their grotto-heavens are arranged in accordance with the star array calculation formation below and treated as formation cores. That puts those grotto-heavens at the front if later fights try to break the formation.",
      "chapters": [
        2275
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
