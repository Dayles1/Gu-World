  "claims": [
    {
      "text": "Star Constellation Immortal Venerable rejects Western Desert righteous path’s call for help and mobilizes almost all Gu Immortals of Central Continent’s ten great ancient sects to create her star array calculation formation. She says Central Continent needs that formation for when the Heavenly Dao undergoes new changes, with two-heavens fusion at a crucial stage. The same day, those sects send large numbers of Gu Immortals above Central Continent’s sky to place and arrange stars according to the formation, an unprecedented gathering that draws five regions’ attention.",
      "chapters": [
        2274
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
