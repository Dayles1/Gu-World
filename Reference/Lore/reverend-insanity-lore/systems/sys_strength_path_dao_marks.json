  "claims": [
    {
      "text": "Regrowing limbs on an immortal zombie body is not only flesh repair: the relevant strength path dao marks must be replenished as well.",
      "chapters": [
        715
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt"
    },
    {
      "text": "Eat strength Immortal Gu lets a strength path Gu Immortal digest strength path desolate beast flesh and bone that hold natural strength path dao marks, carving new marks onto the body without the risk of tribulation.",
      "chapters": [
        778
      ],
      "certainty": "canon",
      "confidence": "B",
