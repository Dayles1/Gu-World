      "mentions": [
        "char_fang_yuan",
        "path_wisdom",
        "gu_star_thought_immortal_gu"
      ]
    },
    {
      "text": "A mortal killer move used by Hei Lou Lan reaches deadly power when amplified by the Great Strength True Martial Physique’s strength path dao marks.",
      "chapters": [
        941
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
