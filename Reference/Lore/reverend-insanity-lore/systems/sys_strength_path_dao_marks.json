        "sys_great_strength_true_martial_physique"
      ]
    },
    {
      "text": "In the body created from rank nine sovereign immortal fetus Gu, Fang Yuan assessed that at the least its strength path dao marks surpassed his previous body’s accumulation.",
      "chapters": [
        1024
      ],
      "certainty": "canon",
      "confidence": "B",
