  "claims": [
    {
      "text": "In Fang Yuan’s sovereign immortal aperture, Mini Southern Border holds more earth path dao marks and also some poison path dao marks.",
      "chapters": [
        1066
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
