  "claims": [
    {
      "text": "Tai Bai Yun Sheng keeps cloud-linked resources in Tai Bai blessed land so the next earthly calamity can draw corresponding cloud path dao marks into the aperture, which would support cloud path mortal Gu production from sparrowhawk insects.",
      "chapters": [
        865
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
