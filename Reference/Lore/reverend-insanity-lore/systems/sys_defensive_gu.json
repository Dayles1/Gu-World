  "claims": [
    {
      "text": "Without a defensive Gu, Fang Yuan’s fifteen year old body cannot take a direct fist from Wang Er without serious injury.",
      "chapters": [
        66
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_fang_yuan",
        "char_wang_er"
      ]
    },
    {
      "text": "A mission to collect honey wine demands a defensive-type Gu to withstand stings; numbers in the group do not replace that requirement.",
      "chapters": [
        98
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt"
    },
    {
      "text": "Fang Yuan lists Blood Moon Gu and Sky Canopy Gu together for attack and defense among the six classifications, beside movement, storage, recon, and healing.",
      "chapters": [
        161
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "six-classifications",
      "text_origin": "source_excerpt",
      "mentions": [
        "gu_blood_moon_gu",
        "gu_sky_canopy_gu"
      ]
    },
    {
      "text": "Qing Shu treats Fish Scale Gu as a defensive Gu worm that can fuse into rank two Scale Armor Gu for good defense.",
      "chapters": [
        123
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "six-classifications",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_gu_yue_qing_shu",
        "gu_fish_scale_gu"
      ]
    },
    {
      "text": "Sky Canopy Gu is a rank three defensive Gu. Carapace Gu is also defensive, but its defended area is too small when it only covers the back.",
      "chapters": [
        205
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "rank-three-example",
      "text_origin": "source_excerpt",
      "mentions": [
        "gu_carapace_gu"
      ]
    },
    {
      "text": "Gu as living tools are covered on Gu worms. Attack as the paired strike class is covered on Attack Gu. Healing as the paired recovery class is covered on Healing Gu. Movement, storage, and recon in the same six-way set are covered on Movement Gu, Storage Gu, and Investigative Gu. Support-type stock outside that set is covered on Support Gu. Poison-effect stock is covered on Poison Gu.",
      "chapters": [],
      "certainty": "inferred",
