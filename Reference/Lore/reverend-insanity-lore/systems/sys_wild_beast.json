  "claims": [
    {
      "text": "In the Hope Gu legend, when the world is still savage wilderness, wild beasts walk the earth among which Ren Zu first appears. Predicament is a group of wild beasts that hunt him; he lacks rock-hard flesh and a wild beast’s teeth and claws, so he sits at the bottom of nature’s food chain until Gu aid him.",
      "chapters": [
        5
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "gu_hope_gu",
        "char_ren_zu"
      ]
    },
    {
      "text": "Academy teaching places Gu everywhere around people, including on the bodies of wild beasts.",
      "chapters": [
        7
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt"
    },
    {
      "text": "Gu Masters and mortals alike fight to survive, sometimes against a scary wild beast, sometimes against weather or other Gu Masters over resources.",
      "chapters": [
        29
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "fac_gu_masters"
      ]
    },
    {
      "text": "On mountain trails, wild beasts and Gu worm attacks can kill travelers who slip or are caught off guard.",
      "chapters": [
        47
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
