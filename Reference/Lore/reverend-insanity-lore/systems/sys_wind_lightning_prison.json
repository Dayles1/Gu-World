  "claims": [
    {
      "text": "After grand tribulations prove useless against Spectral Soul Demon Venerable, heaven conjures a myriad tribulation named Wind Lightning Prison. It descends faster than any Gu Immortal expects. Countless lightning bolts fall from the sky, and countless tornadoes coil around Spectral Soul’s body like pythons and dragons.",
      "chapters": [
        1011
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_spectral_soul_demon_venerable",
        "sys_gu_immortal"
      ]
    },
    {
      "text": "Spectral Soul suppresses the wind and lightning. The lightning bolts vanish under his wrath, the clouds disperse, and the sun returns. The myriad tribulation is resolved by him alone, and witnesses on Fang Yuan’s side and among Heavenly Court Gu Immortals are shocked.",
      "chapters": [
        1012
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "spectral-soul-breaks-it",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_fang_yuan",
        "fac_heavenly_court"
      ]
    },
    {
      "text": "Unlike the later grey memory tribulation, Wind Lightning Prison is extremely fast beyond reaction speed: in an instant the wind and lightning approach and attack.",
      "chapters": [
        1013
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
