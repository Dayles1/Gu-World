  "claims": [
    {
      "text": "Forces list supreme elders in numbered order. First supreme elder sits at the head of that circle. In clan and tribe systems outside Central Continent’s sect model, bloodline and seniority still bind juniors to respect these elders even when battle strength differs.",
      "chapters": [
        691
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "reg_central_continent"
      ]
    },
    {
      "text": "Returned Immortal Gu Houses and similar force assets are handed to the first supreme elder after respects are paid.",
      "chapters": [
        691
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "sys_immortal_gu_house"
      ]
    },
    {
      "text": "Parents of an afflicted disciple seek the supreme elders of their sect. The first supreme elder’s reading of the case is treated as the authoritative explanation they rely on.",
      "chapters": [
        696
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "sect-diagnosis",
      "text_origin": "source_excerpt"
    },
    {
      "text": "In Immortal Crane Sect, the first supreme elder is the person with highest authority and a rank eight who controls the meeting. A bell marks turns of business. That elder states each proposal, keeps discussion on the current vote, and moves the agenda from item to item.",
      "chapters": [
        697
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "meeting-control",
      "text_origin": "source_excerpt",
      "mentions": [
        "fac_immortal_crane_sect"
      ]
    },
    {
      "text": "When manpower and cooperation with other ancient sects collide, the first supreme elder speaks the sect’s binding judgment that other elders must accept.",
      "chapters": [
        698
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "sect-voice",
      "text_origin": "source_excerpt"
    }
  ],
