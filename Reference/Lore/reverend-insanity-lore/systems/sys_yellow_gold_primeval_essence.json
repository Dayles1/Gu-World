  "claims": [
    {
      "text": "A rank four Gu Master has yellow gold primeval essence.",
      "chapters": [
        55
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
