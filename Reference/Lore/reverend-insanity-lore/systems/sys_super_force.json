  "claims": [
    {
      "text": "Even a super force openly fields only two or three rank five Gu Masters.",
      "chapters": [
        527
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
