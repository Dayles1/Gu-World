  "claims": [
    {
      "text": "Spiral drill star spear is sold as an offensive killer move among star path stock in treasure yellow heaven. Fang Yuan shops for a star path offensive killer move and recalls icy stardust as a wide-range mortal offensive option with defense-piercing stardust and slowing frost when it sticks. Spiral drill star spear’s low recognition marks weak market value beside that planned buy.",
      "chapters": [
        667
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_fang_yuan"
      ]
    },
    {
      "text": "Familiar face is an immortal killer move that is not an offensive killer move, yet it still indirectly costs the lives of two rank eight Gu Immortals.",
      "chapters": [
        709
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "not-every-killer-move",
      "text_origin": "source_excerpt",
      "mentions": [
        "sys_gu_immortal"
      ]
    },
    {
      "text": "Hei Lou Lan answers a lack of investigative killer moves by naming offensive killer moves instead, and activates Self Strength with astonishing might.",
      "chapters": [
        714
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
