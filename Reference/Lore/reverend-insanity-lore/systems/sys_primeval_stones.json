  "summary": {
    "text": "Primeval stones are oval grey-white lumps of condensed natural essence. Gu Masters spend them as currency and absorb or retrieve their essence to refill the primeval sea, leaving powder.",
    "text_origin": "source_excerpt",
    "source_id": "src_sagaofgu"
  },
