        "sys_dao_marks"
      ]
    },
    {
      "text": "When Shen Shang’s Mutual Injuries takes effect, hundreds of wounds open on Fang Yuan at once. The wounds are filled with human path dao marks that spread rapidly from the injuries, scatter while staying connected as one, and threaten his life as their numbers rise.",
      "chapters": [
        1907
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
