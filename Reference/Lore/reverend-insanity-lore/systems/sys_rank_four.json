  "claims": [
    {
      "text": "An A grade talent, with about ten years of care, can become a rank four Gu Master and compete for clan head.",
      "chapters": [
        4
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "sys_a_grade",
        "sys_gu_master"
      ]
    },
    {
      "text": "B grade talents can cultivate to rank three and even as far as rank four.",
      "chapters": [
        7
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt"
    },
    {
      "text": "Gu Masters at rank four have yellow gold primeval essence and absurd fighting power in early Southern Border terms. Within Gu Yue clan, only the clan leader is rank four when a visiting rank four merchant arrives.",
      "chapters": [
        55
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "fac_gu_masters",
        "reg_southern_border",
        "fac_gu_yue_clan"
      ]
    },
    {
      "text": "Fourth rank is the clan head, the lord of a village.",
      "chapters": [
        31
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt"
    },
    {
      "text": "Among the five mortal ranks, rank four to five are a high level fighting force.",
      "chapters": [
        275
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt"
    },
    {
      "text": "Reaching rank four is a brand new starting point for using many more rank four Gu with light gold primeval essence.",
      "chapters": [
        331
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
