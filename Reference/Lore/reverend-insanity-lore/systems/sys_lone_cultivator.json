  "claims": [
    {
      "text": "Mortals who become Gu Masters without full clan acceptance can only serve as henchmen. Dissatisfied, they become loner Gu Masters. Cultivation is extremely difficult, and competition for resources pushes them toward killing and the demonic path.",
      "chapters": [
        74
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "fac_gu_masters"
      ]
    },
    {
      "text": "Gu Yue Bo, buried in clan affairs, sometimes wants to be a lone cultivator, free and easy with no burden, so cultivation could move faster. Outside the clan system, clan resources are unavailable, and without resources cultivation stalls.",
      "chapters": [
        78
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "clan-burden",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_gu_yue_bo"
      ]
    },
    {
      "text": "Demonic Gu Masters are mostly lone cultivators. They receive no support, and even primeval stones and food must be acquired alone.",
      "chapters": [
        280
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "demonic-overlap",
      "text_origin": "source_excerpt",
      "mentions": [
        "sys_demonic_path"
      ]
    },
    {
      "text": "Ku Mo is remembered as a great rank five expert born as a lone cultivator who slogged alone his whole life.",
      "chapters": [
        380
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "rank-five-example",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_ku_mo"
      ]
    },
    {
      "text": "Fang Yuan names himself a lone cultivator, or rather a demonic Gu Master, when Immortal Crane Sect investigates him.",
      "chapters": [
        493
      ],
      "certainty": "canon",
      "confidence": "B",
