  "claims": [
    {
      "text": "At Wu clan headquarters in Southern Border, rank six Gu Immortal Wu Zhen Zhu controls the formation, with rank five Gu Masters assisting. At her order, white king head flower herb, a rank six immortal material, is tossed into it. It originally belonged to an Eastern Sea rank eight Gu Immortal. After that immortal came to Southern Border and provoked Wu clan, that immortal was killed. Before dying, all of that immortal’s Immortal Gu were destroyed. The formation is a healing immortal formation, but the core Immortal Gu is only rank seven. Wu clan spent a hundred years to refine the relevant Immortal Gu and set the formation up again.",
      "chapters": [
        2096
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
