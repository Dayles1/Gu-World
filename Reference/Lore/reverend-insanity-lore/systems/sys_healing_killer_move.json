  "claims": [
    {
      "text": "When star path dao marks keep a chest wound bleeding, ordinary mortal Gu cannot help and even mortal healing killer moves do nothing, while a healing Immortal Gu can close the injury quickly.",
      "chapters": [
        726
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "sys_mortal_gu",
        "sys_immortal_gu"
      ]
    },
    {
      "text": "Pi Shui Han uses healing killer moves against life chasing fire, but those moves raise his life force and make the fire burn more intensely until he restrains that life force instead.",
      "chapters": [
        795
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "life-force-backlash",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_pi_shui_han"
      ]
    },
    {
      "text": "Fang clan Gu Immortals land healing killer moves on Old Ghost Bai Jun and Eagle Concubine under Divine Bean Palace’s graft wood method, and the healing killer moves are useless.",
      "chapters": [
        1525
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "blocked-recovery",
      "text_origin": "source_excerpt",
      "mentions": [
        "fac_fang_clan",
        "sys_gu_immortal",
        "char_old_ghost_bai_jun",
        "char_eagle_concubine",
        "house_divine_bean_palace"
      ]
    },
    {
      "text": "A light path rank eight Gu Immortal uses a light path healing killer move that wraps her in holy white light and temporarily suppresses dense dark path dao marks, yet she says the method only buys time before the injury erupts again when the move ends.",
      "chapters": [
        1898
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
