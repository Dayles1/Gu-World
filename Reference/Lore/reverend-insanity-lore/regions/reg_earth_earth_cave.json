  "claims": [
    {
      "text": "Fang Yuan names Earth Cave among the ten earths, the unique terrains the world called by that name after the five regions became one, the two heavens combined, and the earth veins of the five regions merged. The other nine are Earth Abyss, Earth Trench, Earth Tunnel, Earth Prison, Production Earth, Flying Earth, Formation Earth, Earth Treasury, and Tomb Earth.",
      "chapters": [
        2058
      ],
      "certainty": "canon",
      "confidence": "B",
