  "claims": [
    {
      "text": "On a Snowy Mountain branch peak covered in green pine trees stands a seven storey pavilion made of ice crystal. Three words are carved on its board: Xue Song Pavilion.",
      "chapters": [
        537
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "appearance",
      "text_origin": "source_excerpt"
    },
    {
      "text": "Green pine trees cover one peak of Snowy Mountain, and the pavilion board there is carved with the three words Xue Song Pavilion. Xue Song Zi stands on the top floor looking down over the branch peak that belongs exclusively to him. Xue Wa, Xue Mi, and Xue Ming kneel in front of Xue Song Pavilion and greet him as Lord Immortal before receiving orders.",
