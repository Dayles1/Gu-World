  "claims": [
    {
      "text": "A grand and elegant white jade hall. Walls, pillars, and roof are pure white as snow, all made of white jade stone. An elevated platform of twenty-three steps holds a green copper divine bird statue bound in huge black chains. Melting green paste falls as mud on the white jade floor, contrasting the white tiles.",
      "chapters": [
        602
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "appearance",
      "text_origin": "source_excerpt"
    },
    {
      "text": "Fang Yuan stands in a grand white jade hall whose walls, pillars, and roof are white jade stone, with an elevated platform of twenty-three steps holding a green copper divine bird statue bound in huge black chains. Mo Yao names the statue Frost Jade Peacock, Imperial Court blessed land’s land spirit. After Gruel Mud begins melting the green paste seal, tremors fade and the hall goes quiet again; melting paste falls as mud on the white jade floor.",
      "chapters": [
        602
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
