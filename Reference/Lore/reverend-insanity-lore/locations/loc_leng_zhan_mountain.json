  "claims": [
    {
      "text": "On the mountain waist of San Cha Mountain, an ending battle leaves three Zuo Clan Gu Masters still standing against four from Che Clan. Elder Zuo Wu Sheng stands wounded before Zuo Chan Yu, Zuo clan leader’s eldest daughter, A grade aptitude and rank three middle stage before age twenty, called the future hope of Zuo clan. Zuo Wu Sheng and Che You Yin are rivals for tens of years and about equal strength; both are injured rank three fighters when Kong Ri Tian appears and captures Zuo Chan Yu with Che Qiao Xiang, then the three kings inheritance opens on the peaks.",
      "chapters": [
        323
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "zuo-clan-fight-at-san-cha",
      "text_origin": "source_excerpt",
