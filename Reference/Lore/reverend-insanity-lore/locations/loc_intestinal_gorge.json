  "claims": [
    {
      "text": "Intestinal Gorge is the northern entrance of Sorrowful Wind Mountain Range. It was created during the Olden Antiquity Era when a beastman expert died and fused with the surrounding mountains. It is under the control of one of Central Continent’s ten great ancient sects, Black Heaven Temple.",
      "chapters": [
        2039
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "appearance",
      "text_origin": "source_excerpt",
      "mentions": [
        "evt_era_olden",
        "fac_ten_great_ancient_sects",
        "loc_black_heaven_temple"
      ]
    },
    {
      "text": "Qin Ding Ling expects Dragon Palace’s path to reach Intestinal Gorge and asks Black Heaven Temple to move Immortal Gu Houses along the gorge, striking if the chance is good or abandoning the gorge to preserve strength if enemies are too strong.",
      "chapters": [
        2039
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "appearance",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_qin_ding_ling",
        "house_dragon_palace",
        "sys_immortal_gu_house"
      ]
    },
    {
      "text": "Black Heaven Temple immortals later hide in Intestinal Gorge, with several Immortal Gu Houses concealed around it and leaking no aura.",
