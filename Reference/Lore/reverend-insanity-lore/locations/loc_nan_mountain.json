      "mentions": [
        "reg_southern_border"
      ]
    },
    {
      "text": "Tyrant Heng Mei, leader of the Ten Tyrants, scolds his brothers that this is not Nan mountain and that San Cha mountain is different, reminding them he already told them to mind their actions and words, then says the Ten Tyrants of Nan mountain are not to be trifled with.",
      "chapters": [
        339
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "boss-contrast",
