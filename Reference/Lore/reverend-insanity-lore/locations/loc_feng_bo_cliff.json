  "claims": [
    {
      "text": "No chapter describes the cliff’s rock face or height beyond naming the place and the formation arranged there.",
      "chapters": [
        1048
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "appearance",
      "text_origin": "source_excerpt"
    },
    {
      "text": "Seven days after Lang Ya land spirit gives the location directly, Fang Yuan arrives at Feng Bo cliff and sees the land spirit’s arrangements. The immortal level Gu formation is similar in use to the green crystal hero’s path Zombie Alliance had. Fang Yuan uses it to free himself from the ancient cloud beasts and return to Lang Ya blessed land.",
      "chapters": [
        1048
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "appearance",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_lang_ya_land_spirit",
        "char_fang_yuan",
        "sys_gu_formation",
        "fac_zombie_alliance",
        "loc_lang_ya_blessed_land"
      ]
    },
    {
      "text": "When Fang Yuan was previously hurrying back from Southern Border, he used the teleportation Gu formation at Feng Bo Cliff to get rid of troublesome cloud beasts and return to Lang Ya blessed land. That formation left a deep impression on him.",
      "chapters": [
        1082
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "teleportation-gu-formation",
      "text_origin": "source_excerpt",
      "mentions": [
        "reg_southern_border"
      ]
    },
    {
      "text": "One of Lang Ya blessed land’s teleportation Gu formations was set up at Feng Bo Cliff. Fang Yuan later learns the location of a second such formation at Northern Plains’ dragon elephant plain.",
      "chapters": [
        1085
      ],
      "certainty": "canon",
