  "claims": [
    {
      "text": "An oasis in the Western Desert sea of sand. Near its fringe, a small natural grassland is more desolate than Northern Plains, with sand everywhere and red dagger grass sharp as swords stabbing deep for meager water.",
      "chapters": [
        674
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "appearance",
      "text_origin": "source_excerpt",
      "mentions": [
        "reg_northern_plains"
      ]
    },
    {
      "text": "Humans in the Western Desert live by relying on oases among the sea of sand. Near Han village, a small natural grassland is more desolate than northern plains, with sand everywhere and red dagger grass sharp as swords stabbing deep to take meager water. Children under ten cut that grass with sickles and leather gloves for family pay; one bare handed child grinds the cut blades at a quern-stone into paste for fat sand scorpions kept as the household’s main assets.",
      "chapters": [
        674
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "dagger-grass-and-chase",
      "text_origin": "source_excerpt",
      "mentions": [
        "race_humans",
        "reg_western_desert",
        "loc_han_village"
      ]
    },
    {
      "text": "At night a Gu Immortal chase near the oasis turns into open combat. Thunderous shouting and sand waves shock the whole oasis into chaos.",
      "chapters": [
        674
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "dagger-grass-and-chase",
      "text_origin": "source_excerpt",
      "mentions": [
        "sys_gu_immortal"
      ]
    },
    {
      "text": "Fang Yuan and Plump Lady trade blows across the oasis, yellow sand flying as the sound of breaking bones carries on.",
      "chapters": [
        674
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "commotion-and-leave",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_plump_lady"
      ]
    },
    {
      "text": "When Fang Yuan returns afterward, lights and noise fill the oasis and mortals remain panic-stricken from that fight.",
      "chapters": [
        675
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "commotion-and-leave",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_fang_yuan"
      ]
    },
    {
      "text": "He later goes far from Sha Jing oasis before activating Fixed Immortal Travel.",
      "chapters": [
        676
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
