  "claims": [
    {
      "text": "At the top of Fei He mountain, the pavilion holds a white jade stone table. A thunderous voice there shakes the windows.",
      "chapters": [
        406
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "appearance",
      "text_origin": "source_excerpt"
    },
    {
      "text": "South of Central Continent, thirty thousand feet above the mountains, Fei He Mountain floats among a sea of clouds with trees and ten thousand cranes, the residence of Immortal Crane Sect. Inside Shang Qing pavilion the supreme first elder stares furiously at a thin letter from Feng Jiu Ge and slams it on a white jade stone table.",
      "chapters": [
        406
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "appearance",
      "text_origin": "source_excerpt",
      "mentions": [
        "reg_central_continent",
        "loc_fei_he_mountain",
        "fac_immortal_crane_sect",
        "char_feng_jiu_ge"
      ]
    },
    {
      "text": "The letter shines azure green as the transformation of rank five letter sending green bird Gu, so the elders dare not destroy or burn it. Lei Tan’s thunderous voice then echoes there and shakes the windows as he presses He Feng Yang over defending Fang Yuan though Fang Yuan is not a sect disciple.",
