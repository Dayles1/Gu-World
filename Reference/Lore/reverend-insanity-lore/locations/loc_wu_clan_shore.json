  "claims": [
    {
      "text": "Where red dragon river and yellow dragon river merge, a huge whirlpool creates great dangerous waves. From the peak of Corpse Emperor Yu Ding Tian, looking away from the river toward the shore is Wu clan ground.",
      "chapters": [
        1345
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "appearance",
      "text_origin": "source_excerpt"
    },
    {
      "text": "Toward the northeast shore of that huge whirlpool stands Corpse Emperor Yu Ding Tian.",
      "chapters": [
        1347
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "appearance",
      "text_origin": "source_excerpt"
    },
    {
      "text": "Not far from Corpse Emperor Yu Ding Tian, red dragon river and yellow dragon river merge into a huge whirlpool with dangerous waves. Looking from that corpse mountain away from the river toward the shore is Wu clan land. Taking Corpse Emperor Yu Ding Tian would leave the clan’s holdings east of red dragon river and north of yellow dragon river completely lost.",
      "chapters": [
        1345
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "corpse-mountain-and-lost-ground",
      "text_origin": "source_excerpt",
      "mentions": [
        "fac_wu_clan"
      ]
    },
    {
      "text": "Toward the northeast shore of the huge whirlpool at that intersection stands Corpse Emperor Yu Ding Tian.",
      "chapters": [
