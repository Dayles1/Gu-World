  "claims": [
    {
      "text": "Central Continent, Emperor City. During the Refinement Path Convention finals, Immortal Gu Houses fill the sky above the city while mortal Gu Masters compete below. Outside Emperor City, Central Continent stations many Immortal Gu Houses of varying ranks around the city in a three layered defense line. Western Desert rank eight experts and Immortal Gu Houses gather outside those lines.",
      "chapters": [
        1708
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "appearance",
      "text_origin": "source_excerpt",
      "mentions": [
        "reg_central_continent",
        "sys_refinement_path_convention",
        "sys_immortal_gu_house",
        "fac_gu_masters",
        "reg_western_desert"
      ]
    },
    {
      "text": "Fang Yuan focuses on Emperor City and states he will destroy this Emperor City and kill the Gu Masters in the final competition rather than let Heavenly Court repair fate Gu fully. Immortal Gu Houses appear revolving around Emperor City like planets around the sun.",
      "chapters": [
        1707
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "appearance",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_fang_yuan",
        "fac_heavenly_court",
        "gu_fate_gu"
      ]
    },
    {
      "text": "Bai Ning Bing’s group drives an Immortal Gu House straight for Emperor City after breaking the second defense layer, but the third layer still protects the city.",
      "chapters": [
        1708
      ],
      "certainty": "canon",
      "confidence": "B",
