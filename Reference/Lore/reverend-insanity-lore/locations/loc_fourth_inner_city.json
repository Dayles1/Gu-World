  "claims": [
    {
      "text": "Shang Clan City’s inner cities are graded by class. Fourth inner city is the middle-class zone; fifth is the low-class zone. Once entered, the air feels more moist and the temperature drops slightly. Compared with fifth inner city it is a grade higher: entrance fee is twice as high and facilities are better.",
      "chapters": [
        261
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "loc_shang_clan_city"
      ]
    },
    {
      "text": "Xiao Yan, specializing in fire type Gu worms, rises to rank three middle stage and finally breaks through fourth inner city’s battle zone into third inner city.",
      "chapters": [
        266
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "rank-rise-example",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_xiao_yan",
        "sys_gu_worms"
      ]
    },
    {
      "text": "Wei Yang explains the battle stage rules: thirty net victories in fifth inner city advance a fighter to fourth inner city, and eighty net victories there advance to third. The stage is split into three levels: low in fifth, middle in fourth, and high in third. Newcomers start at fifth with zero wins and losses. Cultivation at rank three is treated as enough to enter fourth inner city in ordinary talk among spectators.",
      "chapters": [
        279
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "battle-stage-tier",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_wei_yang"
      ]
    },
    {
      "text": "Tang Xiong purposely falls from fourth inner city to fifth to challenge Fang Yuan under the name Fang Zheng.",
      "chapters": [
        280
      ],
      "certainty": "canon",
