  "claims": [
    {
      "text": "On the mountain waist of San Cha Mountain, an ending battle leaves four Che Clan Gu Masters still standing against three from Zuo Clan. Che clan elder Che You Yin presses the attack while telling his daughter Che Qiao Xiang to stay back with her injury; she wants to fight beside him. Che You Yin and Zuo Wu Sheng are rivals for tens of years and about equal strength; both are injured rank three fighters when the demonic Gu Master Kong Ri Tian arrives, captures Che Qiao Xiang and Zuo Chan Yu, then the three kings inheritance opens on the peaks.",
      "chapters": [
        323
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "che-clan-fight-at-san-cha",
      "text_origin": "source_excerpt",
      "mentions": [
        "loc_san_cha_mountain",
        "fac_che_clan",
        "fac_gu_masters",
        "fac_zuo_clan",
