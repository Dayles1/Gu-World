    },
    {
      "text": "Deviation (recorded): this page uses the Central Continent region field because the Ren Zu telling is narrated while Fang Yuan is inside Hu Immortal Blessed Land. Cited scenes place the lake in the land of the dead and Obsession Death Domain, not on a five-region map seat.",
      "chapters": [],
      "certainty": "inferred",
      "confidence": "C",
      "verification": "no_citation",
      "source_id": "src_sagaofgu",
      "section": "appearance",
