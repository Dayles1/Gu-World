  "claims": [
    {
      "text": "At night, darkness covers the mountain while wind and thunder rumble and lightning flashes. Partway up the slope, heavy rain falls over a battlefield of Gu Master corpses and a thick bloody smell the rain cannot wash away.",
      "chapters": [
        1012
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "appearance",
      "text_origin": "source_excerpt",
      "mentions": [
        "sys_gu_master"
      ]
    },
    {
      "text": "A hundred thousand years earlier, night wind and thunder cover Southern Border’s Xuan Ci Mountain while a battle has just ended partway up the slope. More than ten Gu Master corpses lie on the ground, and heavy rain cannot wash away the blood smell.",
      "chapters": [
        1012
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "appearance",
      "text_origin": "source_excerpt",
      "mentions": [
        "reg_southern_border"
      ]
    },
    {
      "text": "Only two fighters remain. A young Gu Master kills his heavily injured grandfather after the old man asks why he attacked the clan’s higher-ups, then cuts the old man in two. The young man says the clan’s demands to endure, respect elders, and think for the clansmen had annoyed him since childhood, and he vows to kill whatever annoys him from then on.",
      "chapters": [
        1012
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "appearance",
      "text_origin": "source_excerpt"
    },
    {
      "text": "A hundred thousand years later, that same face appears on Spectral Soul Demon Venerable as a three-headed, thousand-armed form thousands of meters tall, still under wind and lightning.",
      "chapters": [
        1012
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
