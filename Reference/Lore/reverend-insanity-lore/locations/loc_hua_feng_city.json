  "claims": [
    {
      "text": "Hua Feng City Lord visits Steel Thread City as an esteemed guest received by Steel Thread City Lord herself. He brings hairy man Gu Masters and proposes a contest, because the king will hold a martial competition and each region can send only three people, while their region has both cities.",
      "chapters": [
        1050
      ],
