  "claims": [
    {
      "text": "You Chan occupies the famous dragonfish sea area as a natural breeding ground of massive scale, alongside production in her immortal aperture.",
      "chapters": [
        1471
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "appearance",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_you_chan"
      ]
    },
    {
      "text": "In Eastern Sea the dragonfish sea area that had no wind suddenly has huge waves and ripples when she recreates copper dragonfish there.",
      "chapters": [
        1478
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "appearance",
      "text_origin": "source_excerpt",
      "mentions": [
        "reg_eastern_sea"
      ]
    },
    {
      "text": "She leaves this sea area under market pressure from a rival seller in treasure yellow heaven.",
      "chapters": [
        1471
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "market-pressure",
      "text_origin": "source_excerpt"
    },
    {
      "text": "Most of her dragonfish assets sit here rather than only in her immortal aperture, so when a Gu Immortal attacks and destroys the Gu formation she races back from white crane sea area with Qin Bai He in Bai He Palace.",
      "chapters": [
        1484
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "attack-on-the-formation",
      "text_origin": "source_excerpt",
      "mentions": [
        "sys_gu_immortal",
        "sys_gu_formation",
        "char_qin_bai_he",
        "house_bai_he_palace"
      ]
    },
    {
      "text": "After taking Bai He Palace at white crane sea area, Fang Yuan returns here with Omni-directional Travel, empties the sea area, and later leaves without waiting for Heavenly Court.",
      "chapters": [
        1487
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "emptying",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_fang_yuan",
        "sys_omni_directional_travel",
        "fac_heavenly_court"
      ]
    },
    {
      "text": "He kills You Chan and Qin Bai He here inside purple star broken life, then erases traces so Qing Yue Zhi Cheng would find nothing even if he came.",
