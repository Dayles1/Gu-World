  "claims": [
    {
      "text": "Bai Ning Bing and Hei Lou Lan find a world of birds and flowers shrouded in thin fog. A variant human Gu Immortal appears from within the fog and names the place the Mushroomman Paradise.",
      "chapters": [
        1337
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "appearance",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_bai_ning_bing",
        "char_hei_lou_lan",
        "sys_gu_immortal"
      ]
    },
    {
      "text": "Fang Yuan stands on the tallest mountain in Mushroomman Paradise. Lu Wei Yin explains that this Mushroomman blessed land received Paradise Earth Immortal Venerable’s help and turned into a paradise free from calamities and tribulations. Paradise Earth also left his Virtue true inheritance here, so the place’s name became Virtue Paradise.",
      "chapters": [
        2083
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "virtue-paradise",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_fang_yuan",
        "char_lu_wei_yin",
        "char_paradise_earth_immortal_venerable",
        "inh_virtue_true_inheritance"
      ]
    },
    {
      "text": "Lu Wei Yin points at the mountain base and says Mushroomman Paradise is now Fang Yuan’s property, to annex or leave as Southern Border territory. It has existed for over a hundred thousand years with abundant resources comparable to top tier grotto-heavens in the two heavens.",
      "chapters": [
        2087
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "handed-to-fang-yuan",
      "text_origin": "source_excerpt",
      "mentions": [
        "reg_southern_border"
      ]
    }
