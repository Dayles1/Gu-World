  "claims": [
    {
      "text": "Strong wind blows throughout the year on this spiritual mountain that holds spirit springs, and the environment is really bad.",
      "chapters": [
        304
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
