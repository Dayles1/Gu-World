  "claims": [
    {
      "text": "On Myriad Life Road, Hei Lou Lan sees that downward stretches of the heavenly road spend less strength and give no rewards. Lu Tong Lan names those stretches Downslope Road beside Upslope Road from The Legends of Ren Zu. Ordinary judgment favors Downslope Road for its small expenditure and saves Upslope Road for the later half, but Immortal Zombie Giant Sun’s guidance is the opposite: do not take Downslope Road, walk Upslope Road instead. Gu Immortals who travel the same distance while using Downslope Road often keep rewards within mortal materials only.",
      "chapters": [
        2115
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
