  "claims": [
    {
      "text": "After the most dangerous stretch of Xiao Yue mountain, the caravan’s next stop is Xue Lei mountain, followed by a few more clan villages before Shang Liang mountain’s Shang Clan City.",
      "chapters": [
        245
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "named-on-the-planned-route",
      "text_origin": "source_excerpt",
      "mentions": [
        "loc_xiao_yue_mountain",
        "loc_shang_liang_mountain",
        "loc_shang_clan_city"
      ]
    },
    {
      "text": "After crossing Mu Bei Mountain and then Shuang Jiang mountain, the next place is Xue Lei mountain. The most dangerous part of the trade route is already over, so danger greatly decreases. Fang Yuan and Bai Ning Bing are wanted by Bai Clan, so the four move on after passing through Xue Lei mountain and continue across further mountains.",
      "chapters": [
        258
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "after-mu-bei-and-shuang-jiang",
      "text_origin": "source_excerpt",
      "mentions": [
        "loc_mu_bei_mountain",
        "loc_shuang_jiang_mountain",
        "char_fang_yuan",
        "char_bai_ning_bing",
        "fac_bai_clan_bai_gu_mountain"
      ]
    },
    {
      "text": "Xue Lei mountain has Zhao Clan and is not considered a wild area, since there are human inhabitants on it. Fang Yuan and Bai Ning Bing do not go to Zhao Clan on that pass.",
      "chapters": [
        258
      ],
      "certainty": "canon",
      "confidence": "B",
