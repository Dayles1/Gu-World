  "claims": [
    {
      "text": "Qin Yan brothel has eight storeys, with the number one lady’s room on the top floor.",
      "chapters": [
        282
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "appearance",
      "text_origin": "source_excerpt"
    },
    {
      "text": "A shop assistant at Fu Tai Xiang He Restaurant tells Fang Yuan that Li Ran’s reserved window seat looks into Qin Yan brothel toward Lady An Yu’s room. From that seat Fang Yuan can see into the brothel.",
      "chapters": [
        282
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "view-into-an-yus-room",
      "text_origin": "source_excerpt",
      "mentions": [
        "loc_fu_tai_xiang_he_restaurant",
        "char_fang_yuan",
        "char_li_ran",
        "char_lady_an_yu"
      ]
    },
    {
      "text": "Qin Yan brothel has eight storeys, and narration names An Yu as a rank two Gu Master whose Gu Master identity can invoke men’s conquering desires; rumors say it takes almost ten thousand primeval stones to have her for a night. Many restaurants sit around the brothel; Fang Yuan judges that at Fu Tai Xiang He’s distance he would only see a blur if An Yu were present, and that better peek spots exist.",
      "chapters": [
        282
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "view-into-an-yus-room",
      "text_origin": "source_excerpt",
      "mentions": [
        "sys_gu_master"
      ]
    },
    {
      "text": "At the auction house someone claims Shang Ya Zi and Fang Zheng went to Qin Yan brothel, competed for the number one lady, and that Fang Zheng got her. Lady An Yu is pointed out in the crowd; after her pimp winks she blushes without answering, and most doubters take that as proof.",
      "chapters": [
        307
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "auction-house-rumor",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_shang_ya_zi",
        "char_fang_zheng"
      ]
    },
    {
      "text": "A servant reports a citywide rumor that Shang Ya Zi lost Lady An Yu to Fang Zheng. Shang Ya Zi calls her that Qin Yan brothel’s prostitute and laughs the claim off as rubbish.",
      "chapters": [
        310
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "city-rumor-to-shang-ya-zi",
      "text_origin": "source_excerpt"
    }
  ],
