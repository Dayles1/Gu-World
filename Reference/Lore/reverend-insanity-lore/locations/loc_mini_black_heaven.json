  "claims": [
    {
      "text": "Fang Yuan places a walking meat tree into Mini Black Heaven within the sovereign immortal aperture. Mini Black Heaven’s environment is close to the real immemorial black heaven, so the tree is pleased after relocation and stretches out its branches comfortably, without the bespoke dark habitat Hei Fan once needed. The walking meat tree’s branches are soft and thick like octopus tentacles, and a light whip can send desolate beasts flying.",
      "chapters": [
        1133
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "appearance",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_fang_yuan",
        "char_hei_fan"
      ]
    },
    {
      "text": "Further aperture surveys still note that Mini Black Heaven holds the walking meat tree.",
      "chapters": [
        1159
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "appearance",
      "text_origin": "source_excerpt"
    },
    {
      "text": "Mini Black Heaven has no light at all. It is a special environment with only a few ancient desolate plant walking meat trees.",
      "chapters": [
        1461
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "dark-walking-meat-trees",
      "text_origin": "source_excerpt"
    },
    {
      "text": "Soul beasts captured by Fang Yuan, including desolate, ancient, and immemorial soul beasts, are usually kept in Mini Black Heaven until he needs them elsewhere.",
      "chapters": [
        2042
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "soul-beast-holding",
      "text_origin": "source_excerpt",
      "mentions": [
        "sys_soul_beast"
      ]
    },
    {
      "text": "During a broad aperture tribulation, Star Collection City receives word that a terrifying beast calamity has appeared in Mini Black Heaven, with thousands of green claw ghost winged lions hunting down soul beasts.",
      "chapters": [
        2204
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "ghost-winged-lion-calamity",
      "text_origin": "source_excerpt",
      "mentions": [
        "loc_star_collection_city"
      ]
    },
    {
      "text": "Combat Beast King orders that Mini Black Heaven does not need to be saved, and that rescuing desolate beasts, ancient desolate beasts, and even immemorial desolate beasts there should be given up so large cities and important resource points can be protected first.",
      "chapters": [
        2205
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "rescue-abandoned",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_combat_beast_king"
      ]
    }
  ],
