  "claims": [
    {
      "text": "In Mini Orange Heaven there are profound lights emitting from flowing light fruits, the result of Fang Yuan’s earlier farming effort.",
      "chapters": [
        1159
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "appearance",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_fang_yuan"
      ]
    },
    {
      "text": "A small field of aurora lights sits there, with many floating flowing light fruits inside those lights. After he obtains many light path Gu worms from the jade light pit, the scale of the aurora lights and flowing light fruits expands greatly on that foundation.",
      "chapters": [
        1291
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "appearance",
      "text_origin": "source_excerpt",
      "mentions": [
        "sys_gu_worms"
      ]
    },
    {
      "text": "Fang Yuan places modified pure white light shine fungi into Mini Orange Heaven. The fungi float in the sky and help areas that need intense light. Under that influence, Mini Orange Heaven’s aurora lights start to expand, mildly at first but substantially over time.",
      "chapters": [
        1458
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "fungi-placement",
      "text_origin": "source_excerpt"
    },
    {
      "text": "A fire rain that becomes meteor rain strengthens further as it enters mini orange heaven, rising to rank seven level before continuing into other mini heavens.",
      "chapters": [
        2127
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "cross-heaven-disaster",
      "text_origin": "source_excerpt"
    }
  ],
