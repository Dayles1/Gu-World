  "claims": [
    {
      "text": "Shang clan city covers the entire mountain. Outer-city structures of many kinds blend together across the peak in assorted colors, and the clan remodelled the mountain for thousands of years into surface and inner city.",
      "chapters": [
        260
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "appearance",
      "text_origin": "source_excerpt",
      "mentions": [
        "loc_shang_clan_city"
      ]
    },
    {
      "text": "Fang Yuan tells Bai Ning Bing their next destination is Shang Liang mountain. Bai Ning Bing links the name to Shang clan. Shang clan ranks among the top Southern Border forces and is famed for business there; Shang clan city is known as a trading center even outside the region.",
      "chapters": [
        229
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "appearance",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_fang_yuan",
        "char_bai_ning_bing",
        "reg_southern_border"
      ]
    },
    {
      "text": "When the travelers reach the foot of Shang Liang mountain, Shang clan city’s huge gate stands ahead.",
      "chapters": [
        258
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "appearance",
      "text_origin": "source_excerpt"
    },
    {
      "text": "Shang clan city covers the entire mountain. Shang Clan remodelled the mountain over thousands of years, using the surface and building an inner city into the mountain’s interior.",
      "chapters": [
        260
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "appearance",
      "text_origin": "source_excerpt",
      "mentions": [
        "fac_shang_clan"
      ]
    },
    {
      "text": "Shang clan city is number one in the southern border in size, with over ten thousand shops and hundreds of thousands of people on the mountain.",
      "chapters": [
        265
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "appearance",
      "text_origin": "source_excerpt"
    },
    {
      "text": "The inner city has five regions from first to fifth, then the outer city beyond.",
      "chapters": [
        261
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "appearance",
      "text_origin": "source_excerpt"
    },
    {
      "text": "Fang Yuan and Bai Ning Bing set off from Shang Liang mountain; to reach San Cha Mountain, Huo Tan mountain is a necessary stop.",
      "chapters": [
        335
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
