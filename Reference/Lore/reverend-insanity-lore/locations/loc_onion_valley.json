  "claims": [
    {
      "text": "A wide valley overgrown with green onions, a unique habitat like crescent lake.",
      "chapters": [
        496
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "appearance",
      "text_origin": "source_excerpt"
    },
    {
      "text": "Fang Yuan tells Ge Guang they will go there before rushing Yu Tian heroes assembly. Narration calls it a unique habitat like crescent lake, then describes a famous rank two Gu that looks like an onion but is red like fire; when activated it emits an intense odor that makes wild beasts irascible and more likely to attack people, so the place is much more dangerous than crescent lake. Fang Yuan says that very long ago he bred some wolves there, and that after years of growth they should have matured and expanded.",
      "chapters": [
        496
      ],
      "certainty": "inferred",
      "confidence": "C",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "appearance",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_fang_yuan",
        "char_ge_guang",
        "loc_yu_tian",
        "loc_crescent_lake"
      ]
    },
    {
      "text": "Speaking to Hei Lou Lan, Fang Yuan says that back then at onion valley he left some wolves behind, and that after these years they expanded to a great extent. Ge Guang adds that when Fang Yuan came out of onion valley, the endless number of wolves stunned them all. Narration states that after Fang Yuan went into onion valley alone, he opened the stargate and connected it to Hu Immortal Blessed Land, bringing out most of the wolves inside, and that he covered up his tracks on onion valley.",
      "chapters": [
        499
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "wolves-after-hei-lou-lan",
      "text_origin": "source_excerpt",
