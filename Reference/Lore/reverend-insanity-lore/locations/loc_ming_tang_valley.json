        "reg_central_continent",
        "sys_gu_worms",
        "sys_immortal_gu",
        "sys_gu_immortal",
        "char_gong_sun_liang"
      ]
    },
    {
      "text": "Fairy Zi Wei tells Heavenly Court they shall go to Ming Tang valley to capture Gong Sun Liang.",
      "chapters": [
        1052
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "heavenly-court-target",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_fairy_zi_wei",
        "fac_heavenly_court"
      ]
    },
    {
      "text": "A Defy member, demonic Gu Immortal Gong Sun Liang who had been hiding in Ming Tang valley, is ambushed and captured by Heavenly Court Gu Immortals. He sends a request for help and Defy falls into turbulence.",
      "chapters": [
        1066
