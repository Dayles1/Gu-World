  "claims": [
    {
      "text": "No chapter draws a full landscape of the valley beyond naming it as a deep treasure land rich in light path dao marks.",
      "chapters": [
        1030
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "appearance",
      "text_origin": "source_excerpt"
    },
    {
      "text": "Ming Tang valley sits under Wind Cloud Manor and Heavenly Lotus Sect, two of the ten great ancient sects. It is famous in Central Continent among the best places to produce light path Gu worms, and almost every twenty years a wild light path Immortal Gu forms there. Deep in the valley hides the demonic path Gu Immortal Unmoving Mountain, Gong Sun Liang.",
      "chapters": [
        1030
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "appearance",
      "text_origin": "source_excerpt",
      "mentions": [
        "house_wind_cloud_manor",
