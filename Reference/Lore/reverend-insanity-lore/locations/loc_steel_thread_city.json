  "claims": [
    {
      "text": "No chapter describes the city’s walls or skyline beyond naming its scale and market. Within the city alone there are hundreds of thousands of hairy men, not counting periphery villages and towns.",
      "chapters": [
        1049
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "appearance",
      "text_origin": "source_excerpt"
    },
    {
      "text": "Steel Thread City is the grandest city in Black Hair Continent of Lang Ya blessed land. Narration calls its trading market one of the most famous markets on that continent, and at the southeast corner of the market a fat muscular hairy man walks onto a stage ringed by other hairy men.",
      "chapters": [
        1049
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "appearance",
      "text_origin": "source_excerpt",
      "mentions": [
        "loc_black_hair_continent",
        "loc_lang_ya_blessed_land"
      ]
    },
    {
      "text": "Steel Thread City Lord manages city affairs and fields Fang Zheng in a contest against Hua Feng City, including a refinement path round Hua Feng City Lord chooses under agreed rules. Elders of Steel Thread City and the city lord watch the match with high stakes for Fang Zheng.",
      "chapters": [
        1050
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "city-lord-contests",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_steel_thread_city_lord",
        "char_fang_zheng",
        "loc_hua_feng_city",
        "char_hua_feng_city_lord"
      ]
    },
    {
      "text": "From Cloud Cover Continent, Fang Yuan sends a will that divides above Black Hair Continent, with one portion flying to Steel Thread City and quietly seeping into the female city lord’s mind while she processes documents.",
