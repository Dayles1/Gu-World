  "claims": [
    {
      "text": "Tremors shake Heavenly Court and a dragon shaped pillar of light rises. Fairy Zi Wei asks whether a senior has awakened. Granny Sha treats the scene as a Heavenly Court senior. Wei Ling Yang says the immortal graveyard is unfathomable and mysterious.",
      "chapters": [
        1228
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "fac_heavenly_court",
        "char_fairy_zi_wei",
        "char_granny_sha",
        "char_wei_ling_yang"
      ]
    },
    {
      "text": "The three immortals fly in and find a huge pit with a withered old man inside. Healing methods fail until Granny Sha pours true dragon heavenly water into his mouth. After five hundred grams he stands, says this is the last time he can awaken, and that more of that water is a waste. Fairy Zi Wei names him Duke Long, and he agrees.",
      "chapters": [
        1228
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_duke_long"
      ]
    },
    {
      "text": "Deep in Heavenly Court the immortal graveyard is plain grassland. When a senior awakens, a huge pit forms on that grassland.",
      "chapters": [
        1228
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "appearance",
      "text_origin": "source_excerpt"
    },
    {
      "text": "Flesh Whip Immortal fights Immortal Gu Houses as a rank eight expert who had been slumbering in Heavenly Court’s immortal graveyard. Star Constellation’s will, pressed by Fang Yuan’s victories since rebirth, awakened many Gu Immortals in advance, and those experts had a full range of Immortal Gu and some mutual cooperation.",
      "chapters": [
        1925
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "rank-eight-experts",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_flesh_whip_immortal",
        "sys_immortal_gu_house",
        "char_fang_yuan",
        "sys_gu_immortal",
        "sys_immortal_gu"
      ]
    },
    {
      "text": "Qin Song has awakened earlier in this life than in the previous one. Fairy Zi Wei notes that there is no wisdom path Gu Immortal awakening in the immortal graveyard this time.",
      "chapters": [
        1926
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "rank-eight-experts",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_qin_song"
      ]
    }
