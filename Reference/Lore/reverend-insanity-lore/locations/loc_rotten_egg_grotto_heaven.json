  "claims": [
    {
      "text": "When Ice Crystal Immortal Monarch gathers allies against Heavenly Court in immemorial black heaven, Rotten Egg grotto-heaven sends six eggman Gu Immortals who can form the ancient battle formation Rotting Smell Vicious Cloud. Narration lists it with Chaotic Rock grotto-heaven and Strange Hair grotto-heaven as one of the three forces close to Ice Crystal Immortal Monarch that bring trump cards.",
      "chapters": [
        1994
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_ice_crystal_immortal_monarch",
