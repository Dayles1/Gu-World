  "claims": [
    {
      "text": "In the air over this sea, Fang Yuan, Shark Demon, and their group hold an intense negotiation with Song clan Gu Immortals and reach an agreement after half an hour.",
      "chapters": [
        907
      ],
      "certainty": "canon",
