  "claims": [
    {
      "text": "In Heavenly Court, Duke Long activates the immortal killer move Dragon Claw Strike together with chaotic dragon fist; fist shadows and claw marks fill the field as he wrecks Seven Extreme Desolation’s head again and again and leaves Calamity Luck Altar in ruins.",
      "chapters": [
        1733
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "fac_heavenly_court",
        "char_duke_long",
        "sys_killer_moves",
        "move_seven_extreme_desolation",
        "house_calamity_luck_altar"
      ]
    },
    {
      "text": "Facing Qi Sea Ancestor, Duke Long opens with Dragon Claw Strike as a transformation path killer move that puts a claw mark in the air. The hit turns the target into fading cloud fog; Duke Long treats the cast as a test and reads the battlefield as qi path, with transformation path methods greatly restricted there.",
      "chapters": [
        1834
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "against-qi-sea-ancestor",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_qi_sea_ancestor"
      ]
    },
    {
      "text": "Duke Long’s right hand turns into a dragon claw as he uses Dragon Claw Strike to slash at Fang Yuan’s skull; Fang Yuan in bandit monkey form blocks it with his left arm, and the claw feels to Duke Long like punching a mountain.",
      "chapters": [
        1934
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "against-fang-yuan",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_fang_yuan"
      ]
    },
    {
      "text": "In Duke Long’s transformation path combat system, Dragon Claw Strike is one of four offense methods with chaotic dragon fist, spiraling dragon fangs, and world shaking dragon hammer; those four cover close, mid-range, and long range combat.",
      "chapters": [
        1945
      ],
