  "claims": [
    {
      "text": "Song clan has a signature water path inheritance called flowing water. That inheritance has defensive killer moves including noncorroding flowing water, emotionless flowing water, and flowering flowing water, which guard against poison path, wisdom path, and wood path respectively.",
      "chapters": [
        2238
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "fac_song_clan"
      ]
    },
    {
      "text": "Fang Yuan sees Song Yi Shi practicing a water path defensive killer move in poetic emotion sea area. She is currently using noncorroding flowing water. After looking for a while, he deciphers all of the profundities of that move.",
      "chapters": [
        2238
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "poetic-emotion-sea",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_fang_yuan",
        "char_song_yi_shi"
      ]
    },
    {
      "text": "Song Yi Shi cultivates for six hours before stopping. She looks at the steam and judges that at that rate she can complete cultivation of noncorroding flowing water in half a month. After she completes it, she plans to move on to emotionless flowing water. By using the same core, those passive defensive killer moves can be stacked.",
      "chapters": [
        2239
      ],
