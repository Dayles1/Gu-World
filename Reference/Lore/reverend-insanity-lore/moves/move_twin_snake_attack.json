  "claims": [
    {
      "text": "On the battle stage against Bai Ning Bing, Yan Tu answers her dual ice blades. Two fiery snakes appear, first about necklace sized, then expand into pythons several meters long and as thick as a bucket.",
      "chapters": [
        313
      ],
      "certainty": "canon",
