  "claims": [
    {
      "text": "In the Eastern Sea contest for Dragon Palace, Duke Long opens his mouth and roars as the immortal killer move dragon roaring wave, then flickers from place to place to strike nearby enemies with fists and claws.",
      "chapters": [
        1695
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "reg_eastern_sea",
        "house_dragon_palace",
        "char_duke_long",
        "sys_killer_moves"
      ]
    },
    {
      "text": "On Heavenly Court’s battlefield, Duke Long activates Dragon Roaring Wave and opens his mouth in a loud roar; the sound waves of the dragon roar spread rapidly all over the place. He then activates Body Flicker and teleports along with those dragon sound waves, appearing directly in front of Fang Yuan less than an arm’s length away.",
      "chapters": [
        1934
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "heavenly-court-battlefield",
      "text_origin": "source_excerpt",
      "mentions": [
        "fac_heavenly_court",
        "move_body_flicker",
        "char_fang_yuan"
      ]
    },
    {
      "text": "Closing distance on Fang Yuan’s warship.",
      "chapters": [],
      "certainty": "inferred",
      "confidence": "C",
      "verification": "no_citation",
      "source_id": "src_sagaofgu",
      "section": "closing-distance",
      "text_origin": "source_excerpt"
    },
    {
      "text": "He later pairs Dragon Roaring Wave with Body Flicker again and suddenly appears on the right of Myriad Year Flying Warship, close enough that daybreak swords swarm him.",
      "chapters": [
        1943
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "closing-distance",
