  "claims": [
    {
      "text": "As Qin Bai Sheng closes on the cloud building in Lang Ya blessed land, his right hand waves in front of him. Golden light bursts out. The cast shoots at the building. The air currents are fierce. The hammer is even larger than the cloud building, which looks weak under it.",
      "chapters": [
        880
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
