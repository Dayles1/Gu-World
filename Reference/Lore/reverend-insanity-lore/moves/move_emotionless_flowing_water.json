  "claims": [
    {
      "text": "Song clan’s flowing water inheritance includes emotionless flowing water among its defensive killer moves. Noncorroding flowing water, emotionless flowing water, and flowering flowing water guard against poison path, wisdom path, and wood path respectively.",
      "chapters": [
        2238
      ],
