  "claims": [
    {
      "text": "Reading Hei Fan true inheritance, Fang Yuan finds the immortal killer move. He plans to use it with Chu Du because their current agreement was handled only by Chu Du and feels unreliable.",
      "chapters": [
        1130
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "inh_hei_fan_true_inheritance",
        "char_fang_yuan",
        "sys_killer_moves",
        "char_chu_du"
      ]
    },
    {
      "text": "Before leaving Hei Fan grotto-heaven he casts hundred years harmony and creates a new alliance agreement with Chu Du.",
      "chapters": [
        1134
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "alliance-with-chu-du",
      "text_origin": "source_excerpt",
      "mentions": [
        "loc_hei_fan_grotto_heaven"
      ]
    },
    {
      "text": "When variant humans bind members with information path dao marks through an earth path method, he likens that cross-path pattern to his time path immortal killer move hundred years harmony.",
      "chapters": [
        1146
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "cross-path-likeness",
      "text_origin": "source_excerpt"
    },
    {
      "text": "Hei Lou Lan later makes the same comparison for Ying Wu Xie’s soul path alliance method.",
      "chapters": [
        1149
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "cross-path-likeness",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_hei_lou_lan",
        "char_ying_wu_xie"
      ]
    },
    {
      "text": "Fang Yuan attributes some of his time path dao marks to the hundred years harmony agreement with Chu Du, similar to earth path marks from the variant human alliance.",
      "chapters": [
        1161
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "cross-path-likeness",
      "text_origin": "source_excerpt"
    },
    {
      "text": "Grandmaster attainment can mimic other paths’ advantages; hundred years harmony is a classic example of time path Gu producing an information path effect, showing Hei Fan’s time path was at least grandmaster.",
      "chapters": [
        1326
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "attainment-example",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_hei_fan"
      ]
    },
    {
      "text": "At the grandmaster versus great grandmaster distinction, hundred years harmony again shows time path imitating information path.",
      "chapters": [
        1502
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "attainment-example",
      "text_origin": "source_excerpt"
    }
