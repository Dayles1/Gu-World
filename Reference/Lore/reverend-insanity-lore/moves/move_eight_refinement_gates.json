  "claims": [
    {
      "text": "During the fight with Zhao Pu, Yu Yi Ye Zi takes the chance to palm-strike toward Zhao Pu’s back from afar and calls eight refinement gates, third gate, hand gate, open. Two exquisite palm silhouettes strike Zhao Pu’s back with incredible speed. Zhao Pu gives a muffled groan, blood splashes out from his back and covers his injuries, and he finds the attack much stronger than before.",
      "chapters": [
        1263
      ],
      "certainty": "canon",
      "confidence": "B",
