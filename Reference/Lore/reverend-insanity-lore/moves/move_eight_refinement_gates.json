      "text_origin": "source_excerpt",
      "mentions": [
        "char_zhao_pu",
        "char_yu_yi_ye_zi"
      ]
    },
    {
      "text": "Yu Yi Ye Zi is a refinement path Gu Immortal, but his battle strength is also extraordinary. Given some time, he can target his opponent’s weaknesses properly.",
      "chapters": [
        1263
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "intro",
