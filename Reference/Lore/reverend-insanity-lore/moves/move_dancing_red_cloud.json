  "claims": [
    {
      "text": "She uses it as her fastest method to go rescue Fairy Cui Bo, with Thousand Transformations Ancestor’s will present to help and to supervise her. Wild winds blow by her ears as she lies on the cloud toward green ghost desert. After dark clouds cover the sky, she sits cross-legged, opens her eyes, and rides it past those clouds while staying vigilant. When an ancient soul beast pounces, Thousand Transformations’ will tells her to advance. The cloud does not stop or change directions.",
      "chapters": [
        1412
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_fairy_cui_bo",
        "char_thousand_transformations_ancestor"
      ]
    },
    {
      "text": "She rides it in an arc to avoid a green claw ghost winged lion and pulls some distance away.",
      "chapters": [
        1413
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
