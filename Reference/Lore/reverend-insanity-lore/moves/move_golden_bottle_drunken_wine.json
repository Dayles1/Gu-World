  "claims": [
    {
      "text": "At a concealed inheritance site, Green Ant Ascetic’s will has Zui Xian Weng accept the couple’s inheritance after he vows to oppose Fang Yuan. A golden bottle holds green ants; Green Ant Ascetic created army ant and hid that weakness deeply, and food path makes the strike hard to guard against.",
      "chapters": [
        2110
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
