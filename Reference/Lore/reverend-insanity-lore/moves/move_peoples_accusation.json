  "claims": [
    {
      "text": "When three Central Continent rank eight Gu Immortals close on Fang Yuan, they tell him Heavenly Court prepared more than ten investigative killer moves against him and name people’s accusation, created by Primordial Origin Immortal Venerable, among them.",
      "chapters": [
        1699
      ],
