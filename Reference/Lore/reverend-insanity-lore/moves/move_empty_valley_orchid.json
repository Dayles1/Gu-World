  "claims": [
    {
      "text": "When Divine Bean Palace and other rank eight threats press Fallen Flower Hall, Fang An Lei activates the immortal killer move empty valley orchid. The Immortal Gu House shrinks to toy size, flower petals become orchid stalks with spreading fragrance, and space expands and stretches by several times so Divine Bean Palace, Eagle Concubine, and a winged black python immemorial soul beast must travel a huge distance even though the house sits nearby. Fang An Lei struggles to sustain it at her limit while resisting that band of rank eight enemies.",
      "chapters": [
        1518
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
