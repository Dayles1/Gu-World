  "claims": [
    {
      "text": "In the River of Time, Fang Yuan rejects torrential charge and orders Myriad Year Flying Warship to use daybreak sword against Gu Liu Ru. White light shoots out; River of Time water bubbles from it, silver strands condense into sharp sword-like blades, and those blades strike Gu Liu Ru hard enough to break through his defense, wound him, and destroy Immortal Gu in his wheelchair Immortal Gu House. Gu Liu Ru judges it a time path killer move that extracts the sharpest time path power from the river’s water: sword-shaped in form, time path dao marks in essence, rank eight in itself, and further raised by clever use of the River of Time.",
      "chapters": [
        1811
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "loc_river_of_time",
