  "claims": [
    {
      "text": "Fang Yuan secretly activates Immortal Gu Distracting Thoughts to prepare this immortal killer move while turtling behind a soul beast army inside Wan Xiao’s immortal battlefield.",
      "chapters": [
        1800
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_fang_yuan",
        "gu_distracting_thoughts_immortal_gu",
        "char_wan_xiao"
      ]
    },
    {
      "text": "The move makes enemies within a certain range develop distracting thoughts. The effect is not obvious at the start. As time passes, enemies have more distracting thoughts that disturb normal thinking. Wan Hao Guang, nearest to Fang Yuan, splits attention mid-battle and is encircled. Wan Xiao develops distracting thoughts while activating an immortal killer move, so activation fails and backlash heavily injures him. Wan Liang Han, a wisdom path Gu Immortal, senses the peculiar method and orders retreat to prepare a counter later.",
      "chapters": [
        1800
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "effect",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_wan_hao_guang",
        "char_wan_liang_han",
        "sys_gu_immortal"
      ]
    },
    {
      "text": "Wan clan’s three immortals are affected by distracting thoughts generation and cannot use killer moves freely, because activation is likely to fail and backlash without harming the enemy. Wan Liang Han is also struck by the move: while suppressing distracting thoughts and watching Wan Hao Guang and Wan Xiao, he cannot notice anything more.",
      "chapters": [
        1801
      ],
      "certainty": "inferred",
      "confidence": "C",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "aftermath",
      "text_origin": "source_excerpt",
      "mentions": [
        "fac_wan_clan"
      ]
    }
