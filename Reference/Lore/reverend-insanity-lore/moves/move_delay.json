  "claims": [
    {
      "text": "Narration states that in Fang Yuan’s previous life the killer move was famed across the five regions under that short name. During the five regions chaotic war, use of delay on Northern Plains Gu Immortals cut their casualties and helped stall Central Continent’s push.",
      "chapters": [
        815
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
