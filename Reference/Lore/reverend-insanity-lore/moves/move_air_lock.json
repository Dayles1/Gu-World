  "claims": [
    {
      "text": "After Fang Yuan and his group activate Omni-directional Travel successfully, they only teleport a tiny distance, not even ten percent of before. Wu Yong’s voice names air lock as Clear Jade Dripping Wind Tiny Bamboo Building appears on the horizon again.",
      "chapters": [
        1386
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
