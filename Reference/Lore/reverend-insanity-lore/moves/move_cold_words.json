  "claims": [
    {
      "text": "Old Immortal Hua Yu confronts Dragon Palace during Wu Shuai’s invasion of Profound Literature grotto-heaven. He opens his mouth and moves his tongue, spitting out text characters that shroud Dragon Palace like a storm with dense frost energy.",
      "chapters": [
        2009
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
