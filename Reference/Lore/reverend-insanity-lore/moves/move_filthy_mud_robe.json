  "claims": [
    {
      "text": "In Starry Sky grotto-heaven, after metal path wounds from three flying sword rats accumulate on his back, Shi Lei activates this immortal killer move. The rats land on the robe and cannot free themselves, stuck as if in a swamp.",
      "chapters": [
        727
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
