  "claims": [
    {
      "text": "On Tian Ti mountain, when He Feng Yang judges the time ripe, Fairy Cang Yu names the Gu he draws as Expand Space Immortal Gu, property of Immortal Crane Sect’s second supreme elder and normally used to enlarge a blessed land’s space; he has borrowed it for this immortal killer move. Over ten beads of green grape immortal essence are spent at once, translucent ripples rise, space cracks like glass, and the terrain of Hu Immortal blessed land shows through so he can invite her to enter.",
      "chapters": [
        699
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
