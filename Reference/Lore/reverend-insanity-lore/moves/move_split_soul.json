  "claims": [
    {
      "text": "In a Lang Ya cloud city secret room, Fang Yuan’s soul leaves his body while wills left in the body activate Split Soul. The move comes from Spectral Soul’s true inheritance and he has modified it so he can use it. Intense pain and a huge soul injury follow the first activation, which fails, and he heals with guts Gu. The cast needs the Gu Immortal’s soul to leave the body and leave thoughts, wills, or emotions to manipulate Gu worms. Success makes splitting as easy as drinking water; failure can collapse the soul, so Gu Immortals with weak soul foundations cannot use it blindly. Fang Yuan only starts trying after reaching ten million man soul.",
      "chapters": [
        1471
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "fac_lang_ya_sect",
