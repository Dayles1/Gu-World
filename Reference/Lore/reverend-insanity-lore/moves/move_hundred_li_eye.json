  "claims": [
    {
      "text": "Through Little Hu Immortal in treasure yellow heaven, Fang Yuan trades one chestnut yak desolate beast corpse for a pair of bat desolate beast wings and this investigative killer move. Market rating puts it at six immortal essence stones, the top tier among mortal killer moves, and he says he had been lacking that kind of investigative tool. The bat wings, not the eye move, are what he names as the greater satisfaction of the deal.",
      "chapters": [
        732
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_little_hu_immortal",
        "char_fang_yuan",
        "sys_killer_moves"
      ]
    },
    {
      "text": "On Dang Hun Mountain his pupils enlarge when he activates it: within one hundred li grassland and debris look close enough to touch; past that range sight blurs but stays clearer than the naked eye; past about four hundred li he can only tell colors and shadows. It cannot see through stealth or bypass obstacles, so anything behind a block stays hidden. He keeps it active while flying and watching sky and ground.",
      "chapters": [
        733
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "range-and-limits",
      "text_origin": "source_excerpt",
      "mentions": [
        "loc_dang_hun_mountain"
      ]
    },
    {
      "text": "Hundred li eye is the base for the immortal killer move thousand li eye, which needs corresponding Immortal Gu.",
      "chapters": [
        733
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "immortal-follow-on",
      "text_origin": "source_excerpt",
      "mentions": [
        "sys_immortal_gu"
      ]
    },
    {
      "text": "Outside Dark Flow Giant City he uses hundred li eye to watch the giant gully entrance to Earth Trench that Zombie Alliance guards.",
      "chapters": [
        743
      ],
