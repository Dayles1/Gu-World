  "claims": [
    {
      "text": "A Northern Plains expert arrives before Duke Long. A dragon roar sounds, and an elegant purple-gold dragon qi appears in the sky for an instant. The Gu Immortal wants to see it and sees only remnant traces. The expert who reached Duke Long stands motionless, a hole through his chest. Blood gushes from his mouth, countless mini dragon-shaped qi emerge on his body, and he detonates into flesh and blood. He cannot take one hit from Duke Long. Killer moves land on Duke Long. The purple-gold dragon-shaped qi flashes again. Duke Long appears far away, and many killer moves miss.",
      "chapters": [
        1721
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "reg_northern_plains",
        "char_duke_long",
        "sys_gu_immortal"
      ]
    },
    {
      "text": "Duke Long snickers and roars. The purple-gold dragon-shaped qi flickers continuously as he rampages among the encircling Gu Immortals. Purple-gold dragon qi flickers again. The battlefield becomes silent, and Duke Long stands before Calamity Luck Altar.",
      "chapters": [
        1722
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "breaking-the-encirclement",
      "text_origin": "source_excerpt",
      "mentions": [
        "house_calamity_luck_altar"
      ]
    },
    {
      "text": "The purple-gold dragon-shaped qi flickers as Duke Long appears elsewhere. He dodges winged blade. His right dragon horn is sliced apart.",
      "chapters": [
        1723
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "dodges-winged-blade-horn-sliced",
      "text_origin": "source_excerpt"
    },
    {
      "text": "A dragon roar sounds and purple-gold dragon-shaped qi erupts. Seven Extreme Desolation cannot react. Duke Long disappears.",
      "chapters": [
        1732
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "escapes-before-it-can-react",
      "text_origin": "source_excerpt",
      "mentions": [
        "move_seven_extreme_desolation"
      ]
    },
    {
      "text": "Duke Long throws a dragon-shaped purple-gold qi without looking back. This is a qi path killer move. Five Elements Grandmaster is struck by the purple-gold dragon qi and bursts into pieces, dying on the spot.",
      "chapters": [
        1745
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "five-elements-ring",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_five_elements_grandmaster"
      ]
    },
    {
      "text": "Purple-gold dragon-shaped qi flickers as Duke Long is teleported right in front of Yu Yang Zi.",
      "chapters": [
        1930
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "yu-yang-zi",
      "text_origin": "source_excerpt"
    },
    {
      "text": "Immortal killer move Purple-Gold Dragon-Shaped Qi is named. Once he uses this killer move, offense, defense, healing, or movement all have accompanying purple-gold dragon-shaped qi. It is his main method in qi path, and it is very comprehensive. In the previous life, Five Elements Grandmaster died from this move.",
      "chapters": [
        1939
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "accompanying-qi",
      "text_origin": "source_excerpt"
    },
    {
      "text": "Duke Long shoots forward. His purple-gold dragon-shaped qi flickers constantly and his figure appears and disappears, moving in all directions as he tries to evade.",
      "chapters": [
        1944
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "fist-heart-sword",
      "text_origin": "source_excerpt"
    },
    {
      "text": "The purple-gold dragon-shaped qi around him chases and attacks Fang Yuan like a storm. In Duke Long’s qi path combat system this killer move is a jack of all trades, and its most important use is still movement.",
      "chapters": [
        1945
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "storm-chase",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_fang_yuan"
      ]
    }
  ],
