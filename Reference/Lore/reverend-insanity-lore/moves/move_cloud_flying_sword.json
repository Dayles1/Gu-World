  "claims": [
    {
      "text": "Among the Immortal Gu Fang Yuan takes from the sleeping immortal zombie Bo Qing is flying sword Gu, a rank seven Immortal Gu with the outer appearance of a silver-winged dragonfly. Bo Qing used it often in combat. With that Gu as a core, together with other Immortal Gu and mortal Gu, he created many sword path killer moves that left a deep mark in history. Cloud flying sword is listed among the named examples, with formless flying sword, pursuing flying sword, and ten thousand li flying sword.",
      "chapters": [
        995
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
