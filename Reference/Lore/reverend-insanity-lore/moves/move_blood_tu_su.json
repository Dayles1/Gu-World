  "claims": [
    {
      "text": "Seeing the field, Blazing Demonic Immortal recognizes Song Zi Xing’s attack. The battlefield killer move is uniquely distinctive in Central Continent. Song Zi Xing claims Vicious Lightning Fiend’s lightning deity could break the field open, yet doubts any escape can beat his blood rainbow flash; when he later flees as a bloody rainbow he even discards blood path Immortal Gu used to build the battlefield, then races back to reclaim control after realizing he is in an illusion.",
      "chapters": [
        848
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
