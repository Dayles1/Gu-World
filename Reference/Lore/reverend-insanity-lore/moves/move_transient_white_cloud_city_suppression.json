  "claims": [
    {
      "text": "Around Heavenly Court’s immortal graveyard, Gu Immortals act as formation cores and raise an immortal formation. Fog spreads across the battlefield like thick clouds. Figures still rise from the graveyard with the same battle strength as their main bodies, but when killed they break into lumps of fog. Immortal Zombie Giant Sun deduces a painting path formation that also contains human path methods, with Divine Emperor City as the core, Heavenly Court Gu Immortals as supplementary cores, and Star Constellation Immortal Venerable as the main controller.",
      "chapters": [
        2192
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "loc_immortal_graveyard",
