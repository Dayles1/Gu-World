  "claims": [
    {
      "text": "While fleeing Fang Yuan with Feng Jun, Zhou Min activates this move in anger. Her eyes stare wide and shoot golden white light as sharp as blades and daggers. Narration names her a light path Gu Immortal with sight light Immortal Gu, and names this her strongest move, Farsight Weapon Light.",
      "chapters": [
        1126
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
