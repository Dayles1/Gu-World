  "claims": [
    {
      "text": "Inside fighting soul battlefield in Yu Lu blessed land, while Shark Demon’s group shelters in Profound Ice House, Xie Shu Fang gathers black and white light into a large ball that looks like a map of the field. On that map the incomplete house is a white center, soul beasts are surrounding darkness, and hidden Gu worms shine like stars at clear locations. She names the wisdom path immortal killer move Distinct Map, then pinches a hidden spot on the map until a soft crack sounds and the Gu there shatter.",
      "chapters": [
        905
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
