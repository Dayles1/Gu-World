  "claims": [
    {
      "text": "When three myriad wolf kings charge Zheng tribe camp, Zheng tribe leader’s Thunder Bird obstructs the turtleback myriad wolf king. He shouts for the lightning spear corps to shoot together. Lightning spears fly. Support Gu Masters converge them into a lightning snake. One elder activates eagle claw Gu so the snake grows two sharp, steel-like claws. Another activates rhino horn Gu, and a sharp golden horn grows from its head. A third activates silver scales Gu, adding bright silver scale armor. The armed lightning spear circles in the air like a divine dragon and charges the wind wolf myriad beast king.",
      "chapters": [
        480
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
