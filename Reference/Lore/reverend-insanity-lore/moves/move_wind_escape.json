  "claims": [
    {
      "text": "At Luo Po Valley, Qin Bai Sheng presses Hui Feng Zi to join an attack on Lang Ya blessed land and names this killer move as the reason Hui Feng Zi can retreat as he wishes. Hui Feng Zi, a rank seven wind path Gu Immortal, refuses the invitation on the blessed-land and grotto-heaven limit. After a failed exchange with death wind flying blade, he casts wind escape toward the valley sky; the method has saved him many times, including once escaping pursuit by the rank eight Gu Immortal Yao Huang. A Gu formation still forces him out of the wind state and blocks breakout, so he joins Qin Bai Sheng’s side under pressure.",
      "chapters": [
        779
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "loc_luo_po_valley",
