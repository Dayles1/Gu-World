  "claims": [
    {
      "text": "When Fang Yuan arrives beside Hei Lou Lan with Fixed Immortal Travel, Xue Song Zi waves his sleeves and creates a curved moon blade wheel the size of a horse carriage. The blade wheel spins in the air and slashes at Fang Yuan. He uses icy wind blade wheel.",
      "chapters": [
        677
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_fang_yuan",
        "char_hei_lou_lan",
        "gu_fixed_immortal_travel",
        "char_xue_song_zi"
      ]
    },
    {
      "text": "The blade wheel made of ice is extremely sharp, oozing with frost energy, and extremely fast when pushed by the wind. Before it reaches him, Fang Yuan feels icy winds blowing on him. He judges that the killer move has the essence of both ice and wind path, and that its value is at least three immortal essence stones. He evades it with light illusion bat wings.",
      "chapters": [
        677
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt"
    },
    {
      "text": "The blade wheel hits the ground, digs deep like cutting tofu, and carves a huge trench on the grassland. Ice that is tough as rocks forms on the sides of the trench.",
      "chapters": [
        677
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt"
    },
    {
      "text": "Xue Song Zi creates a curved moon blade wheel the size of a horse carriage. The wheel is made of ice, oozes frost energy, and is pushed by wind. After it misses, it cuts a huge trench whose sides freeze into ice as tough as rocks.",
