  "claims": [
    {
      "text": "While chasing Spectral Soul Demon Venerable, Qin Ding Ling activates Luck Slicing Golden Blade and shoots out a small golden blade.",
      "chapters": [
        2333
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_spectral_soul_demon_venerable",
        "char_qin_ding_ling"
      ]
    },
    {
      "text": "The golden blade starts only the size of a thumb, then grows in the air until it reaches the size of a horse carriage. Against Spectral Soul Demon Venerable’s colossal black mountain-like body, that horse carriage-sized blade looks like an ant dancing above his head.",
      "chapters": [
        2333
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "appearance",
      "text_origin": "source_excerpt"
    },
    {
      "text": "The blade swings down to slice off Spectral Soul Demon Venerable’s luck. He ignores the attack and keeps forcing his way into Heavenly Court, yet his massive luck is still reduced by the luck slicing golden blade. The reduction is insignificant beside the sheer size of that luck, and Qin Ding Ling feels helplessness as rank eight methods fail to stop a rank nine body that keeps recovering.",
      "chapters": [
        2333
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "luck-cut",
      "text_origin": "source_excerpt",
      "mentions": [
        "fac_heavenly_court"
      ]
    }
