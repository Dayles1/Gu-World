  "claims": [
    {
      "text": "While weighing Star Constellation Immortal Venerable’s dream realm inside Starry Sky grotto-heaven, Fang Yuan names Tang clan of Western Desert’s immortal killer move Steal Dream as the method that could steal that dream realm out of the grotto-heaven, move it elsewhere, and let him devour it at his own pace. In his previous five hundred years, Tang clan had the deepest dream path foundation among the five regions’ super forces and rose on dream path during the five regions chaotic war. He already holds Unravel Dream, but without Steal Dream he would still have to enter Starry Sky grotto-heaven and get close to that dream, so he cannot contest Combat Immortal Sect for it yet.",
      "chapters": [
        776
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
