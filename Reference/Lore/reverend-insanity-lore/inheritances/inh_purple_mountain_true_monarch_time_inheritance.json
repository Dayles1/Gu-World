  "claims": [
    {
      "text": "Tai Bai Yun Sheng’s time path inheritance is extraordinary: a Gu Immortal inheritance. Its core has three Gu: river as before Gu, mountain as before Gu, and man as before Gu. The inheritance theorizes that when he becomes an immortal, using the resonance of heaven and earth, he can advance man as before Gu into an Immortal Gu; mortal man as before Gu can only be used on others, while Immortal Gu Man as Before can be used on himself.",
      "chapters": [
        604
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_tai_bai_yun_sheng",
        "path_time",
        "sys_gu_immortal",
        "gu_river_as_before_gu",
        "gu_mountain_as_before_gu",
        "gu_man_as_before_gu",
        "sys_immortal_gu",
        "gu_man_as_before_immortal_gu"
      ]
    },
    {
      "text": "When young, Tai Bai Yun Sheng gave an old beggar a bowl of water; when clear-headed, the beggar offered three Gu Immortal inheritances, and Tai Bai Yun Sheng chose the third.",
      "chapters": [
        615
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "beggar-origin",
      "text_origin": "source_excerpt"
    },
    {
      "text": "He chose the as before time path inheritance from the three immortal inheritances, matching his cautious nature.",
      "chapters": [
        621
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "beggar-origin",
      "text_origin": "source_excerpt"
    },
    {
      "text": "After becoming a Gu Immortal he holds Landscape as Before and Man as Before as Immortal Gu.",
      "chapters": [
        618
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "beggar-origin",
      "text_origin": "source_excerpt",
      "mentions": [
        "move_landscape_as_before",
        "move_man_as_before"
      ]
    },
    {
      "text": "While soul searching Dong Fang Chang Fan, Fang Yuan finds that Tai Bai Yun Sheng’s time path inheritance was from Purple Mountain True Monarch, and that Dong Fang Chang Fan’s wisdom path inheritance was from the same mysterious old man.",
      "chapters": [
        811
      ],
      "certainty": "canon",
