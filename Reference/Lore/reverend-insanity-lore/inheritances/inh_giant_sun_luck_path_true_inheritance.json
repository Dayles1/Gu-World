  "claims": [
    {
      "text": "During the Imperial Court crisis, Ma Hong Yun and Zhao Lian Yun are protected by the luck path true inheritance and stay safe for the moment. Giant Sun’s will sends Hei Lou Lan to retrieve that luck path true inheritance. The text calls it a supreme hidden treasure left by Giant Sun Immortal Venerable, used on his path to rule an era, and treats Giant Sun’s luck path true inheritance as a giant golden egg firmly protecting the two. Giant Sun’s will opens a passage toward the true inheritance secluded domain and asks Hei Lou Lan to push the luck path true inheritance into it.",
      "chapters": [
        622
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
