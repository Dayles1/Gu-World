  "claims": [
    {
      "text": "Fang Yuan finds a bright red rock like a fire lotus in a valley after killing an eerie fire dragon python. The rock opens in layers and shows Gu worms and a stele written in northern plains words.",
      "chapters": [
        548
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "appearance",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_fang_yuan",
        "sys_gu_worms"
      ]
    },
    {
      "text": "The fire path Gu Master who left the inheritance was called Huo Zheng Jun, a righteous rank four fire path Gu Master. He entered the valley by accident, was attacked by the eerie fire dragon python, and before dying from his injuries left his Gu worms and made the inheritance. He left seven Gu worms. After years, four have died and three remain. His core Gu worm was the rank four fire pupil Gu. Fang Yuan keeps the three remaining Gu, stores the recipes, and smashes the stele.",
      "chapters": [
        548
      ],
