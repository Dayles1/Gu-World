  "claims": [
    {
      "text": "Beside Prince Feng Xian she is one of two high-status servants from Spirit Affinity House, with Swordmaster You Lan the other. She speaks first, naming Loose Tail Ridge as one of Northern Plains’ ten great fierce areas and guessing Lang Ya blessed land hides nearby.",
      "chapters": [
        1546
      ],
      "certainty": "canon",
