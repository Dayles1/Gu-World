      ]
    },
    {
      "text": "She wears a yellow dress and is extremely beautiful.",
      "chapters": [
        1546
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "appearance",
      "text_origin": "source_excerpt"
    },
    {
      "text": "She frowns that Feng Jiu Ge’s group has sent no word and asks if they are in trouble. She also questions whether sending only rank seven Gu Immortals into Lang Ya blessed land is overconfident, then is astounded when Prince Feng Xian ranks Feng Jiu Ge above himself. With Swordmaster You Lan she had once been indignant that Spirit Affinity House placed Feng Jiu Ge level with their rank eight master, then gradually changed that view.",
      "chapters": [
        1546
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
