  "claims": [
    {
      "text": "After Fang Yuan’s clash around Present and Past Pavilion, Qing Ye walks over to Shang Xunzi on Eternal Yacht’s deck and reports that the other two were swept away by the River of Time and cannot be found. Qing Ye says the core Immortal Gu were recovered and that a room is ready so Shang Xunzi can revive the siblings.",
      "chapters": [
        1630
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
