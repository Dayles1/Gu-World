  "claims": [
    {
      "text": "He arrives at Shang Yan Fei’s clan banquet in Shang clan city among the young masters who appear after Wei Yang’s first round of introductions. He is the youngest among those present and a late bloomer.",
      "chapters": [
        269
      ],
      "certainty": "canon",
