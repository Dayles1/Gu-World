  "claims": [
    {
      "text": "Meng tribe carefully picked him as a Gu Immortal junior for Meng Zi Zai to nurture. He calls Meng Zi Zai uncle, guesses the intruder is a lone demonic Gu Immortal, and is excited that the trip can introduce him to Lord Meng Tu for their shared faction. His cultivation and status are low enough that the tribe has not yet told him of Meng Tu’s death when Meng Zi Zai learns the soul lantern is out.",
      "chapters": [
        1566
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "fac_meng_tribe",
        "sys_gu_immortal",
        "char_meng_zi_zai",
        "char_meng_tribe_meng_tu"
      ]
    },
    {
      "text": "He has a rough appearance and is tall and well-built.",
      "chapters": [
        1566
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "appearance",
      "text_origin": "source_excerpt"
    },
    {
      "text": "He cannot match Meng Zi Zai’s rank seven speed and arrives later. Dense blade path dao marks stab his skin with pain. He finds Meng Zi Zai kneeling in tears, hears that Brother Meng Tu has died in battle, and is ordered to return, cultivate, and keep the news sealed. Investigation Courtyard soon arrives with Meng tribe’s second supreme elder; Meng Zhao puts his heart at rest and leaves the chase to them.",
      "chapters": [
        1566
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "death-news-and-dismissal",
      "text_origin": "source_excerpt",
      "mentions": [
        "house_investigation_courtyard"
      ]
    },
    {
      "text": "After rebirth Fang Yuan recalls that Meng Zi Zai and Meng Zhao from Meng tribe investigated Meng Tu’s death and had actually suspected Sleeping Lady.",
      "chapters": [
        1752
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "rebirth-investigation",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_fang_yuan",
        "char_sleeping_lady"
      ]
    }
