  "claims": [
    {
      "text": "After Blue Phoenix Tribe and Fire Blend Tribe stage a clash, Lu Tong Lan brings Hei Lou Lan to meet Fire Blend Tribe Leader, who smiles and names himself Yellow Extremity Jiao Huo. He hands Lu Tong Lan immortal materials suited for Hei Lou Lan, then cuts corpse meat for a pot while explaining that totem dao marks stay fixed in bodies here after apertures are digested by Myriad Beast Fusion Color Heaven. He says he was the first of them to arrive, was exposed as an outsider, ate people to raise his totem, and became Fire Blend Tribe Leader.",
      "chapters": [
        2113
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "fac_blue_phoenix_tribe",
        "fac_fire_blend_tribe",
        "char_lu_tong_lan",
