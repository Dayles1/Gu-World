  "claims": [
    {
      "text": "She first appears in Ni Yu blessed land as Dong Fang Chang Fan’s guest, sipping tea while a smoke image shows the Hei tribe and Dong Fang tribe battle. She praises Dong Fang Yu Liang’s performance and asks whether Chang Fan secretly gave him an Immortal Gu or other arrangements for Imperial Court.",
      "chapters": [
        514
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "loc_ni_yu_blessed_land",
        "char_dong_fang_chang_fan",
        "fac_hei_tribe",
        "fac_dong_fang_tribe",
        "char_dong_fang_yu_liang",
        "sys_immortal_gu",
        "loc_imperial_court"
      ]
    },
    {
      "text": "She holds the post of Liu tribe external supreme elder and is secretly supporting Liu Wen Wu; if Liu Wen Wu took the Imperial Court throne it would greatly help her status in Liu tribe. When Chang Fan tells her Snowy Mountain blessed land has secretly contacted Ma tribe, she believes the wisdom path deduction, cannot stay seated, and leaves Ni Yu to warn others. After she leaves, Chang Fan smiles: the discussion was a scheme he made for her, taking advantage of her own stake and expectations.",
      "chapters": [
        514
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "liu-tribe-stake",
      "text_origin": "source_excerpt",
      "mentions": [
        "fac_liu_tribe",
        "char_liu_wen_wu",
        "loc_snowy_mountain",
        "fac_ma_tribe"
      ]
    },
    {
      "text": "After she departs, Hei Bai becomes the next guest in the blessed land.",
      "chapters": [
        519
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "liu-tribe-stake",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_hei_bai"
      ]
    },
    {
      "text": "Hei Bai later tells Hei Cheng in Xiao Hun blessed land that Ma tribe’s Snowy Mountain ties match what Liu tribe’s external supreme elder Gu Immortal Tan Bi Ya reported.",
      "chapters": [
        537
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "confirmed-report",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_hei_cheng",
        "loc_xiao_hun_blessed_land",
        "sys_gu_immortal"
      ]
    },
    {
      "text": "After Hei tribe beats Ma tribe, Hei Cheng credits information from Fairy Tan Bi Ya for revealing the secret Ma tribe and Snowy Mountain relationship.",
      "chapters": [
        543
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "confirmed-report",
      "text_origin": "source_excerpt"
    }
