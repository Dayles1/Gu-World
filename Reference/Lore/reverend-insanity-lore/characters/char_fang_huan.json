  "claims": [
    {
      "text": "A burial mound on a precipice draws earth path and fire path beasts with yellowish-brown and red light around a tombstone. The light collapses into the mound, the mound splits, and Gu Immortal aura leaks out as he opens his eyes, recalls his name, then flies up and declares that he is alive again under that demonic title. Red light waves surge from his body and burn most of the beast groups. He asks Bai Ning Bing for help against remaining immemorial desolate beasts and promises a heavy reward.",
      "chapters": [
        2141
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "sys_gu_immortal",
        "char_bai_ning_bing"
      ]
    },
    {
      "text": "He appears as a naked male immortal when the mound bursts open.",
      "chapters": [
        2141
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "appearance",
      "text_origin": "source_excerpt"
    },
    {
      "text": "Bai Ning Bing kills the immemorial desolate beasts, then cuts Fang Huan into two at the waist and soul searches him. Through that search she learns he is from a previous generation, cultivated earth path, later inherited heart fire true inheritance and cultivated fire path as well, did fire monster business, and had been one of the tycoons of that business in treasure yellow heaven. He had died long ago and revived for reasons she cannot yet pin down. The dense earth path and fire path dao marks of the site had condensed into his immortal body.",
      "chapters": [
        2141
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "death",
      "text_origin": "source_excerpt"
    }
