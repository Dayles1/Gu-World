  "claims": [
    {
      "text": "Song clan has occupied Eastern Sea for hundreds of years and sits in the top ten among that region’s super forces. The publicly known number of clan Gu Immortals is eighteen. His son Song Diao Ling was a rank seven Gu Immortal, publicly recognized as successor, until he was schemed against and died over ten years before this stretch, leaving Song Yi Shi as the only descendant of his bloodline. After her immortal ascension he personally protected her and gave her the poetic emotion sea area.",
      "chapters": [
        893
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "fac_song_clan",
        "reg_eastern_sea",
        "sys_gu_immortal",
        "char_song_yi_shi"
      ]
    },
    {
      "text": "In the study room of Heavy Water blessed land he turns around slowly. He shows no anger on his face and smiles kindly.",
      "chapters": [
        899
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "appearance",
      "text_origin": "source_excerpt",
      "mentions": [
        "loc_heavy_water_blessed_land"
      ]
    },
    {
      "text": "He is discussing clan matters with rank seven elders when Song Yi Shi barges in. He is preparing to lead clan Gu Immortals against Cai clan and Ruo Lai clan for Old Eccentric Tian Nan’s inheritance at Ascending Heaven Plain. He gives Song Yi Shi a token and sends her to twin polar sea strait to find Song Jia Dan.",
      "chapters": [
        899
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "inheritance-contest",
      "text_origin": "source_excerpt",
      "mentions": [
        "inh_tian_nan_true_inheritance",
        "loc_ascending_heaven_plain",
        "char_song_jia_dan"
      ]
    },
    {
      "text": "At Twin Polar Sea Strait, Song Jia Dan senses that Song Qi Yuan’s token has been used and lets the fog part into a path for Song Yi Shi and Song Xia Qi.",
      "chapters": [
        987
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "token-opens-twin-polar-sea-strait",
      "text_origin": "source_excerpt",
      "mentions": [
        "loc_twin_polar_sea_strait",
        "char_song_xia_qi"
      ]
    },
    {
      "text": "He cultivates light path, and his attainment level is very high. He uses a pure white light that splits into threads to kill ants inside Song Yi Shi’s body.",
      "chapters": [
        2103
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "ants-purged-from-song-yi-shi",
      "text_origin": "source_excerpt"
    }
  ],
