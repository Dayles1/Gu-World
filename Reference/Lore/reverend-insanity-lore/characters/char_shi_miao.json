  "claims": [
    {
      "text": "Duke Long names him among Granny Rong, Yang Zi He, Shi Miao, and Zhang Yin, lone and demonic immortals of Eastern Sea surrounding him at Dragon Palace. Shi Miao takes the lead into that fight.",
      "chapters": [
        1688
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_duke_long",
        "char_granny_rong",
        "char_yang_zi_he",
        "char_zhang_yin",
        "reg_eastern_sea",
        "house_dragon_palace"
      ]
    },
    {
      "text": "He is robust, with triangular eyes that shine with cold light. Later narration again places him as a muscular Gu Immortal with triangular eyes shining in cold light.",
      "chapters": [
        1688
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "appearance",
      "text_origin": "source_excerpt",
      "mentions": [
        "sys_gu_immortal"
      ]
    },
    {
      "text": "Narration places him in the four person alliance of Granny Rong, Yang Zi He, Zhang Yin, and Shi Miao opposing Eastern Sea righteous path rank eights and Duke Long. In battle he spatters blood while retreating from an intense explosion.",
      "chapters": [
        1690
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "four-person-alliance",
      "text_origin": "source_excerpt",
      "mentions": [
        "fac_eastern_sea_righteous_path"
      ]
    },
    {
      "text": "Charging out of Dragon Palace, he spatters a mouthful of acid water that grows with the wind into a huge wave and melts Qing Yue An’s phantom mountain path for Dragon Palace.",
      "chapters": [
        1692
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "acid-water-against-qing-yue-an",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_qing_yue_an"
      ]
    },
    {
      "text": "He is listed among Song Qi Yuan, Qing Yue An, Shen Cong Sheng, Zhang Yin, Granny Rong, and others seeking Dragon Palace in an unprecedented Eastern Sea rank eight gathering.",
      "chapters": [
        1700
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "eastern-sea-rank-eight-gathering",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_song_qi_yuan",
        "char_shen_cong_sheng"
      ]
    },
    {
      "text": "Already controlled by Dragon Palace as a dragon general, he charges Heavenly Court’s defensive line toward Heaven Overseeing Tower. Duke Long grabs his rock skinned neck, then Shi Miao melts over Duke Long’s body to pin him while Fang Yuan’s five finger fist heart sword strikes. Shi Miao dies as a severed corpse with a smile.",
      "chapters": [
        1949
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "death-pinning-duke-long",
      "text_origin": "source_excerpt",
      "mentions": [
        "fac_heavenly_court",
        "house_heaven_overseeing_tower",
        "char_fang_yuan"
      ]
    }
  ],
