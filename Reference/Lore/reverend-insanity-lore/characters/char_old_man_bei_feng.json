  "claims": [
    {
      "text": "When Feng Chan Zi ascended to immortal, Old Man Bei Feng gave him grass puppet Immortal Gu as a gift. Ying Wu Xie explains that gift while the group waits at Wind Cloud Manor and meets a grass puppet avatar of rank six battle strength instead of Feng Chan Zi in person.",
      "chapters": [
        1052
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_feng_chan_zi",
        "sys_immortal_gu",
        "char_ying_wu_xie",
        "house_wind_cloud_manor"
      ]
    },
    {
      "text": "Feng Chan Zi is his grandson and is very doted on. With Old Man Bei Feng’s accumulated achievements and battle strength potential, he could already rise to Heavenly Court and become one of its members. Fairy Zi Wei says that if he wants to come to Heavenly Court she will personally welcome him, but because Feng Chan Zi is punished to guard Hidden Dragon Cave at only rank six, Old Man Bei Feng is to handle that post with him.",
      "chapters": [
        1069
      ],
      "certainty": "canon",
      "confidence": "B",
