  "claims": [
    {
      "text": "In Ni Yu blessed land, Tan Bi Ya and Dong Fang Chang Fan treat the loan as an open secret among Gu Immortals while ranking Ye Lui Sang among that year’s popular Imperial Court candidates. Dong Fang Chang Fan places Ye Lui tribe in the Huang Jin bloodline as one of the Northern Plains super tribes, notes that the tribe has not owned Imperial Court for the last eight rounds, and says Hei Cheng of Hei tribe has mocked Ye Lui Lai over that record, which is why Ye Lui Lai is mobilizing an Immortal Gu to regain face.",
      "chapters": [
        514
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
