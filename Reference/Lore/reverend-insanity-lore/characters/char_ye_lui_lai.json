        "fac_hei_tribe",
        "sys_immortal_gu"
      ]
    },
    {
      "text": "During the upheaval of Eighty-Eight True Yang Building, Ye Lui Sang feels the fire path Immortal Gu near his heart tremble; Ye Lui Lai lent that Gu before the Imperial Court contest.",
      "chapters": [
        564
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "immortal-gu-path",
