  "claims": [
    {
      "text": "Immortal Crane Sect disciples name the four great obscenities, including Eastern Obscenity Chen Yi Dao, as rank four Gu Masters who travel Central Continent and together can contend against rank five.",
      "chapters": [
        336
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "fac_immortal_crane_sect",
        "fac_gu_masters",
        "reg_central_continent"
      ]
    },
    {
      "text": "Later text names him Eastern Obscenity Chen Yin Dao, still rank four, leader of the Four Great Obscenities, and a famous demonic path expert in Central Continent’s Gu Master world. He orders the Gu House taken out when sorrowful winds blow, and leads the four into Sorrowful Wind Mountain Range hoping leftovers from a Gu Immortal fight might let them ascend to immortal. They search the ruins for seven days and then find a still living person with a strange bloom and wilt cycle around him.",
      "chapters": [
        2084
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "sorrowful-wind-search",
      "text_origin": "source_excerpt",
      "mentions": [
        "fac_four_great_obscenities",
        "sys_gu_master",
        "sys_gu_house",
        "sys_gu_immortal"
      ]
    },
    {
      "text": "At Sorrowful Wind Mountain Range the four rest in an ordinary cave. The text again names Eastern Obscenity Chen Yin Dao among them and says they are infamous in Central Continent’s Gu Master world for taking the chastity and lives of many innocent girls.",
      "chapters": [
        2092
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "cave-rest",
      "text_origin": "source_excerpt"
    }
  ],
