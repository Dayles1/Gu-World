  "claims": [
    {
      "text": "A female immortal appears after a Shang clansman freezes in fear and rebukes him for disregarding kinship for authority and wealth. She looks at Shang Xin Ci with approval and says warmly that she is an ancestor of Shang clan, Shang Qing Qing, and that from now on Shang Xin Ci will assume the role of Shang clan leader.",
      "chapters": [
        1059
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_shang_xin_ci",
        "fac_shang_clan"
      ]
    },
    {
      "text": "She appears as a female immortal. No chapter gives further physical detail beyond that role and her warm manner toward Shang Xin Ci.",
      "chapters": [
        1059
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "appearance",
      "text_origin": "source_excerpt"
    },
    {
      "text": "As a senior female immortal of Shang clan, she singlehandedly supports Shang Xin Ci to become the leader of Shang clan. She conceals herself and watches in the background to control the situation and prevent chaos. When Shang Tan Mo doubts whether the girl can lead after Yi Tian Mountain, Shang Qing Qing says generations of clan leaders were nurtured through experience, and that she chose Shang Xin Ci for heart and magnanimity rather than ability. She points to the loyal subordinates on the mountain peak as evidence of that charisma.",
      "chapters": [
        1072
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "shang-xin-ci-as-leader",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_shang_tan_mo",
        "loc_yi_tian_mountain"
      ]
    }
