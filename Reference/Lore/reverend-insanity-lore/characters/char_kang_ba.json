  "claims": [
    {
      "text": "In the trading market of Steel Thread City, a fat and muscular hairy man walks onto a stage ringed by other hairy men. Someone asks loudly what goods he has this time. The hairy man Kang Ba specializes in selling slaves, has a huge business, and has a certain amount of fame.",
      "chapters": [
        1049
      ],
      "certainty": "canon",
      "confidence": "B",
