  "claims": [
    {
      "text": "On the night Chen Chi’s group discusses Fang Yuan as Hei Cheng, the male Gu Immortal Chen Li Zhi says they have to talk to Hei Cheng properly.",
      "chapters": [
        1122
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_chen_chi",
        "char_fang_yuan",
        "char_hei_cheng",
        "sys_gu_immortal"
      ]
    },
    {
      "text": "He worries that delaying will annoy Hei Cheng and push him toward Zheng Tuo, then backs Chen Chi’s analysis that their four votes nearly give half the grotto-heaven’s support. Chen Chi tells Fang Yuan that his nephew Chen Li Zhi is an enslavement path Gu Immortal who envies the upper extreme heavenly eagle. Chen Li Zhi presses lifespan Gu as a condition for their support.",
      "chapters": [
        1123
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "succession-talks",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_zheng_tuo",
        "gu_lifespan_gu"
      ]
    },
    {
      "text": "Fang Yuan, still posing as Chen Chi, summons him, praises him as Little Zhi, draws him close with talk of Hei Cheng’s offers, then kills him as he sits and stores the corpse in his immortal aperture.",
      "chapters": [
        1124
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "assassination-in-the-palace",
      "text_origin": "source_excerpt"
    },
    {
      "text": "Fang Yuan later tells Chen Le that Chen Chi, Chen Wan Yun, and Chen Li Zhi died in his hands, and that the rank seven Gu Immortals of their side are dead.",
      "chapters": [
        1127
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "named-among-the-dead",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_chen_le",
        "char_chen_wan_yun"
      ]
    }
  ],
