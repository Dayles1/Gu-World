  "claims": [
    {
      "text": "Rumors say Suan Bu Jin is Old Man Lie Shen’s inheritor, a demonic descendant recruited by Fang clan, and that Wan clan will investigate that identity.",
      "chapters": [
        1799
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "fac_fang_clan",
        "fac_wan_clan"
      ]
    },
    {
      "text": "He had been a Wan clan wisdom path Gu Immortal, but an accident while cultivating made him lose himself and become a lunatic. He had rank seven cultivation, and his strength rose further after he went crazy. He caused huge losses to Wan clan and slaughtered Gu Immortals of other righteous path forces. Several righteous path forces allied to besiege and kill him, but they found no traces. He disappeared completely and the matter was left unresolved.",
      "chapters": [
        1799
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "madness-and-disappearance",
      "text_origin": "source_excerpt",
      "mentions": [
        "sys_gu_immortal"
      ]
    },
    {
      "text": "After Wan Liang Han’s death, Wan clan’s first supreme elder says they can be certain Suan Bu Jin is Old Man Lie Shen’s inheritor and that the bloody debt Old Man Lie Shen owes will be paid by him. Placing that crime on Fang Yuan gives Western Desert righteous path forces an excuse to move against Fang clan. Fang clan answers by declaring they will protect Fang Yuan and prove his origin relates to Zheng Jing Shen instead.",
      "chapters": [
        1802
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "crime-pinned-on-suan-bu-jin",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_wan_liang_han",
        "char_fang_yuan",
        "reg_western_desert",
        "char_zheng_jing_shen"
      ]
    }
  ],
