  "claims": [
    {
      "text": "She appears before Old Ghost Bai Jun after his defeat and says their master ordered her to bring him back for questioning. She leads him through a quicksand pit into the green-light space and up the golden stairs to Divine Bean Palace, where both kneel and greet the soul beast master.",
      "chapters": [
        1508
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_old_ghost_bai_jun",
        "house_divine_bean_palace"
      ]
    },
    {
      "text": "She wears tight black clothing that shows a seductive figure. Her face is pale white as if she never saw sunlight, without rosiness, and her eyes shine with a gloomy light.",
      "chapters": [
        1508
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "appearance",
      "text_origin": "source_excerpt"
    },
    {
      "text": "She and Old Ghost Bai Jun had entered Divine Bean Palace and been suppressed into Qing Chou’s slaves. Qing Chou refined Soul Beast Token and gave it to Bai Jun so a soul beast army could strike the palace.",
      "chapters": [
        1516
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "slave-of-qing-chou",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_qing_chou",
        "gu_soul_beast_token"
      ]
    },
    {
      "text": "When Chen Yi takes control of Divine Bean Palace and suppresses their master, she and Old Ghost Bai Jun defect and become Chen Yi’s lackeys.",
      "chapters": [
        1522
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "defection-and-later-service",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_chen_yi"
      ]
    },
    {
      "text": "Chen Yi later sends them out against flowery wind warriors. They are rank seven Gu Immortals and experienced demonic cultivators, skilled at preserving their lives after righteous path pursuit.",
      "chapters": [
        1525
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "defection-and-later-service",
      "text_origin": "source_excerpt",
      "mentions": [
        "sys_gu_immortal"
      ]
    },
    {
      "text": "Fang clan later forcibly subdues both as slaves after the fight over Divine Bean Palace.",
      "chapters": [
        1616
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "defection-and-later-service",
      "text_origin": "source_excerpt",
      "mentions": [
        "fac_fang_clan"
      ]
    }
  ],
