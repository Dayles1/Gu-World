  "claims": [
    {
      "text": "Old Ghost Bai Jun holds him and Fang Yun as captives with dark grey soul chains. Fang clan is a Western Desert super force, and Old Ghost Bai Jun names Fang Leng a talent among rank sixes and a possible successor, the direct great-grandson of Fang clan’s first supreme elder. He keeps quiet under torture, then tells Old Ghost Bai Jun to kill them rather than yield.",
      "chapters": [
        1504
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_old_ghost_bai_jun",
        "char_fang_yun",
        "fac_fang_clan",
        "reg_western_desert"
      ]
    },
    {
      "text": "He is slightly older than Fang Yun and has a square face.",
      "chapters": [
        1504
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "appearance",
      "text_origin": "source_excerpt"
    },
    {
      "text": "When Fallen Flower Hall opens he is stable and mature with an air of nonchalance, and narration calls him a rising star in Fang clan.",
      "chapters": [
        1513
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "appearance",
      "text_origin": "source_excerpt",
      "mentions": [
        "house_fallen_flower_hall"
      ]
    },
    {
      "text": "He leaves Fallen Flower Hall with Fang An Lei and Fang Yun to thank Suan Bu Jin and open cooperation talks.",
      "chapters": [
        1513
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "clan-alliance",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_fang_an_lei"
      ]
    },
    {
      "text": "During the later clash he and Fang Yun help control the Immortal Gu House and show guilt when Fang An Lei is struck.",
      "chapters": [
        1519
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "clan-alliance",
      "text_origin": "source_excerpt",
      "mentions": [
        "sys_immortal_gu_house"
      ]
    },
    {
      "text": "After reinforcements arrive he remains among Fang clan’s rank six elites in green ghost desert.",
      "chapters": [
        1521
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "clan-alliance",
      "text_origin": "source_excerpt"
    }
  ],
