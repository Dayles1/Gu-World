  "claims": [
    {
      "text": "Xiao He Jian, Lady Cold Ash, and other invaders look down on the dying Gu Immortal in the ruins of Crescent Moon grotto-heaven and ask whether she will surrender. She has rank eight cultivation and is the owner of Crescent Moon grotto-heaven. She holds terrain advantage but is outnumbered and hanging on her last breath. She refuses to surrender, saying her grotto-heaven has no conflicts with the outside world and has never provoked them nor held ambitious plans.",
      "chapters": [
        2018
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
