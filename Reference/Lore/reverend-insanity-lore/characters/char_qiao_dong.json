  "claims": [
    {
      "text": "At Iron Eagle blessed land, Hei tribe’s second supreme elder says Qiao Dong became an immortal under that elder’s guidance decades earlier, and complains that his loyalty has wavered. Hei Cheng reports that he has already struck and taught Qiao Dong a lesson, and expects no further trouble for five years.",
      "chapters": [
        691
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "loc_iron_eagle_blessed_land",
        "fac_hei_tribe",
        "char_hei_cheng"
      ]
    },
    {
      "text": "During the assault on Iron Eagle blessed land he is named a righteous path Gu Immortal and the first supreme elder of Qiao tribe. He claims the resonance eagles defending the land are fruits of Qiao tribe’s labor rather than Hei tribe creations. The same stretch records that he became an immortal because of Hei tribe’s support, that Qiao tribe was Hei tribe’s subordinate and was pressured by Hei Cheng after seeking to leave, and that he has now joined the attack under Liu tribe with Liu Zhuan Shen behind him.",
      "chapters": [
        1108
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "iron-eagle-assault",
      "text_origin": "source_excerpt",
      "mentions": [
        "sys_gu_immortal",
        "fac_qiao_tribe",
        "fac_liu_tribe",
        "char_liu_zhuan_shen"
      ]
    },
    {
      "text": "Hei Tie Sheng’s life draining darkness hits him as a mountain-like shadow; he calls for Liu Zhuan Shen, who appears in front of him, then finds Qiao Dong floating behind him with no vitality left, dead.",
      "chapters": [
        1109
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "death-at-iron-eagle",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_hei_tie_sheng"
      ]
    }
  ],
