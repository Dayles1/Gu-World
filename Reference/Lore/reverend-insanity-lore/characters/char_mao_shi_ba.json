  "claims": [
    {
      "text": "Hua Feng City’s final hairy man Gu Master steps onto the stage against Fang Zheng, puffs out his chest, and names himself Mao Shi Ba. He is furious when Fang Zheng does not respond, taking the silence as humiliation.",
      "chapters": [
        1050
      ],
