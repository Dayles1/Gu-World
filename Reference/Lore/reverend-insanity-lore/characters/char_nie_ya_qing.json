  "claims": [
    {
      "text": "Cunning Gentleman Sun Shi Han lists Liu Wen Wu, Luo Bo Jun, and Nie Ya Qing as rank five experts on Liu tribe’s side in the Imperial Court struggle, calling that lineup rare across the past ten contests.",
      "chapters": [
        527
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_sun_shi_han",
        "char_liu_wen_wu",
        "char_luo_bo_jun",
        "fac_liu_tribe",
        "loc_imperial_court"
      ]
    },
    {
      "text": "Later rolls of experts in the sacred palace still name Nie Ya Qing beside Tai Bai Yun Sheng, the twin demons, and other rank four peak or rank five fighters.",
      "chapters": [
        582
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "sacred-palace-fights",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_tai_bai_yun_sheng"
      ]
    },
    {
      "text": "When Hei Lou Lan orders a mass strike on a flying bear phantom, Nie Ya Qing is among the experts who charge in. He is a rank five Gu Master using iron hook silver slash Gu, forms his palm into an eagle claw, and tears at the phantom’s eyes, nose, and mouth so it takes the hits passively.",
      "chapters": [
        583
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "sacred-palace-fights",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_hei_lou_lan",
        "sys_gu_master"
      ]
    },
    {
      "text": "When Tai Bai Yun Sheng shatters his aperture to attempt Gu Immortal advancement, Nie tribe leader Nie Ya Qing is deeply moved and praises the courage of that step.",
      "chapters": [
        606
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "nie-tribe-leader",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_tai_bai_yun_sheng",
        "sys_gu_immortal",
        "fac_nie_tribe"
      ]
    },
    {
      "text": "The fan translation writes Nie Ya Qing. No Chinese characters for the personal name appear in the English chapter text used here.",
