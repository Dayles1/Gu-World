  "claims": [
    {
      "text": "Duke Long hovers over Eastern Sea after Dragon Palace sinks into the sea. Song Qi Yuan reveals himself, then two more Gu Immortals show themselves: Qing Yue An, first supreme elder of Qing Yue clan, and Hua Cai Yun. She starts to address Duke Long. He cuts her off and attacks. Several immortal killer moves are exchanged, and the three who came forward are suppressed and forced back. Fang Yuan watches from the sea as a sea snake and judges that Duke Long can suppress those three by himself.",
      "chapters": [
        1690
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
