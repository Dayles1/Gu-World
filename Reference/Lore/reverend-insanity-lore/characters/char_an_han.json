  "claims": [
    {
      "text": "At Flying Frost Sect he sits on a bamboo chair as first elder, reads Fang Yuan’s leaked rank five aura as real, and orders burly men to move around the disguised demonic Gu Master.",
      "chapters": [
        828
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "loc_flying_frost_sect",
        "char_fang_yuan",
        "sys_demonic_path"
      ]
    },
    {
      "text": "Watching Fang Yuan burn souls to refine ghost fire Gu, he snorts that the method is evil and unorthodox. As host first elder he faces loss of face if he fails, and he wants first place in that Refinement Path Convention round for Flying Frost Sect. Crowds around the stage say first place there has to go to Lord An Han.",
      "chapters": [
        831
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "ghost-fire-round",
      "text_origin": "source_excerpt",
      "mentions": [
        "gu_ghost_fire_gu",
        "sys_refinement_path_convention"
      ]
    },
    {
      "text": "Fang Yuan’s two-tasks-at-once refinement shocks him into standing without noticing. A disciple calls him back, and the sect leader’s look forces him onto the stage to restore reputation through refinement path. Spectators cast optimistic gazes at the famous An Han, while an old Gu Master judges that he already knows he cannot beat Fang Yuan and has lost composure. When a duel between Fang Yuan and Zheng Shan Chuan draws the crowd, An Han leaves the venue to them and later quietly pushes resources so the duel continues.",
      "chapters": [
        832
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "stage-pressure",
      "text_origin": "source_excerpt",
      "mentions": [
        "sys_gu_master",
        "char_zheng_shan_chuan"
      ]
    }
  ],
