  "claims": [
    {
      "text": "He created the Five Regional Mountain Range. People call him Restriction Expert because he is the expert of restriction path in his generation. Restriction path is a branch of rule path, as emotion path is a branch of wisdom path.",
      "chapters": [
        1042
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
