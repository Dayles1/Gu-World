  "claims": [
    {
      "text": "She bows to Shang Yan Fei as clan leader. He tells her that from today she will take care of Missy Ci Er to the best of her efforts, and she answers that she understands.",
      "chapters": [
        263
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_shang_yan_fei"
      ]
    },
    {
      "text": "He orders her, when near Shang Xin Ci, to pay great attention and find out how they managed to come to Shang Liang mountain, pointing to the servants who speak without thinking as the easiest breakthrough. She completes that mission in just three days. Narration says she was an orphan adopted by Shang Yan Fei, loyal and trusted to use, with great ability to perform.",
      "chapters": [
        263
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_shang_xin_ci",
        "loc_shang_liang_mountain"
      ]
    },
    {
      "text": "She is a young female Gu Master. At Shang Yan Fei’s banquet she wears servant attire.",
      "chapters": [
        270
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "appearance",
      "text_origin": "source_excerpt",
      "mentions": [
        "sys_gu_master"
      ]
    },
    {
      "text": "Tian Lan wears servant attire as she pushes the door open and returns to Shang Xin Ci’s side before Xin Ci walks into the courtyard.",
      "chapters": [
        270
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "banquet-return",
      "text_origin": "source_excerpt"
    },
    {
      "text": "Beside Shang Xin Ci and Shang Chi Wen there are four servants, and two of them are Tian Lan and Xiao Die, Shang Xin Ci’s personal servants.",
      "chapters": [
        305
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
