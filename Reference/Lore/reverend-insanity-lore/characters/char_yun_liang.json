  "claims": [
    {
      "text": "He is named Yun Liang, known as Cloud Gentleman. He arrives before Murong Qing Si at affinity wood, concentrates on collecting it, then spars with her on terms that let her take half; both leave satisfied.",
      "chapters": [
        1106
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
