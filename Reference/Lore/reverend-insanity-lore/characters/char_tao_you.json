  "claims": [
    {
      "text": "Leopard King Nu Er Tu leads his army against Tao tribe after that tribe’s alliance has already taken many setbacks. Alliance leader Tao You judges that he has no hope of becoming Lord of Imperial Court, submits to Nu Er Tu, and their combined armies surge in military power.",
      "chapters": [
        536
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_nu_er_tu",
        "fac_tao_tribe",
        "loc_imperial_court"
      ]
    },
    {
      "text": "After Hei Lou Lan wins the contest, his recruitment roll names Tao You among the experts who answer the call, including Fang Yuan as Chang Shan Yin and Tai Bai Yun Sheng.",
      "chapters": [
        582
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "true-yang-building-experts",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_hei_lou_lan",
        "char_fang_yuan",
        "char_chang_shan_yin",
        "char_tai_bai_yun_sheng"
      ]
    },
    {
      "text": "Against the flying bear phantom the charge names him with experts who are either rank four peak stage or rank five. He is an earth path Gu Master: he absorbs earth energy, gathers it into himself, and punches consecutive earth-energy meteors that crash onto the bear while Dou E and Gu Guo Long also strike.",
      "chapters": [
        583
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "true-yang-building-experts",
      "text_origin": "source_excerpt",
      "mentions": [
        "sys_gu_master",
        "char_dou_e",
        "char_gu_guo_long"
      ]
    },
    {
      "text": "Later, with Fang Yuan, Tai Bai Yun Sheng, Xi Xue, Pei Yan Fei, Gu Guo Long, and others, he joins a killer-move push that tilts a True Yang Building round toward the alliance army.",
      "chapters": [
        604
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "true-yang-building-experts",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_xi_xue",
        "char_pei_yan_fei",
        "house_eighty_eight_true_yang_building"
      ]
    },
    {
      "text": "The fan translation writes Tao You. No Chinese characters for the personal name appear in the English chapter text used here.",
