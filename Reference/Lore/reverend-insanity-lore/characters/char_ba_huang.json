  "claims": [
    {
      "text": "Bai Ning Bing sends it at Mo Wu Tian. It is a hill-sized enormous dog emperor. Its physique is majestic, its whole body covered with yellow sleek fur. It has a head like a lion, with a thick mane around its neck that is dazzling like a sun. Its bark is like a bolt from the blue, suppressing the battlefield into silence, after which the dog beasts flare with morale. Once it uses the wild Gu on it, it can contend against rank five Gu Masters. Mo Wu Tian is stopped.",
      "chapters": [
        394
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "appearance",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_bai_ning_bing",
        "char_mo_wu_tian",
        "sys_wild_gu",
        "fac_gu_masters"
      ]
    },
    {
      "text": "Before Mo Wu Tian it is bathed in blood, in a condition worse than his. Healing Gu on it work under milky-white light, and it heals most of its injuries and becomes revitalized again.",
      "chapters": [
        397
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "healing",
      "text_origin": "source_excerpt",
      "mentions": [
        "sys_healing_gu"
      ]
    },
    {
      "text": "When Xiao Mang and Mo Wu Tian press toward the bronze hall, Ba Huang and Ying Ming appear and block their advancement as before.",
      "chapters": [
        403
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "second-blockade",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_xiao_mang",
        "char_ying_ming"
      ]
    },
    {
      "text": "Fang Yuan later classes Ying Ming and Ba Huang as two beast emperors whose battle strength could match rank five Gu Masters, able to obstruct Mo Wu Tian and Xiao Mang for a time.",
      "chapters": [
        409
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "beast-emperor",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_fang_yuan"
      ]
    },
    {
      "text": "Fang Yuan used both dog emperors in the three kings blessed land to hold off rank five Gu Masters. Occupied with escaping, he could not attend to them, and he does not know whether they were killed in the battle or taken in by others.",
      "chapters": [
        491
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "three-kings-blessed-land",
      "text_origin": "source_excerpt"
    }
  ],
