    },
    {
      "text": "He is a male Gu Master with triangular eyes.",
      "chapters": [
        497
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "appearance",
      "text_origin": "source_excerpt"
    },
    {
      "text": "Mo Shi Kuang answers with a palm clap that sends an invisible crushing force across the stage. Viper Prince recognizes qi path and rank four peak stage only as he is crushed into minced meat that splatters everywhere, and the fight ends in one move.",
      "chapters": [
        497
      ],
      "certainty": "canon",
      "confidence": "B",
