  "claims": [
    {
      "text": "After Mo Shi Kuang steps forward for Liu Wen Wu of Liu tribe at the heroes assembly in Northern Plains, a speaker on Hei Lou Lan’s side dismisses the inkman and sends Viper Prince to exchange moves. He is a male Gu Master with triangular eyes; he walks onto the battle stage and beckons Mo Shi Kuang with a finger.",
      "chapters": [
        497
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
