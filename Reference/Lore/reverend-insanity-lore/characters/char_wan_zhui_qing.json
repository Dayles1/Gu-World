  "claims": [
    {
      "text": "After Suan Bu Jin kills Wan Liang Han, Wan Zhui Qing kneels on the ground and bawls, and no one can persuade him to stop.",
      "chapters": [
        1802
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_wan_liang_han"
      ]
    },
    {
      "text": "Wan clan’s first supreme elder asks whether his father left him the inheritance. He holds back tears and says his father taught him everything about the inheritance, killer moves, and Gu recipes, but not even one Immortal Gu was left behind. The first supreme elder says Wan Liang Han will be honored and that any Gu materials required to refine his Immortal Gu will be provided for free from the clan treasury, hoping those Immortal Gu were destroyed rather than taken. Wan Zhui Qing kowtows multiple times in thanks.",
      "chapters": [
        1802
      ],
