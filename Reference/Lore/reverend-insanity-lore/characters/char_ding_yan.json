  "claims": [
    {
      "text": "Immortal Hua Die tells Chu Ying that Ding Yan once held clues to an information path inheritance, was attacked by Liu Qing Yu, Zhou Li, and Tang Song, and is dead. Ding Qi comes to the turbulent flow sea area for revenge when Liu Qing Yu appears to seek that inheritance.",
      "chapters": [
        1154
      ],
      "certainty": "inferred",
      "confidence": "C",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_immortal_hua_die",
        "char_liu_qing_yu",
        "char_zhou_li",
        "char_tang_song",
        "char_ding_qi"
      ]
    },
    {
      "text": "Ding Qi says he and his brother created blood trace Immortal Gu and Immortal Gu Blood Oath together. Narration ranks Ding Qi and Ding Yan among present blood path experts for that research and refinement. Ding Qi also treats Fang Yuan as his brother’s murderer when the inheritance clue surfaces.",
      "chapters": [
        1157
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "blood-path-creations",
      "text_origin": "source_excerpt",
      "mentions": [
        "gu_blood_trace_immortal_gu",
        "gu_blood_oath_immortal_gu",
        "char_fang_yuan"
      ]
    },
    {
      "text": "Fang Yuan later lists blood trace Gu and blood oath Gu among his blood path Immortal Gu and states that Eastern Sea blood path demonic immortals Ding Yan and Ding Qi created them, one for investigation and the other with an information path effect, that the two Immortal Gu were destroyed, and that he refined them through natural inspiration and his own deductions without obtaining the recipes from the brothers.",
      "chapters": [
        2252
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "fang-yuan-refinement",
      "text_origin": "source_excerpt",
      "mentions": [
        "sys_immortal_gu",
        "reg_eastern_sea"
      ]
    }
  ],
