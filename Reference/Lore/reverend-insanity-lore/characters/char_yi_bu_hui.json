  "claims": [
    {
      "text": "When chasing wind Gu’s price rises to three hundred and fifty thousand, only two Gu Masters remain competing. One is Yi clan elder Yi Bu Hui, and the other is Fei clan elder Fei Luan Feng. The text notes Yi clan and Fei clan did not have a good relationship, and the two compete as sparks arise. Yi Bu Hui eventually buys the Gu for four hundred and forty thousand.",
      "chapters": [
        307
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "auction-rivalry-and-purchase",
      "text_origin": "source_excerpt",
      "mentions": [
        "gu_chasing_wind_gu",
        "fac_gu_masters",
        "fac_yi_clan",
        "fac_fei_clan",
        "char_fei_luan_feng"
      ]
    },
    {
      "text": "When Atmosphere Gu opens at a base bid of two hundred and sixty thousand primeval stones, Yi clan elder Yi Bu Hui bids three hundred thousand first. Fei clan elder Yan Luan Feng answers with three hundred and fifty thousand.",
      "chapters": [
        308
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "atmosphere-gu-bid",
      "text_origin": "source_excerpt",
      "mentions": [
        "gu_atmosphere_gu"
      ]
    },
    {
      "text": "Shang Xin Ci later weighs that Yi clan and Fei clan elders might compete and push that Gu’s price higher if the bid stayed lower.",
      "chapters": [
        308
      ],
