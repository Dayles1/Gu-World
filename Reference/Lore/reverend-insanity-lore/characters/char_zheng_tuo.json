  "claims": [
    {
      "text": "In a mountain cave with Feng Jun and Zhou Min he argues over whether to move against the heavenly spirit.",
      "chapters": [
        1119
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_feng_jun",
        "char_zhou_min"
      ]
    },
    {
      "text": "When Fang Yuan arrives disguised as Hei Cheng, Chen Chi and Zheng Tuo are the rank seven Gu Immortals matching that cultivation on their side.",
      "chapters": [
        1120
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_fang_yuan",
        "char_hei_cheng",
        "char_chen_chi",
        "sys_gu_immortal"
      ]
    },
    {
      "text": "When Chen Chi’s side sends up the warning of bright light, Zheng Tuo says that no matter whether there really is an ancient desolate beast attack or Chen Chi is trying to scheme against them, they need to go and investigate the situation. Moving out with Feng Jun and Zhou Min, they meet a fleeing Chen Le, who is Fang Yuan in disguise; a sword path immortal killer move stabs into Zheng Tuo’s body and cuts him in half on the spot, killing him instantly.",
      "chapters": [
        1125
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "death",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_chen_le"
      ]
    },
    {
      "text": "Fang Yuan later picks up the corpse split into two and stores both pieces in his immortal aperture, while Zhou Min screams for him to release their brother’s corpse.",
      "chapters": [
        1127
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "death",
      "text_origin": "source_excerpt"
    },
    {
      "text": "Fang Yuan later counts about twelve thousand blood path dao marks from this blood path Gu Immortal of Hei Fan grotto-heaven.",
      "chapters": [
        1161
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "death",
      "text_origin": "source_excerpt",
      "mentions": [
        "loc_hei_fan_grotto_heaven"
      ]
    }
  ],
