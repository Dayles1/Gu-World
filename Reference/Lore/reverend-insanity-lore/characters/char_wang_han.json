  "claims": [
    {
      "text": "Facing Fang Yuan on the battle stage and unable to win a prolonged fight against All-out Effort Gu’s phantoms, a blue shirt burly man brings out Water Prison Gu, saying he took a high interest loan to buy the rank three Gu on purpose, to deal with Fang Yuan and claim All-out Effort Gu for himself. He argues that beast strength is hard while the flow of water is soft, so softness subdues hardness, but Fang Yuan’s crocodile strength phantom kick smashes the water prison to pieces.",
      "chapters": [
        288
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_fang_yuan",
        "gu_all_out_effort_gu",
        "gu_water_prison_gu"
      ]
    },
    {
      "text": "That kick’s impact carries Fang Yuan forward and kills the man, ending the match; the hosting Gu Master declares Fang Yuan the winner. Spectators outside the stage name the dead fighter Wang Han and say that even he lost and died in the battle stage, crediting the strength of All-out Effort Gu.",
      "chapters": [
        289
      ],
