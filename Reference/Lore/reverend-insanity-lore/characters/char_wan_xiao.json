  "claims": [
    {
      "text": "With Wan Hao Guang and Wan Liang Han he traps Fang Yuan under the Suan Bu Jin identity inside an immortal battlefield. He is tall and thin, dressed in a green robe, and surrounded by whirlwinds as he mocks the catch.",
      "chapters": [
        1799
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_wan_hao_guang",
        "char_wan_liang_han",
        "char_fang_yuan"
      ]
    },
    {
      "text": "He is tall and thin, dressed in a green robe, and surrounded by whirlwinds.",
      "chapters": [
        1799
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "appearance",
      "text_origin": "source_excerpt"
    },
    {
      "text": "He activates the immortal battlefield and raises a giant tornado against Fang Yuan’s soul beast army while coordinating with Wan Liang Han to protect Wan Hao Guang’s charge.",
      "chapters": [
        1799
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "immortal-battlefield-trap",
      "text_origin": "source_excerpt"
    },
    {
      "text": "While controlling the battlefield and throwing wind spears that can heavily injure or kill ancient soul beasts, he develops distracting thoughts mid activation of an immortal killer move. The move fails and backlash heavily injures him.",
      "chapters": [
        1800
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "distracting-thoughts-backlash",
      "text_origin": "source_excerpt"
    },
    {
      "text": "After Wan Liang Han dies he and Wan Hao Guang cannot finish Fang Yuan. Fang Yuan heavily injures him until he falls unconscious, and Wan Hao Guang carries him away.",
      "chapters": [
        1801
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "escape-with-wan-hao-guang",
      "text_origin": "source_excerpt"
    },
    {
      "text": "He later guards Wan clan territory at tall pine oasis as a rank seven expert. When Fang clan attacks the oasis formation he rides a wind falcon and escapes after the first supreme elder falls.",
      "chapters": [
        2247
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "tall-pine-oasis",
      "text_origin": "source_excerpt",
      "mentions": [
        "fac_wan_clan",
        "fac_fang_clan"
      ]
    }
  ],
