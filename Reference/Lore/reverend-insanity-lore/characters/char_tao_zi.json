  "claims": [
    {
      "text": "As more established Gu Masters thicken the crowd, he is listed among arrivals and is noted for spirit peach Gu, a famous rank five Gu.",
      "chapters": [
        375
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
