  "claims": [
    {
      "text": "During the immortal zombie meeting at Dark Flow Giant City, talk of the erupting flame furnace turns the hall toward a red will. Yin Liu Gong names Craftsman Huo De the most suitable person in the alliance while the leader is in Eastern Sea, and asks what he thinks.",
      "chapters": [
        741
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "loc_dark_flow_giant_city",
        "char_yin_liu_gong",
        "reg_eastern_sea"
      ]
    },
    {
      "text": "His will in the hall is red.",
      "chapters": [
        741
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "appearance",
      "text_origin": "source_excerpt"
    },
    {
      "text": "The red will answers that his cultivation level is too low and that suppressing the flame furnace is hard, yet he will not reject the work if everyone agrees, except that a thousand contribution points is too low. Yin Liu Gong raises the reward to one thousand two hundred, and Huo De’s will accepts.",
      "chapters": [
        741
      ],
      "certainty": "canon",
