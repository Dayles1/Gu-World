  "claims": [
    {
      "text": "On Sorrowful Wind Mountain Range other youngsters tell him the mountain is occupied and that there is no place for him. The strongest pushes him to the ground. He does not resist, only moves his small group of sheep and leaves, later finding a patch of grass for them after falling and bruising on steep paths.",
      "chapters": [
        2039
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt"
    },
    {
      "text": "His clothes are patched with many tattered areas and he looks like a beggar. He walks on thin legs.",
      "chapters": [
        2039
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "appearance",
      "text_origin": "source_excerpt"
    },
    {
      "text": "Central Continent’s four great obscenities and Wang Xiao Er are forced into desperation by Qin Juan at Southern Border’s Sun Moon Sinkhole. He shouts that they will jump if she comes closer.",
      "chapters": [
        2095
      ],
      "certainty": "canon",
      "confidence": "B",
