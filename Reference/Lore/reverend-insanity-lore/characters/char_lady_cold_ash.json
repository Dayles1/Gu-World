  "claims": [
    {
      "text": "Night Heavenly Wolf Lord greets the rank eight female immortal of Soul Pacifying grotto-heaven as Lady Cold Ash when she arrives at Ice Crystal grotto-heaven with a soul beast army and two rank seven companions. She leaves the rank sevens outside to watch the army, enters the meeting with Night Heavenly Wolf Lord, and later leads the soul beasts home.",
      "chapters": [
        1969
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_night_heavenly_wolf_lord",
        "loc_soul_pacifying_grotto_heaven",
        "loc_ice_crystal_grotto_heaven"
      ]
    },
    {
      "text": "She is the only rank eight of Soul Pacifying grotto-heaven and its natural leader. Below her, An Chong and An Xun are the leading rank sevens. An Xun is her nephew and the prospect she backs to rise beyond rank seven. She lends him a killer move that lets him command three thousand soul beasts and one immemorial soul beast guardian for twenty days.",
      "chapters": [
        1974
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "soul-pacifying-leadership",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_an_chong",
        "char_an_xun"
      ]
    },
    {
      "text": "She later sends An Chong to Eastern Sea’s black heaven to meet Granny Skeleton and show willingness to cooperate among human grotto-heavens.",
      "chapters": [
        1975
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "soul-pacifying-leadership",
      "text_origin": "source_excerpt",
      "mentions": [
        "reg_eastern_sea",
        "char_granny_skeleton"
      ]
    }
  ],
