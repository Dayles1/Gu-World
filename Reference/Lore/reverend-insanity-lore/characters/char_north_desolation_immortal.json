  "claims": [
    {
      "text": "Longevity Heaven has twelve positions split into Eight Extremities and Four Desolations. The Four Desolation Immortals are East Desolation, South Desolation, West Desolation, and North Desolation, four rank eight immortals. The seats are meant only for rank eight Gu Immortals, while the Eight Extremities need at least elite rank seven cultivation.",
      "chapters": [
        1238
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "fac_longevity_heaven",
        "fac_eight_extremities",
        "fac_four_desolations",
        "char_east_desolation_immortal",
        "char_south_desolation_immortal",
        "char_west_desolation",
        "sys_gu_immortal"
      ]
    },
    {
      "text": "Bull Demon and Flower Lady take the role of North Desolation Immortal together. Bull Demon is a muscular brute with a thick beard and a thunderous voice, extremely tall and strong, with a powerful aura. Flower Lady is a little girl with a flower on her head who sits on his shoulder, giggling, with crystal-like eyes that flicker with innocence. When West Desolation Immortal Bing Sai Chuan awakens, they greet him as Senior West Desolation.",
      "chapters": [
        1692
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "bull-demon-and-flower-lady",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_bull_demon",
        "char_flower_lady",
        "char_bing_sai_chuan"
      ]
    },
    {
      "text": "Inside Heavenly Court, narration names Bull Demon and Flower Lady together as the Northern Desolation Immortals, usually extremely close and never leaving each other’s side.",
      "chapters": [
        1711
      ],
