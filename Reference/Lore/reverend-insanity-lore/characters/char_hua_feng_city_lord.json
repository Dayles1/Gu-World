  "claims": [
    {
      "text": "Steel Thread City receives him as an esteemed guest. At the banquet he points to the hairy man Gu Masters behind him and proposes a contest: the king will hold a martial competition, each region may send only three people, and their region has both cities, so the cities should decide who goes.",
      "chapters": [
        1050
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "loc_steel_thread_city",
        "fac_gu_masters"
      ]
    },
    {
      "text": "After several rounds Hua Feng City wins all matches and Steel Thread City loses all of theirs. He drinks wine casually while Steel Thread City Lord fears years of pressure if they take no wins. For the last match he chooses Gu refinement as the content, citing hairy man tradition, and stays unabashed when Steel Thread elders look at him with distaste. Sensing Fang Zheng’s rank five aura puts him on alert. When Fang Zheng’s half complete Gu goes up in smoke mid contest, he laughs aloud.",
      "chapters": [
        1050
      ],
      "certainty": "canon",
      "confidence": "B",
