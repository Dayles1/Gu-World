  "claims": [
    {
      "text": "He flies above white crane sea area after Qin Bai He stops answering his letters, sees the place robbed bare, and dives to search for her and Bai He Palace. He is a Gu Immortal of the Eastern Sea super force Qing Yue clan and the bloodline descendant of first supreme elder Qing Yue An. He has held one-sided affection for Qin Bai He for a decade despite knowing she likes women and rejects him; she replies half-heartedly so as not to offend Qing Yue clan.",
      "chapters": [
        1488
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_qin_bai_he",
        "house_bai_he_palace",
        "sys_gu_immortal",
        "reg_eastern_sea",
        "fac_qing_yue_clan",
        "char_qing_yue_an"
      ]
    },
    {
      "text": "He wears a green shirt and has a young appearance, a sharp nose, a wide face, and eyes shining like stars.",
      "chapters": [
        1488
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "appearance",
      "text_origin": "source_excerpt"
    },
    {
      "text": "He finds a huge trench with crevices and broken rocks, no Bai He Palace, and no battle traces, then suspects a rank eight or that she moved. He later reaches dragonfish sea area as well and still finds nothing, because Fang Yuan erased traces after killing Qin Bai He and You Chan inside purple star broken life. With Qing Yue clan’s strength the clan quickly unveils a portion of the truth about those murders.",
      "chapters": [
        1488
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "search-after-the-robbery",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_fang_yuan",
        "char_you_chan"
      ]
    },
    {
      "text": "Qing Yue Zhi Cheng asks Qing Yue clan’s first supreme elder for help, and the elder sends him to seek out a wisdom path Gu Immortal, the one hiding in Nan Gong, Hua An. He finds Hua An already expecting him, and the two agree to spread rumors of the fairies’ deaths while Zhi Cheng insists the two are still alive.",
      "chapters": [
        1495
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "seeking-help-for-qin-bai-he",
      "text_origin": "source_excerpt",
      "mentions": [
        "fac_nan_gong_clan",
        "char_hua_an"
      ]
    }
