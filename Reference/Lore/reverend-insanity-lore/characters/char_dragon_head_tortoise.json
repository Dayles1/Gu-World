  "claims": [
    {
      "text": "Eastern Sea talk ranks three wisdom path experts with the saying that Jia Dan sits in twin polar, Hua An hides in Nan Gong, and Dragon Head Tortoise lives inside adversity sea.",
      "chapters": [
        899
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "reg_eastern_sea",
        "char_song_jia_dan",
        "char_hua_an",
        "fac_nan_gong_clan"
      ]
    },
    {
      "text": "When Song Jia Dan cannot deduce Xing Xiang Zi’s location, Song Yi Shi and Song Xia Qi reason that anyone shielding him would have to stand at least at Song Jia Dan’s level, and name Nan Gong clan’s Hua An and Dragon Head Tortoise Immortal in adversity sea as the two who might have done it.",
      "chapters": [
        899
      ],
      "certainty": "inferred",
      "confidence": "C",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_song_yi_shi",
        "char_song_xia_qi"
      ]
    },
    {
      "text": "Song Jia Dan and Hua An are righteous path members who rarely deduce for lone immortals. Dragon Head Tortoise stays inside adversity sea, his traces hard to find, so people struggle to seek his help.",
      "chapters": [
        1296
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "adversity-sea-recluse",
      "text_origin": "source_excerpt"
    },
    {
      "text": "Dragon Head Tortoise Immortal in adversity sea is one of the famous Eastern Sea Gu Immortals who come to attend Fang Yuan’s qi sea banquet.",
      "chapters": [
        1887
      ],
      "certainty": "canon",
      "confidence": "B",
