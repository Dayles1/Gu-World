  "claims": [
    {
      "text": "Duke Long names him among Granny Rong, Yang Zi He, Shi Miao, and Zhang Yin when four Eastern Sea lone and demonic rank eights surround him at Dragon Palace.",
      "chapters": [
        1688
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_duke_long",
        "char_granny_rong",
        "char_shi_miao",
        "char_zhang_yin",
        "reg_eastern_sea",
        "house_dragon_palace"
      ]
    },
    {
      "text": "He is dressed in a white robe, looks young, and is handsome.",
      "chapters": [
        1688
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "appearance",
      "text_origin": "source_excerpt"
    },
    {
      "text": "Narration places him in the four person alliance of Granny Rong, Yang Zi He, Zhang Yin, and Shi Miao against Eastern Sea righteous path rank eights.",
      "chapters": [
        1690
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "four-person-alliance",
      "text_origin": "source_excerpt",
      "mentions": [
        "fac_eastern_sea_righteous_path"
      ]
    },
    {
      "text": "With Zhang Yin, Granny Rong, and Shi Miao he suddenly attacks Song Qi Yuan, Qing Yue An, Hua Cai Yun, and Shen Cong Sheng. He states with firm determination that even if they die they will protect Dragon Palace.",
      "chapters": [
        1725
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "guarding-dragon-palace",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_song_qi_yuan",
        "char_qing_yue_an",
        "char_hua_cai_yun",
        "char_shen_cong_sheng"
      ]
    },
    {
      "text": "Zhu Que Er finds that he, Zhang Yin, Granny Rong, and Shi Miao trust each other completely and will let one another defend them in danger. He urges releasing Di Zang Sheng to create chaos and opportunity.",
      "chapters": [
        1924
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "dragon-generals",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_zhu_que_er",
        "char_di_zang_sheng"
      ]
    },
    {
      "text": "As one of the Four Dragon Generals flying from Dragon Palace with Zhang Yin, Granny Rong, and Old Man Bei Feng, he is pierced by Che Wei’s golden silver lights and dies.",
      "chapters": [
        2027
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "death-in-heavenly-court",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_old_man_bei_feng",
        "char_che_wei"
      ]
    }
