  "claims": [
    {
      "text": "When Chu Du’s side strikes Iron Eagle blessed land, Bai Zu Wei pursues Fang Yuan. He has rank seven cultivation and leads the defenders there. He had sent Hei tribe Gu Immortals out to resource points and judged the blessed land still safe until the sudden attack. Fang Yuan reads him as a metal path Gu Immortal whose body shines with golden light and who trusts his defense. Bai Zu Wei uses an investigative immortal killer move created by Heavenly Lord Bai Zu, turning his eyes golden as he searches for Fang Yuan’s true body among myriad self phantoms.",
      "chapters": [
        1170
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_chu_du",
        "loc_iron_eagle_blessed_land",
        "char_fang_yuan",
        "fac_hei_tribe",
        "sys_gu_immortal",
        "char_heavenly_lord_bai_zu"
      ]
    },
    {
      "text": "When he sees Fang Yuan charge him, his facial muscles move and he shows a ruthless expression. Under rage his eyes turn red and his voice grows hoarse.",
      "chapters": [
        1170
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "appearance",
      "text_origin": "source_excerpt"
    },
    {
      "text": "He is the key person controlling ancient battle formation Green City Rampage. After the formation breaks he takes the largest backlash and dies on the spot. He is the number one person below Heavenly Lord Bai Zu and the core of Bai Zu tribe’s Gu Immortals.",
      "chapters": [
        1172
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "death-in-green-city-rampage",
      "text_origin": "source_excerpt",
      "mentions": [
        "move_green_city_rampage",
        "fac_bai_zu_tribe"
      ]
    },
    {
      "text": "Heavenly Lord Bai Zu later learns of the death by letter and treats Bai Zu Wei as a child he had raised singlehandedly.",
      "chapters": [
        1173
      ],
      "certainty": "canon",
      "confidence": "B",
