  "claims": [
    {
      "text": "Immortal Hua Die warns Chu Ying that blood path demonic immortal Ding Qi has come to the turbulent flow sea area after his younger brother Ding Yan died, and that Ding Qi wants revenge because Liu Qing Yu appeared to seek the same information path inheritance.",
      "chapters": [
        1154
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_immortal_hua_die",
        "char_ding_yan",
        "char_liu_qing_yu"
      ]
    },
    {
      "text": "When Fang Yuan meets him he has injuries, messy hair, and a sorry state. In pursuit his eyes turn blood red with killing intent.",
      "chapters": [
        1157
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "appearance",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_fang_yuan"
      ]
    },
    {
      "text": "He stares at Fang Yuan, names him as the one who took the inheritance his brother found, and activates blood trace Immortal Gu to show blood-colored shadows of Fang Yuan taking that inheritance. He states that he and his brother created blood trace Immortal Gu and Immortal Gu Blood Oath together. Narration ranks the brothers among present blood path experts for researching and refining those Gu. Alone against Zhou Li, Tang Song, and other pursuers, he fights, escapes, then rushes Fang Yuan and attacks first.",
      "chapters": [
        1157
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "blood-trace-confrontation",
      "text_origin": "source_excerpt",
      "mentions": [
        "gu_blood_trace_immortal_gu",
        "gu_blood_oath_immortal_gu",
        "char_zhou_li",
        "char_tang_song"
      ]
    },
    {
      "text": "Inside City Well he is among the last three standing under Fang Yuan’s strength path giant hand, then self-detonates. His blood path immortal aperture remains with resources destroyed, and Fang Yuan can still annex the blessed land as a blood path grandmaster.",
      "chapters": [
        1158
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "self-detonation",
      "text_origin": "source_excerpt",
      "mentions": [
        "loc_city_well"
      ]
    },
    {
      "text": "Fang Yuan later weighs ownership conditions of Ding Qi blessed land, including a blood path Immortal Gu recipe requirement for Blood Revenge.",
      "chapters": [
        1187
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "blessed-land-remnant",
      "text_origin": "source_excerpt",
      "mentions": [
        "sys_gu_recipe",
        "gu_blood_revenge_immortal_gu"
      ]
    },
    {
      "text": "Much later Fang Yuan still credits Ding Yan and Ding Qi with creating blood trace Gu and blood oath Gu.",
      "chapters": [
        2252
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "blessed-land-remnant",
      "text_origin": "source_excerpt"
    }
  ],
