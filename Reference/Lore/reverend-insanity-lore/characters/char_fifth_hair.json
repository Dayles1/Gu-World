  "claims": [
    {
      "text": "Lang Ya land spirit explains that under Lang Ya Sect rules, a large enough contribution can raise a member’s status by one level, giving the example that Sixth Hair could promote to Fifth Hair. Fang Yuan is not a true hairy man Gu Immortal at that time, so he receives contribution points instead of that promotion.",
      "chapters": [
        1082
      ],
