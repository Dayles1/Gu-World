  "claims": [
    {
      "text": "Space Extremity is named in Longevity Heaven’s Eight Extremities roster: Heaven Extremity, Earth Extremity, Black Extremity, Yellow Extremity, Space Extremity, Time Extremity, Flood Extremity, and Desolate Extremity, eight rank seven Gu Immortals who share core authority with the Four Desolations.",
      "chapters": [
        1238
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
