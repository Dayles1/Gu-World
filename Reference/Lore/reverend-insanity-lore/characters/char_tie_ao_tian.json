  "claims": [
    {
      "text": "At dusk he walks at the center of a depleted Tie clan pursuit that left Qing Mao Mountain. Losses along Huang Long river and a Xuan Yuan Divine Pheasant attack that took three companions, including their best investigator and a rank three defensive Gu Master, cut the group down. He still refuses to quit: he is fourth young master, A grade, raised on Tie iron will, and he treats catching the blood sea inheritance demonic Gu Masters and avenging Tie Xue Leng as capital for a future clan leader bid after he only managed to save Tie Ruo Nan on his first mission out.",
      "chapters": [
        214
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
