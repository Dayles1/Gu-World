        "loc_blood_sea",
        "fac_longevity_heaven",
        "sys_gu_immortal",
        "char_yao_huang",
        "sys_immortal_gu"
      ]
    },
    {
      "text": "He has no hair, and his body emits intense light in all directions, like a person made of light. He rubs his bald head and cannot frown without any eyebrows.",
      "chapters": [
        2274
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "appearance",
      "text_origin": "source_excerpt"
    },
    {
