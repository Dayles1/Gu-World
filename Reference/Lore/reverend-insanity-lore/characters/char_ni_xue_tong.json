  "claims": [
    {
      "text": "She speaks with a frowned expression. Alone with Chang Biao after the tent flap closes, she has weak and feeble eyes that shed tears as she jumps into his embrace.",
      "chapters": [
        530
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "appearance",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_chang_biao"
      ]
    },
    {
      "text": "She urges Chang Ji You not to waver and not to forget their circumstances, and tells him not to worry about his father. Alone with Chang Biao and guarded outside, she sobs that You Er keeps asking about Chang Shan Yin and that she almost told the truth: Chang Ji You is not Chang Shan Yin’s flesh and blood. Narration states that if the secret is exposed, Chang Biao and Ni Xue Tong would be publicly shamed as an adulterous couple and would never raise their heads again, having harmed an expert of the tribe. Chang Biao fears that the only option then would be to escape with Ni Xue Tong and his own flesh and blood Chang Ji You as demonic Gu Masters, despised and chased by the tribe.",
      "chapters": [
        530
      ],
      "certainty": "canon",
      "confidence": "B",
