        "fac_xiao_clan",
        "sys_gu_immortal"
      ]
    },
    {
      "text": "Some time back, rank four middle stage righteous path Xiao Fu Lu died at the hands of the famous demonic assassins Meng Tu and Jiao Huang.",
      "chapters": [
        354
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
