  "claims": [
    {
      "text": "At sixteen she holds a contest to find her husband. She originally loved Fan Ji, was impregnated with his child, then saw his true nature after he refused marriage and locked herself in her mother’s residence, never going out. After negotiations with Kong Yi Hen failed and the two rank eights fought, she threatened Fan Ji in a rage, fainted from anger, and on waking insisted on an open husband contest. Calligraphy Pavilion Lady could not convince her otherwise and hoped someone else might give her happiness or at least distract her from depression and thoughts of suicide.",
      "chapters": [
        1833
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_fan_ji",
        "char_calligraphy_pavilion_lady"
      ]
    },
    {
      "text": "Wu Shuai obeyed his father’s orders and became her husband to create a relationship with Calligraphy Pavilion Lady. After she gives birth she still cannot stop thinking of Fan Ji, keeps contact with him, and they meet countless times until it is almost an open secret.",
      "chapters": [
        1835
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "marriage-to-wu-shuai",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_wu_shuai"
      ]
    },
    {
      "text": "Calligraphy Pavilion Lady brings her to Wu Shuai’s victory banquet as his wife-in-name, then leaves her behind afterward and tells the couple they should stay together.",
      "chapters": [
        1841
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "banquet",
      "text_origin": "source_excerpt"
    },
    {
      "text": "After Wu Shuai enslaves Calligraphy Pavilion Lady he could imprison Shu Jiu Ling, but he lets her go be with the person she truly loved.",
      "chapters": [
        1845
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "released",
      "text_origin": "source_excerpt"
    }
  ],
