  "claims": [
    {
      "text": "At the blood battle martial competition he arrives with Nian Er Fu as a wood path Gu Immortal.",
      "chapters": [
        1193
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_nian_er_fu",
        "sys_gu_immortal"
      ]
    },
    {
      "text": "He stops Nian Er Ping Zhi from taking an early fight against a nameless rank six, saying a kill would not awe the immortals.",
      "chapters": [
        1194
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_nian_er_ping_zhi"
      ]
    },
    {
      "text": "He is in charge of Nian Er Ping Zhi’s safety on the trip and orders the Sword Child called back when the fight turns dangerous.",
      "chapters": [
        1195
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "sys_sword_child"
      ]
    },
    {
      "text": "In battle emerald wooden armor covers his whole body, and fresh yellow and green leaves grow on it when lightning strikes.",
      "chapters": [
        1196
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "battle-armor",
      "text_origin": "source_excerpt"
    },
    {
      "text": "When he rushes out of Golden Dawn Hall, Hao Zhen’s lightning hits him and he answers with immortal killer move Sick Tree Spring Armor, famous in Northern Plains as his self-created defense. Chu Du judges that he chose to armor himself rather than move first to save Nian Er Ping Zhi, then Nian Er Yi Fang laughs and names sword heart clarity from Sword Saint true inheritance. Chou Lao Wu later calls him crafty for pretending panic while knowing Nian Er Ping Zhi was safe.",
      "chapters": [
        1196
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "sick-tree-spring-armor-and-craft",
      "text_origin": "source_excerpt",
