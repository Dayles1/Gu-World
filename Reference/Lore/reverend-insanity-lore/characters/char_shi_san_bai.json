  "claims": [
    {
      "text": "When Fang Yuan splits a rockman earth path grotto-heaven into the sovereign immortal aperture, a mountain range appears in Mini Central Continent. Shi San Bai shouts that it has appeared and names it their tribe’s Myriad Ravine Mountain Range. He is among the rockman Gu Immortals of that former grotto-heaven who were sent into the sovereign immortal aperture in advance, then fly into the mountain range to speak to cheering rockman Gu Masters and begin earth vein core work.",
      "chapters": [
        2154
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_fang_yuan",
        "loc_mini_central_continent",
        "sys_gu_immortal",
        "fac_gu_masters"
      ]
    },
    {
      "text": "Rockman Gu Immortal Shi San Bai thanks Yu Zi for specializing in water path while helping set up an earth path resource point he could not have accomplished alone. He had agreed with Shi Gua Bi to finish that mission, then waits for others to team up when needed. With Shi San Bai as the leader and Yu Zi as the support, the two spend close to ten days finishing the resource point. He shows a respectful expression when Lord Wu Shuai arrives, congratulates Wu Shuai, and later invites Yu Zi to continue teaming up on another earth path resource point. When she refuses, he suggests she take a rest and says from his own experience the mission board is never empty and manpower is short.",
      "chapters": [
        2254
      ],
      "certainty": "inferred",
      "confidence": "C",
