  "claims": [
    {
      "text": "Fei Qing is a Fei tribe Gu Master whom his cousin Fei Chang strikes with a poison Gu in a bid for the clan leader position. Fleeing warm pond valley with his son Fei Cai, he uses swift ghost cloud Gu to escape the pursuit, then abandons the Gu on sensing it has been tampered with and hides with his son in a swamp, losing his own movement while the poison keeps spreading.",
      "chapters": [
        488
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "fac_fei_tribe",
        "sys_gu_master",
        "sys_poison_gu",
        "char_fei_cai"
      ]
    },
    {
      "text": "Coughing green blood, he tells Fei Cai that Giant Sun Immortal Venerable’s bloodline runs thick and rare in him, qualifying him to enter Eighty-Eighth True Yang Building inside Imperial Court blessed land for the grace Ancestor Giant Sun left behind, then sends him fleeing north-west, correcting the boy’s wrong turns from where he sits.",
      "chapters": [
        488
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_giant_sun_immortal_venerable",
        "house_eighty_eight_true_yang_building",
        "loc_imperial_court_blessed_land",
        "char_immortal_zombie_giant_sun"
      ]
    },
    {
      "text": "Fei Chang finds him, has him bound and dragged by rope, and uses soul search Gu on him to hunt down Fei Cai’s hiding place, leaving Fei Qing’s soul heavily injured. Fei Chang abandons the search when Ma tribe’s ambush on Fei tribe forces him back to the camp, and the tribe is wiped out in that invasion.",
      "chapters": [
        488
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "fac_ma_tribe"
      ]
    }
