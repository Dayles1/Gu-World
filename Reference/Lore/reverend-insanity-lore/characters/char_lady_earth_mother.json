  "claims": [
    {
      "text": "Fighting Fang Yuan, a dual spear wielding Gu Immortal has his severed head reform from grey clouds and credits the battlefield killer move, grey cloud battle puppet, to Lady Earth Mother, speaking with pride.",
      "chapters": [
        1141
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_fang_yuan",
        "sys_gu_immortal"
      ]
    },
    {
      "text": "The Earth Mother Altar statue shows a female human immortal hugging a rockman Gu Immortal’s arm. The two look into the distance with blissful expressions.",
      "chapters": [
        1144
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "appearance",
      "text_origin": "source_excerpt"
    },
    {
      "text": "Xue Er says Lady Earth Mother was kind and benevolent, that her love crossed race, and that after Shi Mu died she died of her own accord to be with him. Her dao marks and blessed land became the underground land that gave rockmen a foundation for survival. Her methods gathered earth qi on what had been pure icy land and formed the soil of the northern icy plain.",
      "chapters": [
        1144
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "death-and-land",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_xue_er"
      ]
    },
    {
      "text": "Fang Yuan recognizes her from Hei Cheng’s soul search as Hei Feng Yue, Old Ancestor Hei Fan’s most beloved granddaughter, who had vanished from Hei tribe with attitude Gu. She hid her identity, fell in love with a rockman Gu Immortal, and stayed with him rather than return to the tribe.",
      "chapters": [
        1144
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "hei-feng-yue",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_hei_cheng",
        "char_hei_fan",
        "fac_hei_tribe",
        "gu_attitude_gu"
      ]
    },
    {
      "text": "Earlier talk already names Hei Feng Yue as the spoiled mortal granddaughter to whom Hei Fan gave attitude Gu before she vanished on the icy plain.",
      "chapters": [
        948
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "hei-feng-yue",
      "text_origin": "source_excerpt"
    }
  ],
