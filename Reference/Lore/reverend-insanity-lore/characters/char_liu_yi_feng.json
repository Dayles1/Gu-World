  "claims": [
    {
      "text": "In Ni Yu blessed land, Dong Fang Chang Fan tells Hei Bai that the Liu tribe leader of that generation, Liu Yi Feng, had unprecedented talent and was a genius barely seen in a hundred years. Hei Bai, then Hei tribe leader and a step from Imperial Court, recalls losing by one move so that Liu tribe emerged victorious.",
      "chapters": [
        519
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
