  "claims": [
    {
      "text": "Twelfth Hair and Lian Ke Xin take a mission to nurture Gu Immortal seeds and enter a mountain forest where a hairy man Gu Master is being chased, covered in wounds. Lian Ke Xin inspects him and finds the mixed blood. Twelfth Hair warns her not to run wild with the surname, names him the son of Gu Yue Fang Zheng rather than Fang Yuan’s bloodline, and says Fang Yuan has been secretly nurturing him with opportunities and setbacks as the most qualified Gu Immortal seed among their hairy man Gu Masters.",
      "chapters": [
        2243
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_twelfth_hair",
        "char_lian_ke_xin",
        "sys_gu_immortal",
        "sys_gu_master",
        "char_fang_zheng",
        "char_fang_yuan",
        "fac_gu_masters"
      ]
    },
    {
      "text": "His chest is covered in black hair.",
      "chapters": [
        2244
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "appearance",
      "text_origin": "source_excerpt"
    },
    {
      "text": "He hides behind ancient tree roots, still bleeding from mouth and nose, with more than ten injuries, three bone fractures, and severe organ damage. He tears away a tattered upper shirt, exposes a deep chest wound with broken white bone, and forces a centipede-like healing Gu to stop the bleeding and drag the wound shut. Pursuers call him a mixed blood monster and say that even with rank five cultivation, a crippled refinement killer move has destroyed most of his Gu worms, yet more than ten experts have already died at his hands.",
      "chapters": [
        2244
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "pursuit-wounds",
      "text_origin": "source_excerpt",
