  "claims": [
    {
      "text": "Che You Yin mocks him as old man Wu Sheng and vows that all three Zuo fighters will die without a proper burial. Che Qiao Xiang treats him as her father’s rival for tens of years and about the same strength, and fears that even wounded his dying counterattack would be terrifying.",
      "chapters": [
        323
      ],
      "certainty": "canon",
