  "claims": [
    {
      "text": "While inspecting grey-white stone slabs taken from Chai tribe resources in Ge tribe camp, Fang Yuan recalls that if the slabs were real they would trace to the immemorial era and to Ren Zu’s daughter Carefree Wisdom Heart. That stretch states she came to the Qian Kun Crystal Wall in order to save Wisdom Gu. Inside that wall’s mirror image sits Book Mountain, with an ink waterfall and literature spring whose black splashes form words, the origin of the hundred clan writing system; after the wall broke it became numerous grey-white stone slabs.",
      "chapters": [
        495
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "fac_chai_tribe",
        "fac_ge_tribe",
        "char_fang_yuan",
        "char_ren_zu",
        "loc_qian_kun_crystal_wall",
        "gu_wisdom_gu",
        "loc_book_mountain"
      ]
    },
    {
      "text": "Ordinal claims for her place among Ren Zu’s children conflict across chapters.",
      "chapters": [
        495
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt"
    },
    {
      "text": "Sources conflict:",
      "chapters": [],
