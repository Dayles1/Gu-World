  "claims": [
    {
      "text": "Heavenly Court observers credit Lord Zhou Xiong Xin’s rumor cage as the battlefield killer move with the fastest activation time, so fast Fang Yuan cannot react in time.",
      "chapters": [
        1699
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "fac_heavenly_court",
        "char_fang_yuan"
      ]
    },
    {
      "text": "He wears a white robe, has a square face with an air of righteousness, and his body is quite muscular.",
      "chapters": [
        1700
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "appearance",
      "text_origin": "source_excerpt"
    },
    {
      "text": "Unlike three accompanying rank eights from Central Continent’s ten great ancient sects, he is a recently awakened Heavenly Court member. He activates immortal battlefield rumor cage, suppressing other paths while amplifying information path. Fang Yuan has never seen him before. Narration places Heavenly Court members as elite among rank eights, and Fang Yuan finds rumor cage the fastest immortal battlefield killer move he has seen. Zhou Xiong Xin condemns Fang Yuan’s slaughter and launches immortal killer moves that include regenerating silver tigers tied to the battlefield.",
      "chapters": [
        1700
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "battles-fang-yuan-inside-the-cage",
      "text_origin": "source_excerpt",
      "mentions": [
        "fac_ten_great_ancient_sects"
      ]
    },
    {
      "text": "Fang Yuan’s plot succeeds in killing Zhou Xiong Xin. The remaining three rank eights then break Fang Yuan’s formation and escape. Narration frames rumor cage’s trap as Fang Yuan’s ambush from the start, and the formation’s brief hold on the other three as the window needed to kill him.",
      "chapters": [
        1703
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "death",
      "text_origin": "source_excerpt"
    }
  ],
