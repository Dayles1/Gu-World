  "claims": [
    {
      "text": "Beside Lu Qing Ming and Han Dong at Tai Qiu’s outskirts, he adds that Dong Fang Yu Liang and the other mortal Gu Masters have weak auras and do not draw desolate beasts the way Gu Immortals would.",
      "chapters": [
        781
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_lu_qing_ming",
        "char_han_dong",
        "loc_tai_qiu",
        "char_dong_fang_yu_liang",
        "fac_gu_masters",
        "sys_gu_immortal"
      ]
    },
    {
      "text": "When Lu Qing Ming calls to move, Su Guang and Han Dong follow him toward the teleportation Gu formation.",
      "chapters": [
        782
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "joint-charge",
      "text_origin": "source_excerpt",
      "mentions": [
        "sys_gu_formation"
      ]
    },
    {
      "text": "After a desolate level phantom beast swallows Han Dong, Su Guang and Lu Qing Ming chase. He shouts for the beast to turn phantom again while they attack from outside and Han Dong attacks from within. Seeing Lu Qing Ming’s immortal killer move entangled wind, his expression lightens because he knows that move’s power. When the beast still carries Han Dong toward its home and Su Guang cannot catch up, he shows despair at Dong Fang Chang Fan’s enslavement methods.",
      "chapters": [
        785
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "saving-han-dong",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_dong_fang_chang_fan"
      ]
    },
    {
      "text": "With Han Dong gone, Lu Qing Ming and Su Guang are only at rank six.",
      "chapters": [
        790
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "saving-han-dong",
      "text_origin": "source_excerpt"
    }
