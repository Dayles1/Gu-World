  "claims": [
    {
      "text": "Duke Long names her among Granny Rong, Yang Zi He, Shi Miao, and Zhang Yin, lone and demonic immortals of Eastern Sea’s Gu Immortal world who surround him at Dragon Palace.",
      "chapters": [
        1688
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_duke_long",
        "char_yang_zi_he",
        "char_shi_miao",
        "char_zhang_yin",
        "reg_eastern_sea",
        "sys_gu_immortal",
        "house_dragon_palace"
      ]
    },
    {
      "text": "She is an old woman, hunch-backed, with deep wrinkles on her face that resemble the pattern of a purple venomous snake, extending from her face to her arms and to her whole body.",
      "chapters": [
        1688
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "appearance",
      "text_origin": "source_excerpt"
    },
    {
      "text": "When Duke Long charges Dragon Palace she blocks him, her whole body releasing purple gas while she is heavily injured and pale as paper. Narration names her a poison path Gu Immortal whose purple poisonous air is her trump card, enough that Duke Long detours rather than touch it. Over days of fighting her loss is the greatest: one core Immortal Gu is destroyed, her speed falls greatly, and she stays passive through determination and help from the other three.",
      "chapters": [
        1690
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "poison-path-obstruction",
      "text_origin": "source_excerpt",
      "mentions": [
        "sys_immortal_gu"
      ]
    },
    {
      "text": "She is listed with Song Qi Yuan, Qing Yue An, Shen Cong Sheng, Zhang Yin, Shi Miao, and others in the unprecedented Eastern Sea rank eight gathering seeking Dragon Palace.",
      "chapters": [
        1700
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "ongoing-eastern-sea-gathering",
