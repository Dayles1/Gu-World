  "claims": [
    {
      "text": "At Han village on the fringe of Sha Jing oasis,",
      "chapters": [
        674
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "loc_han_village",
        "loc_sha_jing_oasis"
      ]
    },
    {
      "text": "Han Li’s parents kneel and thank Doctor Mo for saving their son after the boy choked. Doctor Mo says he is the Gu Master stationed in the village, that saving Han Li was natural, and that he met the crisis while patrolling, then leaves while the parents keep thanking him.",
      "chapters": [
        676
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_han_li",
        "sys_gu_master"
      ]
    },
    {
      "text": "He is an elderly Gu Master.",
      "chapters": [
        676
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "appearance",
      "text_origin": "source_excerpt"
    },
    {
      "text": "Fang Yuan watches from nearby and sees a rank two Gu Master jump from a large village house, straighten his clothes, pretend to arrive by chance, then revive Han Li after the parents plead. From the talk, Fang Yuan places him as a healing Gu Master stationed in the village and notes a secret connection with Han Li. After inspecting Gu worms and flesh modifications on Han Li’s body, Fang Yuan concludes that Doctor Mo is refining rank three human medicine Gu, using a human child as the main material over years for a single-use lifespan increase with large drawbacks. Fang Yuan judges Doctor Mo no longer young, that he chose Han Li for that refinement, that a monitoring Gu explains the fast arrival, and that the refinement’s vitality boost is why revival after choking was easy. Fang Yuan does not kill him, because a mysterious death would draw investigation on Han village, while leaving him alive keeps Han Li cared for through the three to four years still needed to finish the Gu. Fang Yuan also judges that his own planted Gu worms outclass rank two Doctor Mo’s methods, and that any later attempt to harm Han Li would rebound hard.",
      "chapters": [
        676
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "stationed-healer-and-human-medicine-gu",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_fang_yuan",
        "sys_gu_worms",
        "gu_human_medicine_gu"
      ]
    }
