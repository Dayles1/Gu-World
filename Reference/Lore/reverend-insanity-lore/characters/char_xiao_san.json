  "claims": [
    {
      "text": "At night outside the camp, an investigative group sees a white-hair zombie hop into view under the bonfire light. The group leader speaks indifferently and tells Xiao San to take care of the unlucky zombie.",
      "chapters": [
        254
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt"
    },
    {
      "text": "He answers “Yes, boss,” laughs, and walks toward it. A healing master warns him about corpse poison. Xiao San waves the warning off and says, “Understood, understood. Do you take me as a three-year-old child?” Narration notes he has already killed many white-hair zombies since entering Mu Bei mountain. He freezes when he sees the larger zombie horde, then turns, runs, and screams for the alarm as hundreds of white-hair zombies press forward with stronger black-hair zombies mixed among them.",
      "chapters": [
