  "claims": [
    {
      "text": "As Xia clan’s first supreme elder he hears Gu Immortals urge a fight and keeps a dark face. Though only rank seven, he has high reputation, argues they should withdraw into Immortal Gu Houses, and despairs that so many rank eight Gu Immortals are attacking a Xia clan blessed land that is not Heavenly Court.",
      "chapters": [
        1982
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "fac_xia_clan",
        "sys_gu_immortal",
        "sys_immortal_gu_house",
        "fac_heavenly_court"
      ]
    },
    {
      "text": "He walks out of the Eastern Sea alliance army to challenge the variant human force, fights a rank seven snowman Gu Immortal, and lands a fatal killer move before Ice Crystal Immortal Monarch interferes.",
      "chapters": [
        2069
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "alliance-battle",
      "text_origin": "source_excerpt",
      "mentions": [
        "reg_eastern_sea",
        "race_snowmen",
        "char_ice_crystal_immortal_monarch"
      ]
    },
    {
      "text": "When bladewings penetrate Xia clan’s Immortal Gu House Whale Fishing Boat, he is killed inside that House with a mournful howl.",
