  "claims": [
    {
      "text": "The Bai clan leader organizes a banquet again and invites Fang Yuan and Bai Ning Bing. At the small banquet in the central tent, only the day’s top hunters sit among the guests. Once they are seated, Bai Mo Xing starts introductions so the young Gu Masters can meet the clan’s rising stars.",
      "chapters": [
        217
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
