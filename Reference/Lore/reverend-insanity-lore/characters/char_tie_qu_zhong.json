  "claims": [
    {
      "text": "In treasure yellow heaven he buys copper and silver dragonfish to feed rank seven edge Gu, and he plans a white steel extract resource point so he can stop buying substitutes. Southern Border’s righteous path deploys him with Shang Hu Zhang as one of the pairs hunting Fang Yuan.",
      "chapters": [
        1600
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "gu_edge_immortal_gu",
        "reg_southern_border",
        "char_shang_hu_zhang",
        "char_fang_yuan"
      ]
    },
    {
      "text": "Inside years flow execution formation, Fang Yuan’s great thief ghost hand steals his Immortal Gu. He coughs blood as his killer move fails from backlash and cries out for his rank seven edge Gu.",
      "chapters": [
        1603
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "edge-gu-theft",
      "text_origin": "source_excerpt",
      "mentions": [
        "sys_immortal_gu"
      ]
    },
    {
      "text": "Jun Shen Guang names him Tie clan’s Tie Qu Zhong, known as Great Sir Tie. When he made his debut he captured and killed over ten demonic path Gu Immortals, and Southern Border’s demonic immortals trembled at his name.",
      "chapters": [
        1604
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "great-sir-tie",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_jun_shen_guang",
        "fac_tie_clan",
        "sys_gu_immortal"
      ]
    },
    {
      "text": "After the dream realm ambush he is among the Southern Border rank seven captives locked in Fang Yuan’s sovereign immortal aperture, eyes closed in dream realms beside Shang Hu Zhang and Yang Ku.",
      "chapters": [
        1605
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "captive",
      "text_origin": "source_excerpt"
    }
  ],
