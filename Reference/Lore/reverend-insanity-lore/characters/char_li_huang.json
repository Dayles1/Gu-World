  "claims": [
    {
      "text": "Fang Yuan faces an experienced rank eight Gu Immortal whose immortal killer move verdant sun flame cloak blazes until his body resembles a huge fireball, both attacking and defending as dragons burn on contact. Near the end of that clash Fang Yuan names him Li Huang while pressing five finger fist heart sword against the cloak.",
      "chapters": [
        1632
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_fang_yuan",
        "sys_gu_immortal"
      ]
    },
    {
      "text": "A later summary calls him the old man Li Huang after Fang Yuan breaks out of the time path formation.",
      "chapters": [
        1633
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt"
    },
    {
      "text": "He is an old man.",
      "chapters": [
        1632
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "appearance",
      "text_origin": "source_excerpt"
    },
    {
      "text": "When he arrives later as Heavenly Court reinforcement, flames scatter and a muscular old man appears.",
      "chapters": [
        1695
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "appearance",
      "text_origin": "source_excerpt",
      "mentions": [
        "fac_heavenly_court"
      ]
    },
    {
      "text": "His immortal killer move verdant sun flame cloak covers his entire body like a fireball, burns myriad dragons that draw near, and recovers after Luo Po seal only grazes his shoulder. Fang Yuan reads his soul defense as tight and finds no clear weakness.",
      "chapters": [
        1632
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "appearance",
      "text_origin": "source_excerpt"
    },
    {
      "text": "He pays respects to Duke Long and says that with verdant sun flame cloak, no one in the world can harm Feng Jin Huang while he guards her.",
      "chapters": [
        1695
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "river-of-time-duty",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_duke_long",
        "char_feng_jin_huang"
      ]
    }
  ],
