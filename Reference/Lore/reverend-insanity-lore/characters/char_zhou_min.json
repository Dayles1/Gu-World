  "claims": [
    {
      "text": "She urges Feng Jun and Zheng Tuo to convince Old Immortal Chen Chi before acting, and argues that Chen Chi has the highest cultivation among them even if others look down on him.",
      "chapters": [
        1119
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_feng_jun",
        "char_zheng_tuo",
        "char_chen_chi"
      ]
    },
    {
      "text": "Fang Yuan notes her and Feng Jun as rank six when they greet him as Hei Cheng.",
      "chapters": [
        1120
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_fang_yuan",
        "char_hei_cheng"
      ]
    },
    {
      "text": "She is a light path Gu Immortal nurtured by a Gu Immortal from a past generation and holds sight light Immortal Gu. Her criminal immortal light path inheritance comes from criminal immortals rather than Old Ancestor Hei Fan. Chen Le describes her killer move farsight weapon light: her eyes shoot golden white light that can cut down anything, stronger at longer range and drastically weakened close up. In battle she spews anger, activates that move, and cries for Fang Yuan to die as white light shoots from her eyes.",
      "chapters": [
        1126
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "light-path-and-farsight-weapon-light",
      "text_origin": "source_excerpt",
      "mentions": [
        "sys_gu_immortal",
        "gu_sight_light_immortal_gu",
        "char_hei_fan",
        "char_chen_le"
      ]
    },
    {
      "text": "After Zheng Tuo dies she screams for Fang Yuan to release their brother’s corpse, then flees with Feng Jun, joins other immortals, and helps assemble an ancient battle formation. Along the escape Fang Yuan kills her while Feng Jun crashes onto Immortal Succession Mountain heavily injured.",
      "chapters": [
        1127
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "death",
      "text_origin": "source_excerpt",
      "mentions": [
        "loc_immortal_succession_mountain"
      ]
    }
  ],
