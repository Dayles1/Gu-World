  "claims": [
    {
      "text": "Duke Long names him last among Granny Rong, Yang Zi He, Shi Miao, and Zhang Yin, lone and demonic immortals of Eastern Sea surrounding him at Dragon Palace.",
      "chapters": [
        1688
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_duke_long",
        "char_granny_rong",
        "char_yang_zi_he",
        "char_shi_miao",
        "reg_eastern_sea",
        "house_dragon_palace"
      ]
    },
    {
      "text": "He wears a black robe. His face cannot be seen. He is silent like an eerie ghost and filled with dark energy.",
      "chapters": [
        1688
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "appearance",
      "text_origin": "source_excerpt"
    },
    {
      "text": "Narration places him in the four person alliance of Granny Rong, Yang Zi He, Zhang Yin, and Shi Miao opposing Eastern Sea righteous path rank eights and Duke Long.",
      "chapters": [
        1690
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "alliance-and-later-gathering",
      "text_origin": "source_excerpt",
      "mentions": [
        "fac_eastern_sea_righteous_path"
      ]
    },
    {
      "text": "He later flies with Song Qi Yuan to face Duke Long together when that fight pauses.",
      "chapters": [
        1695
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "alliance-and-later-gathering",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_song_qi_yuan"
      ]
    },
    {
      "text": "He remains among the Eastern Sea rank eight gathering listed with Song Qi Yuan, Qing Yue An, Shen Cong Sheng, Granny Rong, Shi Miao, and others.",
      "chapters": [
        1700
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "alliance-and-later-gathering",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_qing_yue_an",
        "char_shen_cong_sheng"
      ]
    },
    {
      "text": "In the chase around Dragon Palace he strikes Song Qi Yuan with fatal dark lightning and chuckles that Song Qi Yuan should chase him if unafraid of dying. The remaining righteous path rank eights name fatal dark lightning as Zhang Yin’s trump card: huge cost to activate, formless, colorless, and unable to be sensed, arrangeable in sea or air, exploding on contact.",
      "chapters": [
        1691
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "fatal-dark-lightning",
      "text_origin": "source_excerpt"
    }
  ],
