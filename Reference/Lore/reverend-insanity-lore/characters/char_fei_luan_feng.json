  "claims": [
    {
      "text": "After Doctor Su Shou vanishes into a private room, arriving notables include Yan Tu, Yi Huo, Yi Bu Hui, and Fei Luan Feng of Fei clan.",
      "chapters": [
        306
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_doctor_su_shou",
        "char_yan_tu",
        "char_yi_huo",
        "char_yi_bu_hui",
        "fac_fei_clan"
      ]
    },
    {
      "text": "When chasing wind Gu’s price rises to three hundred and fifty thousand, only two Gu Masters remain competing. One is Yi clan elder Yi Bu Hui, and the other is Fei clan elder Fei Luan Feng. Yi clan and Fei clan did not have a good relationship, and the two compete as sparks arise. Yi Bu Hui eventually buys the Gu for four hundred and forty thousand.",
      "chapters": [
        307
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "chasing-wind-bidding",
      "text_origin": "source_excerpt",
      "mentions": [
        "gu_chasing_wind_gu",
        "fac_gu_masters",
        "fac_yi_clan"
      ]
    },
    {
      "text": "When Atmosphere Gu opens at a base bid of two hundred and sixty thousand primeval stones, Yi clan elder Yi Bu Hui bids three hundred thousand. Fei clan elder Yan Luan Feng answers with three hundred and fifty thousand and is equally tough.",
      "chapters": [
        308
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "atmosphere-gu-bidding",
      "text_origin": "source_excerpt",
      "mentions": [
        "gu_atmosphere_gu"
      ]
    },
    {
      "text": "Shang Xin Ci later weighs that Yi clan and Fei clan elders might compete and push that Gu’s price higher if the bid stayed lower.",
      "chapters": [
        308
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
