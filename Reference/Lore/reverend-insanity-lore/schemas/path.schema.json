{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "path.schema.json",
  "title": "path",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/envelope"
    },
    {
      "type": "object",
      "required": [
        "attributes",
        "claims"
      ],
      "properties": {
        "entity_type": {
          "enum": [
            "path"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^path_"
        },
        "attributes": {
          "type": "object",
          "description": "Raw infobox fields from the source, kept for later typed mapping."
        },
        "claims": {
          "$ref": "common.schema.json#/$defs/claims"
        }
      }
    }
  ]
}