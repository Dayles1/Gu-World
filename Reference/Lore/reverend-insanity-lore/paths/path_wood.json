        "char_xue_san_si"
      ]
    },
    {
      "text": "Fairy Li Shan cultivated information path mainly and wood path and earth path secondarily. In orchard garden in mountain, pear blossoms and coiling vines are named wood path techniques in a battlefield killer move that also uses earth path gravity.",
      "chapters": [
        943
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "what-the-path-governs",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_fairy_li_shan"
      ]
    },
    {
      "text": "Giant Sun Immortal Venerable states that Genesis Lotus cultivates wood path and painting path.",
      "chapters": [
        2203
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "genesis-lotus-primary",
      "text_origin": "source_excerpt",
