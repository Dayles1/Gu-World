  "claims": [
    {
      "text": "The novel treats bone path as a named cultivation path with Gu Masters, Gu worms, and killer moves built around bone.",
      "chapters": [],
      "certainty": "inferred",
      "confidence": "C",
      "verification": "no_citation",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "fac_gu_masters",
        "sys_gu_worms"
      ]
    },
    {
      "text": "Ku Mo’s Gu set is built on bone path understanding. Besides the rank five soft bones Gu, his other seven Gu are rank four pieces tied to bone path. Fang Yuan judges that he only scratches the surface of bone path, so inheriting that set would not let him display even half of Ku Mo’s battle strength. Soft bones Gu turns the bones of lifeforms soft within a twenty-five kilometre radius, leaving a victim without skeletal support.",
      "chapters": [
        380
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "what-the-path-governs",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_ku_mo",
        "gu_soft_bones_gu",
        "char_fang_yuan"
      ]
    },
    {
      "text": "Shi Wu is a bone path Gu Master who buys all the bone bamboo Gu in a northern plains market while claiming to research a new Gu path recipe.",
      "chapters": [
        442
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "what-the-path-governs",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_shi_wu",
        "sys_gu_master"
      ]
    },
    {
      "text": "When Fang Yuan lists exchange goods for desolate beast corpses, fifth on the list is bone path Gu worms such as Battle Bone Wheel, which can be arranged into the killer move White Bone Chariot.",
      "chapters": [
        732
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "killer-move-materials",
      "text_origin": "source_excerpt",
      "mentions": [
