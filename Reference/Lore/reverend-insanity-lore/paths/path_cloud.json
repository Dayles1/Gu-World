        "char_bai_ning_bing"
      ]
    },
    {
      "text": "Rising Azure Cloud is a cloud path movement Immortal Gu.",
      "chapters": [
        663
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
