        "sys_gu_immortal"
      ]
    },
    {
      "text": "Li Jun Ying tells Zhao Lian Yun that she recently became a shadow path great grandmaster, and that her Illusory Fairy skill plus that attainment let her tamper with Gu materials without easy detection.",
      "chapters": [
        2089
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "what-the-path-governs",
