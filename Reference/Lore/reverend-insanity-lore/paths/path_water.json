  "claims": [
    {
      "text": "The novel treats water path as a named cultivation path with mortal Gu Masters, dao marks on lifeforms, and clan inheritances, not as a generic word for liquid.",
      "chapters": [],
      "certainty": "inferred",
      "confidence": "C",
