      ]
    },
    {
      "text": "While clearing King Quan’s inheritance, Fang Yuan kills a rank three peak stage water path Gu Master.",
      "chapters": [
        349
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "what-the-path-governs",
      "text_origin": "source_excerpt",
      "mentions": [
