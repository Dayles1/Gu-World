  "claims": [
    {
      "text": "The novel treats poison path as a named cultivation path with mortal Gu Masters, Immortal Gu, and Immortal killer moves, not as a generic word for toxin.",
      "chapters": [],
      "certainty": "inferred",
      "confidence": "C",
      "verification": "no_citation",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
