  "claims": [
    {
      "text": "The novel treats blade path as a named cultivation path with killer moves, Immortal Gu, dao marks, and ranked attainment.",
      "chapters": [],
      "certainty": "inferred",
      "confidence": "C",
      "verification": "no_citation",
      "source_id": "src_sagaofgu",
