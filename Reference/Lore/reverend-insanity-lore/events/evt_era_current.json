  "claims": [
    {
      "text": "Caution",
      "chapters": [],
      "certainty": "inferred",
      "confidence": "C",
      "verification": "no_citation",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt"
    },
    {
      "text": "An empty Venerable list here is not a claim that none arose. Named claimants and late placements sit in the gated sections below. Sources disagree on Early Antiquity Era versus Late Antiquity Era before the present age. The Chinese name for this age is uncited. This page states nothing about where the regional walls come from.",
      "chapters": [],
      "certainty": "inferred",
      "confidence": "C",
      "verification": "no_citation",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt"
    },
    {
      "text": "Sources do not agree on the name of the age immediately before the present age.",
      "chapters": [],
      "certainty": "inferred",
      "confidence": "C",
      "verification": "no_citation",
      "source_id": "src_sagaofgu",
      "section": "name-in-the-succession",
      "text_origin": "source_excerpt"
    },
    {
      "text": "Sources conflict:",
      "chapters": [],
      "certainty": "inferred",
      "confidence": "C",
      "verification": "no_citation",
      "source_id": "src_sagaofgu",
      "section": "name-in-the-succession",
      "text_origin": "source_excerpt"
    },
    {
      "text": "The question is open.",
      "chapters": [],
      "certainty": "inferred",
      "confidence": "C",
      "verification": "no_citation",
      "source_id": "src_sagaofgu",
      "section": "name-in-the-succession",
      "text_origin": "source_excerpt"
    },
    {
      "text": "Fang Yuan stands by the window in Gu Yue Village on Qing Mao Mountain after Spring Autumn Cicada returns him five hundred years, carrying memory of a prior life in this age.",
      "chapters": [
        1
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "fang-yuans-rebirth",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_fang_yuan",
        "loc_gu_yue_village",
        "loc_qing_mao_mountain",
        "gu_spring_autumn_cicada"
      ]
    },
    {
      "text": "He is fifteen years old.",
      "chapters": [
        9
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "fang-yuans-rebirth",
      "text_origin": "source_excerpt"
    },
    {
      "text": "The village sits in the Southern Border.",
      "chapters": [
        29
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "fang-yuans-rebirth",
      "text_origin": "source_excerpt",
      "mentions": [
        "reg_southern_border"
      ]
    },
    {
      "text": "Immortal Yi Yan’s prophecy and which of its three names remain open.",
      "chapters": [],
      "certainty": "inferred",
      "confidence": "C",
      "verification": "no_citation",
      "source_id": "src_sagaofgu",
      "section": "three-era-prophecy",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_immortal_yi_yan"
      ]
    },
    {
      "text": "Immortal Yi Yan, a rank eight wisdom path Gu Immortal and friend of Long Hair Ancestor, expended fifty years of his life to deduce that after three great eras three venerables would appear: Spectral Soul Demon Venerable, Paradise Earth Immortal Venerable, and Great Dream Immortal Venerable. That deduction became known as the Prophecy of Three Venerables. By then Paradise Earth Immortal Venerable was already dead; only Great Dream Immortal Venerable had yet to be born.",
      "chapters": [
        461
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "three-era-prophecy",
      "text_origin": "source_excerpt",
      "mentions": [
        "sys_gu_immortal",
        "char_long_hair_ancestor",
        "char_spectral_soul_demon_venerable",
        "char_paradise_earth_immortal_venerable",
        "char_great_dream_immortal_venerable",
        "sys_prophecy_of_three_venerables"
      ]
    },
    {
      "text": "Heavenly Court’s pursuit of Fang Yuan by name.",
      "chapters": [],
      "certainty": "inferred",
      "confidence": "C",
      "verification": "no_citation",
      "source_id": "src_sagaofgu",
      "section": "listed-for-pursuit",
      "text_origin": "source_excerpt"
    },
    {
      "text": "Heavenly Court has listed him on the Demon Judgment Board and is hunting him by name.",
      "chapters": [
        1052
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "listed-for-pursuit",
      "text_origin": "source_excerpt",
      "mentions": [
        "fac_heavenly_court",
        "house_demon_judgment_board"
      ]
    },
    {
      "text": "A living disciple named as the future Great Dream Immortal Venerable.",
      "chapters": [],
      "certainty": "inferred",
      "confidence": "C",
      "verification": "no_citation",
      "source_id": "src_sagaofgu",
      "section": "new-claimants",
      "text_origin": "source_excerpt"
    },
    {
      "text": "Duke Long names Feng Jin Huang as the future Great Dream Immortal Venerable and takes her as a disciple toward that throne.",
      "chapters": [
        1440
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "new-claimants",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_duke_long",
        "char_feng_jin_huang"
      ]
    },
    {
      "text": "Brand-new dao marks Fang Yuan finds in Crazed Demon Cave.",
      "chapters": [],
      "certainty": "inferred",
      "confidence": "C",
      "verification": "no_citation",
      "source_id": "src_sagaofgu",
      "section": "new-dao-marks",
      "text_origin": "source_excerpt",
      "mentions": [
        "loc_crazed_demon_cave"
      ]
    },
    {
      "text": "In Crazed Demon Cave, Fang Yuan finds brand-new dao marks that point to paths not yet founded. He reads them as a possible future for someone else and does not take up creating those paths himself.",
      "chapters": [
        1865
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "new-dao-marks",
      "text_origin": "source_excerpt"
    },
    {
      "text": "Dao vein plans inside Fang Yuan’s aperture.",
      "chapters": [],
      "certainty": "inferred",
      "confidence": "C",
      "verification": "no_citation",
      "source_id": "src_sagaofgu",
      "section": "artificial-earth-veins",
      "text_origin": "source_excerpt"
    },
    {
      "text": "He plans dao vein construction inside his aperture.",
      "chapters": [
        2140
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "artificial-earth-veins",
      "text_origin": "source_excerpt"
    },
    {
      "text": "Construction of an artificial earth vein inside the aperture.",
      "chapters": [],
      "certainty": "inferred",
      "confidence": "C",
      "verification": "no_citation",
      "source_id": "src_sagaofgu",
      "section": "artificial-earth-vein-underway",
      "text_origin": "source_excerpt"
    },
    {
      "text": "Construction of an artificial earth vein is already underway in that stretch.",
      "chapters": [
        2142
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "artificial-earth-vein-underway",
      "text_origin": "source_excerpt"
    },
    {
      "text": "A past crisis of Thieving Heaven and Limitless at Crazed Demon Cave, not an event of this age.",
      "chapters": [],
      "certainty": "inferred",
      "confidence": "C",
      "verification": "no_citation",
      "source_id": "src_sagaofgu",
      "section": "past-world-boundary-breach",
      "text_origin": "source_excerpt"
    },
    {
      "text": "Thieving Heaven Demon Venerable breaks the world boundary at its thinnest point inside Crazed Demon Cave. Limitless Demon Venerable’s will warns that if the hole is not mended, the entire world will be destroyed; Reckless Savage’s will and Genesis Lotus’s will join the attempt to hold it.",
      "chapters": [
        2171
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "past-world-boundary-breach",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_thieving_heaven_demon_venerable",
        "char_limitless_demon_venerable",
        "char_reckless_savage_demon_venerable"
      ]
    },
    {
      "text": "Primordial Domain in the ninth layer and in The Legends of Ren Zu.",
      "chapters": [],
      "certainty": "inferred",
      "confidence": "C",
      "verification": "no_citation",
      "source_id": "src_sagaofgu",
      "section": "ninth-layer-core",
      "text_origin": "source_excerpt",
      "mentions": [
        "loc_primordial_domain",
        "sys_the_legends_of_ren_zu"
      ]
    },
    {
      "text": "Primordial Domain is named as the other core of the ninth layer, and in The Legends of Ren Zu as the most mysterious part of Qian Kun Crystal Wall, holding information of the world since creation.",
      "chapters": [
        2176
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "ninth-layer-core",
      "text_origin": "source_excerpt",
      "mentions": [
        "loc_qian_kun_crystal_wall"
      ]
    },
    {
      "text": "Fang Yuan’s rank nine ascent and Demon Venerable name.",
      "chapters": [],
      "certainty": "inferred",
      "confidence": "C",
      "verification": "no_citation",
      "source_id": "src_sagaofgu",
      "section": "rank-nine-ascent",
      "text_origin": "source_excerpt"
    },
    {
      "text": "During the Crazed Demon Cave battle, Fang Yuan reaches genuine rank nine. Giant Sun Immortal Venerable and Star Constellation Immortal Venerable fight him as a third venerable. When Star Constellation’s flying stars leave dao marks on him, rank nine refinement path lets him refine those flying-star dao marks into his own.",
      "chapters": [
        2211
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "rank-nine-ascent",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_giant_sun_immortal_venerable",
        "char_star_constellation_immortal_venerable"
      ]
    },
    {
      "text": "He is the eleventh venerable of the Gu cultivator world, Heaven Refining Demon Venerable.",
      "chapters": [
        2215
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "rank-nine-ascent",
      "text_origin": "source_excerpt"
    },
    {
      "text": "Fang Yuan and Giant Sun pressing Star Constellation at Heavenly Court.",
      "chapters": [],
      "certainty": "inferred",
      "confidence": "C",
      "verification": "no_citation",
      "source_id": "src_sagaofgu",
      "section": "heavenly-court-assault",
      "text_origin": "source_excerpt"
    },
    {
      "text": "Fang Yuan and Giant Sun Immortal Venerable arrive at Heavenly Court while Star Constellation Immortal Venerable holds Spectral Soul Demon Venerable in star fog. They attack her and press toward the qi harvest fruit core; she is forced onto the defensive inside Heavenly Court.",
      "chapters": [
        2334
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "heavenly-court-assault",
      "text_origin": "source_excerpt"
    },
    {
      "text": "The Heavenly Court Final War arc covers that stretch.",
      "chapters": [],
      "certainty": "inferred",
      "confidence": "C",
      "verification": "no_citation",
      "source_id": "src_sagaofgu",
      "section": "heavenly-court-assault",
      "text_origin": "source_excerpt",
      "mentions": [
        "evt_arc_heavenly_court_final_war"
      ]
    }
  ],
