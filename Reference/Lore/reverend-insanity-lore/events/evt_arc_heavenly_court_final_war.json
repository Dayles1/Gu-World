  "claims": [
    {
      "text": "Chapter 2211 is titled Fang Yuan Becomes Venerable, and the range opens on that ascension and the consolidation that follows it, ahead of the war itself.",
      "chapters": [
        2211
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt"
    },
    {
      "text": "Qin Ding Ling and Jun Shen Guang move through the two heavens on recruitment work aimed at grotto-heaven forces tied to Fang Yuan. Qin Ding Ling judges that if Old Immortal Hua Yu and others betray Fang Yuan, Heaven Refining Demon Venerable’s reputation would fall to the lowest among the three venerables, so she and Jun Shen Guang keep pressing that recruitment line. In the same chapter, Spectral Soul Demon Venerable pierces a heavenly chasm and drives Fairy Zi Wei and Ying Wu Xie into retreat while absorbing soul beasts.",
      "chapters": [
        2270
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "court-recruitment-and-spectral-soul",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_qin_ding_ling",
