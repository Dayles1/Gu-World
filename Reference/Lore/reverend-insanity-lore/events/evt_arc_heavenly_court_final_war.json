        "char_spectral_soul_demon_venerable",
        "char_fairy_zi_wei",
        "char_ying_wu_xie"
      ]
    },
    {
      "text": "After Fang Yuan gains the upper hand against Star Constellation Immortal Venerable in spectral heaven, Giant Sun Immortal Venerable enters that battlefield on Star Constellation’s side.",
      "chapters": [
        2310
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "spectral-heaven-contest",
