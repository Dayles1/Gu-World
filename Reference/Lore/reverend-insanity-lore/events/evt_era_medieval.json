        "sys_righteous_path",
        "sys_gu_master"
      ]
    },
    {
      "text": "How far back the novel places the Medieval Antiquity Era from the present.",
      "chapters": [],
      "certainty": "inferred",
      "confidence": "C",
      "verification": "no_citation",
      "source_id": "src_sagaofgu",
      "section": "distance-from-the-present",
      "text_origin": "source_excerpt"
    },
    {
      "text": "Zombie Alliance is said to have appeared in the Medieval Antiquity Era, three hundred thousand years ago.",
      "chapters": [
        653
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "distance-from-the-present",
      "text_origin": "source_excerpt",
      "mentions": [
        "fac_zombie_alliance"
      ]
    },
    {
      "text": "Fang Yuan’s later entries into Thieving Heaven spaces, dream realm, and true inheritances.",
      "chapters": [],
      "certainty": "inferred",
      "confidence": "C",
      "verification": "no_citation",
      "source_id": "src_sagaofgu",
