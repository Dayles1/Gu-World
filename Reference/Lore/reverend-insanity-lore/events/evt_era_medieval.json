      "section": "thieving-heaven-inheritances",
      "text_origin": "source_excerpt"
    },
    {
      "text": "Fang clan holds a Thieving Heaven true inheritance that Fang Yuan browses.",
      "chapters": [
        1857
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "thieving-heaven-inheritances",
      "text_origin": "source_excerpt",
