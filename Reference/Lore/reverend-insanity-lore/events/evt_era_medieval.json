      "section": "name-in-the-succession",
      "text_origin": "source_excerpt"
    },
    {
      "text": "An Immortal Venerable is a rank nine righteous Gu Master; a Demon Venerable is a rank nine demonic path Gu Master.",
      "chapters": [
        383
      ],
      "certainty": "canon",
      "confidence": "B",
