      "mentions": [
        "char_fang_yuan"
      ]
    },
    {
      "text": "Fang Yuan enters a Thieving Heaven Demon Venerable true inheritance space.",
      "chapters": [
        991
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "thieving-heaven-inheritances",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_thieving_heaven_demon_venerable"
      ]
    },
    {
      "text": "Thieving Heaven’s dream realm stands as its own subject of exploration.",
