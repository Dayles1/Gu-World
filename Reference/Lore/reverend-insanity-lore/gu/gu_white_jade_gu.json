    "claims": [
      {
        "text": "Qing Mao Mountain chapters describe White Jade Gu as defensive fusion product without naming a cultivation path for this Gu.",
        "chapters": [],
        "certainty": "inferred",
        "confidence": "C",
        "verification": "no_citation",
        "source_id": "src_sagaofgu",
        "section": "path",
