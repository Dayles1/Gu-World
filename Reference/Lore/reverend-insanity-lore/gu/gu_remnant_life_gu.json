  "history": {
    "claims": [
      {
        "text": "Fang Yuan names it when he reviews Chou Jiu’s corpse after the killer ghost doctor’s staged suicide in the blessed land.",
        "chapters": [
          385
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_fang_yuan",
          "char_chou_jiu"
        ]
      },
      {
        "text": "Chou Jiu relies on it as a hidden resurrection. Fang Yuan’s previous-life memory already places a return from death after Chou Jiu’s throat was cut during the Yi Tian Mountain battle, startling both righteous and demonic path. In the blessed land, heavenly power suppresses the Gu’s law fragment in Chou Jiu’s body, so it cannot activate until that suppression weakens as the blessed land crumbles. Fang Yuan then destroys the corpse into minced meat and ashes so that path is closed.",
        "chapters": [
          385
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "prevented-resurrection",
        "text_origin": "source_excerpt",
