  "history": {
    "claims": [
      {
        "text": "A Man tribe market shopkeeper sells it for four thousand five hundred and fifty primeval stones. Domination Immortal Chu Du invents Jin Strength Gu and Jun Strength Gu as popular alternatives to beast strength Gu. Fang Yuan already has Chang Shan Yin’s appearance; he picks this jun strength line to merge into northern plains practice and to support enslavement path with physical strength.",
        "chapters": [
          442
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "fac_man_tribe",
          "char_chu_du",
          "gu_beast_strength_gu",
          "char_fang_yuan",
          "char_chang_shan_yin"
        ]
      },
      {
        "text": "The human strength jun strength branch refers to Jin Strength Gu, strength of ten jin Gu, Jun Strength Gu, strength of ten jun Gu, strength of hundred jun Gu, and others, and it is then the mainstream strength path cultivation in Northern Plains.",
        "chapters": [
          754
        ],
        "certainty": "canon",
        "confidence": "B",
