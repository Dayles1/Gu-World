    "price_claims": [
      {
        "text": "Long Hair Ancestor refined dog shit luck Immortal Gu as soon as Giant Sun Immortal Venerable died. It then guarded Lang Ya blessed land, aiding Gu refinement and shielding the blessed land from disasters. Fang Yuan sells Luo Po Valley to Lang Ya land spirit and receives dog shit luck Immortal Gu with blood asset Immortal Gu and dark limit Immortal Gu, all rank six.",
        "chapters": [
          1063
        ],
        "certainty": "canon",
        "confidence": "B",
