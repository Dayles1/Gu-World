    "claims": [
      {
        "text": "With Miniscule Mountain raised, approaching immortal killer moves weaken as they close in: an ice dragon shrinks to an ice snake, a strength path giant hand shrinks to less than one percent of its size, and a heavenly flower fades and wilts, so Dong Fang Chang Fan can block what remains. Pi Shui Han names that method the immortal killer move big to small. Unfettered Scholar has Disintegrate and similarly has thousand disintegrations; when he uses that killer move on Miniscule Mountain, big to small counters the strike.",
        "chapters": [
          801
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "miniscule-mountain-defense",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_dong_fang_chang_fan",
