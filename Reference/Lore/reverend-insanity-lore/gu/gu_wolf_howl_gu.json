  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "Fang Yuan howls towards the sky with Wolf Howl Gu, letting out a furious howl like that of a wolf king. Under the effect of the Gu worm, the wolf group on the ranch faintly enlarges, their energy inflates and their battle strength multiplies. Fang Yuan laughs loudly and wills his wolf group to howl together, with the wolf howl spreading without restraint and travelling a thousand li.",
        "chapters": [
          453
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "ranged-effect",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Fang Yuan activates Wolf Howl Gu alongside Wolf Smoke Gu on the battlefield, crying like a wolf as his voice spreads far and wide, increasing the wolf group’s battle strength. Immediately after, he emits dense smoke that engulfs the battlefield, healing the wolves’ injuries.",
        "chapters": [
          473
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "battlefield-coordination",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_wolf_smoke_gu"
        ]
      },
      {
        "text": "Fang Yuan activates Wolf Howl Gu when wild water wolves attack his wolf group, sending reinforcements to help against obstruction from water wolves.",
        "chapters": [
          495
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "extended-use",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Late in his northern plains campaign, Wolf Howl Gu resides among his body-housed Gu alongside Wolf Care Gu, Eagle Rise Gu, Wolf Sprint Gu and Breath Concealment Gu.",
        "chapters": [
          504
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "extended-use",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_wolf_care_gu",
          "gu_eagle_rise_gu",
          "gu_wolf_sprint_gu",
          "gu_breath_concealment_gu"
        ]
      },
      {
        "text": "Fang Yuan continuously activates Wolf Howl Gu while creating shocking variations in assault against a defense line, with each variation bringing an enormous threat.",
        "chapters": [
          515
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
