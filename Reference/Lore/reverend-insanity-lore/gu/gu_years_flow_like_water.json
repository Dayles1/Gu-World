  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "More immortal essence yields more year Gu, and with enough expenditure it can produce immortal level year Gu. While a rank six year Gu still exists, Immortal Gu uniqueness blocks immortal level year Gu output, so only mortal year Gu come out no matter how much essence is spent. A rank six Gu Immortal can already activate it with green grape immortal essence, though higher rank essence produces more year Gu.",
        "chapters": [
          1129
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_gu_immortal"
        ]
      },
      {
        "text": "With his rank six cultivation, Fang Yuan’s green grape immortal essence cannot activate Years Flow Like Water, unlike attitude Gu, which needs only mental energy.",
        "chapters": [
          1130
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_attitude_gu"
        ]
      },
      {
        "text": "Sources conflict:",
        "chapters": [],
        "certainty": "inferred",
        "confidence": "C",
        "verification": "no_citation",
        "source_id": "src_sagaofgu",
