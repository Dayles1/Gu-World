  "history": {
    "claims": [
      {
        "text": "Fang Yuan takes it from Hei Fan’s true inheritance, sealed with year Gu in ice, and names it a rank eight time path Immortal Gu. In Hei Fan’s life it was his only rank eight Immortal Gu.",
        "chapters": [
          1129
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_fang_yuan",
          "inh_hei_fan_true_inheritance",
          "gu_year_gu",
          "path_time",
          "sys_immortal_gu",
          "char_hei_fan"
        ]
      },
      {
        "text": "Even with his battle strength newly surged, Fang Yuan still cannot unseal Years Flow Like Water.",
        "chapters": [
          1302
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "still-sealed",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Fang Yuan unseals Years Flow Like Water and uses it as the core of year beast summoning, the version in Hei Fan’s true inheritance that summons an army of year beasts where the year Gu version summons only one. Even a rank six Gu Immortal can use this rank eight Immortal Gu.",
        "chapters": [
          1401
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "year-beast-summoning",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Heavenly Court credits Hei Fan’s true inheritance for Fang Yuan controlling the upper extreme heavenly eagle, a rank eight existence, at rank seven cultivation, while the truth is hundred and eighty slaves together with this Gu’s own flaw. Hei Fan never exposed that weakness, so Heavenly Court cannot deduce that Fang Yuan has a way to lure immemorial year beasts to him.",
        "chapters": [
          1432
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "hidden-behind-the-eagles-control",
        "text_origin": "source_excerpt",
        "mentions": [
          "fac_heavenly_court"
        ]
      }
    ]
  },
