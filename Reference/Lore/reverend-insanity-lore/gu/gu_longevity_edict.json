    "claims": [
      {
        "text": "Reading the blood battle martial competition as a political compromise, Fang Yuan works out that Yao Huang was already reluctant when he received the edict and needed only an explanation to hand back to Longevity Heaven. Fang Yuan judges that Longevity Heaven is dreaming if it means to rely on the Longevity Edict alone to destroy the alliance between Chu Sect and Bai Zu tribe, and that only sending rank eight experts to kill Heavenly Lord Bai Zu would do it.",
        "chapters": [
          1207
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
