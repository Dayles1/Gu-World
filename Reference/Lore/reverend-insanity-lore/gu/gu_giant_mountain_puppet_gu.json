  "appearance": {
    "claims": [
      {
        "text": "The Gu centers on a copper mask that brightens from a glimmer into dazzling green light as essence pours in. Mountain rocks condense around that mask into a robust giant whose face is the enlarged copper mask, simple and unadorned. Horse chariots could run on its arms and it could hold an elephant on its fist. Standing in the blood lake, water reaches only about its waist.",
        "chapters": [
          185
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "appearance",
        "text_origin": "source_excerpt"
      },
      {
        "text": "It later forms into a copper mask that covers Tie Ruo Nan’s face.",
        "chapters": [
          202
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
