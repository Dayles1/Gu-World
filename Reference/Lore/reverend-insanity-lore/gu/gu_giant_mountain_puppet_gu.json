        "text_origin": "source_excerpt",
        "mentions": [
          "char_tie_ruo_nan"
        ]
      }
    ],
    "visual_confidence": "text_described"
  },
  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "The puppet descends into the blood lake, calls Fire Dragon Gu onto its right arm and Oil Dragon Gu onto its left, and fights Blood River Python with iron-hand support from Ironfist Grappling Gu. Its rock body has the softness of red soil, so the python’s constriction can shrink its waist.",
