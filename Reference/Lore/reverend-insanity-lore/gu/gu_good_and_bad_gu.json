  "history": {
    "claims": [
      {
        "text": "Two Gu worms grow on Carefree Wisdom Heart’s palms as Ren Zu’s group drifts on the River of Time’s floating ice. The Gu on her left palm is named Good, the one on her right Bad. Speaking together in a soft voice, good Gu and bad Gu tell Ren Zu’s group they can help humans distinguish which situation is good and which is bad.",
        "chapters": [
          2185
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_gu_worms",
          "char_carefree_wisdom_heart",
          "char_ren_zu",
          "loc_river_of_time"
        ]
      },
      {
        "text": "Guided by good Gu and bad Gu, Ren Zu’s group chooses only floating ice that carries a good situation, and standing on it leaves all three of them happy. As each piece of ice submerges its good situation turns bad, so the three keep leaping to the next, growing happier, then ecstatic, then euphoric, until the joy leaves them unable to move, they forget the situation they are in, and the ice sinks under them and drops all three into the river one after another.",
        "chapters": [
          2185
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt"
      }
    ]
