  "history": {
    "claims": [
      {
        "text": "In Immortal Crane Sect’s Shang Qing pavilion, the supreme first elder holds a thin letter that shines azure green. It is the transformation of the rank five Letter Sending Green Bird Gu, and destroying it would let Feng Jiu Ge sense the act.",
        "chapters": [
          406
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "fac_immortal_crane_sect",
          "loc_shang_qing_pavilion",
          "char_feng_jiu_ge"
        ]
      },
      {
        "text": "Fang Yuan takes the green bird from three letter Gu that reached the blessed land and transforms it into a letter from the rank seven Gu Immortal Feng Jiu Ge. The letter praises him, then asks for a battle between Fang Yuan and Feng Jin Huang.",
        "chapters": [
          418
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "challenge-letter-to-fang-yuan",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_fang_yuan",
          "sys_gu_immortal",
          "char_feng_jin_huang"
        ]
      },
      {
        "text": "Outside on Tian Ti mountain, He Feng Yang also sees a green bird enter a loophole and names it Letter Sending Green Bird Gu.",
        "chapters": [
          420
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "challenge-letter-to-fang-yuan",
        "text_origin": "source_excerpt",
        "mentions": [
          "loc_tian_ti",
          "char_he_feng_yang"
        ]
      },
      {
        "text": "Fang Yuan does not answer the challenge at once. He detains the rank five Letter Sending Green Bird Gu that Feng Jin Huang used for the challenge, treats it as created by Feng Jiu Ge, and later uses that same letter Gu to contact Spirit Affinity House.",
        "chapters": [
          658
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "held-reply-route",
        "text_origin": "source_excerpt",
        "mentions": [
          "fac_spirit_affinity_house"
        ]
      },
      {
        "text": "Feng Jiu Ge holds a rank five Letter Sending Green Bird Gu carrying Fang Yuan’s acceptance of the challenge.",
        "chapters": [
          696
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "acceptance-and-sect-message",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Immortal Crane Sect’s first elder flicks out a rank five Letter Sending Green Bird Gu as a message; He Feng Yang receives it and sends his consciousness into it to read.",
        "chapters": [
          697
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "acceptance-and-sect-message",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Fairy Bai Qing shows Feng Jin Huang a letter Gu from Feng Jiu Ge after he has crossed into Northern Plains. Feng Jin Huang names it the information path Immortal Gu Letter Sending Green Bird and cannot read it while still a mortal. Fairy Bai Qing then takes out another Letter Sending Green Bird Gu that is a rank five mortal Gu, carrying Fang Yuan’s earlier letter.",
        "chapters": [
          730
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "fathers-northern-plains-letter",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_fairy_bai_qing",
          "reg_northern_plains",
          "sys_immortal_gu",
          "sys_mortal_gu"
        ]
      }
    ]
