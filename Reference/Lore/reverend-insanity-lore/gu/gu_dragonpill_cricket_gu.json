  "appearance": {
    "claims": [
      {
        "text": "No cited chapter describes the Gu worm’s body. When Chi Cheng activates it against Gu Yue Fang Zheng, an orange red-coloured glow comes from both legs as he leaps clear.",
        "chapters": [
          83
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "form-and-rank",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_gu_worms",
          "char_fang_zheng"
        ]
      },
      {
        "text": "No cited chapter names its Rank in plain words. It appears among the academy second-Gu picks available to rank one students.",
        "chapters": [
          62
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
