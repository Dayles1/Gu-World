          13
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "wild-dragonpill-crickets",
        "text_origin": "source_excerpt",
        "mentions": [
          "loc_qing_mao_mountain"
        ]
      },
      {
        "text": "Fang Yuan later dashes through a group of them while chasing the Liquor worm.",
        "chapters": [
          14
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "wild-dragonpill-crickets",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_liquor_worm"
        ]
      },
      {
        "text": "No cited chapter states that Chi Cheng’s Gu is refined from those wild insects, or that the Gu worm’s body matches that wild form.",
