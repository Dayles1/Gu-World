  "economy": {
    "canonical_prices": [],
    "price_claims": [
      {
        "text": "Fang Yuan takes almost two hundred Bone Spear Gu from Bai Gu mountain, but after starvation and earlier trading only fifty-six remain when he prices them at Tong Ou shop for three hundred twenty primeval stones each, with spiral bone spear Gu and bone spike Gu bringing the package to forty thousand six hundred and twenty. That Tong Ou sale fails, and he keeps the Gu.",
        "chapters": [
          262
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "sale-in-shang-clan-city",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_bone_spike_gu"
        ]
      },
      {
        "text": "Shang Ya Zi later buys that same Gu package at the original Tong Ou total of forty thousand six hundred and twenty primeval stones, and the recipe set he receives uses Bone Spear Gu as a base for many further recipes.",
        "chapters": [
          268
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "sale-in-shang-clan-city",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_shang_ya_zi"
        ]
      }
    ],
    "game_proposals": []
  },
