  "history": {
    "claims": [
      {
        "text": "Fang Yuan and Bai Ning Bing find Bone Spear Gu in the milk-spring vat of the white bone inheritance on Bai Gu mountain, filling most of the vat beside a smaller number of rank two Spiral Bone Spear Gu.",
        "chapters": [
          222
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_fang_yuan",
          "char_bai_ning_bing",
          "loc_bai_gu_mountain",
          "gu_spiral_bone_spear_gu"
        ]
      },
      {
        "text": "Bai clan elders later recognize both kinds among the destroyed Gu when they enter the first hall.",
        "chapters": [
          223
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "fac_bai_clan_bai_gu_mountain"
        ]
      },
      {
        "text": "Fang Yuan refines over two hundred Bone Spear Gu into his aperture on the spot with the Spring Autumn Cicada’s aura, while Bai Ning Bing focuses first on a Spiral Bone Spear Gu. They destroy the leftover vat Gu rather than leave them for Bai clan.",
        "chapters": [
          222
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "fang-yuan-and-bai-ning-bing",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_spring_autumn_cicada"
        ]
      },
      {
        "text": "They still hold large numbers when they leave the inheritance.",
        "chapters": [
          228
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "fang-yuan-and-bai-ning-bing",
        "text_origin": "source_excerpt"
      },
      {
        "text": "At upper stage rank one, storing hundreds of Bone Spear Gu overloads his aperture during a snow silver primeval essence transfer, so he moves all the Bone Spear Gu into Bai Ning Bing’s aperture before accepting that essence.",
        "chapters": [
          230
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "fang-yuan-and-bai-ning-bing",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Those Bone Spear Gu and Spiral Bone Spear Gu still sit in Bai Ning Bing’s aperture at that time.",
        "chapters": [
          236
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "fang-yuan-and-bai-ning-bing",
        "text_origin": "source_excerpt"
      }
    ]
  },
