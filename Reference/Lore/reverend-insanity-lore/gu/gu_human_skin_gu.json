  "history": {
    "claims": [
      {
        "text": "Fang Yuan refines Human Skin Gu from Chang Shan Yin’s corpse using black ants, a flower, and a multi-colored blaze Gu, then uses it after peeling his own skin so he takes Chang Shan Yin’s appearance, including fingerprints, palm prints, chest hair, and even grey hair of age. Human skin is the main ingredient. The transformation is complete: not just skin, but hair, eye color, bone shape, and old injuries are replicated. Centuries later in the five region chaotic battle, Gu Masters develop the same Gu for identical-face disguise; Central Continent Gu Masters use it to penetrate enemy headquarters for assassination and mass destruction.",
        "chapters": [
          432
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_fang_yuan",
          "char_chang_shan_yin",
          "race_humans",
          "fac_gu_masters",
          "reg_central_continent"
        ]
      },
      {
        "text": "Fang Yuan disguised himself as Chang Shan Yin using the human skin Gu. This mortal Gu could deceive people like Hei Lou Lan, but it failed to deceive Giant Sun’s will.",
        "chapters": [
          613
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
