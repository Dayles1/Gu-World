    "organism_type": "unknown",
    "organism_type_basis": null,
    "claims": [
      {
        "text": "Water trace Gu at rank three raises speed enough to almost rival some rank four Gu, but leaves wet footprints that are easy to track. At rank four it can become wave trace Gu with a stronger effect. The series splits at rank five into wandering wave trace Gu, which has instant evasion, and river wave trace Gu, which lets a Gu Master run quickly on water. At rank six the series reaches worldly wave trace Gu.",
        "chapters": [
          428
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "series-and-rank",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_gu_master"
        ]
      }
    ]
  },
  "appearance": {
    "claims": [
      {
        "text": "It is like a jellyfish the size of a baby’s fist.",
        "chapters": [
          641
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "appearance",
        "text_origin": "source_excerpt"
      }
    ],
    "visual_confidence": "text_described"
  },
  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "It suits water path Gu Immortals and works better around rivers, lakes, or the sea, and Fang Yuan rates its ordinary travel speed above Rising Azure Cloud.",
        "chapters": [
          664
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "speed-and-combat-use",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_rising_azure_cloud"
        ]
      },
      {
        "text": "Fang Yuan uses it once to pull clear of dark arrows after light illusion bat wings fail him repeatedly.",
        "chapters": [
          677
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "speed-and-combat-use",
        "text_origin": "source_excerpt"
      }
    ]
  },
  "feeding": {
    "known": true,
    "food_raw": null,
    "foods": [],
    "claims": [
      {
        "text": "Worldly Wave Trace needs tens of thousands of underworld jellyfish and thousands of deepsea lightning eels. As a component of Water Pavilion, with Delight in Water and Mountain, it had been fed well inside Imperial Court blessed land for years before Fang Yuan held it. Fairy Li Shan once received only about a hundred deepsea lightning eels as ornamental stock from a Gu Immortal returning from eastern sea, and all of them died under poor care.",
        "chapters": [
          672
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "feed-requirements",
        "text_origin": "source_excerpt",
        "mentions": [
          "loc_imperial_court_blessed_land",
          "char_fairy_li_shan"
        ]
      },
      {
        "text": "Fang Yuan lists those jellyfish and eels among the specific foods for his Immortal Gu and calls them specialties of eastern sea, putting them on the list Tai Bai Yun Sheng carries toward Hai Shi blessed land.",
        "chapters": [
          673
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "feed-requirements",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_tai_bai_yun_sheng",
          "loc_hai_shi_blessed_land"
        ]
      }
    ]
  },
