    "activation_raw": null,
    "claims": [
      {
        "text": "After many experiments, Fang Yuan restates the design: borrow strength Gu as the core, the six flying zombie Gu as the foundation, and eighteen Gu as complements. Strictly speaking he classes the killer move as transformation path. It gathers zombie energy to turn a person into a flying zombie so the body becomes more than ten times as strong and can hold even greater strength. Three life force boosting Gu among the complements sustain that form for seven minutes before zombie energy devours lifeforce.",
        "chapters": [
          574
        ],
        "certainty": "canon",
        "confidence": "B",
