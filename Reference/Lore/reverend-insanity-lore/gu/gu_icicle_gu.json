    ],
    "factions": [],
    "origin": "unknown",
    "claims": [
      {
        "text": "In Shang Clan City Bai Ning Bing treats Icicle Gu as a long range option beside snowball Gu.",
        "chapters": [
          297
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "shang-clan-city-set",
        "text_origin": "source_excerpt",
        "mentions": [
          "loc_shang_clan_city",
          "gu_snowball_gu"
        ]
      },
      {
        "text": "Against Tie Dao Ku, Icicle Gu joins snowballs in a torrent that breaks a charge.",
        "chapters": [
          298
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "shang-clan-city-set",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_tie_dao_ku"
        ]
      },
      {
        "text": "He then keeps Icicle Gu and drops snowball Gu. The choice rests on rank two restriction plus an Ice Explosion Gu combo, against snowball Gu’s heavier primeval spend.",
        "chapters": [
          299
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "shang-clan-city-set",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Against Yan Tu, Bai Ning Bing opens with rank two Icicle Gu while the crowd and Wei Yang track the rising essence cost of heavier icicle fire, and Bai Ning Bing later detonates icicles with Ice Explosion Gu to extinguish a fiery claw.",
        "chapters": [
          312
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "shang-clan-city-set",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_wei_yang"
        ]
      }
    ]
  },
