    "claims": [
      {
        "text": "Su Bai Man once held rank six Time Anchor Immortal Gu; it can anchor onto a certain period in time. After she died, Shadow Sect acquired it, and it was destroyed in the Battle of Yi Tian Mountain. Fang Yuan’s hairy man Gu Immortals refine rank six Time Anchor Immortal Gu. It can coordinate with Spring Autumn Cicada into a killer move that returns Fang Yuan to a specific marked time. Because fate Gu is injured and not destroyed, it can restrict the effectiveness of merging Time Anchor into spring autumn success; only fate Gu’s complete destruction would let that merge work fully.",
        "chapters": [
          1810
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "destruction-and-re-refinement",
        "text_origin": "source_excerpt",
