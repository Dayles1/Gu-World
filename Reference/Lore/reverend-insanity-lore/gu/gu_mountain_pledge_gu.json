  "appearance": {
    "claims": [
      {
        "text": "This Immortal Gu resembles a beetle. It is thick and solid, even bigger than an adult’s palm. Its body is ash gray with a stony texture, a pair of large pincers grow on its head, its back is rugged like mountains rather than glossy, and there are moss-like stripes on the joints of its legs.",
        "chapters": [
          660
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "appearance",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Mountain pledge Gu is grouped with Sea Oath Gu as Immortal Gu famous in ancient times. Sea oath Gu is rank six in that same pairing.",
        "chapters": [
          384
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "form-and-rank",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_sea_oath_gu",
          "sys_immortal_gu"
        ]
      }
    ],
    "visual_confidence": "text_described"
  },
  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "Mountain pledge and sea oath work like Poison Vow Gu, but Poison Vow Gu is an expenditure Gu while these two can be used repeatedly. The obvious weakness is that the oath must face a large mountain, and destroying that mountain ends the oath’s effect.",
        "chapters": [
          384
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
