  "history": {
    "claims": [
      {
        "text": "On San Cha Mountain, Fang Yuan and Chou Jiu discuss oaths: even a completed sea oath is not unbreakable, and mountain pledge Gu shares that weakness against sea or mountain.",
        "chapters": [
          384
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "loc_san_cha_mountain",
          "char_fang_yuan",
          "char_chou_jiu"
        ]
      },
      {
        "text": "It is a rank six information path Immortal Gu as famous as sea oath Gu: choose a mountain to pledge to, and while that mountain exists the oath cannot be violated. Fang Yuan chooses Snowy Mountain for the alliance oath with Hei Lou Lan on the Gu that Fairy Li Shan calls out.",
        "chapters": [
          660
        ],
