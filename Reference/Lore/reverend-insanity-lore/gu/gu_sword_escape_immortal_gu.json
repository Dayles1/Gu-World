    "claims": [
      {
        "text": "After Yi Tian Mountain, the sword path Immortal Gu are refined under the light of wisdom and become Fang Yuan’s. He holds this Gu in his left hand and Flying Sword Gu in his right: this one is named a movement Immortal Gu whose speed is not inferior to rank seven Qi Escape Immortal Gu, and both show rank seven aura.",
        "chapters": [
          1033
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "yi-tian-mountain-refinement",
        "text_origin": "source_excerpt",
        "mentions": [
          "loc_yi_tian_mountain",
          "gu_flying_sword_gu"
        ]
      }
    ]
