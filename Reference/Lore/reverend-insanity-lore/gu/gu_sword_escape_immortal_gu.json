  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "When he activates it, he flies forward like a sword. In linear speed it can compare with similarly ranked qi escape Gu. Against Chu Du he stops this Gu in mid flight, activates blood torrent in the gap while inertia carries him, and turns with it.",
        "chapters": [
          1062
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "activation-and-flight",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Sword Escape Immortal Gu at rank seven alone surpasses a rank six blood path killer move in that stretch, though using it on green grape immortal essence is costly for his cultivation level then. In that stretch he again flies as if turned into a flying sword.",
        "chapters": [
          1086
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "power-and-essence-cost",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Against the eagle hound group at Tai Qiu, he uses this Gu and within an instant crosses from the battlefield’s edge to its center.",
        "chapters": [
          1136
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "crossing-a-battlefield",
        "text_origin": "source_excerpt",
        "mentions": [
          "loc_tai_qiu"
        ]
      }
    ]
  },
