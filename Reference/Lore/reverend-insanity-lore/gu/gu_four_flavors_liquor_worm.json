  "appearance": {
    "claims": [
      {
        "text": "Compared with the Liquor worm, there is not much change in its external form, except that it is slightly bigger. It also resembles a silkworm and has a tiny pair of shiny black eyes. The Liquor worm’s body is completely white, but this worm’s body continuously flickers with four colors: red for spicy, blue for bitter, green for sour, and yellow for sweet.",
        "chapters": [
          121
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "appearance",
        "text_origin": "source_excerpt"
      },
      {
        "text": "It still looks like a silkworm and keeps a tiny pair of shiny black eyes, only slightly larger than a Liquor worm. Four colors flicker on its body: red for spicy, blue for bitter, green for sour, and yellow for sweet.",
        "chapters": [
          121
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "form-and-rank",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Chapters 202 and 326 name it a rank two Four Flavors Liquor worm on the liquor-worm ladder.",
        "chapters": [
          202
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "form-and-rank",
        "text_origin": "source_excerpt"
      }
    ],
    "visual_confidence": "text_described"
  },
  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "After Fang Yuan advances to rank two upper stage, his crimson primeval essence passes through the worm and, with primeval stone replenishment, becomes rank two peak stage dark red primeval essence.",
        "chapters": [
          145
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Chapter 121 already notes that the newly refined worm can refine rank two primeval essence by a small realm; chapter 326 states the same step as purifying red steel primeval essence by a small realm.",
        "chapters": [
          121
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt"
      }
    ]
  },
