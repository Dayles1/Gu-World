  "history": {
    "claims": [
      {
        "text": "Fang Yuan plans this fusion from prior-life memory while still on Qing Mao Mountain: two Liquor worms plus wines of sour, sweet, bitter, and spicy flavors.",
        "chapters": [
          105
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_fang_yuan",
          "loc_qing_mao_mountain",
          "gu_liquor_worm"
        ]
      },
      {
        "text": "He completes the fusion in a secret room, using redberry wine, golden honey wine, bitter shell wine, and white grains liquid, and obtains the worm on the first try.",
        "chapters": [
          121
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Once Fang Yuan is rank two with red steel primeval essence, he can use the worm again, but Bai Ning Bing’s snow silver primeval essence is better for refining his aperture, so the worm loses its use while she is available.",
        "chapters": [
          239
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "with-bai-ning-bing",
