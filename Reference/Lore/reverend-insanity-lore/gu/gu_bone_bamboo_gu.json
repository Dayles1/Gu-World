  "history": {
    "claims": [
      {
        "text": "Fang Yuan looks for Bone Bamboo Gu after the white bone wheel in his aperture is near destruction.",
        "chapters": [
          431
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_fang_yuan"
        ]
      },
      {
        "text": "The worm is shaped like finger-bone bamboo, pale white, and looks like a white candle. Fang Yuan keeps Ghost Fire Gu under his tongue, breathes out eerie blue ghost fire onto a Bone Bamboo Gu, and the bamboo melts into white bone smoke that the battle bone wheel draws into its cracks as it recovers. One Gu lasts about five minutes under that burn before it is used up. Man tribe later sends Fang Yuan a gift box of a hundred Bone Bamboo Gu.",
        "chapters": [
          445
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "form-and-repair-burn",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_ghost_fire_gu"
        ]
      },
      {
        "text": "He spends the full hundred repairing the battle bone wheel’s worst wounds, and after that stretch the Gu are used up.",
        "chapters": [
          449
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "gift-spent",
        "text_origin": "source_excerpt"
      }
    ]
  },
