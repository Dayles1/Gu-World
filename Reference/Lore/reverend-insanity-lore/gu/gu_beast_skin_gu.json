  "history": {
    "claims": [
      {
        "text": "In the Gu Yue academy Gu storage room, after Iron Skin Gu, Fang Yuan sees Beast Skin Gu. Jade Skin Gu and Beast Skin Gu belong to the same series as Bronze Skin Gu and the other skin Gu: similar appearance and similar defense effects, but with large value gaps between members.",
        "chapters": [
          62
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "fac_gu_yue_clan",
          "char_fang_yuan",
          "gu_jade_skin_gu",
          "gu_bronze_skin_gu"
        ]
      },
      {
        "text": "Beast Skin Gu is the most common Gu in that series, even cheaper than Rock Skin Gu, but it has more evolutionary lines and can fuse with more varieties of Gu. Jade Skin Gu is the rarest of the series. The academy storage room holds only rank one Gu, and the skin Gu Fang Yuan inspects there sit in that stock.",
        "chapters": [
          62
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
