  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "In the San Cha Mountain standoff after the dragon blast, Tie Mu Bai wears it while Wu Gui stands on a dark cloud and Ku Mo relies on bone armor and bone wings; the three then attack together in a clash ordinary eyes cannot track.",
        "chapters": [
          373
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt"
      },
      {
        "text": "After killing Tie Mu Bai, Fang Yuan excavates Golden Coat Gu with the other rank four Gu on that corpse, all of them high quality metal path worms.",
        "chapters": [
          379
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "fang-yuans-use",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_fang_yuan"
        ]
      },
      {
        "text": "Facing Ha Tu Gu’s Battle Bone Wheel, he activates Golden Coat Gu and takes a hit that sends him flying.",
        "chapters": [
          430
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "fang-yuans-use",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_ha_tu_gu",
          "gu_battle_bone_wheel_gu"
        ]
      },
      {
        "text": "He later places that rank four Golden Coat Gu into a moving perspective cup Gu with Charging Crash Gu and Bone Wings Gu, sending them into Hu Immortal blessed land for Little Hu Immortal to keep.",
        "chapters": [
          434
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "fang-yuans-use",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_moving_perspective_cup_gu",
          "gu_charging_crash_gu",
          "gu_bone_wings_gu",
          "loc_hu_immortal_blessed_land",
          "char_little_hu_immortal"
        ]
      },
      {
        "text": "Pei Yan Fei activates rank four Golden Coat Gu so his body shines with golden light that dims into armor, then combines it with Swallow Wings Gu and Rainbow Transformation Gu into the killer move Golden Rainbow Strike.",
        "chapters": [
          482
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "other-users",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_pei_yan_fei",
          "gu_swallow_wings_gu",
          "gu_rainbow_transformation_gu",
          "move_golden_rainbow_strike"
        ]
      },
      {
        "text": "He uses the same three Gu set again against Hao Ji Liu and later against the flying bear phantom.",
        "chapters": [
          525
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "other-users",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_hao_ji_liu"
        ]
      }
    ]
  },
