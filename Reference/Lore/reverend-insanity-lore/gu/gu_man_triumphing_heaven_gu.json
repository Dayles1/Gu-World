  "history": {
    "claims": [
      {
        "text": "At Living Treasure Door, Shang Yan Fei asks to exchange for a rank five man triumphing heaven Gu still held in the treasure realm.",
        "chapters": [
          274
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "fac_living_treasure_door",
          "char_shang_yan_fei"
        ]
      },
      {
        "text": "Shang Yan Fei gives up blood handprint Gu for the trade, then refines man triumphing heaven Gu with purple crystal primeval essence as soon as it leaves the door. He keeps it in order to awaken Shang Xin Ci’s aperture, then raise her aptitude with other Gu and support her cultivation.",
        "chapters": [
          274
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
