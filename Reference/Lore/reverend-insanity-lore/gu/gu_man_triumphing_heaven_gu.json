  "appearance": {
    "claims": [
      {
        "text": "This Gu was like a thousand year ginseng, with many roots and a yellow body. Its lustre was dim, the upper part resembled a body, and the lower part diverged like a pair of legs.",
        "chapters": [
          274
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "appearance",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Shang Yan Fei names it a rank five Gu when he asks for the exchange. The copy Living Treasure Door returns looks like a thousand year ginseng: many roots, a yellow body with dim lustre, an upper part like a body, and a lower part that splits like a pair of legs. Once out of the treasure realm, the Gu regains its wild nature in three breaths if it is not refined at once.",
        "chapters": [
          274
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "form-and-rank",
        "text_origin": "source_excerpt"
      }
    ],
    "visual_confidence": "text_described"
  },
  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "Living Treasure Door states that man triumphing heaven Gu can defy heaven and change fate by forcefully awakening an aperture for mortals who have no cultivating talent, and calls the Gu extremely precious. The treasure realm will only trade it for a Gu of even greater value to the realm.",
        "chapters": [
          274
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt"
      }
    ]
