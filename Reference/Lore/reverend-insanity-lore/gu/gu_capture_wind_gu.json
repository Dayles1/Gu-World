  "history": {
    "claims": [
      {
        "text": "Inside treasure yellow heaven, Fang Yuan’s will opens his eyes and announces that this rank seven movement Immortal Gu, capture wind Gu, has been refined as per the request of Southern Border’s Wu Yong, and that they will make the transaction now.",
        "chapters": [
          2222
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_fang_yuan",
          "sys_immortal_gu",
          "reg_southern_border",
          "char_wu_yong"
        ]
      },
      {
        "text": "Under every watching Gu Immortal’s gaze, Wu Yong’s will approaches Fang Yuan’s will. Fang Yuan’s will tosses the rank seven Capture Wind Gu to Wu Yong’s will. Wu Yong’s will nods without speaking and leaves treasure yellow heaven with the new Immortal Gu. Shi Zhong, watching, is shocked that someone made a transaction with Fang Yuan, and that it is Southern Border’s Wu Yong.",
        "chapters": [
          2222
        ],
