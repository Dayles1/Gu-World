  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "When advancing to Gu Immortal, heaven, earth, and human qi must stay in balance. Human qi, which Mo Yao also calls man qi, is the sum of the Gu Master’s own accumulation. Man qi Gu takes in the man qi of other people, purifies it, and adds it to oneself at advancement, raising the chance of breakthrough and deepening a new Immortal’s foundation and potential.",
        "chapters": [
          600
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_gu_immortal",
          "sys_gu_master"
        ]
      },
      {
        "text": "A mortal will sent near that true inheritance can be refined into a negligible amount of man qi before it arrives. Fang Yuan cannot endure the Gu’s might while still mortal, and he leaves the inheritance rather than claim it.",
        "chapters": [
          600
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
