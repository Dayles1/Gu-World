  "history": {
    "claims": [
      {
        "text": "Fang Yuan declares himself Great Love Immortal Venerable and places a list in treasure yellow heaven offering to refine Gu for anyone who pays, including mortal Gu without quantity limit and even rank eight Immortal Gu. He says refining Immortal Gu for friend and foe alike will prove the great love in his heart.",
        "chapters": [
          2219
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_fang_yuan",
          "sys_mortal_gu",
          "sys_immortal_gu"
        ]
      },
      {
        "text": "Giant Sun Immortal Venerable knows Fang Yuan’s Great Love Gu refinement plan cannot be stopped. It is an open scheme everyone can see, and Gu Immortals’ desires cannot be suppressed. Killing Northern Plains lone immortals who transact with Fang Yuan would only drive them toward Eastern Sea and strengthen the Heaven and Earth Great Love Alliance, so Giant Sun Immortal Venerable refuses that trap. Star Constellation Immortal Venerable likewise treats the declaration that Fang Yuan will refine Gu for enemies and allies alike as something Heavenly Court cannot stop and should use for benefit, sending He Feng Yang to transact for a new Immortal Gu.",
        "chapters": [
          2225
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "open-scheme",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_gu_immortal",
          "reg_northern_plains",
          "reg_eastern_sea",
          "fac_heaven_and_earth_great_love_alliance",
          "fac_heavenly_court",
          "char_he_feng_yang"
        ]
      },
      {
        "text": "Facing insufficient immortal essence, Fang Yuan lists expanding his Great Love Gu refinement plan and adding more resource points to the sovereign immortal aperture as one path to raise the aperture origin core and produce more immortal essence, rather than accelerating aperture time.",
        "chapters": [
          2227
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "immortal-essence-need",
        "text_origin": "source_excerpt"
      }
    ]
  },
