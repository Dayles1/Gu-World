    "related_variants": [],
    "claims": [
      {
        "text": "During ascension he sends man as before, his vital Gu, into the tri-colored primordial qi, then pours a theoretical Immortal Gu recipe into the qi cocoon around it.",
        "chapters": [
          609
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "refinement",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_vital_gu",
          "sys_gu_recipe"
        ]
      },
      {
        "text": "The cocoon breaks into a colorful butterfly trailing rainbow light, and he names the result Immortal Gu Man as Before.",
        "chapters": [
          611
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "refinement",
        "text_origin": "source_excerpt"
      }
    ]
  },
