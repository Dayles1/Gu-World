    "claims": [
      {
        "text": "Divine Sense Gu and connecting heaven Gu are both rank five and demand a huge amount of primeval essence. Even a rank five peak stage Gu Master might last only several breaths, so Gu Immortals or land spirits usually spend immortal essence to use them.",
        "chapters": [
          465
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "rank-and-cost",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_gu_master",
          "sys_gu_immortal"
        ]
      },
      {
        "text": "Thought, will, and emotion share one branch, and Gu Masters use thoughts to create related Gu. The text lists Divine Sense Gu with star thought Gu and space thought Gu as Gu Immortals’ commonly used example in that set.",
        "chapters": [
          570
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
