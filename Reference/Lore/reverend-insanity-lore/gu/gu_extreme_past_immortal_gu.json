    "activation_raw": null,
    "claims": [
      {
        "text": "Looking Back Immortal Gu and Vivid Recollection Immortal Gu both let a Gu Immortal stand in the present and observe the past, with different scopes. Looking Back used near old earth wood shows the former glorious scenery of that place. Vivid Recollection lets the user inspect their own past. With Extreme Past, the Gu Immortal’s will can be drawn out and observe all that has happened in the past through the river of time.",
        "chapters": [
          746
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_looking_back_immortal_gu",
          "gu_vivid_recollection_immortal_gu",
          "sys_gu_immortal"
        ]
      },
      {
        "text": "Fang Yuan frames a deduction that starts from having Extreme Past: pair that time path investigative Immortal Gu with time anchor Immortal Gu into a killer move that marks the past from the present, then use Man as Before Immortal Gu to restore a living human body without losing wisdom Gu. He also notes Extreme Past is only an example, and that other time path Immortal Gu might fit Time Anchor better.",
        "chapters": [
          746
        ],
        "certainty": "canon",
