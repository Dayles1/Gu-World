  "history": {
    "claims": [
      {
        "text": "Man Duo tells Shi Wu that spring egg Gu is a rank five Gu with extremely high demand on primeval essence, and that even a rank five middle stage Gu Master cannot activate it at one try. Elder Shi Wu has rank three cultivation, so he would need to use lasting Gu and continuing Gu to activate it, and that way the quickest planting of the spirit spring would take close to a month.",
        "chapters": [
          554
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
