  "appearance": {
    "claims": [
      {
        "text": "Longhorn Beetle Gu as a group have long, circular cylinder figures with many outlines on the back, much of the body black with metallic luster, a pair of feelers longer than the body, a strong chin, and a screech like timber being sawed. The Brute Force Longhorn Beetle Gu has an entire body of red metallic colour and a pair of antennae coarser than the usual Longhorn Beetle ones, with bamboo joint-like growths at small intervals along the top of the antennae.",
        "chapters": [
          62
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "appearance",
        "text_origin": "source_excerpt"
      }
    ],
    "visual_confidence": "text_described"
  },
  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "It grants temporary super strength with the reputation of one bull’s strength, lasting five breaths. Every activation consumes a large share of primeval essence: rank one middle stage needs 10%, and if converted to initial stage that is 20%. Heavy use on a weak constitution can injure muscles or tear them; only Gu Masters with a strong body choose it, and Fang Yuan judges his small frame unsuitable.",
        "chapters": [
          62
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "fac_gu_masters"
        ]
      }
    ]
  },
