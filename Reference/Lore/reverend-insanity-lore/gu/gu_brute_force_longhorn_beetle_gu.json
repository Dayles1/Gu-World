  "economy": {
    "canonical_prices": [],
    "price_claims": [
      {
        "text": "The Gu is highly sought after in the market, and earlier caravans to Gu Yue village sold large numbers of it. Flower Boar Gu spends the same primeval essence for one boar’s strength over ten breaths, twice as long, at half the market price of Brute Force Longhorn Beetle Gu.",
        "chapters": [
          62
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "loc_gu_yue_village",
          "gu_flower_boar_gu"
        ],
        "needs_review": true
      },
      {
        "text": "Chi Shan asks the clan leader for a Brute Force Longhorn Beetle Gu so one bull’s strength plus his inborn strength could push River Swallowing Toad awake; the elders forbid Gu-aided pushing for that attempt.",
        "chapters": [
          118
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
