  "history": {
    "claims": [
      {
        "text": "A caravan trader on Qing Mao Mountain names Brute Force Longhorn Beetle Gu while pitching stock, saying a Gu Master who uses it can burst out with the strength of a cow.",
        "chapters": [
          39
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "loc_qing_mao_mountain",
          "sys_gu_master"
        ]
      },
      {
        "text": "Fang Yuan later inspects one in the academy Gu storage room among the rank one Longhorn Beetle Gu wall and walks past it as unsuitable for his body.",
        "chapters": [
          62
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_fang_yuan"
        ]
      },
      {
        "text": "Fang Yuan contrasts its brief, costly burst and strong after-effects with Black and White Boar Gu, which raise strength permanently in small steps that remain after the Gu dies.",
        "chapters": [
          62
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "comparison-and-demand",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_black_and_white_boar_gu"
        ]
      },
      {
        "text": "Fang Zheng later treats Flower Boar Gu or Brute Force Longhorn Beetle Gu as the kind of strength raiser needed to break a jade barrier by force, still needing a defensive Gu as well.",
        "chapters": [
          85
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "comparison-and-demand",
        "text_origin": "source_excerpt",
