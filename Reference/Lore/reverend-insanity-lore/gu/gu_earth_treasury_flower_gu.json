  "appearance": {
    "claims": [
      {
        "text": "It is like the combination of a lotus and kale. Petals knit tightly in numerous thick pieces that feel slippery. Peeled one by one they are like thick layers of silk, then thinner paper-like layers toward the core. Buried, the bud shows a faint dark gold light, sits about two inches deep, and is around the size of a stone mill, delicate and mysterious in dark gold. The last overlapping petals form a fist-sized translucent ball holding golden liquid with a Gu worm asleep inside.",
        "chapters": [
          63
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "appearance",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_gu_worms"
        ]
      }
    ],
    "visual_confidence": "text_described"
  },
  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "It is a one-time use Gu. Once implanted in the ground it cannot be moved. Its food is earth energy, so planted ground with enough earth energy keeps it alive. Its one use is to contain a Gu in the flower heart, immersing it in golden nectar that partly imitates sealing and lets the Gu hibernate. Fang Yuan peels the last petals, lets golden liquid run like soybean oil, and retrieves White Boar Gu from the first flower.",
        "chapters": [
          63
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "storage-effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_white_boar_gu"
        ]
      },
      {
        "text": "He later fills in the hole left from digging it out.",
        "chapters": [
          71
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "storage-effect",
        "text_origin": "source_excerpt"
      }
    ]
  },
