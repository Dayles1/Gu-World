  "history": {
    "claims": [
      {
        "text": "During the invasion of Lang Ya blessed land, Xue Song Zi carries ice heart Immortal Gu in his immortal aperture. The Gu is about the size of an average horse, shaped like a heart, an icy statue that gives off frost energy.",
        "chapters": [
          874
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "loc_lang_ya_blessed_land",
          "char_xue_song_zi"
        ]
      },
      {
        "text": "Ying Wu Xie later says Shadow Sect Gu Immortals secretly set a Gu formation on Jade Pot Mountain and turned it into a Gu breeding ground. In the past that place had nurtured ice heart Gu, but those Gu had been taken away by the time of that visit. He adds that one ice heart Immortal Gu is still there and has now fully formed, and asks Bai Ning Bing to retrieve the wild Immortal Gu; the Gu she draws in is named rank six ice soul Immortal Gu.",
        "chapters": [
          1186
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "jade-pot-mountain-breeding",
        "text_origin": "source_excerpt",
