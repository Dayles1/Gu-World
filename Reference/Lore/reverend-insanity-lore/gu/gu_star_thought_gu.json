  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "Empowered by his Seven Star Light killer move, he activates Star Thought Gu and raises tens of thousands of star thoughts into a star cloud that he hurls at Hei Lou Lan. Star thoughts move very fast, strike the enemy’s mind from any direction, and are hard to guard against; weak willpower can leave victims idiotic, and most struck Gu Masters feel dizzy and lose footing. Hei Lou Lan judges that creating so many without limit costs at least two years of Dong Fang Yu Liang’s lifespan.",
        "chapters": [
          513
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "battlefield-use",
        "text_origin": "source_excerpt",
        "mentions": [
          "move_seven_star_light",
          "char_hei_lou_lan",
          "fac_gu_masters"
        ]
      },
      {
        "text": "Black banner elite troop answers with battle thought Gu, grouped with Star Thought Gu and empty thought Gu as wisdom path Gu. Those battle thoughts surge battle intent and help the elite troop resist the star thought cloud’s impact.",
        "chapters": [
          514
        ],
        "certainty": "canon",
        "confidence": "B",
