  "history": {
    "claims": [
      {
        "text": "Dong Fang Yu Liang injects rank five primeval essence into Star Thought Gu when he must rework plans against Wolf King Chang Shan Yin. Under its effect a question becomes a thought that gives off blue starlight, leaves his brain, and flies above his head instead of staying formless in mind.",
        "chapters": [
          505
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_dong_fang_yu_liang",
          "char_chang_shan_yin"
        ]
      },
      {
        "text": "He raises thousands of star thoughts at once, then steers them to collide, fuse, or split while his primeval sea falls. After hours of work the swarm shrinks to a few fist-sized thoughts that carry complicated answers, and reading them yields clear methods with ordered steps. Wisdom path deductions of this scale also spend soul energy; heavier work risks soul damage or death, so he follows with other Gu to recover.",
        "chapters": [
          505
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "deduction",
        "text_origin": "source_excerpt"
      }
    ]
  },
