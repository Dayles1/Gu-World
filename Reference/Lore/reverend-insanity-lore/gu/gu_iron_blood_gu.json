  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "Activation transforms the user’s blood: it darkens, grows denser, and slows, and the user’s skin darkens with it. Pain becomes intense pleasure, which helps a Gu Master adapt to battles and can turn even a weak Gu Master into a warrior addicted to battle.",
        "chapters": [
          669
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_gu_master"
        ]
      },
      {
        "text": "While it is held active, blood blade Gu can fire pitch black iron-blood blades from bursting skin, and molten-iron-like blood then flows from the wounds.",
        "chapters": [
          669
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_blood_blade_gu"
        ]
      },
      {
        "text": "He Feng Yang added Iron Blood Gu to Fang Zheng’s drills after an earlier attempt failed at blood merge Gu. On the next try the pleasure was too strong, blood flowed out freely until Fang Zheng fainted, and he lasted three breaths of time.",
        "chapters": [
          669
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "limits-in-training",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_blood_merge_gu"
        ]
      },
      {
        "text": "Failed blood demon flower Gu later produces pain so severe that Iron Blood Gu’s effect cannot resist it, and Lord Sky Crane then orders Cold Blood Gu.",
        "chapters": [
          669
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "limits-in-training",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_blood_demon_flower_gu",
          "gu_cold_blood_gu"
        ]
      },
      {
        "text": "Fang Zheng again opens with Iron Blood Gu in the blood pool, darkening blood and skin, then keeps it active while blood blade Gu fires iron-blood blades. When failed blood demon flower Gu blooms, the pain again outruns Iron Blood Gu’s effect.",
        "chapters": [
          698
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "hu-immortal-attack-drills",
        "text_origin": "source_excerpt"
      }
    ]
  },
