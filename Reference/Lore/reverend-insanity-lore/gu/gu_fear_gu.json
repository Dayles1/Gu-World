    "activation_raw": null,
    "claims": [
      {
        "text": "Fear Gu flies into Ren Zu’s heart and tortures him with fear of wind, sunlight, tree leaves, snakes, rain, and finally death, so he cannot keep walking toward the Door of Life and Death. Self Gu says death itself is not the scary part, and Fear Gu answers that the only thing worth being afraid of is fear.",
        "chapters": [
          944
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
