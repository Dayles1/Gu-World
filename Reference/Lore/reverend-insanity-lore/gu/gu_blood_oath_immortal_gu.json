  "history": {
    "claims": [
      {
        "text": "After Fang Yuan flies out of the blue water regional wall into Eastern Sea, a rank six blood path Gu Immortal fleeing Liu Qing Yu and other Eastern Sea Gu Immortals offers him a share of a peerless fortuitous encounter in the turbulent flow sea area if Fang Yuan helps him, and says he is willing to use blood oath Immortal Gu to form that pact.",
        "chapters": [
          1045
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_fang_yuan",
          "reg_eastern_sea",
          "path_blood",
          "sys_gu_immortal",
          "char_liu_qing_yu"
        ]
      },
      {
        "text": "Fang Yuan later lists blood trace Gu and blood oath Gu together and states that one was used for investigation and the other could achieve an information path effect. He holds blood oath Gu among his other blood path Immortal Gu. He did not take the Immortal Gu recipes from Ding Yan and Ding Qi; he knew those two Immortal Gu were destroyed, then used natural inspiration and his own deductions to refine them.",
        "chapters": [
          2252
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "fang-yuans-copy",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_gu_recipe"
        ]
      }
    ]
