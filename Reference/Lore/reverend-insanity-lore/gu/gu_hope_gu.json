  "appearance": {
    "claims": [
      {
        "text": "Every spot of light is one Hope Gu: little lights and dots of light that rise from the flower sea, envelop a body, and enter it. In the Ren Zu legend it is frail, only a tiny ball of light, and gives out a dim white light that is not beautiful beside Wisdom Gu.",
        "chapters": [
          5
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "appearance",
        "text_origin": "source_excerpt"
      },
      {
        "text": "When Fang Zheng walks the ceremony path, his body is bathed in Hope Gu’s pure white light.",
        "chapters": [
          181
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "appearance",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_fang_zheng"
        ]
      }
    ],
    "visual_confidence": "text_described"
  },
