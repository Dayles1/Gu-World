  "history": {
    "claims": [
      {
        "text": "Hei Lou Lan perceives a strength path Immortal Gu as soon as it is assimilated into the sixty-eighth floor of Eighty-Eight True Yang Building. It is called flying bear strength Gu.",
        "chapters": [
          593
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_hei_lou_lan",
          "path_strength",
          "sys_immortal_gu",
          "house_eighty_eight_true_yang_building"
        ]
      },
      {
        "text": "The flying bear is a desolate beast whose battle strength can match Gu Immortals. Eighty-Eight True Yang Building absorbs and refines this Gu to form the hundredth round of that sixty-eighth floor.",
        "chapters": [
          593
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_gu_immortal"
        ]
      },
      {
        "text": "Tai Bai Yun Sheng reports that Hei Lou Lan’s immortal aperture was created using the flying bear strength Immortal Gu, that Giant Sun’s will gave her that strength path Immortal Gu, and that flying bear strength Gu is then her vital Gu.",
        "chapters": [
          693
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "aperture-and-vital-gu",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_tai_bai_yun_sheng",
          "sys_blessed_lands_and_grotto_heavens",
          "sys_vital_gu"
        ]
      },
      {
        "text": "Fang Yuan obtains Hei Lou Lan’s flying bear strength Immortal Gu among a large batch of Immortal Gu in a transaction.",
        "chapters": [
          1079
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "fang-yuans-acquisition",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_fang_yuan"
        ]
      },
      {
        "text": "A later review again lists Hei Lou Lan’s flying bear strength Immortal Gu among the Gu that became Fang Yuan’s possessions.",
        "chapters": [
          2017
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "fang-yuans-acquisition",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Fang Yuan adds flying bear strength Gu into his flying bear transformation killer move and gains the strength of an actual flying bear.",
        "chapters": [
          1177
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "transformation-strength",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_killer_moves"
        ]
      }
    ]
