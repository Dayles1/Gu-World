    "related_variants": [],
    "claims": [
      {
        "text": "Across ranks one through five, producing malicious thoughts stays similar; the differences are how many thoughts one activation yields and how much primeval essence it costs. To feed the light of wisdom he plans for at least two thousand rank five specimens activated together. The original rank five recipe had to climb step by step from rank one upward. With the light of wisdom he shortens that into a two-step recipe: a half-finished Gu, then completion.",
        "chapters": [
          736
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "rank-and-refinement",
        "text_origin": "source_excerpt"
      }
    ]
  },
