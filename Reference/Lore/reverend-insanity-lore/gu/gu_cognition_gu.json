    "activation_raw": null,
    "claims": [
      {
        "text": "Cognition Gu says cognition is the wings of freedom, and that the wings a person gains depend on that person’s own thoughts. It turns into a warm light and shines on Verdant Great Sun, and a pair of white feathered wings appears on his back. Cognition Gu names those wings “self”, says everyone has a self-cognition, and warns him not to bask too long in sunlight or that sense of self will expand or shrink. It adds that the higher he flies, the harder he falls.",
        "chapters": [
          371
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt"
      }
    ]
  },
