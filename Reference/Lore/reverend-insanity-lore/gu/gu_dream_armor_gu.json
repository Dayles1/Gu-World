  "history": {
    "claims": [
      {
        "text": "Fang Yuan holds a dream path Immortal Gu. At that time he already has rank eight Dream Token as the core of Dragon Palace, and he finds Dream Armor even more important than Dreaming and Dream Token because it is defensive. With it, he has the capability of resisting dream path tribulations, so the Pure Dream Reality Seeker clone can undergo immortal ascension. He wants a dream path defensive killer move that uses dream armor Immortal Gu as the core.",
        "chapters": [
          2088
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_fang_yuan",
          "sys_immortal_gu",
          "gu_dream_token",
          "house_dragon_palace",
          "gu_dreaming_gu",
          "sys_pure_dream_reality_seeker_physique"
        ]
      },
      {
        "text": "Dream armor Immortal Gu had been given to the pure dream clone long ago. During that clone’s immortal ascension, the clone is defended by dream armor Immortal Gu. The clone does not have the sovereign immortal body and cannot use Fang Yuan’s compound killer moves, and must stabilize the three qi, so the clone activates dream armor Immortal Gu directly. Even though the Gu is rank seven, the clone has immortal essence the main body gave him. Fang Yuan only did the tribulation after getting dream armor Immortal Gu. During the tribulation, Dream Armor is with the clone. The main body only has rank seven Dreaming and rank eight Dream Token.",
        "chapters": [
          2090
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "clone-tribulation",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Meng Qiu Zhen has dream armor Immortal Gu’s protection, and also dream creation Immortal Gu and dream butterfly Immortal Gu. Dream butterfly Immortal Gu, though an investigative Gu worm, surpasses Dream Armor and Dream Creation for exploring dream realms.",
        "chapters": [
          2095
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "dream-realm-exploration",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_meng_qiu_zhen",
          "gu_dream_creation_gu",
          "gu_dream_butterfly_gu",
          "sys_investigative_gu"
        ]
      },
      {
        "text": "Fang Yuan cannot use Shocking Departure of Year Dream Wave and Dang Hun Sound because the rank seven Dream Armor was given to Meng Qiu Zhen.",
        "chapters": [
          2314
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "held-by-meng-qiu-zhen",
        "text_origin": "source_excerpt"
      }
    ]
  },
