  "appearance": {
    "claims": [
      {
        "text": "It is a round ruby-like jewel that was cut in half. This semi-circular ball-shaped Gu worm looks very cute, and its red color is very attractive. Its head is only ten percent of its body. Its back is round and smooth, with black markings all over, resembling a tortoise shell.",
        "chapters": [
          2088
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "appearance",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_gu_worms"
        ]
      }
    ],
    "visual_confidence": "text_described"
  },
  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "Fang Yuan uses the compound killer move Shocking Departure of Year Dream Wave and Dang Hun Sound. It uses rank eight rule path departure Gu, rank eight wisdom path great shock Gu, rank eight time path year Gu, rank seven dream armor Gu, rank eight water path huge wave Gu, rank eight sound path ringing sound Gu, and its core is the secluded domain of heaven and earth, Dang Hun Mountain.",
        "chapters": [
          2309
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "compound-killer-move",
        "text_origin": "source_excerpt",
        "mentions": [
          "move_shocking_departure_of_year_dream_wave",
          "gu_departure_gu",
          "gu_great_shock_gu",
          "gu_year_gu",
          "gu_huge_wave_gu",
          "gu_ringing_sound_gu",
          "loc_dang_hun_mountain"
        ]
      },
      {
        "text": "Despite Dream Armor being only rank seven, Star Constellation Immortal Venerable does not have an effective way to block the dream path portion. Later in the same fight, Fang Yuan activates defensive methods crazily, but even dream armor Gu shows no effect against Star Constellation Immortal Venerable’s Mental Domain move. Methods like that of dream armor Gu are at a lower level and do not have enough strength to block it.",
        "chapters": [
          2309
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "compound-killer-move",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_star_constellation_immortal_venerable",
          "loc_mental_domain"
        ]
      }
    ]
