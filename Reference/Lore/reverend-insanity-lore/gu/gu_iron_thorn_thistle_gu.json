  "history": {
    "claims": [
      {
        "text": "After Bai Ning Bing kills Chen Cui Hua, Fang Yuan uses Plunder Gu and pulls three Gu from the darkening aperture: Rice Bag Grass Gu, Iron Thorn Thistle Gu, and a charred thunder bean mother Gu.",
        "chapters": [
          211
        ],
        "certainty": "canon",
