  "history": {
    "claims": [
      {
        "text": "Fairy Zi Wei goes to Southern Border’s Virtue Paradise to borrow Gu from Lu Wei Yin. He refuses other Gu but agrees that benevolence Gu can benefit the world. Outsiders must walk and ascend to the top of the mountain under Paradise Earth Immortal Venerable’s rules to gain the qualification to borrow it, and the climb grows harder at higher cultivation.",
        "chapters": [
          1693
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_fairy_zi_wei",
          "reg_southern_border",
          "loc_mushroomman_paradise",
          "char_lu_wei_yin",
          "char_paradise_earth_immortal_venerable"
        ]
      },
      {
        "text": "Heavenly Court’s standing plan is to use Benevolent Equality on Spring Autumn Cicada. At one point benevolence Gu is still in Southern Border with Lu Wei Yin, and Fairy Zi Wei plans to contact him to borrow it again. Duke Long treats Lu Wei Yin’s yes or no as a clue about whether Fang Yuan has already used rebirth.",
        "chapters": [
          1789
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "counter-to-spring-autumn-cicada",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_spring_autumn_cicada",
          "char_fang_yuan"
        ]
      },
      {
        "text": "Fairy Zi Wei later completes the mountain climb and obtains benevolence Gu.",
        "chapters": [
          1915
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "counter-to-spring-autumn-cicada",
        "text_origin": "source_excerpt"
      },
      {
        "text": "She reports no problem with benevolence Gu while practicing Benevolent Equality.",
        "chapters": [
          1918
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "counter-to-spring-autumn-cicada",
