    "claims": [
      {
        "text": "In the Shang clan city stretch, Fang Yuan recalls the Gu worms Bai Ning Bing had with Northern Dark Ice Soul Physique, including water shield Gu beside ice blade Gu, icicle Gu, blue bird ice coffin Gu, ice muscles Gu, and frost demon Gu. He says those worms belonged to ice and water series and complemented each other.",
        "chapters": [
          230
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "ice-and-water-series-mention",
        "text_origin": "source_excerpt",
        "mentions": [
          "loc_shang_clan_city",
          "sys_northern_dark_ice_soul_physique",
          "gu_ice_blade_gu",
          "gu_icicle_gu",
          "gu_blue_bird_ice_coffin_gu",
          "gu_ice_muscles_gu",
          "gu_frost_demon_gu"
        ]
      }
    ]
  },
  "appearance": {
    "claims": [
      {
        "text": "In Fang Yuan’s aperture it looks like a jellyfish floating in the primeval sea.",
        "chapters": [
          145
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "appearance",
        "text_origin": "source_excerpt"
      },
      {
        "text": "After a thunderball destroys the water shield, the jellyfish-like Gu appears very dull inside the aperture.",
        "chapters": [
          150
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "appearance",
        "text_origin": "source_excerpt"
      },
      {
        "text": "No cited chapter names its Rank in plain words. Bai Ning Bing’s activated shield grows thicker and becomes no weaker than a rank three Gu worm’s defense.",
        "chapters": [
          141
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "form-and-rank",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_gu_worms"
        ]
      }
    ],
    "visual_confidence": "text_described"
  },
  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "Activation sends two lines of water vapour from the nostrils that coil into a spherical barrier of condensed moisture. Fang Yuan rates its defensive power as superior to even White Jade Gu. Moving water in the ball disperses force. Pin needles that enter the shield slow to a halt and are purged by the currents.",
        "chapters": [
          136
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_white_jade_gu"
        ]
      },
      {
        "text": "Full defense needs a free ball shape. Against a wall the ball cannot form and power falls sharply. On the ground the shield is less than half of its usual strength.",
        "chapters": [
          136
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Shared damage through Shadow Bond Gu passes through even when Bai Ning Bing holds Water Shield Gu.",
        "chapters": [
          137
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_shadow_bond_gu"
        ]
      },
      {
        "text": "Bai Ning Bing relies on it in the Qing Mao Mountain wolf-tide fights, including against Xiong Li and against Gu Yue Qing Shu’s pin needles and green vines.",
        "chapters": [
          136
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "bai-ning-bings-use",
        "text_origin": "source_excerpt",
        "mentions": [
          "loc_qing_mao_mountain",
          "char_gu_yue_qing_shu"
        ]
      },
      {
        "text": "When vines wrap the shield and threaten to collapse it, Bai Ning Bing withdraws the defense and switches to offense.",
        "chapters": [
          141
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "bai-ning-bings-use",
        "text_origin": "source_excerpt"
      }
    ]
  },
