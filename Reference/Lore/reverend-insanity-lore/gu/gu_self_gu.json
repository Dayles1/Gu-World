    "activation_raw": null,
    "claims": [
      {
        "text": "During Dong Fang Chang Fan’s battle of wills against his tribe’s wills, Dong Fang Yu Liang says Ren Zu did not abandon his daughter, blaming self Gu for causing the trouble. Dong Fang Chang Fan answers that the self Gu was Ren Zu’s own, and that Ren Zu’s own deepest thoughts lay behind it.",
        "chapters": [
          805
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "an-excuse-in-a-battle-of-wills",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_dong_fang_chang_fan",
          "char_dong_fang_yu_liang"
        ]
      }
    ]
  },
  "feeding": {
    "known": true,
    "food_raw": null,
    "foods": [],
    "claims": [
      {
        "text": "When feathermen mock Ren Zu for lacking wings, self Gu grows angry and captures every featherman in the sky at once. It boasts that biting strength Gu earlier gave it its own strength, with no price to pay for using it, and that one’s own strength is what is most reliable.",
        "chapters": [
          870
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
