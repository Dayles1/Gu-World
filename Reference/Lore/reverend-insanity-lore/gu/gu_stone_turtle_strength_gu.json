  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "Fang Yuan’s first activation under Instant Success Gu only lasts half as long as the horse and bull steps, so he gains only half a turtle strength before Instant Success Gu runs out.",
        "chapters": [
          297
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt"
      },
      {
        "text": "On the battle stage against Ju Kai Bei, All-out Effort Gu brings out a huge turtle phantom labeled stone turtle strength. That phantom collapses under a dragon-elephant strike. Stone turtle strength is clearly not dragon-elephant strength’s match. Later in the same fight the same stone turtle strength meets dragon-elephant strength with a completely different result. After that later clash, brown bear and boar phantoms vanish in the air, and spectators note that Fang Yuan is using two beast phantoms at once.",
        "chapters": [
          317
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_ju_kai_bei",
          "gu_all_out_effort_gu"
        ]
      },
      {
        "text": "When Tie Dao Ku and other Tie clan Gu Masters wound him, Bitter Strength Gu raises his output and three more beast phantoms appear above him: green bull, horse, and stone turtle.",
        "chapters": [
          360
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "battle-boost",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_tie_dao_ku",
          "fac_tie_clan",
          "fac_gu_masters"
        ]
      }
    ]
  },
