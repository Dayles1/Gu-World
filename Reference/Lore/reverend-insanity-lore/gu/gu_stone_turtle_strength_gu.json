    "origin": "unknown",
    "claims": [
      {
        "text": "After Instant Success Gu has already seated horse and bull strength, Fang Yuan forces focus and activates Stone Turtle Strength Gu as the next implant.",
        "chapters": [
          297
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "fang-yuans-shang-clan-city-use",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Fang Yuan gains half a turtle strength beside bull and horse strength.",
        "chapters": [
          299
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "fang-yuans-shang-clan-city-use",
        "text_origin": "source_excerpt"
      },
      {
        "text": "When he cannot buy Bitter Strength Gu, he tries to refine it himself and feeds Stone Turtle Strength Gu into a three-colored fusion sphere. The attempt fails, and among four lost fusion materials he lists brown bear strength Gu, galloping horse strength Gu, green bull labor Gu, and Stone Turtle Strength Gu.",
        "chapters": [
          304
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "fang-yuans-shang-clan-city-use",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_bitter_strength_gu",
          "gu_brown_bear_strength_gu"
        ]
      },
      {
        "text": "By the Ju Kai Bei match he still holds stone turtle strength among eight beast phantoms: boar, brown bear, crocodile, green bull, horse, stone turtle, white elephant, and black python.",
        "chapters": [
          317
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "fang-yuans-shang-clan-city-use",
        "text_origin": "source_excerpt"
      }
    ]
  },
