  "history": {
    "claims": [
      {
        "text": "When Fang Yuan must move sixty thousand rockmen out of Hu Immortal Blessed Land without opening its doors, he refuses Immortal Crane Sect’s copy and refines Hole Earth Gu himself from the ordinary recipe.",
        "chapters": [
          423
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_fang_yuan",
          "loc_hu_immortal_blessed_land",
          "fac_immortal_crane_sect"
        ]
      },
      {
        "text": "Hole Earth Gu’s range is limited to one region. From Hu Immortal blessed land in central continent it can connect anywhere in that continent, and is useless beyond it.",
        "chapters": [
          459
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "regional-range",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Once planted in a blessed land, it can no longer be changed.",
        "chapters": [
          466
        ],
        "certainty": "canon",
        "confidence": "B",
