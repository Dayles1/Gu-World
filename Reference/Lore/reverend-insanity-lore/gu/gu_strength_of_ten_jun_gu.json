  "history": {
    "claims": [
      {
        "text": "He uses up those five bought Gu, then draws more from Hei tribe inventory. By then his body holds sixty jun, one thousand eight hundred jin, with turtle jade wolf skin helping the body bear about a hundred jun.",
        "chapters": [
          500
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "sixty-jun-strength",
        "text_origin": "source_excerpt",
        "mentions": [
          "fac_hei_tribe"
        ]
      },
      {
        "text": "In a later session the weights-like Gu hovers above him while its light shrouds his body; that copy is left half spent, and finishing it would bring him to seventy jun, called just passable among rank four initial stage strength path Gu Masters.",
        "chapters": [
          504
        ],
        "certainty": "canon",
        "confidence": "B",
