    "claims": [
      {
        "text": "In a scene from Shadow Sect’s past, Purple tells the sect’s other immortals that Azure fell into the trap of love because Spirit Affinity House used their signature Immortal Gu, love Gu. He calls the Gu rank nine, its might nigh unstoppable.",
        "chapters": [
          1016
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "named-the-sects-signature-gu-by-purple",
        "text_origin": "source_excerpt",
