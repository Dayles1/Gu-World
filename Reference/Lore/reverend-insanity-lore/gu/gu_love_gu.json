    "foods": [],
    "claims": [
      {
        "text": "A later Ren Zu stretch has love Gu approach Ren Zu while he is stalled by fear. It says it smells hope and fear from him and that both together are its food. Ren Zu will not give hope away, so love Gu stays beside him and says that with love present he can summon Courage Gu. After he calls, Courage Gu comes, lands in his heart at the aura of love and fear, and plays with Fear Gu there.",
        "chapters": [
          1175
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "food-of-hope-and-fear",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_courage_gu",
          "gu_fear_gu"
        ]
      }
    ]
  },
