    "food_raw": null,
    "foods": [],
    "claims": [
      {
        "text": "The Boar Gu series eats pork. Black and White Boar Gu need about one fully grown pig’s worth of meat every five days; the text names that appetite for those two and states pork as food for the whole series.",
        "chapters": [
          64
        ],
        "certainty": "canon",
