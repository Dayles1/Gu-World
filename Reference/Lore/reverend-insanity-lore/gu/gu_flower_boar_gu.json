  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "Its use is like Brute Force Longhorn Beetle Gu: it temporarily adds strength. Brute Force Longhorn Beetle Gu gives one bull’s strength for five breaths. Flower Boar Gu gives one boar’s strength for ten breaths, twice as long, at the same primeval essence cost, with lesser side effects because the strength gain is smaller.",
        "chapters": [
          62
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_brute_force_longhorn_beetle_gu"
        ]
      }
    ]
  },
