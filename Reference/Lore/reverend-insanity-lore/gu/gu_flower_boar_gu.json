    "used_in_recipes": [],
    "refinement_materials": [],
    "confirmed_evolutions": [],
    "related_variants": [],
    "claims": [
      {
        "text": "In that trial he receives grand white moon gold, skull stones, dragon-side tooth, young autumn grass, fifty primeval stones, a flower boar Gu, and a boar cage Gu as materials for Gu refinement. The inheritance does not name which Gu he must refine. He sees three possible recipes and watches a hairy man begin a refinement, then distracts that hairy man until the attempt fails under heavenly power. Fang Yuan collects the materials afterward and moves on without finishing a refinement from that bundle in the chapter.",
        "chapters": [
          357
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "refinement-material",
        "text_origin": "source_excerpt"
      }
    ]
  },
  "economy": {
    "canonical_prices": [],
    "price_claims": [
      {
        "text": "Fang Yuan calls it the most common Gu worm, sold most abundantly in the market, at half the price of Brute Force Longhorn Beetle Gu. Among the Boar Gu series he ranks Black and White Boar Gu far above it in value. A Black Boar Gu or a White Boar Gu could sell for six hundred primeval stones; that figure is never given for Flower Boar Gu itself.",
        "chapters": [
          62
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_black_and_white_boar_gu"
        ],
        "needs_review": true
      }
    ],
    "game_proposals": []
  },
  "distribution": {
    "locations": [],
    "factions": [],
    "origin": "unknown",
    "claims": [
      {
        "text": "Wild boar kings often carry Boar Gu such as Pink Boar Gu or Flower Boar Gu, and may also host Beast Skin Gu or Spike Fur worm.",
        "chapters": [
          77
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "habitat-and-early-use",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_beast_skin_gu"
        ]
      },
      {
        "text": "In the academy year-end fights, Chi Cheng’s opponent has only a Flower Boar Gu. Temporary one-boar strength does not help when Chi Cheng refuses close combat and wins with mobility and moonblades.",
        "chapters": [
          82
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "habitat-and-early-use",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_gu_yue_chi_cheng"
        ]
      },
      {
        "text": "Fang Zheng later treats Flower Boar Gu or Brute Force Longhorn Beetle Gu as the kind of strength raiser needed to break a jade barrier by force, still needing a defensive Gu as well.",
        "chapters": [
          85
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
