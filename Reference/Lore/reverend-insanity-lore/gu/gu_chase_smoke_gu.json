  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "Man Duo says he obtained it by chance, and that anyone stained by its smoke keeps that stain for months, which makes the Gu useful for finding traces. He states he used it on Ge Yao when he first saw her. When he activates it, colorless and odorless smoke turns black and marks stained targets, including Fang Yuan and later several poison beard wolves that carry thicker smoke than he does. Contact can pass the stain: Fang Yuan had been close to Ge Yao, and the banquet smoke then follows him until the wolves show a stronger mark.",
        "chapters": [
          447
        ],
        "certainty": "canon",
        "confidence": "B",
