    "claims": [
      {
        "text": "Fang Yuan’s recipe for the final step of second aperture Gu needs lifespan Gu, divine travel Gu, and two third watch Gu used in a row. Overlaying those two copies makes time flow nine times faster on him, which he treats as a tonic that also raises Spring Autumn Cicada’s pressure on his aperture.",
        "chapters": [
          389
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "second-aperture-recipe",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_second_aperture_gu",
          "gu_lifespan_gu",
          "gu_divine_travel"
        ]
      },
      {
        "text": "On page he activates the first third watch Gu on the refining light ball, then prepares the second; under that effect the ball changes rapidly, and he notes that divine travel Gu broadens space while third watch Gu condenses time.",
        "chapters": [
          395
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "second-aperture-recipe",
        "text_origin": "source_excerpt"
      }
    ]
  },
