        ]
      }
    ]
  },
  "appearance": {
    "claims": [],
    "visual_confidence": "unknown"
  },
  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "In Spirit Affinity House tests, the observed effect expends the soul to create beautiful wings. Fairy Bai Qing later judges that this is not the Gu’s true effect.",
        "chapters": [
          696
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "false-observed-effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "fac_spirit_affinity_house",
          "char_fairy_bai_qing"
        ]
      },
      {
        "text": "Fairy Bai Qing calls it a movement Immortal Gu that lets her enter dream realms at will and prevents dream realms from influencing her.",
        "chapters": [
          730
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "movement-immortal-gu-judgment",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Dream wings Immortal Gu can put the user into a deep sleep at any time, attach dream wings to the soul, and let that soul roam dream realms with freedom to advance or retreat while keeping safety. Unlike Dream Travel, it does not need immortal essence to activate, so it suits cultivators who are not yet Gu Immortals.",
        "chapters": [
          911
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "activation-without-immortal-essence",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_dream_travel",
          "sys_gu_immortal"
        ]
      }
    ]
  },
