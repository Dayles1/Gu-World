    "claims": [
      {
        "text": "When Feng Jin Huang’s soul leaves her body in a dream realm, a pair of rainbow colored feather wings unfolds on her soul’s back as dream wings Immortal Gu’s manifestation. Fang Yuan’s thought in the same stretch calls it rank six.",
        "chapters": [
          913
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
