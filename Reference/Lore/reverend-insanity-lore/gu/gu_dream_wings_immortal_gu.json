  "history": {
    "claims": [
      {
        "text": "Feng Jin Huang obtains dream wings Immortal Gu at age three while sleeping; the Gu comes to her in her dreams.",
        "chapters": [
          399
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_feng_jin_huang",
          "sys_immortal_gu"
        ]
      },
      {
        "text": "During the Hu Immortal Inheritance contest she activates it and grows a beautiful pair of wings; observers name the legendary Immortal Gu Dream Wings.",
        "chapters": [
          398
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "inh_hu_immortal_inheritance"
        ]
      },
      {
        "text": "After a long coma tied to the Gu, Feng Jin Huang wakes and states that it can bring her into dream realms.",
        "chapters": [
          723
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "entry-into-dream-realms",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Pure Dream Reality Seeker Transformation is only a rank six killer move, with limited might because its core Immortal Gu, Dream Wings, is only at rank six.",
        "chapters": [
          1685
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "pure-dream-reality-seeker-core",
