  "economy": {
    "canonical_prices": [],
    "price_claims": [
      {
        "text": "In Shang clan city’s Tong Ou shop the listed price is six hundred primeval stones, slightly above a Liquor worm at five hundred eighty, matching black and white boar Gu at six hundred, against about two hundred fifty for ordinary rank one Gu.",
        "chapters": [
          262
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "shop-prices",
