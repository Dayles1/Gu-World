  "history": {
    "claims": [
      {
        "text": "During Fei tribe’s internal fight at warm pond valley, Fei Chang activates Soul Search Gu on Fei Qing after Fei Qing refuses to say where Fei Cai fled.",
        "chapters": [
          488
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "fac_fei_tribe",
          "char_fei_qing",
          "char_fei_cai"
        ]
      },
      {
        "text": "Fang Yuan loots a rank seven soul search Immortal Gu from Yang Ku. He reckons he could build a soul search immortal killer move from other soul path Immortal Gu, but this one makes the work far more convenient.",
        "chapters": [
          1610
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "soul-search-immortal-gu",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_fang_yuan",
          "sys_immortal_gu"
        ]
      },
      {
        "text": "Days later he uses it as the core of the Soul Search immortal killer move, a dozen times more efficient than the Gu activated alone.",
        "chapters": [
          1614
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "soul-search-immortal-gu",
        "text_origin": "source_excerpt",
        "mentions": [
          "move_soul_search"
        ]
      },
      {
        "text": "After taking Qing Hui Zi’s Gu worms, Demon Immortal Qi Jue pays special attention to exceptional mortal Gu, and Soul Search Gu is named among the kinds that interest him.",
        "chapters": [
          2002
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "immortal-inspection-of-mortals",
