  "history": {
    "claims": [
      {
        "text": "Among Chou Jiu’s Gu worms, most are healing Gu plus movement Gu. He lacks a rank five healing Gu and holds Warp Gu instead. Fang Yuan sizes it up and stores it.",
        "chapters": [
          385
        ],
        "certainty": "canon",
        "confidence": "B",
