  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "Warp Gu is a space path Gu. It tears through space and transports the Gu Master’s body. The strong effect carries an equally intense backlash. Constant use entangles tendons, makes blood flow backwards, and dislocates joints, so the Gu Master grows uglier over time. Using it also requires other Gu worms to modify the body. Fang Yuan activates it to vanish from the bronze hall when Xiao Mang’s light river crashes in, and Tie Ruo Nan judges that the Gu came from the killer ghost doctor.",
        "chapters": [
          397
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "activation-and-backlash",
