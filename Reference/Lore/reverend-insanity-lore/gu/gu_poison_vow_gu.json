    "used_in_recipes": [],
    "refinement_materials": [],
    "confirmed_evolutions": [],
    "related_variants": [],
    "claims": [
      {
        "text": "Shang Ya Zi refuses a paper agreement for the nine hundred thousand primeval stone recipe sale and insists on Poison Vow Gu. Fang Yuan reads first, then Shang Ya Zi, and the Gu takes effect; Shang Ya Zi warns that changing mind or breaking the deal means death as a blood puddle.",
        "chapters": [
          268
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "shang-ya-zis-recipe-vow",
        "text_origin": "source_excerpt"
      },
      {
        "text": "The terms include secrecy from unknowing third parties. Fang Yuan later exploits wording around a “knowing third party” without violating his own side of that vow.",
        "chapters": [
          310
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "shang-ya-zis-recipe-vow",
        "text_origin": "source_excerpt"
      }
    ]
  },
