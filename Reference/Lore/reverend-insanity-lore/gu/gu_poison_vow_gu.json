  "appearance": {
    "claims": [
      {
        "text": "It is a purple red worm, only finger size, with a dangerous looking mouth.",
        "chapters": [
          268
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "appearance",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Poison Vow Gu is a purple red worm, only finger size, with a dangerous looking mouth, and a rank three consumable Gu.",
        "chapters": [
          268
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "form-and-rank",
        "text_origin": "source_excerpt"
      },
      {
        "text": "It stays rank three; almost every shop in the third inner city sells it, priced at forty-five hundred primeval stones with at least a yellow pear token, cut to three thousand when Fang Yuan shows a purple thorn token.",
        "chapters": [
          272
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "form-and-rank",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Cited chapters never print a Chinese name for it.",
        "chapters": [],
        "certainty": "inferred",
        "confidence": "C",
        "verification": "no_citation",
        "source_id": "src_sagaofgu",
        "section": "form-and-rank",
        "text_origin": "source_excerpt"
      }
    ],
    "visual_confidence": "text_described"
  },
  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "In the vow rite the Gu bites a finger, burns with heart pain, and grows as it drinks heart blood while each side reads the written terms. After both sides finish, the blood-stuffed Gu explodes into red light spots that fuse into their bodies, which shows the vow has taken effect. If the spoken terms do not match true inner intent, the Gu becomes a puddle of stale blood instead and the vow fails. Once bound, a violator turns into a puddle of blood and dies. Fang Yuan later notes that its restriction is very strong, otherwise Gu Masters would not use it.",
        "chapters": [
          268
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "fac_gu_masters"
        ]
      },
      {
        "text": "Poison Vow Gu contains the law of restriction and stays in a Gu Master’s body to restrict them. Eating One’s Words Gu carries the opposite law and can overwrite it when stronger.",
        "chapters": [
          292
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_gu_master",
          "gu_eating_ones_words_gu"
        ]
      }
    ]
  },
  "feeding": {
    "known": true,
