  "appearance": {
    "claims": [
      {
        "text": "This Gu is fist-sized, shaped like a pebble, and dark brown. Its surface is smooth, like it has a layer of oil.",
        "chapters": [
          350
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
