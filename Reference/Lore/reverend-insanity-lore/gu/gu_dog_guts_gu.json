    "claims": [
      {
        "text": "King Quan Inheritance holds rank one to five Gu of the dog guts series. Above rank two sit rank three dog guts above mountain Gu, able to resist fear of a thousand beast king; rank four dog guts above sea Gu, able to resist a myriad beast king’s aura; and rank five Dog Guts Above Heaven Gu, which can drive dogs into a frenzy with courage enough to attack like a tsunami and even overturn the emperor of dogs. In Fang Yuan’s previous life, many people obtained the rank three and four dog guts Gu, and one lucky person obtained the one and only rank five dog guts above heaven Gu.",
        "chapters": [
          350
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
