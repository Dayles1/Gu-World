  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "Used on dogs, once activated it raises the courage and morale of the user’s dogs in a range, sweeps away their fear, and draws out their complete battle strength. Ordinary dogs can then suppress fear of hundred beast kings, and courage can double or triple. Fang Yuan judges that if he had used it earlier on lightning symbol dogs, those dogs would have attacked a hundred beast king bravely instead of fighting in fear. It is not an attacking Gu, yet he judges it the best supplementary Gu for that dog work, and necessary if he wants to conquer King Quan Inheritance.",
        "chapters": [
          350
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
