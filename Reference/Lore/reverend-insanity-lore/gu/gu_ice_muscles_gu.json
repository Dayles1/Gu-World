  "history": {
    "claims": [
      {
        "text": "On Qing Mao Mountain, Bai Ning Bing reveals that a punched arm was feigned damage after using rank three ice muscle Gu, then kills Xiong Li with an ice hand that freezes the heart. Once the remodel is achieved, ice muscles work like the lasting strength gain from Black and White Boar Gu and require no primeval essence to sustain.",
        "chapters": [
          137
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "loc_qing_mao_mountain",
          "char_bai_ning_bing",
          "char_xiong_li",
          "gu_black_and_white_boar_gu"
        ]
      },
      {
        "text": "Jade bone Gu can be matched with ice muscle Gu for an excellent effect. With both, a Gu Master would have ice muscles and jade bones that mutually complement each other.",
        "chapters": [
          225
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
