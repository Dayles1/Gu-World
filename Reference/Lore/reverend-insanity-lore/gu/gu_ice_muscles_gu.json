  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "Bai Ning Bing’s flesh is already ice muscle throughout. That remodel gives defense, stops perspiration, and stops bleeding.",
        "chapters": [
          223
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt"
      },
      {
        "text": "After frenzy needle bees pierce through Sky Canopy Gu, Bai Ning Bing still lives because Ice Muscles Gu had already been used, stacking a second defense layer.",
        "chapters": [
          209
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_sky_canopy_gu"
        ]
      },
      {
        "text": "Bone spike Gu would first remove the ice muscles, which Bai Ning Bing treats as a loss rather than a gain.",
        "chapters": [
          223
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_bone_spike_gu"
        ]
      },
      {
        "text": "Because Bai Ning Bing’s body is made of ice muscles that stop perspiration, she cannot use a Gu like blood sweat Gu in the future. Ice muscles and jade bones may suit Bai Ning Bing, but Fang Yuan judges that set does not suit him.",
        "chapters": [
          233
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "suitability-limits",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_blood_sweat_gu",
          "char_fang_yuan"
        ]
      }
    ]
  },
