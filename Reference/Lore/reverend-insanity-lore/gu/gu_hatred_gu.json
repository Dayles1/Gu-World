    "origin": "unknown",
    "claims": [
      {
        "text": "In Qing Chou’s restored memories, Qing clan’s first supreme elder says the clan had already broken through Divine Bean Palace’s defense with hatred Gu. Activated in a rank eight wood path Immortal Gu House with hatred Gu at the core of its hall, the clan’s killer move Qing Chou mutated into a soul beast with hatred Gu as its core. Since the chaotic battle began, Qing Chou’s mind has been in chaos because of hatred Gu. Its memories now return in full, and its mind clears. As Qing Chou faces Spectral Soul, the rank eight Immortal Gu Hatred in its body breaks through to become a genuine rank nine Immortal Gu, and Qing Chou turns into a giant with a huge rise in battle strength.",
        "chapters": [
          2056
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "qing-chous-origin-and-rank-nine",
        "text_origin": "source_excerpt",
        "mentions": [
          "fac_qing_clan",
          "house_divine_bean_palace",
          "sys_immortal_gu_house"
        ]
      }
    ]
  },
