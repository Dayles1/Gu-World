  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "Underground, Nine Spiritual Fairy says she and Red Heart Traveler are minutes from forcefully refining hatred Gu. Then Qing Chou breaks out of their formation. She says, unsure of what she saw, that hatred Gu burst out with a trace of a rank nine Immortal Gu’s aura. On the battlefield Nine Spiritual Fairy states that hatred Gu created Qing Chou, that Qing Chou nourishes it, and that it is moving from rank eight toward rank nine.",
        "chapters": [
          2029
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "growth-and-battle-power",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_nine_spiritual_fairy",
          "sys_immortal_gu"
        ]
      },
      {
        "text": "Qing Chou’s hatred Gu is now quasi rank nine, and when activated it amplifies Qing Chou’s strength across the board, above all its offensive killer moves.",
        "chapters": [
          2030
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "growth-and-battle-power",
        "text_origin": "source_excerpt"
      }
    ]
  },
