  "history": {
    "claims": [
      {
        "text": "At Lang Ya blessed land, Lang Ya land spirit identifies an Immortal Gu in Fang Yuan’s hand as Woman’s Heart from historical records, though he has never seen it in person.",
        "chapters": [
          663
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "loc_lang_ya_blessed_land",
          "char_lang_ya_land_spirit",
          "sys_immortal_gu",
          "char_fang_yuan"
        ]
      },
      {
        "text": "He calls the Gu peculiar and vile. Gu worms are classed into nurture, use, and refinement; he says this Immortal Gu fuses the first and third, which Fang Yuan has not seen before, though Fang Yuan knows rank five Blood Guillotine Gu as the type that fuses use and nurturing. Female variant human hearts can replace women’s hearts as food, but the effect is worse and more hearts are needed for the same toxicity.",
        "chapters": [
          663
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "nature",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_gu_worms",
          "gu_blood_guillotine_gu"
        ]
      },
      {
        "text": "In a Gu formation cored on the light of wisdom, Fang Yuan combines Mo Yao’s fake will, Woman’s Heart, and the wisdom path Immortal Gu Unravel Mystery to refine Bo Qing’s Immortal Gu.",
        "chapters": [
          997
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "refining-bo-qings-immortal-gu",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_gu_formation",
          "char_mo_yao",
          "gu_unravel_mystery",
          "char_bo_qing"
        ]
      },
      {
        "text": "A later inventory of Fang Yuan’s Immortal Gu lists Woman’s Heart among his rank six Immortal Gu.",
        "chapters": [
          1082
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "inventory-rank",
        "text_origin": "source_excerpt"
      }
    ]
  },
