        ],
        "needs_review": true
      },
      {
        "text": "Bidding is fierce among rank seven and rank eight Gu Immortals, and the price surpasses earlier highs set by Worldly Wave Trace and Delight in Water and Mountain.",
        "chapters": [
          760
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
