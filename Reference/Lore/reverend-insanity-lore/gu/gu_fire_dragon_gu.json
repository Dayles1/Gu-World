  "appearance": {
    "claims": [
      {
        "text": "A Gu that looks like a flame shoots out of his aperture. The flame quickly forms into a fire snake winding around its own body, then grows scales, claws, horns, and sharp teeth with a horse-like face until it is an enormous fire dragon. When the giant puppet rises, the fire dragon coils around its right arm with its head on the right shoulder.",
        "chapters": [
          185
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "appearance",
        "text_origin": "source_excerpt"
      }
    ],
    "visual_confidence": "text_described"
  },
  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "Fire Dragon Gu is rank four and causes Blood River Python heavy pain because black oil from the destroyed oil dragon sticks to the python and the fire sets that oil burning. The fire dragon is not the python’s match in a direct fight and shrinks under injury, but it drills into the raging inferno to recover, using the fire as home ground. With that burning field the two rank four Gu force the rank five python to dive back into the blood lake for a time. Fang Yuan notes the retreat is temporary while the lake can restore the python, and that Fire Dragon Gu alone would then no longer match it.",
        "chapters": [
          185
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
