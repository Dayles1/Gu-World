  "history": {
    "claims": [
      {
        "text": "After an empty possession true inheritance, Fang Yuan finds two ordinary inheritances that both involve wisdom path. Each holds a rank six Immortal Gu. One is false emotion fake will Gu. Giant Sun Immortal Venerable’s wisdom path attainment is well known, especially in emotion Gu. These two inheritances are not what Fang Yuan wants, and he chooses to let go.",
        "chapters": [
          599
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_fang_yuan",
          "sys_immortal_gu",
          "char_giant_sun_immortal_venerable",
          "gu_emotion_gu"
        ]
      },
      {
        "text": "Giant Sun’s will holds false emotion fake will Gu and treats it as a way to hoodwink Imperial Court blessed land’s land spirit, so two chosen people can be made to look like a couple with true love and become new owners. The Gu contains Giant Sun’s will and stays under that will’s control.",
        "chapters": [
          612
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
