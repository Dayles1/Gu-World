    "price_claims": [
      {
        "text": "Fang Yuan sells jumping grass and buys horizontal charge Gu and vertical crash Gu as his movement Gu. He judges vertical crash more suitable because jumping grass draws jump power from the Gu worm, while vertical crash draws force from his own body and scales as he grows stronger.",
        "chapters": [
          288
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
