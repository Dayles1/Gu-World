  "history": {
    "claims": [
      {
        "text": "Bai Ning Bing smashes Chen Cui Hua’s head with the chainsaw golden centipede. Fang Yuan uses Plunder Gu to take the three aperture Gu, then searches the corpse and finds a hairy leg Gu and a jumping grass Gu among what remains on the body.",
        "chapters": [
          211
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_bai_ning_bing",
          "char_chen_cui_hua",
          "char_fang_yuan",
          "gu_plunder_gu",
          "gu_hairy_leg_gu"
        ]
      },
      {
        "text": "Fang Yuan recalls that after they killed the heavily injured demonic female Gu Master, taking her Gu, including rice bag Gu and jumping grass Gu, was what let them barely get by on the road.",
        "chapters": [
          214
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "early-context",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_gu_master",
          "gu_rice_bag_grass_gu"
        ]
      },
      {
        "text": "Choosing among bone inheritance Gu, he notes he already has jumping grass and does not fight close combat, so Arm bone wings Gu is useless to him.",
        "chapters": [
          222
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "early-context",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_arm_bone_wings_gu"
        ]
      }
    ]
  },
