  },
  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "It is a time path healing Gu that returns a target to a condition at a point in time. Under its effect Zhu Zai reappears uninjured.",
        "chapters": [
          533
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "path_time",
          "sys_healing_gu"
        ]
      },
      {
        "text": "Later in the same battle Tai Bai restores both Zhu Zai and Gao Yang again after the three heads six arms killer move kills them.",
        "chapters": [
          534
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_gao_yang"
        ]
      },
      {
        "text": "In Eighty-Eight True Yang Building he repeatedly resurrects or heals Gu Masters with the same Gu.",
        "chapters": [
          591
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "house_eighty_eight_true_yang_building",
          "fac_gu_masters"
        ]
      },
      {
        "text": "As a mortal Gu it can be used only on others, not on Tai Bai himself.",
        "chapters": [
          534
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "limits",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_mortal_gu"
        ]
      },
      {
        "text": "It targets human bodies and has no effect on Gu worms, so revived Gu Masters do not recover lost worms.",
        "chapters": [
          538
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "limits",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_gu_worms"
        ]
      }
    ]
  },
