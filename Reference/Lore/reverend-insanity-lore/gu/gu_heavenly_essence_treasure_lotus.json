    "claims": [
      {
        "text": "It is a rank three flower Gu.",
        "chapters": [
          163
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "rank-path-and-effect",
        "text_origin": "source_excerpt"
      },
      {
        "text": "The Gu has a reputation as a portable spirit spring because it can produce primeval stones.",
        "chapters": [
          163
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "rank-path-and-effect",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Heavenly Essence Treasure Imperial Lotus is a wood path Immortal Gu.",
        "chapters": [
          2250
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "rank-path-and-effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_immortal_gu"
        ]
      },
      {
        "text": "Shang clan city’s auction presents a recipe for rank four Heavenly Essence Treasure Monarch Lotus. The crowd lists the series as rank three Heavenly Essence Treasure Lotus, rank four Heavenly Essence Treasure Monarch Lotus, and rank five Heavenly Essence Treasure King Lotus, and ties the line to Immortal Venerable Genesis Lotus, including talk of rank six Heavenly Essence Treasure Imperial Lotus. The recipe needs Heavenly Essence Treasure Lotus as the main ingredient. Wei Yang places the last bid and obtains the recipe in public.",
        "chapters": [
          308
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "series-and-advancement",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_wei_yang"
        ]
      },
      {
        "text": "Fang Yuan had made him bid to avoid suspicion. Afterward Wei Yang offers him the recipe in a heart engraved Gu; at Fang Yuan’s request Wei Yang activates it himself, imprinting the Monarch Lotus refinement method in Fang Yuan’s heart.",
        "chapters": [
          309
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "series-and-advancement",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Fang Yuan treats advancing his rank three copy into Heavenly Essence Treasure Monarch Lotus as a large later project that needs spirit springs.",
        "chapters": [
          345
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "series-and-advancement",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Inside Eighty-Eight True Yang Building’s treasure room he finds a rank five Heavenly Essence Treasure King Lotus sealed in crystal and recalls the series from rank three Heavenly Essence Treasure Lotus through rank six Heavenly Essence Treasure Imperial Lotus. He had used a Heavenly Essence Treasure Lotus earlier to cover weak aptitude, but advancing it cost too many natural spirit springs, and after his aptitude improved greatly he gave up on the heavenly essence treasure lotus Gu. He judges there is no point in using the rank three Heavenly Essence Treasure Lotus anymore, while the rank five King Lotus fits his present condition, and he exchanges four spring egg Gu for that King Lotus and refines it at once.",
        "chapters": [
          558
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "series-and-advancement",
        "text_origin": "source_excerpt",
        "mentions": [
          "house_eighty_eight_true_yang_building"
        ]
      }
    ]
  },
  "appearance": {
    "claims": [
      {
        "text": "It is a flower bud, blue and white following one another, floating in the spring water behind a crystal wall.",
        "chapters": [
          162
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "appearance",
        "text_origin": "source_excerpt"
      },
      {
        "text": "It is a flower Gu. Through the crystal it shows eight leaves and a damaged half leaf. When a primeval stone strikes it, it transits between blue and white and shakes like water ripples. Fang Yuan has heard that ordinary people cannot see it and that it can only be seen clearly through the crystal.",
        "chapters": [
          163
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "appearance",
        "text_origin": "source_excerpt"
      }
    ],
    "visual_confidence": "text_described"
  },
  "abilities": {
    "activation_raw": null,
    "claims": []
  },
