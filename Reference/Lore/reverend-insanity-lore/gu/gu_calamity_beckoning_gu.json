  "economy": {
    "canonical_prices": [],
    "price_claims": [
      {
        "text": "Qin Bai Sheng introduces it as a rank seven luck path Immortal Gu that helps others by harming oneself: it helps another person undergo tribulation and attracts the calamity or tribulation onto the user. Nobody bids, and it goes unsold.",
        "chapters": [
          758
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "auction-listing",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_qin_bai_sheng"
        ]
      },
      {
        "text": "Qin Bai Sheng next offers Reverse Misfortune, another rank seven luck path Immortal Gu. Narration treats that Immortal Gu as similar to Calamity Beckoning Gu, both luck path and both rank seven, while the hall’s responses differ sharply.",
        "chapters": [
          760
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "auction-listing",
