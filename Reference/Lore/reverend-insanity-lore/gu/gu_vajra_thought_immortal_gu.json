  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "Injected with red date immortal essence it creates small metallic golden thoughts that clank when they collide. Those thoughts are poor at fusing for deduction and excel in fighting instead. Outside the mind they expand into fist sized golden balls. One thought can move at about half of sword escape Immortal Gu’s speed and crash through a tile to drill deep underground. Quantity scales with rank: rank five mortal vajra thought Gu can make about a hundred thoughts at once, while the Immortal Gu can make thousands or tens of thousands. With attitude Gu, unravel mystery Gu, and affection Gu, Fang Yuan counts four wisdom path Immortal Gu in hand. Imitating myriad star fireflies, he designs an immortal killer move cored on vajra thought Immortal Gu, then judges that core alone too weak and plans to modify the move with divination tortoise transformation to raise its strength.",
        "chapters": [
          1305
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_immortal_gu",
          "gu_attitude_gu",
          "gu_affection_immortal_gu"
        ]
      }
    ]
  },
  "feeding": {
    "known": true,
