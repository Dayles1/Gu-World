  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "After activation, three white bone shields surround the Gu Master and circle front, left, back, and right.",
        "chapters": [
          265
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_gu_master"
        ]
      },
      {
        "text": "The floating shields block attacks. When Wei Yang strikes with a light broadsword during a Shang clan city spar, the blade first splits a white bone shield into half while Fang Yuan has Flying bone shield Gu active with canopy Gu.",
        "chapters": [
          266
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_wei_yang",
          "loc_shang_clan_city"
        ]
      },
      {
        "text": "Hei Lou Lan sends Hei Xiu Yi, a defense-specialized black banner commander, onto the stage. Hei Xiu Yi fields fifty-six flying bone shields that hover and shield him, and a green halo later repairs cracks in those shields. An enormous foot smash then breaks the fifty-six shields in under a second.",
        "chapters": [
          498
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "battle-stage-defense",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_hei_lou_lan",
          "char_hei_xiu_yi"
        ]
      }
    ]
  },
