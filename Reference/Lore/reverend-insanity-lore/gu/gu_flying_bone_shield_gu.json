  "history": {
    "claims": [
      {
        "text": "In the second white bone hall on Bai Gu mountain, Fang Yuan and Bai Ning Bing find Flying bone shield Gu held in one of three white bone pillar hands beside Ribcage shield Gu and Arm bone wings Gu. Pillar text limits the inheritor to one choice among the three. Fang Yuan chooses and refines Flying bone shield Gu.",
        "chapters": [
          222
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "loc_bai_gu_mountain",
          "char_fang_yuan",
          "char_bai_ning_bing",
          "gu_ribcage_shield_gu",
          "gu_arm_bone_wings_gu"
        ]
      },
      {
        "text": "Man tribe external elder Shi Wu summons three flying bone shields while retreating from Fang Yuan. Fang Yuan smashes all three, then smashes another three when Shi Wu summons them again.",
        "chapters": [
          444
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "three-shield-summons",
        "text_origin": "source_excerpt",
        "mentions": [
          "fac_man_tribe",
          "char_shi_wu"
        ]
      },
      {
        "text": "Facing a combined strike, Hei Xiu Yi again raises fifty-six flying bone shields in a blocking wall, with oil wind between the shields as part of his defense set, and holds for a stretch while protecting Fang Yuan behind him.",
        "chapters": [
          512
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "covering-shield-wall",
        "text_origin": "source_excerpt"
      },
      {
        "text": "When thirty-eight sealing arts contaminates Fang Yuan’s defense, the white bone shields hovering around him fall one after another and turn back into flying bone shield Gu.",
        "chapters": [
          642
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "seal-and-reversion",
        "text_origin": "source_excerpt"
      }
    ]
  },
