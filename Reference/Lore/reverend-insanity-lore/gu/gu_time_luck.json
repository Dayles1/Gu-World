  "history": {
    "claims": [
      {
        "text": "Fairy Li Shan offers several Immortal Gu as compensation; Fang Yuan chooses Time Luck. She obtained it as payment from Qin Bai Sheng. Ordinary Gu Immortals who activate it expend their own lifespan, and as an immortal zombie Fang Yuan cannot spend lifespan the same way, so she warns him against picking it. She also has an immortal killer move with Time Luck as the core that draws on another person’s lifespan to amplify the user’s luck. Fang Yuan takes the Gu anyway, planning to try inch of time in place of lifespan, and Fairy Li Shan lets him have it.",
        "chapters": [
          767
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
