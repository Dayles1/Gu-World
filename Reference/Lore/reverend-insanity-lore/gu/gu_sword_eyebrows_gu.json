  "history": {
    "claims": [
      {
        "text": "Fang Yuan draws it from the immortal zombie of Bo Qing at Falling Heavenly River and matches it to information from Feng Jin Huang.",
        "chapters": [
          995
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_fang_yuan",
          "char_bo_qing",
          "loc_falling_heavenly_river",
          "char_feng_jin_huang"
        ]
      },
      {
        "text": "Besides change soul Immortal Gu, which Fang Yuan had already refined, the other sword path Immortal Gu taken from Bo Qing still held Bo Qing’s will and were harder to refine. Fang Yuan left them in Hu Immortal blessed land instead of bringing them to Yi Tian Mountain, where unused Immortal Gu would have been useless anyway. That set includes rank eight wisdom sword Gu, rank seven sword escape Gu, rank seven sword eyebrows Gu, and rank seven flying sword Gu. Leaving them behind kept them from becoming Ying Wu Xie’s property with Fang Yuan’s former body.",
        "chapters": [
          1032
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "left-in-hu-immortal-blessed-land",
