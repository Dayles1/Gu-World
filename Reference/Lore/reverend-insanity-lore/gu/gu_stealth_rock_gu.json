  "refinement": {
    "recipes": [],
    "used_in_recipes": [],
    "refinement_materials": [],
    "confirmed_evolutions": [],
    "related_variants": [],
    "claims": [
      {
        "text": "Fang Yuan plans to fuse Stealth Rock Gu into rank two Stealth Scales Gu, which can conceal clothes as well.",
        "chapters": [
          121
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "fusion-into-stealth-scales-gu",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_stealth_scales_gu"
        ]
      },
      {
        "text": "Fish Scale Gu is used with Stealth Rock Gu to create Stealth Scale Gu. That recipe would only be discovered two hundred years later.",
        "chapters": [
          123
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "fusion-into-stealth-scales-gu",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_fish_scale_gu"
        ]
      },
      {
        "text": "Other materials besides Stealth Rock Gu are common, and he asks Jiang Ya to gather them.",
        "chapters": [
          121
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "fusion-into-stealth-scales-gu",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_jiang_ya"
        ]
      },
      {
        "text": "He obtains the Fish Scale Gu by trading his Black Boar Gu with Gu Yue Qing Shu, and he successfully refines Stealth Scales Gu before the Gu battle tournament.",
        "chapters": [
          123
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "fusion-into-stealth-scales-gu",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_black_boar_gu",
          "char_gu_yue_qing_shu"
        ]
      },
      {
        "text": "After that advance, later chapters speak of Stealth Scales Gu rather than Stealth Rock Gu.",
        "chapters": [],
        "certainty": "inferred",
        "confidence": "C",
        "verification": "no_citation",
        "source_id": "src_sagaofgu",
        "section": "fusion-into-stealth-scales-gu",
        "text_origin": "source_excerpt"
      }
    ]
