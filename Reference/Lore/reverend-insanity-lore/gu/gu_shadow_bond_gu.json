    "claims": [
      {
        "text": "Alliance slope and early wolf-tide chapters describe the shared-damage link without naming a cultivation path for this Gu. Cited chapters also never give a Chinese-character name for it.",
        "chapters": [],
        "certainty": "inferred",
        "confidence": "C",
        "verification": "no_citation",
        "source_id": "src_sagaofgu",
        "section": "path",
        "text_origin": "source_excerpt"
      }
    ]
  },
  "appearance": {
    "claims": [
      {
        "text": "Cited chapters never describe the Gu worm itself in an aperture or by insect shape, never state a rank for it, and never state what it eats. In use, the user’s shadow twists at a creepy angle and pastes itself onto the ground, joining the user’s shadow to the target’s.",
        "chapters": [
          125
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "form",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_gu_worms"
        ]
      }
    ],
    "visual_confidence": "text_described"
  },
  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "When the Shadow Bond Gu Master sustains an injury, the chain-linked Gu Master takes ten percent of that damage.",
        "chapters": [
          125
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_gu_master"
        ]
      },
      {
        "text": "Xiong Jiang uses that share against Bai Bing Yi: Xiong Jiang specializes in defense, Bai Bing Yi is a pure attacker with poor health, so even ten percent is dangerous to him, and Bai Bing Yi admits defeat.",
        "chapters": [
          125
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt"
      },
      {
        "text": "That transmitted injury is a direct effect. Even if Bai Ning Bing had Water Shield Gu, the narration says it cannot block against it.",
        "chapters": [
          137
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_bai_ning_bing",
          "gu_water_shield_gu"
        ]
      }
    ]
  },
