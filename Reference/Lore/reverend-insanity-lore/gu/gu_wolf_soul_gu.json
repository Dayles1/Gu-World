    "claims": [
      {
        "text": "On the ninth use, Fang Yuan’s hundred man soul gains wolf ears, longer hair, wolf eyes, a thinner body, and a sharper nose, and grows more condensed with a grey-white tint. He expects that finishing his remaining copies will refine the hundred man soul to its limit as a half-man half-wolf wolfman soul, stronger than an ordinary hundred man soul.",
        "chapters": [
          443
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "early-refinement",
        "text_origin": "source_excerpt"
      }
    ]
  },
