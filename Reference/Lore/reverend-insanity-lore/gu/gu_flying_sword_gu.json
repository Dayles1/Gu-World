  "history": {
    "claims": [
      {
        "text": "While taking Immortal Gu from the sleeping immortal zombie Bo Qing, Fang Yuan draws this Gu out as the fourth Immortal Gu in that haul.",
        "chapters": [
          995
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_immortal_gu",
          "char_bo_qing",
          "char_fang_yuan"
        ]
      },
      {
        "text": "At a stone pillar inside one of the turbulent flow sea area’s bubble worlds, the pillars seem to sense the information path insignia on Flying Sword Immortal Gu and start shining in red light. The pillars then move slowly, and as they slow a vat sized space opens and a skeleton falls out holding an information path inheritance.",
        "chapters": [
          1156
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
