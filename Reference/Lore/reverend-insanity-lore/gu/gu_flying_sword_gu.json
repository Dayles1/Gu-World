  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "Named examples tied to it include formless flying sword, cloud flying sword, pursuing flying sword, and ten thousand li flying sword.",
        "chapters": [
          995
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "killer-moves",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Formless Flying Sword shoots Flying Sword Immortal Gu out so fast it vanishes at once; Fang Yuan can sense its location while others cannot. It is one of Bo Qing’s signature killer moves. Cloud Flying Sword spreads cloud fog so the sword’s power has no form or limits: it could not be intercepted, and without any solid matter it could not be resisted. Ten Thousand Li Flying Sword sends sword light like a rainbow several thousand li in a blink, with high accuracy.",
        "chapters": [
          1468
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "flying-sword-killer-moves",
        "text_origin": "source_excerpt",
        "mentions": [
          "move_formless_flying_sword",
          "move_cloud_flying_sword",
          "move_ten_thousand_li_flying_sword"
        ]
      }
    ]
  },
  "feeding": {
    "known": true,
    "food_raw": null,
    "foods": [],
    "claims": [
      {
        "text": "He can use Flying Sword Immortal Gu to attack and Sword Escape Immortal Gu to retreat. The sword path immortal killer move sword marks targeting death uses Flying Sword Immortal Gu as the core with a small number of supplementary sword path mortal Gu.",
        "chapters": [
          1131
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "attack-and-retreat",
        "text_origin": "source_excerpt",
