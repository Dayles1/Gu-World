  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "Chi Shan later pairs it with Grand Bear Gu when he explains Xiong Li’s contest strength: Grand Bear Gu can increase his strength by another bear on top of what Brown Bear Innate Strength Gu already provides, for two bears’ strength together. Chi Shan admits he is far from matching that total and that Qing Mao Mountain’s strongest title belongs to Xiong Li.",
        "chapters": [
          123
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_grand_bear_gu"
        ]
      },
      {
        "text": "After Man Shi and Xiong Li die, Fang Yuan reaches the area hoping for Xiong Li’s Brown Bear Innate Strength Gu, but Xiong Li’s corpse and Gu worms are already gone. He judges that Xiong Lin collected them, and also notes the Gu might never have been on the body if Xiong Li had already returned it to his clan.",
        "chapters": [
          142
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "battlefield-aftermath",
        "text_origin": "source_excerpt",
