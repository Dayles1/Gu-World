  "history": {
    "claims": [
      {
        "text": "On Qing Mao Mountain, Xiong Li tells Chi Shan that he has Brown Bear Innate Strength Gu after their contest at the village gate.",
        "chapters": [
          121
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "loc_qing_mao_mountain",
          "char_xiong_li",
          "char_chi_shan"
        ]
      },
      {
        "text": "Asked how many Gu he used to modify his body and raise strength, Fang Yuan answers that he used three: black and white boar Gu, crocodile strength Gu, and the brown bear innate strength Gu he just bought. Wei Yang then names those same three Gu as ones that can permanently increase strength but are expensive, and argues that the investment often returns only a portion of the body’s stored strength in real punches.",
        "chapters": [
          280
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "strength-path-talk",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_black_and_white_boar_gu",
          "gu_crocodile_strength_gu",
          "char_wei_yang"
        ]
      },
      {
        "text": "Fang Yuan has been using brown bear innate strength Gu since he bought it and now masters it. In a stone-pillar test a brown bear phantom appears behind him, matching his right-palm smack as the pillar breaks.",
        "chapters": [
          288
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "mastery",
        "text_origin": "source_excerpt"
      }
    ]
  },
