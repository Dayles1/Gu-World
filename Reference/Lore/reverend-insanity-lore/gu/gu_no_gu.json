  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "Before Chu Du’s Gu formation, Not Immortal’s will activates one rule path Immortal Gu, No, and Pang Shan’s will activates Care. Chu Du fuses their power into the formation so Fang Yuan can breach alliance agreements without harm. Once the two Immortal Gu stop activating, a further breach would bring intense backlash. Using them is not free; as Fang Yuan discussed with Chu Du, the large amount of resources he has contributed to Hei Fan grotto-heaven serves as the compensation. Chu Du afterward keeps both Immortal Gu, along with Not Immortal’s and Pang Shan’s wills, in his own immortal aperture.",
        "chapters": [
          1182
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "rule-path-use-with-care",
