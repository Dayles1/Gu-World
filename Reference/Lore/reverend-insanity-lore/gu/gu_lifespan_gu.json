  "economy": {
    "canonical_prices": [],
    "price_claims": [
      {
        "text": "Though only mortal Gu, lifespan Gu are among the strongest forms of currency in Gu Immortal transactions, and almost nothing compares to them.",
        "chapters": [
          1074
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "trade-and-limits",
        "text_origin": "source_excerpt"
      },
      {
        "text": "In many high end transactions Gu Immortals will not take immortal essence stones and want only lifespan Gu, which makes lifespan Gu a hard currency.",
        "chapters": [
          1128
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "trade-and-limits",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Time path methods that add lifespan with day Gu, month Gu and year Gu carve time path dao marks into the body, and once those accumulate the person can no longer use lifespan Gu.",
        "chapters": [
          1400
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "trade-and-limits",
        "text_origin": "source_excerpt",
        "mentions": [
          "path_time",
          "gu_day_gu",
          "gu_month_gu",
          "gu_year_gu"
        ]
      },
      {
        "text": "The Gu Immortal world ranks the development of an immortal aperture in seven ordered levels, and the seventh is producing lifespan Gu.",
        "chapters": [
          1489
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "trade-and-limits",
        "text_origin": "source_excerpt"
      }
    ],
    "game_proposals": []
  },
