  "appearance": {
    "claims": [
      {
        "text": "Year-count forms differ. One three hundred years lifespan Gu is like a blue snake coiled into a round loop, and one five hundred years lifespan Gu is like a young dragon bearing its claws.",
        "chapters": [
          390
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "appearance",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Another three hundred years lifespan Gu looks like rough-textured roots coiled into a circle.",
        "chapters": [
          402
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "appearance",
        "text_origin": "source_excerpt"
      }
    ],
    "visual_confidence": "text_described"
  },
