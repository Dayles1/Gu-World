        "mentions": [
          "char_hei_bai",
          "char_pan_ping",
          "fac_tang_tribe",
          "loc_cao_fu_region",
          "loc_ni_yu_blessed_land"
        ]
      },
      {
        "text": "When the three-head six-arms monster presses Hei tribe’s side, Pan Ping shouts “Take my sole blade Gu!” then activates single blade Gu in the same strike. The activation lands a shallow wound on the monster’s chest before the wound recovers.",
        "chapters": [
          534
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "hei-tribe-clash",
        "text_origin": "source_excerpt",
        "mentions": [
          "fac_hei_tribe"
        ]
      },
      {
        "text": "After Pan Ping dies under Fang Yuan’s control of the fight, Fang Yuan stores the Gu worms from the corpses and singles out Sole Blade Gu as having collection value.",
        "chapters": [
          580
        ],
