    "claims": [
      {
        "text": "The Gu Immortal Blade Demon created it. Blade Demon once used a rank six Sole Blade Gu, then died in battle to Butterfly Sword Immortal, whose side consumed his blessed land. The recipe was not passed down. Many Sole Blade Gu remain in the mortal realm from gifts Blade Demon handed out while disguised as a mortal, and Pan Ping’s copy is treated as one of those gifts. Dong Fang Chang Fan states the Gu can reach rank six at most.",
        "chapters": [
          519
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
