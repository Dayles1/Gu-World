  "history": {
    "claims": [
      {
        "text": "Hei Bai names Sole Blade Gu when Pan Ping beheads Tang tribe leader during the Cao Fu fighting watched from Ni Yu blessed land.",
        "chapters": [
          519
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
