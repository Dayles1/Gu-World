  "history": {
    "claims": [
      {
        "text": "Three days after delivering ancient bronze skin Gu, Li Xian brings essence iron bone Gu to Fang Yuan on San Cha Mountain.",
        "chapters": [
          355
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_ancient_bronze_skin_gu",
