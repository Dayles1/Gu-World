  "history": {
    "claims": [
      {
        "text": "Qin Ding Ling says that during three hundred thousand years sealed in a metal coffin while she comprehended luck path, gamble Gu was attracted to her and came to the coffin one day. She treats that arrival as both the backlash of Giant Sun Immortal Venerable forcefully taking Thieving Heaven’s true inheritance and her own fortuitous encounter.",
        "chapters": [
          2200
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_qin_ding_ling",
          "char_giant_sun_immortal_venerable",
          "inh_thieving_heaven_true_inheritance"
        ]
      },
      {
        "text": "She activates immortal killer move luck gamble with that Gu. Immortal Zombie Giant Sun shows three. The die rolls again and she shows five. His vast luck transfers to her. After she recovers she activates the move again. He shows three and she shows two, so her luck surges out and transfers back to him. The numbers determine victory or defeat, but the outcome is random. Even she cannot influence it.",
        "chapters": [
          2200
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "luck-gamble-core",
        "text_origin": "source_excerpt",
