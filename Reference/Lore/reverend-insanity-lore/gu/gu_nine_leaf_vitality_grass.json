  "appearance": {
    "claims": [
      {
        "text": "In his palm it is dainty and delicate: emerald green roots like a ginseng’s beard, semi-transparent stolons like jadeite, and nine round jade-green leaves covering and reflecting each other in a round plate.",
        "chapters": [
          102
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "appearance-rank-and-path",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Once refined, it can sit in the palm as living grass or return into a green insignia on that palm.",
        "chapters": [
          106
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "appearance-rank-and-path",
        "text_origin": "source_excerpt"
      },
      {
        "text": "It is a healing-type rank two Gu worm. It is a healing-type grass Gu, and no chapter names a cultivation path for it.",
        "chapters": [
          102
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "appearance-rank-and-path",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_gu_worms"
        ]
      }
    ],
    "visual_confidence": "text_described"
  },
  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "For ordinary healing it is no better than Life breath grass. Its true value is the leaves: each leaf torn off is a vitality leaf, a rank one expendable grass Gu that disappears after one use.",
        "chapters": [
          102
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_life_breath_grass"
        ]
      },
      {
        "text": "After one vitality leaf heals a person, other vitality leaves give that person no further healing for the next hour. Even so, easy refinement, instant healing, and easy feeding make vitality leaves the most popular healing method among rank two Gu Masters.",
        "chapters": [
          102
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "fac_gu_masters"
        ]
      },
      {
        "text": "Primeval essence poured into the bare stem grows new leaves. Fang Yuan finds that growing one mature leaf costs about 20% of his rank two essence sea at that time.",
        "chapters": [
          106
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Growing out a full set of nine leaves takes him about half a day.",
        "chapters": [
          112
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt"
      }
    ]
  },
  "feeding": {
    "known": true,
    "food_raw": null,
    "foods": [],
    "claims": [
      {
        "text": "It needs only water and sunlight, so raising it has virtually no feed cost.",
        "chapters": [
          106
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "feeding",
        "text_origin": "source_excerpt"
      }
    ]
  },
  "refinement": {
    "recipes": [],
    "used_in_recipes": [],
    "refinement_materials": [],
    "confirmed_evolutions": [],
    "related_variants": [],
    "claims": [
      {
        "text": "In a dream realm that reenacts Gu Yue clan judgment, the clan leader orders the nine leaf vitality grass Gu returned to Fang Yuan’s uncle and aunt. Fang Yuan seizes that grass because the dream presents it as a high tier ingredient for refining dream Gu.",
        "chapters": [
          770
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "dream-material",
        "text_origin": "source_excerpt"
      }
    ]
  },
  "economy": {
    "canonical_prices": [],
    "price_claims": [
      {
        "text": "One vitality leaf is priced at about fifty primeval stones, so nine leaves are worth about four hundred and fifty before costs.",
        "chapters": [
          106
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "needs_review": true
      },
      {
        "text": "Near the wolf tide, clan sale prices climb from fifty-five to sixty primeval stones per leaf, and Fang Yuan asks Qing Shu sixty-five. Fang Yuan expects the peak wolf-tide price to pass one hundred in his memory of the same period.",
        "chapters": [
          124
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_gu_yue_qing_shu"
        ],
        "needs_review": true
      },
      {
        "text": "At Tong Ou shop, one-time expenditure Gu like vitality grass are priced at fifty primeval stones apiece.",
        "chapters": [
          262
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "market-price-outside-the-village",
        "text_origin": "source_excerpt"
      }
    ],
    "game_proposals": []
  },
