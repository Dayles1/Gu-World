  "appearance": {
    "claims": [
      {
        "text": "It is the size of two hands, like a long-horned beetle with a black exoskeleton, and very heavy. Even with Fang Yuan’s sovereign immortal body he cannot hold it; once refined it floats while he observes it.",
        "chapters": [
          1346
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "appearance",
        "text_origin": "source_excerpt"
      }
    ],
    "visual_confidence": "text_described"
  },
  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "As the name suggests, it protects the Gu Immortal. It is rule path. Used alone it needs time: its effects activate only after ten breaths. Once those ten breaths pass, its defensive effect is among the top rank seven defenses, with status equal to sword escape Immortal Gu.",
        "chapters": [
          1346
        ],
        "certainty": "inferred",
        "confidence": "C",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
