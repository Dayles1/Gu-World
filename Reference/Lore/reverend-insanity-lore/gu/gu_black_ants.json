  "feeding": {
    "known": true,
    "food_raw": null,
    "foods": [],
    "claims": [
      {
        "text": "After Immortal Gu produces black ant mortal Gu on its own and sends them out to feed on immortal materials, then uses the nutrients they retain on itself. Any immortal material can feed After through them. The point of feeding is preserving these black ant mortal Gu, which are tough enough to devour immortal materials and digest them while holding the nutrients. They remain mortal Gu. If too many are destroyed, After starves. After can produce only one black ant mortal Gu each month, and without enough of them After dies of hunger.",
        "chapters": [
          1129
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "feeding-after-immortal-gu",
        "text_origin": "source_excerpt"
      }
    ]
