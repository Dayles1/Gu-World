    "claims": [
      {
        "text": "Before the finish, he buys large numbers of low rank Gu and refinement materials while preparing to refine rank five breath concealment Gu and other Gu.",
        "chapters": [
          469
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "rank-five-refinement",
        "text_origin": "source_excerpt"
      },
      {
        "text": "At Crescent Lake, after returning from Hu Immortal blessed land, he finishes refining and obtains rank five breath concealment Gu. He refines it in northern plains so the new Gu is born with that region’s recognition and avoids regional suppression. At rank five the Gu is still like a purple exquisite tree leaf, only deeper purple with a slight metallic luster. He uses it to hide his cultivation back to rank four middle stage while his true realm is higher. Later narration also restates the Zi You mountain find as rank two; ranking up that worm produces the rank five Gu.",
        "chapters": [
          477
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "rank-five-refinement",
        "text_origin": "source_excerpt",
        "mentions": [
          "loc_crescent_lake",
          "loc_hu_immortal_blessed_land"
        ]
      }
    ]
