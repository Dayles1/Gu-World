  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "Gu Masters can use it to conceal their aura and cultivation level, a camouflage ability to some degree.",
        "chapters": [
          229
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "fac_gu_masters"
        ]
      },
      {
        "text": "With the Gu in their ears, Fang Yuan and Bai Ning Bing hide their Gu Master aura so a village head cannot sense them, and they can disguise as mortals.",
        "chapters": [
          232
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_bai_ning_bing",
          "sys_gu_master"
        ]
      },
      {
        "text": "Fang Yuan’s Breath Concealment Gu sits on his left ear among his carried Gu.",
        "chapters": [
          273
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt"
      },
      {
        "text": "When he attacks, the concealment drops and his true aura shows. He first uses Breath Concealment Gu, then loses the rank three hide once he strikes.",
        "chapters": [
          280
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt"
      },
      {
        "text": "The same overwrite recurs while he is rank three peak stage showing as middle stage until he attacks.",
        "chapters": [
          316
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
