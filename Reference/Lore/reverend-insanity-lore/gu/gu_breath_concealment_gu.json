  "history": {
    "claims": [
      {
        "text": "Near Zi You mountain, a female dark leopard dies to black-feather pythons and the male dies afterward. Fang Yuan then loots the corpses and pulls two exquisite purple leaves from the male’s left ear and the female’s right ear. The text names them Breath Concealment Gu.",
        "chapters": [
          228
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "loc_zi_you_mountain",
          "char_fang_yuan"
        ]
      },
      {
        "text": "Breath Concealment Gu is a rank three grass Gu; those finds are exquisite purple leaves. Almost all dark leopards there carry one in an ear, but the beasts move in pairs at least at thousand beast king level, so capturing them is hard, and that source is not yet widely known. In Fang Yuan’s previous life, a righteous path figure nicknamed Hunting King, Sun Gan, later hunted dark leopards for these Gu and sold them.",
        "chapters": [
          229
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "form-and-early-rank",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_sun_gan"
        ]
      },
      {
        "text": "Sources conflict:",
        "chapters": [],
        "certainty": "inferred",
        "confidence": "C",
