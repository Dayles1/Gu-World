  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "One phantom already overpowers Fang Yuan’s rank three beast phantoms, and two phantoms stacked escalate that gap further. Habitual Strength Gu is what accumulates the strength that then erupts as those phantoms; after a burst, Habitual Strength Gu begins to accumulate again.",
        "chapters": [
          317
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_habitual_strength_gu"
        ]
      },
      {
        "text": "Three dragon-elephant phantoms can suppress five of Fang Yuan’s beast phantoms. The combination of dragon guts Gu, Dragon Travel Tiger Steps Gu, and dragon-elephant Gu forms a resonance of Dao marks from similar law fragments, which greatly raises the chance of bringing out his dragon-elephant phantom.",
        "chapters": [
          319
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
