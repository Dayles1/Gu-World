  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "It is the rank seven Immortal Gu Fang Yuan had obtained from Bo Qing’s immortal zombie body. Mo Yao activates the Gu so her soul and Bo Qing’s soul trade places. That use saves Bo Qing during a tribulation and deceives the world. Fang Yuan later activates it to trade places with Ying Wu Xie at Yi Tian Mountain.",
        "chapters": [
          1019
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect-and-rank",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_immortal_gu",
          "char_fang_yuan",
          "char_ying_wu_xie",
          "loc_yi_tian_mountain"
        ]
      },
      {
        "text": "Change Soul is a soul path Immortal Gu.",
        "chapters": [
          1023
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect-and-rank",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Mo Yao refined Change Soul Immortal Gu, and it is filled with her will. Because of that will, Fang Yuan refines it first among the Immortal Gu taken from Bo Qing’s body; the sword path Immortal Gu carrying Bo Qing’s will progress more slowly and remain in Hu Immortal blessed land before Yi Tian Mountain.",
        "chapters": [
          1019
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect-and-rank",
        "text_origin": "source_excerpt",
        "mentions": [
          "loc_hu_immortal_blessed_land"
        ]
      },
      {
        "text": "An immortal killer move uses rank seven Change Soul Immortal Gu as its core, together with Attitude Gu, Unravel Mystery, and many dream path and soul path mortal Gu. Fang Yuan receives that move in the dream realm and uses it for the swap with Ying Wu Xie. After the swap, Change Soul and those companion Gu travel with his soul.",
        "chapters": [
          1019
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect-and-rank",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_attitude_gu",
          "gu_unravel_mystery",
          "sys_mortal_gu"
        ]
      }
    ]
  },
