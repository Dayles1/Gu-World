    "claims": [
      {
        "text": "When the four old-timers activate Infinite Search and Lock, Fang Yuan’s left arm shines again and the eight-sided diamond form of Fixed Star Gu is visible. Divine Travel flies into the arm, swallows Fixed Star Gu, and the four old-timers lose their connection as the chains lose their target. After eating Fixed Star Gu, Divine Travel enters hollow Jade Sky Gu and forms a cocoon.",
        "chapters": [
          404
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "refinement-consumption",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_divine_travel",
          "gu_jade_sky_gu"
        ]
      },
      {
        "text": "Fixed Star Gu is the immemorial eight-sided diamond star fragment Bai Ning Bing planted. With Divine Travel, Jade Sky Gu, Fixed Star Gu, and the light of the immemorial era in place, Fang Yuan has the conditions to refine Fixed Immortal Travel.",
        "chapters": [
          405
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "refinement-consumption",
        "text_origin": "source_excerpt"
      }
    ]
  },
  "economy": {
    "canonical_prices": [],
    "price_claims": [
      {
        "text": "At a Shang clan city auction, Fang Yuan skips chasing wind Gu because wind Dao marks would clash with his beast phantoms. He would buy rank four fairy wind Gu for the same recipe line, then sets Fixed Immortal Travel refinement aside: success rate is extremely low and he lacks materials.",
        "chapters": [
          307
        ],
        "certainty": "canon",
        "confidence": "B",
