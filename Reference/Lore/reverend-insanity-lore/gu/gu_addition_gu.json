    "claims": [
      {
        "text": "Fang Yuan had expected Ba Shi Ba’s rank eight rule path Immortal Gu to be consecutive Gu, because Ba Shi Ba’s strongest killer move was the consecutive hit method. Instead it is addition Gu. Consecutive Gu is more famous and more practical in many situations; with rank eight consecutive Gu, Fang Yuan could link killer moves across paths into consecutive moves. Addition Gu disappoints him relative to that hope. Beside this rank eight Gu, Ba Shi Ba also held some rank six and seven Immortal Gu, including two rank seven number Gu named One and Three.",
        "chapters": [
          1791
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "place-among-rule-path-gu",
        "text_origin": "source_excerpt",
        "mentions": [
