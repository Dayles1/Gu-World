          "gu_number_gu"
        ]
      }
    ]
  },
  "appearance": {
    "claims": [
      {
        "text": "It is like a cocoon, pitch black like iron rather than white. When held it feels cold and hard, metallic. The oval black cocoon has no mouth or holes.",
        "chapters": [
          1791
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
