  "feeding": {
    "known": true,
    "food_raw": null,
    "foods": [],
    "claims": [
      {
        "text": "It consumes pearl thread water as food. Submerged in pearl thread water for eight days and nights, the Gu becomes full, and the next feeding is eighty years later. When Fang Yuan inspects it, thirty-six years remain until the next feeding, and Ba Shi Ba already has enough pearl thread water stocked. Feeding a rule path Immortal Gu on that water forced Ba Shi Ba to keep a water path resource point in a mostly rule path aperture.",
        "chapters": [
          1791
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
