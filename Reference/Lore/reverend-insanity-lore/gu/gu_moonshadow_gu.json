  "history": {
    "claims": [
      {
        "text": "The name first appears on the cave wall image when the Gu Yue fourth generation clan leader springs Moonshadow Gu on the Flower Wine Monk. He calls it Moonshadow, says it is the best at hiding, names it rank four, and says it can restrict use of the primeval sea and primeval essence. Watching elders add that the Flower Wine Monk has been inflicted by it, can no longer simply use primeval essence, and that over time even his primeval essence will be threatened.",
        "chapters": [
          15
        ],
        "certainty": "canon",
        "confidence": "B",
