  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "Ordinary Gu Masters often train two to three years before they can fly with it, and five years or more before they dare use it in battle. Activation spends a rush of primeval essence and brings intense pain as bony outgrowths pierce from the backbone and ribs, then converge into two enormous bird-shaped wings whose folded tails can touch the ground. Fang Yuan’s own wings come out pitch black with metallic luster because iron bone Gu and essence iron bone have already remade his skeleton, so the wings are far sturdier than ordinary bone wings. A soft flap can raise a strong whirlwind.",
        "chapters": [
          358
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "fac_gu_masters"
        ]
      }
    ]
  },
