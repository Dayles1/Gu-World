  "history": {
    "claims": [
      {
        "text": "In that legend, Predicaments hunt Ren Zu until three Gu offer aid if he provides for them with his life. He gives his youth to Strength Gu and his prime middle years to the most beautiful of the three, which grants wisdom. With wisdom and strength together he survives for a time, but age still comes, and Strength Gu and Wisdom Gu leave him.",
        "chapters": [
          5
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "intro",
