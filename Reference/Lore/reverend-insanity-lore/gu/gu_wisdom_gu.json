    "claims": [
      {
        "text": "Within Primordial Domain, Ren Zu’s group finally meets wisdom Gu, which is left helpless that Ren Zu found it after it had hidden itself so deeply, and self Gu takes a bite out of it in the end.",
        "chapters": [
          2177
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "found-and-bitten-in-primordial-domain",
        "text_origin": "source_excerpt",
