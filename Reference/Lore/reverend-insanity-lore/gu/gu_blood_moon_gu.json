  "history": {
    "claims": [
      {
        "text": "Fang Yuan finds the Blood Moon Gu recipe in the Gu Yue clan secret room while choosing a rank three attack Gu after he already holds Thunderwings Gu and Sky Canopy Gu.",
        "chapters": [
          157
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_fang_yuan",
          "fac_gu_yue_clan",
          "sys_attack_gu",
          "gu_thunderwings_gu",
          "gu_sky_canopy_gu"
        ]
      },
      {
        "text": "He fails the refinement once and succeeds on the second try, using materials taken from Gu Yue Chi Lian.",
        "chapters": [
          159
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_gu_yue_chi_lian"
        ]
      },
      {
        "text": "In Shang clan city, Tie Ruo Nan presses him about a Gu that gives a strong blood aura and was once used for long-range attack. While presenting himself as Gu Yue Fang Zheng, Fang Yuan takes the Blood Moon Gu from his aperture and tosses it to her. He calls it clan Blood Moon Gu, claims she has seen his brother use it, and says it remained because it was easy to feed after many other Gu starved on the journey. He also uses that story to cover how he and Bai Ning Bing escaped when clan leaders died protecting them. She inspects the Gu and accepts the account.",
        "chapters": [
          303
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "given-to-tie-ruo-nan",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_tie_ruo_nan",
          "char_fang_zheng"
        ]
      },
      {
        "text": "No cited later chapter shows her activating it in a fight. In a later battle-stage clash Ju Kai Bei still speaks as if Fang Yuan holds Blood Moon Gu, and dismisses such a weak attack.",
        "chapters": [
          320
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "given-to-tie-ruo-nan",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_ju_kai_bei"
        ]
      }
    ]
  },
  "attributes": {
    "Path": {
      "text": null,
