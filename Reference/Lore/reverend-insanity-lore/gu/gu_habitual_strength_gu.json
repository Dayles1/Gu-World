    "origin": "unknown",
    "claims": [
      {
        "text": "Current strength path Gu Masters created Habitual Strength Gu to replace All-out Effort Gu after that Gu went extinct. Its lower rank is the rank three store strength Gu. Store strength Gu can store energy and release it slowly attack after attack, but the Gu Master cannot move while charging it, so it sees little use. Refining that Gu into rank four Habitual Strength Gu removes that immobility weakness.",
        "chapters": [
          316
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
