  "economy": {
    "canonical_prices": [],
    "price_claims": [
      {
        "text": "Qin Bai Sheng presents Ma Hong Yun as the recognized inheritor who has had fortune rivalling heaven Immortal Gu used on him. Hall talk treats it as rank eight and as a consumable Gu that can be used only once. Qin Bai Sheng states that the luck path true inheritance details do not contain the Immortal Gu recipe, but do contain a method to reverse refine the used fortune rivalling heaven Immortal Gu and recover the original Immortal Gu, with Ma Hong Yun as the main material. Old Ancestor Xue Hu buys Ma Hong Yun at that auction. Luck Inspection Immortal Gu below rank eight can see only a portion of Fortune Rivalling Heaven when the target uses no concealment; rank eight luck inspection Immortal Gu is required to see its true appearance.",
        "chapters": [
          761
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "auction-and-refinement",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_qin_bai_sheng",
          "sys_gu_recipe",
          "char_old_ancestor_xue_hu",
          "gu_luck_inspection_immortal_gu"
        ]
      },
      {
        "text": "Old Ancestor Xue Hu states that acts which would harm its owner draw backlash that suppresses the attackers’ luck, and that Gu Immortals remain affected because Fortune Rivalling Heaven stands above ordinary luck protection. He plans the refinement with Lady Wan Shou, using Ma Hong Yun as the main material to save resources compared with refining from scratch, while still preparing further luck path Immortal Gu to protect their own luck against the backlash.",
        "chapters": [
          772
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "auction-and-refinement",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_gu_immortal",
          "char_lady_wan_shou"
        ]
      },
      {
        "text": "Lang Ya land spirit states that Giant Sun Immortal Venerable refined Fortune Rivalling Heaven in his later years, and that Dog Shit Luck was his vital Immortal Gu in his early years.",
        "chapters": [
          1029
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "auction-and-refinement",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_lang_ya_land_spirit",
          "gu_dog_shit_luck"
        ]
      },
      {
        "text": "Old Ancestor Xue Hu and Lady Wan Shou begin refining fortune rivalling heaven Immortal Gu at Snowy Mountain blessed land.",
        "chapters": [
          1144
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "auction-and-refinement",
        "text_origin": "source_excerpt",
        "mentions": [
          "loc_snowy_mountain"
        ]
      }
    ],
