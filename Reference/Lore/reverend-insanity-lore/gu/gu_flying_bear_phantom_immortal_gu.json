  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "As Wolf King Chang Shan Yin, Fang Yuan demands the Immortal Gu. Hei Lou Lan weighs that a single thought and a toss can turn the Gu into the flying bear phantom for combat with half-immortal battle strength, that its food is desolate beast flying bear flesh and blood, and that he needs a strength path Immortal Gu more than this phantom path Gu, then gives it to Fang Yuan for compensation and continued help. Fang Yuan restores it through Hu Immortal blessed land and treasure yellow heaven, then tests it against his own six arm heavenly zombie king form. Mo Yao’s will states that the Gu was created by killing a desolate beast flying bear and refining all of its skin, bones, flesh, blood, and soul, and that alone it has half the real flying bear’s strength, with accompanying Gu able to raise that further.",
        "chapters": [
          586
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "transfer-and-use",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_chang_shan_yin",
          "loc_hu_immortal_blessed_land",
          "loc_treasure_yellow_heaven",
          "char_mo_yao"
        ]
      },
      {
        "text": "Fang Yuan throws flying bear phantom Gu and it blossoms into the giant flying bear form. The text states that this Immortal Gu is special in that it can be activated with just one’s mind, without requiring immortal essence, while feeding still needs fresh desolate beast flying bear flesh.",
        "chapters": [
          624
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "activation-without-immortal-essence",
        "text_origin": "source_excerpt"
      }
    ]
  },
