  "history": {
    "claims": [
      {
        "text": "While guarding heaven form, Fang Yuan refines a new heaven path Immortal Gu in the sovereign immortal aperture. Heaven path Immortal Gu Heavenly Web, at rank eight, is the core of the heaven path killer move heavenly web protection veil. In Crazed Demon Cave, Paradise Earth used that move multiple times; its defense is treated as on par with reverse flow protection seal.",
        "chapters": [
          2227
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_fang_yuan",
          "sys_immortal_gu",
          "path_heaven",
          "loc_crazed_demon_cave",
          "char_paradise_earth_immortal_venerable"
        ]
      },
      {
        "text": "After Fang Yuan kills Paradise Earth, only two heaven path Immortal Gu remain among what he finds in that aperture line: heavenly web Gu and heavenly birth Gu. Paradise Earth’s will destroyed those Immortal Gu before death, so Fang Yuan must refine them again; heavenly web Gu is the first he completes.",
        "chapters": [
          2227
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_heavenly_birth_gu"
        ]
      },
      {
        "text": "Paradise Earth lacked heavenly secret Immortal Gu, so he used heavenly web Gu as the core with large amounts of heaven path immortal materials for related concealment work.",
        "chapters": [
          2229
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "obscured-heavenly-secret",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Heavenly Web is later listed among the heaven path Immortal Gu Fang Yuan holds, alongside Heavenly Secret, Heaven’s Envy, and Heavenly Birth.",
        "chapters": [
          2285
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "listed-among-fang-yuans-heaven-path-immortal-gu",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_heavens_envy_gu"
        ]
      }
    ]
  },
