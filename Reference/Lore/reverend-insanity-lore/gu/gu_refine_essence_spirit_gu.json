  "history": {
    "claims": [
      {
        "text": "Dong Fang Yu Liang activates it after heavy wisdom path deductions leave his soul fatigued. His body thins at once as the Gu turns vitality into soul resources, and the fatigue fades while hunger follows. He classes it as a secretly passed down Gu of Dong Fang tribe that heals the soul well without fixing the deeper drain of repeated deduction.",
        "chapters": [
          505
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_dong_fang_yu_liang",
          "path_wisdom",
          "fac_dong_fang_tribe"
        ]
      },
      {
        "text": "Among Dong Fang tribe resources after the contest, Fang Yuan takes refine essence spirit Gu and its recipe together. He names it Dong Fang tribe’s specialty Gu worm, and rumor holds that Dong Fang Chang Fan created the recipe to cultivate wisdom path. Fang Yuan wants it because enslavement path command of beast groups exhausts his soul while his body stays strong, so the Gu can bridge those two demands.",
        "chapters": [
          522
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
