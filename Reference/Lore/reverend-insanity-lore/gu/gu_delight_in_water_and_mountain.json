  "history": {
    "claims": [
      {
        "text": "While refining control over Water Pavilion, Fang Yuan finds two assisting Immortal Gu beside the rank seven core Water Harmony Gu: rank six movement Immortal Gu Worldly Wave Trace and wisdom path Immortal Gu Delight in Water and Mountain.",
        "chapters": [
          568
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "house_water_pavilion",
          "char_fang_yuan",
          "sys_immortal_gu",
          "gu_water_harmony_gu",
          "gu_worldly_wave_trace",
          "path_wisdom"
        ]
      },
      {
        "text": "Mo Yao’s will states that delight in water and mountain Gu can only create joyful will, and that other Gu convert that joyful will into her fake will.",
        "chapters": [
          645
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "joyful-will",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_mo_yao"
        ]
      },
      {
        "text": "Fang Yuan later holds it as a rank six wisdom path Immortal Gu that creates joyful will, and he withholds activating it while immortal essence is scarce.",
        "chapters": [
          653
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "joyful-will",
        "text_origin": "source_excerpt"
      }
    ]
