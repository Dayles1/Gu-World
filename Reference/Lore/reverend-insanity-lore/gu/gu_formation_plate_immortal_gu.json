  "history": {
    "claims": [
      {
        "text": "While placing a transportation Gu formation, Fang Yuan mainly supplies immortal essence while an Immortal Gu sets the formation. That Gu is rank six formation plate Gu.",
        "chapters": [
          1089
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_gu_formation",
          "char_fang_yuan",
          "sys_immortal_gu"
        ]
      },
      {
        "text": "If Lang Ya land spirit refuses to lend formation plate Immortal Gu, Fang Yuan expects he will need other people’s immortal apertures for the work.",
        "chapters": [
          1416
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "negotiation-stall",
        "text_origin": "source_excerpt"
      },
      {
        "text": "After he obtains formation flag Immortal Gu, he notes that with that Gu he will not need to negotiate with Lang Ya land spirit or borrow formation plate Immortal Gu.",
        "chapters": [
          1418
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "formation-flag-alternative",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_formation_flag_immortal_gu"
        ]
      },
      {
        "text": "Formation plate Immortal Gu remains among Lang Ya blessed land’s Immortal Gu inventory, listed with Heavenly Essence Treasure Imperial Lotus, wood sprout Immortal Gu, beast enslavement Immortal Gu, and others, most of which have already been given out to hairy man Gu Immortals for use.",
        "chapters": [
          1758
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
