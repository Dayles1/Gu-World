    "claims": [
      {
        "text": "Lang Ya Sect’s formation plate Immortal Gu can be borrowed, but it is only rank six while the self cleansing immortal formation is rank seven, so using it for that formation has a high chance of failure. The Gu also records Lang Ya Sect’s sub-main teleportation Gu formation. To load the self cleansing formation, Fang Yuan would need to erase that content, then set the new formation once so formation plate Gu can reproduce it afterward. Lang Ya Sect has no formation path Gu Immortals and relies on this Immortal Gu for those teleportation formations, so erasing the recorded details would cost the sect that ability, which Lang Ya land spirit will not accept. They also lack information path methods to extract what formation plate Gu records.",
        "chapters": [
          1415
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "rank-six-borrow-limit",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_lang_ya_land_spirit"
        ]
      }
    ]
  },
  "appearance": {
    "claims": [
      {
        "text": "It is like a round plate, a porcelain plate used to hold rice and vegetables. It floats above Fang Yuan’s head while it mobilizes Gu worms into place.",
        "chapters": [
          1089
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "appearance",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_gu_worms"
        ]
      }
    ],
    "visual_confidence": "text_described"
  },
  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "Its effect is to use all sorts of Gu worms to set up a Gu formation on its own. The Gu Immortal only needs to provide immortal essence and does not need formation path attainment. Immortal level formation plate Gu is one of the support Gu Fang Yuan wants when turning the killer move self cleansing into an immortal Gu formation, and Lang Ya Sect already has one. Formation chart Gu records formation information with a similar role but smaller chance of error than formation plate Gu.",
        "chapters": [
          1410
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_gu_immortal",
          "fac_lang_ya_sect"
        ]
      }
    ]
  },
