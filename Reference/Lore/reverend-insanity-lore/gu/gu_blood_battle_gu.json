  "history": {
    "claims": [
      {
        "text": "Immortal Crane Sect elders call Blood Sea Ancestor someone who achieved great success in blood path, and they place blood battle Gu in the same breath as blood skull Gu, blood handprint Gu, blood qi Gu, blood sweat Gu, menses blood Gu, blood shadow Gu, the ancient desolate beast violent blood dragon bat, and the rank six Immortal Gu blood deity.",
        "chapters": [
          407
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
