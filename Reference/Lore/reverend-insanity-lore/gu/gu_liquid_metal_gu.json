  "appearance": {
    "claims": [
      {
        "text": "In the purple crystal primeval sea, it is a yellow-gold current like melted gold swimming at the bottom. It is liquid form and can change its shape at will; even if broken through, it can regather like water.",
        "chapters": [
          379
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "appearance",
        "text_origin": "source_excerpt"
      },
      {
        "text": "In Tie Mu Bai’s purple crystal primeval sea, liquid metal Gu appears as a yellow-gold current like melted gold swimming at the bottom. It is rank five. Once activated it has great defenses. It is liquid form and can change shape at will; even if broken through, it can regather like water. If Tie Mu Bai used it, Fang Yuan could not break that defense even at full strength. Fang Yuan excavates Tie Mu Bai’s Gu worms, including this rank five Gu, and keeps them in his aperture.",
        "chapters": [
          379
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "form-and-effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_tie_mu_bai",
          "char_fang_yuan",
          "sys_gu_worms"
        ]
      }
    ],
    "visual_confidence": "text_described"
  },
  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "Fang Yuan uses liquid metal Gu to block frost.",
        "chapters": [
          403
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "frost-block-use",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Fang Yuan pours primeval essence into rank four bone wings Gu and rank five liquid metal Gu. Liquid metal covers his whole body like paint, spreads onto the black wings, and dyes him in dazzling golden light as he flies into the river of light.",
        "chapters": [
          404
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "light-stream-defense",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_bone_wings_gu"
        ]
      },
      {
        "text": "Facing a rank five Gu Master’s strong killer move, liquid metal Gu’s defense starts to become useless, and the golden protection is washed away. Liquid metal Gu dies; golden aurora Gu and others are greatly damaged. As the liquid metal fades, Fang Yuan’s identity is revealed.",
        "chapters": [
          405
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "defense-failure",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_gu_master"
        ]
      }
    ]
  },
