  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "After Iron Hand Gu hardens the hands, the palm edges become sharp as a blade, and the two sides of the forearm also become dull blades. With that pair Tie Dao Ku can chop with both arms, rotate them like a windmill, and force close range exchanges that crack Bai Ning Bing’s iceblades and drive her back over a hundred steps before she recovers distance.",
        "chapters": [
          298
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Tie Dao Ku rushes Fang Yuan while activating Hand Blade Gu and Swift Shadow Gu, and his arms slash long wounds across Fang Yuan’s chest.",
        "chapters": [
          360
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "rush-attack-and-chest-wounds",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_fang_yuan"
        ]
      }
    ]
  },
  "feeding": {
    "known": true,
    "food_raw": null,
    "foods": [],
    "claims": [
      {
        "text": "He meets Fang Yuan head on with Swift Shadow Gu, Hand Blade Gu, Iron Hand Gu, Consecutive Slash Gu, Quick Battle Gale, and Blade Qi Gu in one barrage that breaks Golden Shield Gu and tears bronze skin before his primeval essence runs dry. Fang Yuan then breaks his neck.",
