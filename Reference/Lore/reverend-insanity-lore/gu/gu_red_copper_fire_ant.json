  "history": {
    "claims": [
      {
        "text": "It is golden in color and as large as a mountain, and it resembles red copper. Fang Yuan obtains it as one of three Immortal Gu, the other two being a heavily injured fire path Immortal Gu and white noodle queen ant. Fang Yuan can still barely see its origin: it should have been an arrow ant, whose mouth shoots sharp spikes and which, after shooting three, is too weak to fight even a worker ant.",
        "chapters": [
          2108
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_fang_yuan",
          "sys_immortal_gu"
        ]
      },
      {
        "text": "The lingering poisonous ant plague gave birth to two Immortal Gu, red copper immortal ant Gu and white noodle immortal ant Gu. With a slight change there might be another kind of Immortal Gu, such as dark-gold immortal ant or black noodle immortal ant.",
        "chapters": [
          2136
        ],
        "certainty": "canon",
