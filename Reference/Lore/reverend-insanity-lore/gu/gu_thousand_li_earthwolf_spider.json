  "appearance": {
    "claims": [
      {
        "text": "It has a large body.",
        "chapters": [
          46
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "appearance",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Its entire body is pitch black and emits a metallic glow like iron and steel. Its chest and back armor are thick. It has three pairs of legs, each tipped with spiral-shaped feelers like a drill.",
        "chapters": [
          188
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "appearance",
        "text_origin": "source_excerpt"
      },
      {
        "text": "It is rank five and steed-type, and both Jia Jin Sheng and Fang Yuan treat the body as massive: too large to leave the inheritance cave through the crack they used. Fang Yuan also notes that the Photo-audio fight recording never shows the Monk summoning it.",
        "chapters": [
          46
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "form-and-rank",
        "text_origin": "source_excerpt"
      }
    ],
    "visual_confidence": "text_described"
  },
  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "Its attested use is underground travel. It digs tunnels through soil and rock, and a Gu Master rides it as a steed.",
