    "foods": [],
    "claims": [
      {
        "text": "Dragon breath Gu is quite difficult to refine because its material is the breath of dragons. Only a living dragon can send out breath that can then be used as that material. Other living dragons besides a sword dragon can also supply breath for a Gu of this name, but those products can differ slightly and may need other mortal Gu to remove the differences. Fang Yuan notes that adding dragon breath mortal Gu into sword dragon transformation should increase how many times he can use dragon breath.",
        "chapters": [
          1198
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
