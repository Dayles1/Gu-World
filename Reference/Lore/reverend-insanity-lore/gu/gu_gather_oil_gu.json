  "history": {
    "claims": [
      {
        "text": "Fang Yuan refines gather oil Gu, distributes copies, and goes into the sea to collect most of the black oil while leaving a small amount for fishing-village Gu Masters.",
        "chapters": [
          1657
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_fang_yuan",
          "fac_gu_masters"
        ]
      },
      {
        "text": "Xia Lin obtains gather oil Gu from him and raises her efficiency collecting oil, quickly gathering many primeval stones from selling it.",
        "chapters": [
          1659
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_xia_lin"
        ]
      },
      {
        "text": "At Sea God’s Spring, Xia Lin empties a vat of black oil with gather oil Gu, leaving only a golden needle at the bottom. Onlookers recognize the rank five aura and name it the gather oil Gu that has been the hot topic recently. A rank two Gu Master can still activate that rank five Gu.",
        "chapters": [
          1664
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "public-test",
        "text_origin": "source_excerpt"
      }
    ]
