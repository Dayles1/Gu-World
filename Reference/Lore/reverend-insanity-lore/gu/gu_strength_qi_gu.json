  "history": {
    "claims": [
      {
        "text": "In Shang clan city, after Bai Ning Bing’s loss, Ju Kai Bei shows Hard Qi Gu beside Yan Tu and names a two or three times battle strength surge if it were Strength Qi Gu. Yan Tu answers that ancient qi path has already disappeared and that strength qi Gu is extinct.",
        "chapters": [
          315
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "loc_shang_clan_city",
          "char_bai_ning_bing",
          "char_ju_kai_bei",
          "gu_hard_qi_gu",
          "char_yan_tu"
        ]
      },
      {
        "text": "His second aperture still holds rank three Strength Qi Gu that can condense beast phantoms into solid form.",
        "chapters": [
          504
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "northern-plains-scarcity",
        "text_origin": "source_excerpt"
      },
      {
        "text": "By then Strength Qi Gu is already extinct in the mortal markets. His copy came from reverse refining rank four atmosphere Gu, and further copies would need Northern Plains atmosphere Gu reverse refined the same way. At rank five cultivation that rank three Gu helps him very little, yet the text still calls Strength Qi Gu extremely important to strength path Gu Masters even when it is not the core Gu.",
        "chapters": [
          517
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "northern-plains-scarcity",
        "text_origin": "source_excerpt",
        "mentions": [
          "reg_northern_plains"
        ]
      }
    ]
  },
