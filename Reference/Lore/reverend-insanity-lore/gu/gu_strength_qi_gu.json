  "economy": {
    "canonical_prices": [],
    "price_claims": [
      {
        "text": "Fang Yuan reverse refines it from rank four atmosphere Gu in closed door work after buying that Gu at auction. Atmosphere Gu and Strength Qi Gu are both qi path Gu with similar laws, so refinement can convert one into the other. The conversion uses more than twenty ingredients across more than thirty precise steps. Success rate sits above eighty percent. In his previous life that recipe became publicly known among recipe masters only after two hundred years.",
        "chapters": [
          320
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "refinement",
        "text_origin": "source_excerpt",
        "mentions": [
