  "history": {
    "claims": [
      {
        "text": "Fang Yuan takes a burial soul toad from his aperture while arranging rockmen labor after the fox battles on Dang Hun Mountain. It is also called soul burial toad.",
        "chapters": [
          413
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_fang_yuan",
          "loc_dang_hun_mountain"
        ]
      },
      {
        "text": "The toad begins as Hu Immortal’s leftover Gu on Dang Hun Mountain, then sits in Fang Yuan’s kit.",
        "chapters": [
          413
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "ownership",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Burial soul toad is still listed among Gu kept in Hu Immortal blessed land rather than only in his aperture.",
        "chapters": [
          581
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "ownership",
        "text_origin": "source_excerpt",
        "mentions": [
          "loc_hu_immortal_blessed_land"
        ]
      },
      {
        "text": "Before Fang Yuan leaves the blessed land again for northern plains, he hands burial soul toad to Little Hu Immortal.",
        "chapters": [
          616
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "ownership",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_little_hu_immortal"
        ]
      }
    ]
  },
