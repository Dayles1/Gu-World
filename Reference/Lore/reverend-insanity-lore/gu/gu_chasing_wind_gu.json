    "price_claims": [
      {
        "text": "At a Shang clan city auction, the host presents Chasing Wind Gu as the twelfth item: a rank four movement Gu that lets a Gu Master have the speed to chase after winds. The base bid is a hundred and eighty thousand primeval stones.",
        "chapters": [
          307
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "loc_shang_clan_city",
          "sys_movement_gu",
          "sys_gu_master"
        ],
        "needs_review": true
      },
      {
        "text": "Bidding becomes the first climax of that auction. When the price reaches three hundred and fifty thousand, only Yi Bu Hui of Yi clan and Fei Luan Feng of Fei clan remain. Yi clan and Fei clan do not have a good relationship, and Yi Bu Hui eventually buys the Gu for four hundred and forty thousand.",
        "chapters": [
          307
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "auction-sale",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_yi_bu_hui",
          "fac_yi_clan",
          "char_fei_luan_feng",
          "fac_fei_clan"
        ]
      },
      {
        "text": "Fang Yuan holds over two million primeval stones but does not take the lot. He notes that if the lot had been rank four Fairy Wind Gu instead, he would buy it. Market talk later places Bitter Strength Gu around three hundred and eighty thousand, lower than Chasing Wind Gu.",
        "chapters": [
          307
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "auction-sale",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_fairy_wind_gu",
          "gu_bitter_strength_gu"
        ]
      }
