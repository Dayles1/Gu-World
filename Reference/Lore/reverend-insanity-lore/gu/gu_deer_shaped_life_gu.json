  "history": {
    "claims": [
      {
        "text": "In The Legends of Ren Zu, wisdom Gu sends Northern Dark Ice Soul and Desolate Ancient Moon into a still blue sea that holds many life Gu. Those life Gu are like blue gems of many sizes and shapes, including beasts and other forms, but not the human shaped life Gu they seek.",
        "chapters": [
          591
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_the_legends_of_ren_zu",
          "gu_wisdom_gu",
          "char_northern_dark_ice_soul",
          "char_desolate_ancient_moon"
        ]
      },
      {
        "text": "The moment they leave the blue sea, that deer shaped life Gu lets out a soft light, jumps onto the sand, and turns into a fawn. Desolate Ancient Moon later uses that change to argue that a human shaped life Gu would become a living human, and that they themselves are human shaped life forms.",
        "chapters": [
          591
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "ashore-change",
        "text_origin": "source_excerpt"
      }
