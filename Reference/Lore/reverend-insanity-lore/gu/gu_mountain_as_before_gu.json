  "history": {
    "claims": [
      {
        "text": "Tai Bai Yun Sheng holds it as one of two rank five Gu that northern plains people recognize him for, paired with River As Before Gu. Both are named time path Gu worms.",
        "chapters": [
          524
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_tai_bai_yun_sheng",
          "gu_river_as_before_gu",
          "path_time",
          "sys_gu_worms"
        ]
      },
      {
        "text": "When Gu tribe piles stones into a mountain over about ten days, Tai Bai Yun Sheng walks to the front of Hei tribe’s formation, feeds primeval essence into a silver light that becomes a pillar, and names the move mountain as before. Intercepting attacks do not stop the pillar. Humans and beasts stay unhurt while the mountain stones vanish at a visible speed, and Gu tribe’s army falls from hundreds of feet up. On that same day he then persuades Gu tribe to join Hei Lou Lan rather than pressing the slaughter.",
        "chapters": [
          524
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "gu-tribe-stone-mountain",
        "text_origin": "source_excerpt",
        "mentions": [
          "fac_gu_tribe",
          "fac_hei_tribe",
          "race_humans"
        ]
      }
    ]
  },
