  "history": {
    "claims": [
      {
        "text": "When Zhen Yuan Zi’s Gu formation collapses, the formation spirit salvages formation flag Immortal Gu and tells Dancer Hong Yun to use it to keep the remaining formation in the Gu before placing that formation into her immortal aperture. Zhen Yuan Zi created formation flag Gu to supplement formation spirit Immortal Gu because he understood that Gu’s limitations.",
        "chapters": [
          1415
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_zhen_yuan_zi",
          "sys_gu_formation",
          "char_dancer_hong_yun",
          "gu_formation_spirit_immortal_gu"
        ]
      },
      {
        "text": "In Mini Central Continent he sets up a self cleansing immortal Gu formation that uses self love Immortal Gu as the core and formation flag Immortal Gu as the supplement. Once activated it cleanses harmful dao marks constantly, and because of formation flag Immortal Gu the formation can be moved temporarily: he can take it out for use or place it back into the sovereign immortal aperture.",
        "chapters": [
          1422
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "self-cleansing-formation",
