  "economy": {
    "canonical_prices": [],
    "price_claims": [
      {
        "text": "In Shang clan city, Fang Yuan prices the bone spike Gu at seven thousand primeval stones at Tong Ou shop. The shop elderly does not dare test it, notes the mutual injury and the need for a healing Gu, and offers six thousand five hundred; Fang Yuan gives way to six thousand seven hundred, and the elderly agrees. Together with the bone spear Gu and spiral bone spear Gu priced in that visit, Fang Yuan totals forty thousand six hundred and twenty primeval stones.",
        "chapters": [
          262
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "sale-in-shang-clan-city",
        "text_origin": "source_excerpt",
        "mentions": [
          "loc_shang_clan_city",
          "gu_bone_spear_gu",
          "gu_spiral_bone_spear_gu"
        ]
      },
      {
        "text": "That Tong Ou package does not leave his hands there. When the elderly presses for the white bone recipe at a low price and then threatens that other shops will not buy either, Fang Yuan keeps the Gu worms and leaves. Other shops then refuse the sale and send him back toward Tong Ou.",
        "chapters": [
          262
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "sale-in-shang-clan-city",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_gu_worms"
        ]
      },
      {
        "text": "After buying the recipe, Shang Ya Zi buys the bone spear Gu, spiral bone spear Gu and bone spike Gu from Fang Yuan for the forty thousand six hundred and twenty primeval stones of their original agreement.",
        "chapters": [
          268
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "sale-in-shang-clan-city",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_shang_ya_zi"
        ]
      }
    ],
