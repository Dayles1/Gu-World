  "appearance": {
    "claims": [
      {
        "text": "It is about fist sized and like a ball cactus, with thorns like bone spikes all over its surface. It is somewhat heavy.",
        "chapters": [
          223
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "appearance",
        "text_origin": "source_excerpt"
      }
    ],
    "visual_confidence": "text_described"
  },
  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "It is a typical Gu that damages both enemy and user: if the enemy takes a thousand damage, the user takes about eight hundred. When activated, the Gu Master’s skeleton changes and sharp, hard bone spikes protrude. Those spikes pierce the user’s own flesh and skin before they can confront the enemy. Pain is secondary to the need for a matching healing Gu; without one, the user can be seriously injured even if the enemy does not die.",
        "chapters": [
          223
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_gu_master",
          "sys_healing_gu"
        ]
      },
      {
        "text": "Bai Ning Bing loses interest once she hears that cost, because using bone spikes Gu would first remove her ice muscle, a loss rather than a gain for her. Fang Yuan is also not too interested, but still refines the rank three Gu into his aperture for the moment.",
        "chapters": [
          223
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt"
      }
    ]
  },
