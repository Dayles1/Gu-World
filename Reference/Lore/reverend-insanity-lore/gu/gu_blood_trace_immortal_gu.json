    "claims": [
      {
        "text": "Fang Yuan asks how Ding Qi knew he took the inheritance, and Ding Qi answers that he has blood trace Immortal Gu. When Ding Qi activates it, blood colored shadows appear and form a series of movements: Fang Yuan entering a bubble and taking an information path inheritance. That showing draws Zhou Li and Tang Song’s anger toward Fang Yuan.",
        "chapters": [
          1157
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_zhou_li",
          "char_tang_song"
        ]
      },
      {
        "text": "Ding Qi had also used blood trace Immortal Gu to make arrangements at the site before the larger chase closed in.",
        "chapters": [
          1157
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt"
      }
    ]
  },
