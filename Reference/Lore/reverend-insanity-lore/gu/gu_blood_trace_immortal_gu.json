    "claims": [
      {
        "text": "Later Fang Yuan lists blood trace Gu among his blood path Immortal Gu, with blood oath Gu. He states that Eastern Sea’s blood path demonic immortals Ding Yan and Ding Qi created them, that one was for investigation and the other could achieve an information path effect, that he did not obtain the recipes from them, that he knew those two Immortal Gu were destroyed, and that he refined them through natural inspiration plus his own deductions.",
        "chapters": [
          2252
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "fang-yuan-refinement",
        "text_origin": "source_excerpt",
