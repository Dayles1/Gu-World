    "activation_raw": null,
    "claims": [
      {
        "text": "He activates rank four Gather Light Gu. Large amounts of sunlight gather on his palms and turn into a huge, flawless ball of light. With that sunlight ball formed, he activates rank five Extreme light Gu so the ball takes on the glory of the immemorial era, then rank five River Under the Sun Gu, which turns the ball into a river of light. Torrential Light Stream pours that river into the blessed land, shatters the purple barrier over the bronze hall, and drives into the hall.",
        "chapters": [
          397
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
