  "history": {
    "claims": [
      {
        "text": "In her first shown clash on poison grassland she kills three poison beard wolves at once and wounds five or six more before more wolves press her.",
        "chapters": [
          427
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt"
      },
      {
        "text": "While Fang Yuan carries her and cannot attack, he tells her the next opening depends on whether her spiral water arrow is accurate. She shoots on his cue and pierces a shadow crow.",
        "chapters": [
          429
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "aimed-shots",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Against a white bone wheel she later fires three spiral water arrows in a row.",
        "chapters": [
          430
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "aimed-shots",
        "text_origin": "source_excerpt"
      },
      {
        "text": "A Gu Master behind Ge Guang shouts a spiral water arrow warning as a wind wolf leaps. A blue water arrow with strong rotational force then shoots from behind Ge Guang into the wolf’s mouth and kills it.",
        "chapters": [
          437
        ],
        "certainty": "canon",
