  "appearance": {
    "claims": [
      {
        "text": "In that dream it concentrates as a scarlet bee with an intimate bond to its owner.",
        "chapters": [
          1511
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "appearance",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Fang Yuan inspects the Gu as a bee the size of an adult fist, body covered in alternating gold and black stripes and a thin red radiance that brightens when it moves. Its stinger is extremely thin and sharp, longer than the body and reaching an adult’s forearm length.",
        "chapters": [
          1751
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "appearance-after-inspection",
        "text_origin": "source_excerpt"
      }
    ],
    "visual_confidence": "text_described"
  },
  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "Used alone, its red light takes lifespan from lifeforms in range, including the user’s side. Thieving Heaven Demon Venerable left methods so it can activate only thrice before self-detonating, fearing world chaos if it were used freely.",
        "chapters": [
          1581
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "effect-and-limits",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_thieving_heaven_demon_venerable"
        ]
      },
      {
        "text": "Lang Ya land spirit holds Thieving Heaven Demon Venerable’s rank eight steal life Immortal Gu, left to Long Hair Ancestor, and uses it against Heavenly Court’s four immortals during the Lang Ya defense.",
        "chapters": [
          1581
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "lang-ya-defense",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_lang_ya_land_spirit",
          "char_long_hair_ancestor",
          "fac_heavenly_court",
          "fac_lang_ya_sect"
        ]
      },
      {
        "text": "After a second use attempt, Chen Yi’s karma divine tree destroys the Gu.",
        "chapters": [
          1582
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "lang-ya-defense",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_chen_yi"
        ]
      },
      {
        "text": "His will states that normal use steals others’ lifespan dao marks, that a killer move he created can raise the user’s own lifespan (inferior to lifespan Gu), and that reverse use gives the user’s lifespan to another target.",
        "chapters": [
          1782
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "will-on-use",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_lifespan_gu"
        ]
      }
    ]
  },
