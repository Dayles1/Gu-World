  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "Ye Lui Sang states that Battle Space Gu is a rank five space path Gu worm. Once activated, it sends both the enemy and the user into a unique space where they fight to the death, and they leave only when a winner is decided or the time runs out. For a Gu Master user, maintaining that space spends primeval essence constantly, and the space vanishes when that essence runs out.",
        "chapters": [
          584
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_ye_lui_sang",
          "sys_gu_master"
        ]
      },
      {
        "text": "The flying bear phantom’s copy is a wild Gu that draws primeval energy from the air, so that time limit does not end while that supply continues. Fang Yuan judges the effect has a limited range and that fighting from outside that range avoids it.",
        "chapters": [
          584
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_wild_gu",
          "char_fang_yuan"
        ]
      },
      {
        "text": "After that battle, Battle Space Gu is taken by Hei Lou Lan, and the flying bear’s remaining Gu worms are taken by other people.",
        "chapters": [
          586
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "post-battle-possession",
        "text_origin": "source_excerpt"
      }
    ]
  },
