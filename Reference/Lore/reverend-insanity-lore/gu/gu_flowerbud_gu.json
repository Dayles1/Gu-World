  "appearance": {
    "claims": [
      {
        "text": "It is shaped like a flower, light blue in colour, crystal in material, and shines clearly under sunlight.",
        "chapters": [
          283
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "appearance",
        "text_origin": "source_excerpt"
      },
      {
        "text": "It is rank two and used to store items.",
        "chapters": [
          283
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "form-and-rank",
        "text_origin": "source_excerpt"
      },
      {
        "text": "It is Li Ran’s storage Gu, and he keeps a stellar stone inside it at home rather than taking that stone onto the battle stage.",
        "chapters": [
          283
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "form-and-rank",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_storage_gu"
        ]
      }
    ],
    "visual_confidence": "text_described"
  },
  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "It stores physical goods. When Fang Yuan’s mind enters the Gu he sees a large sack of rice, daily necessities, a poor quality block of compressed tea, thirty to forty primeval stones, and a few fossils, with the stellar stone among them.",
        "chapters": [
          283
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Activation uses primeval essence. Fang Yuan injects essence and a black light flies out of the Flowerbud Gu, landing in his palm as the stellar stone.",
        "chapters": [
          283
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt"
      }
    ]
  },
