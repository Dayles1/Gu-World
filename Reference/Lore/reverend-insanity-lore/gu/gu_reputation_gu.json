  "appearance": {
    "claims": [
      {
        "text": "Reputation Gu is like a chrysanthemum with golden yellow petals and a fragrance.",
        "chapters": [
          287
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "appearance",
        "text_origin": "source_excerpt"
      },
      {
        "text": "A later Ren Zu stretch repeats that Verdant Great Sun obtained reputation Gu which looked like a chrysanthemum.",
        "chapters": [
          357
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "appearance",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_verdant_great_sun"
        ]
      }
    ],
    "visual_confidence": "text_described"
  },
  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "Verdant Great Sun wakes from a drunk stretch on a lone hill ringed by the ordinary abyss, having forgotten what happened while drunk, and knows no living being has ever flown past that abyss. In Xi Yu forest there, the trees whisper that reputation Gu lies under a rock at the forest center; he lifts that rock and obtains it. The Gu thanks him and teaches him how to cross the ordinary abyss. With the Gu in his mouth he shouts without making ordinary sound; vibrations shake the abyss and a golden bridge forms in midair, yet hunger limits how far that bridge can stretch. Reputation Gu says reputation itself has no voice, but can spread wide and create tremors. Placed between his buttcheeks, it turns into a chrysanthemum cave; the last forced breath then builds a far longer bridge, and he crosses to safety. The telling closes that a shitty reputation is easier to obtain and maintain than a good one.",
        "chapters": [
          287
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "legend-effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "loc_xi_yu_forest"
        ]
      },
      {
        "text": "A later Ren Zu stretch says he caused an incident while drunk, was trapped in the ordinary abyss, and profited from the disaster by obtaining reputation Gu. Because of reputation Gu, Verdant Great Sun’s reputation grows until the world also spreads that he is a huge drunkard.",
        "chapters": [
          357
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "legend-effect",
        "text_origin": "source_excerpt"
      }
    ]
  },
  "feeding": {
    "known": true,
    "food_raw": null,
    "foods": [],
    "claims": [
      {
        "text": "At the Door of Life and Death, Verdant Great Sun tells Ren Zu he had reputation Gu in his life and bathed in the light of glory. Ren Zu urges him to throw away the reputation Gu. Verdant Great Sun answers that they were not born with fame and fortune and cannot take them after death, then that after he died reputation Gu left him and it is fixed immortal travel Gu that has accompanied him.",
        "chapters": [
          411
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "after-death",
        "text_origin": "source_excerpt",
        "mentions": [
          "loc_door_of_life_and_death",
