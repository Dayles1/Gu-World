  "appearance": {
    "claims": [
      {
        "text": "They are about fist sized and look alike, like silkworms. On the head are two compound eyes like bees or dragonflies, colourful and like shiny glass. The surface is not soft but covered in an insect shell with golden lustre, and the bodies come in many colours.",
        "chapters": [
          156
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "appearance",
        "text_origin": "source_excerpt"
      },
      {
        "text": "They are rank two Digital Shade Gu, a recording type of Gu worm. One step further in advancement is the rank three Photo-audio Gu.",
        "chapters": [
          156
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "form-and-rank",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_gu_worms",
          "gu_photo_audio_gu"
        ]
      }
    ],
    "visual_confidence": "text_described"
  },
  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "Injecting primeval essence makes two beams shoot from the compound eyes. Aimed at a white jade plate, the beams leave fluctuating words that show a Gu’s strengths, weaknesses, fusion recipe, refinement notes, and prior Gu Masters’ experience. Fang Yuan’s first sample is a red-black Digital Shade Gu that projects the Moonscar Gu refinement recipe. Voices are not needed to store recipes, so Digital Shade Gu is enough where Photo-audio Gu would also record sound. The text calls Digital Shade Gu easier to refine and low cost, a common method to contain recipes.",
        "chapters": [
          156
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "fac_gu_masters",
          "sys_gu_recipe"
        ]
      },
      {
        "text": "Clans prefer Digital Shade Gu over bamboo paper because stolen recipes would leak both specialty Gu methods and combat intelligence about a clan’s worms.",
        "chapters": [
          156
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt"
      }
    ]
  },
