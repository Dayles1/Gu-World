  "history": {
    "claims": [
      {
        "text": "During a wild boar king fight, Gu Yue Jiao San tells Hua Xing to plant the corrosion blood grass Gu while he heals a red lava python.",
        "chapters": [
          94
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_gu_yue_jiao_san"
        ]
      },
      {
        "text": "Planting runs through purple vine insignia coiling around Hua Xing’s thumbnails. Red steel primeval essence enters the insignia, vines come alive, and delicate tentacles extend from her nails into the wild boar king’s mouth and along its teeth into its stomach.",
        "chapters": [
          94
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "planting-mechanism",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_red_steel_primeval_essence"
        ]
      },
      {
        "text": "Hua Xing walks up and begins that planting. Fang Yuan lets go of the boar’s tusks, the boar swings free, and the tusks bisect her before the Gu finishes its work.",
        "chapters": [
          94
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "planting-attempt",
