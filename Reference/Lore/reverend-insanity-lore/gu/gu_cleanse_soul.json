    "confirmed_evolutions": [],
    "related_variants": [],
    "claims": [
      {
        "text": "During transactions after Yi Tian Mountain, Sixth Hair reports that Cleanse Soul self-detonated under Fang Yuan’s special will, and Ying Wu Xie could not save it.",
        "chapters": [
          1079
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "loss-and-later-refinement",
        "text_origin": "source_excerpt",
        "mentions": [
          "loc_yi_tian_mountain",
          "char_sixth_hair",
          "char_ying_wu_xie"
        ]
      },
      {
        "text": "Fang Yuan later refines a new cleanse soul Immortal Gu after nearly thirty attempts with Sixth Hair’s support.",
        "chapters": [
          1443
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "loss-and-later-refinement",
        "text_origin": "source_excerpt"
      },
      {
        "text": "That copy is only rank six, fist-sized, grayish white, and shaped like a tadpole.",
        "chapters": [
          1444
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "loss-and-later-refinement",
        "text_origin": "source_excerpt"
      },
      {
        "text": "White lotus giant silkworm Gu remains its food, and Spectral Soul Demon Venerable created that food Gu; Fang Yuan then uses rank six Cleanse Soul with many white lotus giant silkworm Gu in a Luo Po formation that focuses on refining his soul.",
        "chapters": [
          1460
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "loss-and-later-refinement",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_spectral_soul_demon_venerable"
        ]
      }
    ]
