    "price_claims": [
      {
        "text": "Fang Yuan stands to trade for it. Miao Ming Shen says he has little use for the Gu and will trade anything, but Immortal Gu still must exchange for Immortal Gu.",
        "chapters": [
          1298
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "trade",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Fang Yuan offers rank six flying bear strength Immortal Gu. The two leave to finish the deal alone, then return smiling, and Fang Yuan treats Divination Tortoise Shell as obtained from that convention.",
