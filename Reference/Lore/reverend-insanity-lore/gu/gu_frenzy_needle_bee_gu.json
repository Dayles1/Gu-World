  "appearance": {
    "claims": [
      {
        "text": "The swarm packs a beehive as huge as a house; it is a terrifying insect group.",
        "chapters": [
          207
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "form-and-rank",
        "text_origin": "source_excerpt"
      },
      {
        "text": "The bees are small, fly at high speed, and have needles tough as steel. Swarm pressure is compared to a needle rain attack. The bees are resilient enough that, if they fall into a lake that is not too deep, they resurface.",
        "chapters": [
          208
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "form-and-rank",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Some bees in the group have become Gu, rank three frenzy needle bee Gu, large in numbers and penetrating.",
        "chapters": [
          208
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "form-and-rank",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Cited chapters do not give a Chinese name, and they do not describe a Gu form separate from those bees in the swarm.",
        "chapters": [],
        "certainty": "inferred",
        "confidence": "C",
        "verification": "no_citation",
        "source_id": "src_sagaofgu",
        "section": "form-and-rank",
        "text_origin": "source_excerpt"
      }
    ],
    "visual_confidence": "text_described"
  },
  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "Once a frenzy needle bee becomes a Gu, it can penetrate all things: even Bai Ning Bing’s Sky Canopy Gu protection would be pierced by those rank three frenzy needles.",
        "chapters": [
          207
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Rank three frenzy needle bee Gu pierces Sky Canopy Gu, and Bai Ning Bing’s back is pierced and bleeds under the chase.",
        "chapters": [
          208
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_rank_three"
        ]
      },
      {
        "text": "Ordinary frenzy needle bees are weaker. Fang Yuan’s Carapace Gu crocodile skin armor stops ordinary bees, while the few bee Gu go after Bai Ning Bing.",
        "chapters": [
          208
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_carapace_gu"
        ]
      },
      {
        "text": "The rank three piercing swarm counters Sky Canopy Gu, and Ice Muscles Gu as a second defense layer is what keeps Bai Ning Bing alive.",
        "chapters": [
          209
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_ice_muscles_gu"
        ]
      }
    ]
  },
