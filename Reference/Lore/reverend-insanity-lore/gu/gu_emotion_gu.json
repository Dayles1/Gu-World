  "history": {
    "claims": [
      {
        "text": "In Eighty-Eight True Yang Building, Fang Yuan notes that Giant Sun Immortal Venerable’s wisdom path attainment is profound, especially in terms of emotion Gu, which he expanded with many new Gu recipes. Giant Sun Immortal Venerable’s harem and the way girls fall for him are presented as showing the power of his emotion Gu.",
        "chapters": [
          599
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "house_eighty_eight_true_yang_building",
          "char_fang_yuan",
          "char_giant_sun_immortal_venerable",
          "sys_gu_recipe"
        ]
      },
      {
        "text": "Tang clan first supreme elder Tang Yang says Tang clan spent much effort to borrow the rank seven emotion Gu from Xiao tribe, yet Tang Miao’s dream realm exploration still suffered a heavy loss. The clan had entrusted hope in that emotion path Immortal Gu for the attempt. Tang Miao says the Immortal Gu was useful and could suppress her emotions so the dream realm could not draw them out, but that also made her an outsider stuck on the outskirts of the dream’s core.",
        "chapters": [
          775
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
