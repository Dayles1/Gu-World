    "claims": [
      {
        "text": "When activated, Black Mane Gu does not stop at hair on the head. Hair grows from all the pores, and within a few seconds the Gu Master’s body gains a black mane protective armor.",
        "chapters": [
          47
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_gu_master"
        ]
      },
      {
        "text": "That armor effect sits one step past Green Silk Gu’s rank one defense: Green Silk Gu grows head hair into a hair raincoat that covers body and steed, uses about thirty percent of green copper primeval essence, and is not a continuous expenditure type. Black Mane Gu’s armor instead comes from hair on every pore.",
        "chapters": [
          47
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt"
      }
    ]
  },
