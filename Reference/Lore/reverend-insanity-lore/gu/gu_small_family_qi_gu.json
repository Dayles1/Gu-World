    "related_variants": [],
    "claims": [
      {
        "text": "In the following days Fang Yuan refines group strength Gu and small family qi Gu while working on other methods.",
        "chapters": [
          735
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "fang-yuans-refinement",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_group_strength_gu"
        ]
      },
      {
        "text": "Much later he recalls that he once used many small family qi Gu to store tribulation qi and help pass tribulations, and he contrasts that mortal use with the stronger Immortal Gu Big Family Qi.",
        "chapters": [
          1644
        ],
        "certainty": "canon",
        "confidence": "B",
