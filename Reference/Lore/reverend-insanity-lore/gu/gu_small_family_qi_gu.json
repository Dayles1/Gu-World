  "history": {
    "claims": [
      {
        "text": "Fairy Li Shan shows the Gu when Hei Lou Lan prepares immortal ascension on the absolute ice battlefield in northern plains, and Fang Yuan names it on sight as an ancient qi path rank five Gu he has never seen before. The same stretch places qi path earlier than strength path, and earlier in decline. Fairy Li Shan states that without this Gu she would have no confidence in Hei Lou Lan’s ten extreme physique ascension, and she promises Fang Yuan the recipe if that ascension succeeds, along with cutting his immortal essence stone debt in half.",
        "chapters": [
          683
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_fairy_li_shan",
          "char_hei_lou_lan",
          "char_fang_yuan",
          "path_strength"
        ]
      },
      {
        "text": "After she becomes a Gu Immortal, Fang Yuan asks her to release stored earth qi to draw more earthly calamity; she refuses, saying she must keep these Gu to refine Immortal Gu.",
        "chapters": [
          689
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "after-the-tribulation",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_gu_immortal",
          "sys_immortal_gu"
        ]
      },
      {
        "text": "Fairy Li Shan then gives Fang Yuan the recipe as agreed.",
        "chapters": [
          690
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "after-the-tribulation",
        "text_origin": "source_excerpt"
      }
    ]
