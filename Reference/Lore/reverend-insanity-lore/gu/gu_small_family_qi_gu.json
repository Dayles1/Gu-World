  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "He names the rumor that it can advance into Immortal Gu Big Family Qi. During Hei Lou Lan’s ascension, rank five small family qi Gu fly into the sky or land on the ground, absorb heaven and earth qi, store them, and slow how fast that qi piles up.",
        "chapters": [
          683
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_big_family_qi_immortal_gu"
        ]
      },
      {
        "text": "Fang Yuan judges that with this Gu there is a way to influence the heavenly tribulation and earthly calamity. Full Gu only influence those slightly; they do not control them. When a Gu reaches capacity Hei Lou Lan retrieves it, and some self-detonate and return stored heaven and earth qi to the world. Their suppression can delay the earthly calamity while the heavenly tribulation is already underway. She does not have many of them, because even with the recipe refinement materials are hard to find.",
        "chapters": [
          684
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt"
      },
      {
        "text": "When balancing the three qi she takes all of them back and cannot face enemies for a time.",
        "chapters": [
          685
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt"
      }
    ]
  },
