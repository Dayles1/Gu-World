  "economy": {
    "canonical_prices": [],
    "price_claims": [
      {
        "text": "At the qi sea banquet, Drowning Uncle presents rank seven heart blood Immortal Gu and asks for an Immortal Gu exchange. Many Gu Immortals bid, especially blood path cultivators, while righteous path members stay out of the trade. The Gu shows incredible strength just from being seen and would have a great effect if used in battle. Fang Yuan considers trying for it because Song Zi Xing’s inheritance had a heart blood premonition killer move, and he judges this Immortal Gu the most appropriate core for that move. Heart blood Immortal Gu is the Immortal Gu; heart blood premonition is the killer move. Zhang Yin, a rank eight, then bids with rank seven water path Immortal Gu plus a favor.",
        "chapters": [
          1885
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_immortal_gu",
          "sys_gu_immortal",
          "char_fang_yuan",
          "char_song_zi_xing",
          "char_zhang_yin"
        ],
        "needs_review": true
      },
      {
        "text": "Fairy Zi Wei orders Jun Shen Guang to help buy heart blood Immortal Gu without raising suspicions, but Zhang Yin’s high bid already blocks an open Heavenly Court contest. Yang Jun joins the competition, offers a water path Immortal Gu that satisfies Drowning Uncle, seizes heart blood Immortal Gu, and places it into treasure yellow heaven. Fairy Zi Wei obtains heart blood Immortal Gu and quickly gives it to Red Heart Traveler, who cultivates inside Demon Judgment Board and treats it as the core and foundation of a blood path method he has conceptualized for his whole life.",
        "chapters": [
          1886
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
