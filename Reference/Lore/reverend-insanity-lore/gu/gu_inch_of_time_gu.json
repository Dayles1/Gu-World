  "history": {
    "claims": [
      {
        "text": "Although it is a mortal Gu, it looks like a gold bar. Higher rank makes that bar longer and thicker. Fang Yuan has Lang Ya land spirit refine inch of time in bulk with hairy men inside Lang Ya blessed land. After he pays immortal materials, large piles of inch of time Gu accumulate in his immortal aperture like small golden mountains.",
        "chapters": [
          778
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "bulk-refining-and-substitute-tests",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_lang_ya_land_spirit",
          "loc_lang_ya_blessed_land"
        ]
      },
      {
        "text": "When he activates Time Luck while spending inch of time Gu in place of lifespan, the gold mountain of inch of time vanishes in a few breaths, Time Luck stops without that support, and he gains almost no additional luck.",
        "chapters": [
          778
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "bulk-refining-and-substitute-tests",
        "text_origin": "source_excerpt"
      }
    ]
