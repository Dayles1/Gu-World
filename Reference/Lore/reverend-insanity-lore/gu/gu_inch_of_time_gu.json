  "appearance": {
    "claims": [
      {
        "text": "Although it is a mortal Gu, it has an appearance like that of a gold bar. The higher the rank, the longer and thicker the gold bar.",
        "chapters": [
          778
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "appearance",
        "text_origin": "source_excerpt"
      }
    ],
    "visual_confidence": "text_described"
  },
  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "If a refinement would need three days and three nights, inch of time Gu can bring that growth and transformation forward so the Gu Master spends only a few short moments. The set names run from one inch of time at rank one to five inches of time at rank five.",
        "chapters": [
          750
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_gu_master"
        ]
      },
      {
        "text": "Inch of time and Time Luck can work together, but inch of time is expended too intensively. He wants an immortal killer move that lowers that expenditure, yet fails: he lacks enough thoughts, and his time path attainment is too low. Fairy Li Shan yields the immortal killer move time assist luck.",
        "chapters": [
          815
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "killer-move-acquisition",
        "text_origin": "source_excerpt"
      },
      {
        "text": "He then no longer needs to deduce a pairing of Time Luck with inch of time for a temporary luck boost.",
        "chapters": [
          817
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "killer-move-acquisition",
        "text_origin": "source_excerpt"
      }
    ]
  },
