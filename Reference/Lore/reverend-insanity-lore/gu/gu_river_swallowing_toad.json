    "claims": [
      {
        "text": "No cited chapter names a cultivation path for this Gu. Fang Zheng’s later refinement is framed only as a way to counter the enemy’s water path methods, not as naming this Gu’s own path.",
        "chapters": [
          1065
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "path",
