  "appearance": {
    "claims": [
      {
        "text": "Its body was five times the size of lizard house Gu and like a two-storey building.",
        "chapters": [
          507
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "appearance",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Outside it was a lizard: the mouth held the door, and the tongue was like a red carpet ladder. It could curl into a ball that from the sky resembled a huge rock.",
        "chapters": [
          549
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "appearance",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Large Lizard House Gu is rank three, advanced from rank two Lizard House Gu. The rank two form is already bus-sized, looks like a four-legged lizard outside, and has an inner pathway with rooms on both sides. The large form is about five times that size, built like a two-storey building with more rooms and space. When a refinement blast breaks a window, Fang Yuan feeds it primeval essence and the house grows a new panel, fills wall holes, and swallows debris and blood traces.",
        "chapters": [
          507
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "form-and-rank",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_lizard_house_gu"
        ]
      }
    ],
