  "appearance": {
    "claims": [
      {
        "text": "This Gu has a peculiar shape. It is cubic and resembles a wooden box.",
        "chapters": [
          2151
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "appearance",
        "text_origin": "source_excerpt"
      }
    ],
    "visual_confidence": "text_described"
  },
  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "If one places this Gu with any Immortal Gu in the world together for some time, the Gu cultivator can activate imitation Gu to turn itself into that Immortal Gu. Immortal Gu are unique, but imitation Gu can bypass that logic to some extent. The imitated Gu cannot compare to the real one in power.",
        "chapters": [
          2151
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Other than this imitation Gu, the other three rank eight Immortal Gu Gan Ni hands over are all blood path Immortal Gu.",
        "chapters": [
          2151
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Back then, Giant Sun Immortal Venerable asked Heavenly Court for human qi Immortal Gu and failed. He took another path, refining imitation Gu and turning it into human qi Immortal Gu. Next, with that human qi Immortal Gu as the core, he established Eighty-Eight True Yang Building.",
        "chapters": [
          2151
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
