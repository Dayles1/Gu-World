  "history": {
    "claims": [
      {
        "text": "Fairy Zi Wei thanks Duke Long for obtaining Dragon Palace. She names the rank eight dream path Immortal Gu Dream Token as what the palace contains, and says it allows Dream Token to enslave rank eight Gu Immortals. With Zhang Yin and the rest, Heavenly Court’s weakness in manpower was eliminated. Duke Long says he was also surprised by the existence of Dream Token. After he obtained Dragon Palace and refined it, his guesses that those four Eastern Sea Gu Immortals were related to the palace were confirmed.",
        "chapters": [
          1730
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_fairy_zi_wei",
          "char_duke_long",
          "house_dragon_palace",
          "sys_gu_immortal",
          "char_zhang_yin",
          "fac_heavenly_court",
          "reg_eastern_sea"
        ]
      },
      {
        "text": "Wu Shuai follows dream revelations until the revelation to build rank eight Immortal Gu House Dragon Palace appears. He is extremely excited that the core Immortal Gu of rank eight Dragon Palace is rank eight Dream Token, a dream path Gu that corresponds to the great era. He immediately travels the five regions and two heavens, searching for dream path immortal materials.",
        "chapters": [
          1844
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "core-immortal-gu",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_wu_shuai",
          "sys_immortal_gu_house",
          "sys_immortal_gu"
        ]
      },
      {
        "text": "Fang Yuan inspects Dragon Palace and names dream token Immortal Gu. Fang Yuan had always lacked a dream path Immortal Gu. This is his first one, rank eight Dream Token. Unravel dream itself cannot deal with rank eight level Dream Token. The dragonman clone had thought he was Wu Shuai for some time: that was Dream Token’s modification, twisting his own will.",
        "chapters": [
          1847
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "first-dream-path-immortal-gu",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_fang_yuan"
        ]
      }
    ]
  },
