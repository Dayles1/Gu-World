  "appearance": {
    "claims": [
      {
        "text": "Dream Token is shaped like a dragonfly, with a round head and long body, a pair of pink ruby eyes, and four pairs of transparent wings. Looking closely at its thin wings, there is also a faint layer of rainbow halo.",
        "chapters": [
          1847
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "appearance",
        "text_origin": "source_excerpt"
      }
    ],
    "visual_confidence": "text_described"
  },
  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "Fang Yuan learns the exact use of this rank eight dream token Immortal Gu from the Dragon Spirit. It is a dream path Gu worm that has enslavement path ability, similar to Soul Beast Token. Wu Shuai activated it in his last stretch of time, expending not just all of his rank eight immortal essence but also his emotions, memories, and wills. He was not killed by dragonman extermination. He died from using Dream Token, sacrificing himself to create a Dream Token dream realm. If Dream Token is used alone, the user dies, because this Immortal Gu uses all of the Gu Immortal’s foundation to create a dream realm. Gu Immortals at rank six and seven do not have rank eight immortal essence and cannot use it. Gu Immortals at rank eight cannot be forced. They have to do it out of their own will.",
        "chapters": [
          1848
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "activation-cost",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_long_ling",
          "sys_gu_worms",
          "gu_soul_beast_token"
        ]
      }
    ]
  },
