  "history": {
    "claims": [
      {
        "text": "Fang Yuan first shows Vertical Crash Gu on Shang clan city’s battle stage against Li Ran: he charges about fifty steps in one step and, with a wild boar phantom from all-out effort Gu, breaks Li Ran in a single pass.",
        "chapters": [
          286
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_fang_yuan",
          "loc_shang_clan_city",
          "char_li_ran",
          "gu_all_out_effort_gu"
        ]
      },
      {
        "text": "In Northern Plains, when Hei tribe exchange goods have no charging crash Gu, Fang Yuan buys two pairs of rank three horizontal charge Gu and vertical crash Gu to fuse himself.",
        "chapters": [
          517
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "hei-tribe-purchases",
        "text_origin": "source_excerpt",
        "mentions": [
          "reg_northern_plains",
          "fac_hei_tribe"
        ]
      },
      {
        "text": "While sorting Hei tribe exchange goods later, he finds a rank four charging crash Gu and diverts his attention from it, because he has already bought rank three copies and refined them into charging crash Gu.",
        "chapters": [
          522
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "supply-camp-choice",
        "text_origin": "source_excerpt"
      }
    ]
  },
