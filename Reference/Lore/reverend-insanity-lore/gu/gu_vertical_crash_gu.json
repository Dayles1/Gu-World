    "claims": [
      {
        "text": "Two days of refinement turn the two rank three Gu into rank four charging crash Gu. The fused Gu raises charging distance to two hundred steps and halves the delay between uses, at a slightly higher primeval essence cost. The two rank three Gu together cover only a hundred steps. Horizontal charge Gu and vertical crash Gu are the two main materials that, with primeval essence and supplementary materials, refine into charging crash Gu.",
        "chapters": [
          345
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "rank-four-refine",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_charging_crash_gu"
        ]
      }
    ]
  },
