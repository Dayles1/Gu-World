    "claims": [
      {
        "text": "Fang Yuan frames horizontal charge Gu and vertical crash Gu as extremely suitable for strength path Gu Masters because the Gu Master can exert force while moving.",
        "chapters": [
          288
        ],
        "certainty": "canon",
        "confidence": "B",
