  "history": {
    "claims": [
      {
        "text": "After Fang Yuan takes a stellar stone from Wu clan spy Li Ran’s house in Shang clan city, Li Ran finds a heart sound Gu under his bed. He places it in his ear like an earplug, activates it, and hears Fang Yuan answer inside his head.",
        "chapters": [
          284
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_fang_yuan",
          "fac_wu_clan",
          "char_li_ran",
          "loc_shang_clan_city"
        ]
      },
      {
        "text": "Heart sound Gu is green and black, about the size of a baby’s thumb. It is shaped like a conch shell, large at one end and tiny at the other, with a spiral appearance. Speaking through it needs concentrated effort; ordinary thinking is not transmitted. The voice is always tuned, so age cannot be judged from it, but gender can.",
        "chapters": [
          284
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "form-and-speech",
        "text_origin": "source_excerpt"
      },
      {
        "text": "At the restaurant table, Li Ran asks who Fang Yuan is through heart sound Gu, and Fang Yuan answers the same way while they keep a calm face for the room. After a long silence, Li Ran asks through the Gu how he can believe Fang Yuan.",
        "chapters": [
          285
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "restaurant-exchange",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Dong Fang tribe Gu Masters activate heart sound Gu with other Gu for the killer move three hearts combination soul. Heart sound Gu at rank two strengthens the voice of one’s heart.",
        "chapters": [
          511
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "three-hearts-combination",
        "text_origin": "source_excerpt",
        "mentions": [
          "fac_dong_fang_tribe",
          "fac_gu_masters"
        ]
      }
    ]
