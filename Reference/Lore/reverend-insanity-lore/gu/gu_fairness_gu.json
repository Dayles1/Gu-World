  "history": {
    "claims": [
      {
        "text": "Wisdom Gu teaches Ren Zu the secret of the Door of Life and Death. The road of death is the road left behind by destiny Gu when it left Fairness Gu, called the path of destiny. When Ren Zu enters and sees Fairness Gu, he is already dead, and there he will also see Verdant Great Sun’s soul. The road of life is the path destiny Gu treaded when it visited Fairness Gu, also called the path of destiny.",
        "chapters": [
          410
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_wisdom_gu",
          "char_ren_zu",
          "loc_door_of_life_and_death",
          "gu_destiny_gu",
          "char_verdant_great_sun"
        ]
      },
      {
        "text": "At the end of the road of death, amidst calm darkness, Ren Zu sees Fairness Gu. Fairness Gu says life and death are the greatest fairness in this world, and tells him his son is right there.",
        "chapters": [
          410
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Self Gu later tells Ren Zu that the Door of Life and Death’s entrance and exit are the traces left behind by fate Gu when it visited Fairness Gu, and that walking that road means being under fate’s manipulation and arrangement.",
        "chapters": [
          646
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "fates-traces",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_self_gu",
          "gu_fate_gu"
        ]
      },
      {
        "text": "Another telling has Self Gu say all living beings die because fate Gu entered the Door of Life and Death and left a trace when searching for Fairness Gu.",
        "chapters": [
          944
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "fates-traces",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Fang Yuan summarizes the legend as road of life, road of death, and Obsession Death Domain which held fairness Immortal Gu.",
        "chapters": [
          1010
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "immortal-gu-label",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_fang_yuan",
          "loc_obsession_death_domain"
        ]
      },
      {
        "text": "Pacifying Soul Lake also lies within the Door of Life and Death, beside Fairness Gu.",
        "chapters": [
          2192
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "immortal-gu-label",
        "text_origin": "source_excerpt",
        "mentions": [
          "loc_pacifying_soul_lake"
        ]
      }
    ]
