  "history": {
    "claims": [
      {
        "text": "Bai Ning Bing first shows Ice Explosion Gu on the Shang clan city battle stage by detonating an iceblade mid-strike against Tie Dao Ku.",
        "chapters": [
          298
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_bai_ning_bing",
          "loc_shang_clan_city",
          "char_tie_dao_ku"
        ]
      },
      {
        "text": "Bai Ning Bing later explains that turning into ice crystal and using Ice Explosion Gu with it can form a scene extremely similar to the self-destruction of Northern Dark Ice Soul physique, and that this is how the fake self-destruction deceived Fang Yuan.",
        "chapters": [
          396
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "fake-self-destruction-explained",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_northern_dark_ice_soul_physique",
          "char_fang_yuan"
        ]
      }
    ]
