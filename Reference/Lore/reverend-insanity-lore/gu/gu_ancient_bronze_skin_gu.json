  "history": {
    "claims": [
      {
        "text": "On San Cha Mountain, Li Xian delivers ancient bronze skin Gu to Fang Yuan. The worm looks like a bedbug: flat and wide, small headed, oval bodied, yellow-orange with a metallic bronze luster.",
        "chapters": [
          354
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "loc_san_cha_mountain",
          "char_li_xian",
          "char_fang_yuan"
        ]
      },
      {
        "text": "After refining human skin Gu, Fang Yuan uses old removal Gu to wash away the modifications from ancient bronze skin, essence iron bones, and golden steel tendons.",
        "chapters": [
          432
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
