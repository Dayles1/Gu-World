  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "When activated, ancient bronze skin Gu remodels the Gu Master’s skin and flesh into ancient bronze skin. Its defensive power is much stronger than rank three bronze skin Gu. Used while soaking in bronze liquid, that remodeling finishes about thirty percent faster. Fang Yuan soaks in a stone vat of molten bronze and activates the Gu that way.",
        "chapters": [
          354
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_gu_master",
          "gu_bronze_skin_gu"
        ]
      },
      {
        "text": "Three days later he is still tempering his body with it beside essence iron bone Gu, and he judges himself almost finished with the ancient bronze skin Gu process.",
        "chapters": [
          355
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_essence_iron_bone_gu"
        ]
      },
      {
        "text": "Combined with essence iron bones and golden steel tendons, plus golden shield Gu, the defense is later treated as enough to handle the full strength of a rank four peak stage Gu Master.",
        "chapters": [
          368
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_golden_shield_gu"
        ]
      }
    ]
  },
