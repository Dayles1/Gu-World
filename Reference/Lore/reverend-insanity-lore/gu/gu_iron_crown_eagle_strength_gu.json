    "canonical_prices": [],
    "price_claims": [
      {
        "text": "Among the strength path bids at Qin Bai Sheng’s auction, this is the only flying beast Gu; the rest are land based. Fang Yuan also receives immortal materials from Lang Ya land spirit’s list in the same deal. With true solid bat wings in place, he judges that if he could unleash the Gu while flying, the effect would match immortal movement killer moves.",
        "chapters": [
          752
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_qin_bai_sheng",
          "char_fang_yuan",
          "char_lang_ya_land_spirit"
        ],
        "needs_review": true
      },
      {
        "text": "Ying Wu Xie sells iron crown eagle strength Gu in treasure yellow heaven while holding Fang Yuan’s Immortal Gu.",
        "chapters": [
          1071
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "sale-and-permanent-loss",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_ying_wu_xie",
          "gu_strength_gu",
          "loc_treasure_yellow_heaven"
        ]
      },
      {
        "text": "When treasure yellow heaven closes, the Gu is trapped there with connect luck Immortal Gu.",
        "chapters": [
          1079
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "sale-and-permanent-loss",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_connect_luck"
        ]
      },
      {
        "text": "After the later transactions, Fang Yuan cannot get it back.",
