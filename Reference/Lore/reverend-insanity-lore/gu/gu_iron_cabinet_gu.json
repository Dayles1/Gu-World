    "claims": [
      {
        "text": "The iron cabinet Gu recipe was created by Tie clan refinement path master Tie Yi Ban. He meant a firm storage Gu. After the first refine, he gave it to Tie Xue Leng to test; the Divine Investigator used it to capture people and found it durable. Supplemented with qi flow Gu, its effect is amplified, and from then on iron cabinet Gu became an efficient Tie clan means to capture demonic Gu Masters. Li Xian notes that the four old-timers must maintain both Gu, and that if the four attack together the purple qi barrier will disappear.",
        "chapters": [
          354
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "recipe-and-capture-use",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_storage_gu",
          "char_tie_xue_leng",
          "sys_demonic_path"
        ]
      }
    ]
  },
