  "history": {
    "claims": [
      {
        "text": "Gu Yue Mo Chen replies that Pig Iron Gu will be handed over, but his Mo faction’s warehouse does not have any Afterlife Grass Gu, and the forty thousand primeval stones cannot be given at once, only in installments. Fang Yuan knows this old fox is not speaking the truth, and he is also clear that being too overbearing could produce the opposite result. He says that is okay, he will wait for Mo Chen to send them first, then they can talk about marriage, and before that he cannot guarantee his allegiance.",
        "chapters": [
          176
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "fac_mo_family"
        ]
      },
      {
        "text": "Fang Yuan reviews that agreement with Gu Yue Mo Chen. He has already received the Pig Iron Gu and all forty thousand primeval stones. The only thing remaining is that healing grass Gu. He decides he can only forget about the healing Gu now, and he leaves that night for the spirit spring instead.",
        "chapters": [
          180
        ],
