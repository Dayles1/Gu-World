  "history": {
    "claims": [
      {
        "text": "During Hei Lou Lan’s immortal ascension on the icy plains, Hei Cheng opens his right palm and reveals an Immortal Gu that gives off eerie blue light. The text names it a time path rank six Immortal Gu, and its aura makes the two time path Immortal Gu in Tai Bai Yun Sheng’s aperture vibrate. Fairy Li Shan names it Instant Pause on sight.",
        "chapters": [
          688
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
