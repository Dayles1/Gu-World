  "appearance": {
    "claims": [
      {
        "text": "A set of dentures: neat upper and lower teeth, spotless white, with a pearl-like luster.",
        "chapters": [
          224
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "appearance",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Fang Yuan places it at rank three.",
        "chapters": [
          224
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "form-and-rank",
        "text_origin": "source_excerpt"
      }
    ],
    "visual_confidence": "text_described"
  },
  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "It is not an expendable Gu. If a Gu Master’s corpse is incomplete, this Gu can rebuild the flesh first, then rising dead Gu can resurrect the Gu Master when death is within fourteen hours and the body is intact. That pairing has helped major figures, including rank nine immortal and demon venerables.",
        "chapters": [
          224
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_gu_master",
          "gu_rising_dead_gu"
        ]
      },
      {
        "text": "Bai Ning Bing activates it on a cut forearm: an orange glow covers the wound, and skin and flesh grow out almost at once until the injury is gone, at the cost of about twenty percent of her rank three peak stage primeval essence in a single burst. The Gu needs a large instant spend of primeval essence. Fang Yuan’s green copper essence could not fuel a use even if his primeval sea ran dry.",
        "chapters": [
          226
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt"
      }
    ]
  },
  "feeding": {
    "known": true,
    "food_raw": null,
    "foods": [],
    "claims": [
      {
        "text": "Later haul talk also calls the same inheritance healing Gu meat-bone Gu.",
        "chapters": [
          225
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "called-meat-bone-gu",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_meat_bone_gu"
        ]
      },
      {
        "text": "The haul list of the Bai Gu inheritance names it meat bone Gu, cultivation at rank one cannot activate it, and it can regrow burned skin and flesh after damaged tissue is cut away, but it cannot heal the shattered ear cartilage left when earth hearing ear grass is destroyed.",
        "chapters": [
          228
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "called-meat-bone-gu",
        "text_origin": "source_excerpt",
        "mentions": [
          "inh_white_bone_inheritance"
        ]
      }
    ]
  },
