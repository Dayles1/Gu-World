  "appearance": {
    "claims": [
      {
        "text": "It seems made of crystals, looks like a flea, is as large as a fist, and curls up into a ball while staying still.",
        "chapters": [
          2121
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "appearance",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Under white litchi immortal essence it lets out light, crystal-like radiance; when refinement completes the curled crystal flea stretches and lies meekly on Fang Yuan’s palm.",
        "chapters": [
          2135
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "appearance",
        "text_origin": "source_excerpt"
      }
    ],
    "visual_confidence": "text_described"
  },
  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "After his luck gives him an indication, Fang Yuan decides it is time to use a move and activates heaven’s envy Immortal Gu.",
        "chapters": [
          2165
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "crazed-demon-cave-battle",
        "text_origin": "source_excerpt"
      },
      {
        "text": "The move is heaven envies heroic geniuses, which takes heaven’s envy Immortal Gu as its core and targets people of outstanding talent; first meant for venerables, it draws on Limitless Demon Venerable’s arrangements to spread across the great worlds.",
        "chapters": [
          2166
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "crazed-demon-cave-battle",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_limitless_demon_venerable"
        ]
      }
    ]
  },
