  "history": {
    "claims": [
      {
        "text": "While walking Fang Yuan through stellar stone grades in a Shang clan city gambling den, a clerk names star arrow Gu beside star dart Gu and shooting star Gu.",
        "chapters": [
          276
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
