    "activation_raw": null,
    "claims": [
      {
        "text": "Battle Bone Wheel Gu is famous because the rank eight Demonic Gu Immortal Shen Jie Ao, Proud Bone Demon Lord, used it. When he became a rank six Gu Immortal and lacked a rank six Gu, he made the killer move White Bone Chariot from many rank five Gu such as the white bone wheel, with power comparable to a rank six Gu. Bone bamboo Gu combined with ghost fire Gu can repair the damage so the wheel can function again.",
        "chapters": [
          431
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
