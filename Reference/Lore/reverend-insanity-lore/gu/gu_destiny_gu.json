    "claims": [
      {
        "text": "Heavenly Court wants to restore rank nine fate Gu and seize fortune rivalling heaven Gu to try to refine rank ten destiny Gu. Longevity Heaven’s target is lower: use the damaged fate Gu to refine rank nine destiny Gu.",
        "chapters": [
          1942
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "rank-targets",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Bing Sai Chuan presses to take fate Gu and return to Longevity Heaven to refine rank nine destiny Gu.",
        "chapters": [
          1940
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "rank-targets",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Fang Yuan recalls rumors of only two rank ten Immortal Gu: one is destiny Gu, and one of the main materials for refining rank ten destiny Gu is rank nine fate Gu.",
        "chapters": [
          2140
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "rank-ten-rumor",
        "text_origin": "source_excerpt"
      }
    ]
  },
