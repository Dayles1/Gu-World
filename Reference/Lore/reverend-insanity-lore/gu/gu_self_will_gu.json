  "history": {
    "claims": [
      {
        "text": "Fang Yuan receives a batch refined by Twelfth Hair in Lang Ya Sect and inspects one of them in his cloud city.",
        "chapters": [
          1092
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_fang_yuan",
          "char_twelfth_hair",
          "fac_lang_ya_sect"
        ]
      },
      {
        "text": "To guard Chu Du against heaven’s will, he gives Chu Du a lot of self will Gu.",
        "chapters": [
          1115
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "supply-to-an-ally",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_chu_du"
        ]
      },
      {
        "text": "When Fang Yuan decides to give Hei Fan grotto-heaven to Chu Du, he has already given Chu Du the method of self will Gu, so heaven’s will influencing Chu Du’s thoughts is not a worry for him.",
        "chapters": [
          1132
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "supply-to-an-ally",
        "text_origin": "source_excerpt",
        "mentions": [
          "loc_hei_fan_grotto_heaven"
        ]
      },
      {
        "text": "Apart from day, month and year Gu, self will Gu is Fang Yuan’s greatest mortal Gu need. Self will Gu is very rare.",
        "chapters": [
          1177
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "rarity-and-demand",
