  },
  "refinement": {
    "recipes": [],
    "used_in_recipes": [],
    "refinement_materials": [],
    "confirmed_evolutions": [],
    "related_variants": [],
    "claims": [
      {
        "text": "The recipe comes from Shadow Sect as part of that sect’s research on resisting heaven’s will. Fang Yuan obtains it in transactions with Sixth Hair, tries refining it himself with poor results, then gives the recipe to hairy man Gu Immortals in Lang Ya Sect so they can refine it for him with sect contribution points.",
        "chapters": [
          1092
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "recipe-and-supply",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_sixth_hair",
          "sys_gu_immortal"
        ]
      },
      {
        "text": "Twelfth Hair later refines over a hundred rank five self will Gu in one session.",
        "chapters": [
          1199
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "recipe-and-supply",
        "text_origin": "source_excerpt"
      }
    ]
  },
