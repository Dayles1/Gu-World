    "price_claims": [
      {
        "text": "Qin Bai Sheng lists this strength path Immortal Gu as the thirty-fourth item at a Northern Plains Immortal Gu auction. The seller wants a wisdom path Immortal Gu in trade.",
        "chapters": [
          754
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
