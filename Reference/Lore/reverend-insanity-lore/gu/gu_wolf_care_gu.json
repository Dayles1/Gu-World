  "history": {
    "claims": [
      {
        "text": "During a Ge tribe fight against a turtleback wolf group, Fang Yuan covers his right eye, looks at a white-eyes wolf with his left, and pours primeval essence into Chang Shan Yin’s investigative Gu. His left eye then shows the battlefield as if from high ground.",
        "chapters": [
          453
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "fac_ge_tribe",
          "char_fang_yuan",
          "char_chang_shan_yin",
          "sys_investigative_gu"
        ]
      },
      {
        "text": "Outside the aperture, the Gu sits as a vague second pupil in Fang Yuan’s left eye. He lists it among the Gu he holds after inheriting Chang Shan Yin’s set.",
        "chapters": [
          459
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "placement",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Fang Yuan’s true body stays hidden in a corner of the battlefield. Through Wolf Care Gu he watches the fight and commands the wolf group, while other Gu worms carry a false exchange with Hei Lou Lan.",
        "chapters": [
          512
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
