      }
    ],
    "visual_confidence": "text_described"
  },
  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "The black iron hand locked onto the lightning lycan and kept chasing when the beast tried to dodge. The lightning lycan lacked bravery, was already wounded, and would not take the move head-on, then finally roared and collided against the hand. The enormous hand shattered. The lightning lycan received serious injuries, almost all its bones on the verge of shattering, and ran rather than fight Tie Xue Leng again.",
        "chapters": [
          170
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Tie Xue Leng was already injured. After the move he spat blood with a gloomy green color that corroded grass where it fell.",
        "chapters": [
          170
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
