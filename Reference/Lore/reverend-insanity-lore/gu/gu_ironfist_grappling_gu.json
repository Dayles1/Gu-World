      {
        "text": "When used, an enormous black iron hand appears. In the lightning lycan fight it tears the sky apart. The hand can lock onto a target and keep chasing.",
        "chapters": [
          170
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
