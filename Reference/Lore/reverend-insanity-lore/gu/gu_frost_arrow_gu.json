    "price_claims": [
      {
        "text": "At a Shang clan city auction, the host presents Frost Arrow Gu as the first lot: shaped like a drain fly, blue like ice, with a long needle-like mouth. Gu of this kind are a treasure in Ju clan village, set beside how Gu Yue clan collects many moon type Gu.",
        "chapters": [
          306
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "loc_shang_clan_city",
          "fac_ju_clan",
          "fac_gu_yue_clan"
        ],
        "needs_review": true
      },
      {
        "text": "The host sets the base price at seventy thousand primeval stones and notes that even a rank three Gu Master can use it. Bai Ning Bing buys it after bidding against Shang Ya Zi. She wins at a hundred and fifty thousand; that total includes the forty thousand uplift from Shang Ya Zi interfering from another private room.",
        "chapters": [
          306
        ],
