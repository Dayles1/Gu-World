    "claims": [
      {
        "text": "Shen Cong Sheng’s true motive in coming was to save his ancestor Shen Shang. After Chu Ying accepted the mission to kill that sealed demonic immortal, Shen Cong Sheng contacted Fang Yuan, lying that he was looking for response Gu and offering a large amount of immortal materials to express his goodwill.",
        "chapters": [
          1906
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
