  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "Amplify Effect Gu is from the rule path. It supplements other Gu worms and amplifies the effects of the chosen Gu. Amplification scales with rank, and the Gu Master’s primeval essence expenditure rises with that rank. It is popular because it can be used in any path: fire path, water path, and for Fang Yuan both enslavement and strength path.",
        "chapters": [
          522
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect-and-path",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_gu_worms",
          "sys_gu_master"
        ]
      },
      {
        "text": "Among Hei tribe’s resources there is one rank five, one rank four, three rank three, and the rest rank two.",
        "chapters": [
          522
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect-and-path",
        "text_origin": "source_excerpt"
      }
    ]
  },
