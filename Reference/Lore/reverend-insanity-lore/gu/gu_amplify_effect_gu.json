    "claims": [
      {
        "text": "With rank five Amplify Effect Gu and rank four wolf howl Gu, his mutated beasts expand, turn red-eyed, and grow five times in battle strength.",
        "chapters": [
          533
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "rank-five-pairings",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_wolf_howl_gu"
        ]
      },
      {
        "text": "With All-out Effort Gu plus the rank five Amplify Effect Gu he can burst five hundred jun of strength. With rank four Eagle Rise Gu and the same Amplify Effect Gu he grows eagle wings and flies at five times speed.",
        "chapters": [
          534
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "rank-five-pairings",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_all_out_effort_gu",
          "gu_eagle_rise_gu"
        ]
      },
      {
        "text": "He later judges that after getting the rank five Amplify Effect Gu his explosive force is already high enough, except that his body cannot endure the strength increment.",
        "chapters": [
          536
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "rank-five-pairings",
        "text_origin": "source_excerpt"
      },
      {
        "text": "He activates Amplify Effect Gu with wolf howl Gu again when revealing rank five peak stage cultivation.",
        "chapters": [
          539
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "rank-five-pairings",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Killer move four arm earth king uses no less than fourteen Gu worms, including rank five Amplify Effect Gu, and in that state his defense increases by over four times and his strength reaches eight hundred jun.",
        "chapters": [
          541
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "rank-five-pairings",
