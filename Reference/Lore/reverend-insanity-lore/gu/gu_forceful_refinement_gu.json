  "history": {
    "claims": [
      {
        "text": "The Long Hair refinement path haul Fang Yuan gains by annexing Lang Ya blessed land had originally held three rank eight Immortal Gu: Water Refinement, Forceful Refinement, and Advance Refinement. All three are refinement path Immortal Gu. Used alone they have no offensive power and are all support type.",
        "chapters": [
          1767
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
