  "history": {
    "claims": [
      {
        "text": "In Thieving Heaven’s dream realm, Fang Yuan finds a quicksand pit that becomes a hole blowing cold air. Winged fish fly out with the breeze; they are mortal cool wind Gu.",
        "chapters": [
          1492
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_fang_yuan"
        ]
      },
      {
        "text": "The cool wind Gu are very fast and ignore him. Air at the hole edges repels him, and he is too weak and hungry to work the nest closely at first. One Gu is injured in a collision, falls out of the cool air, and lands at the fringe; he grabs it but squashes it to death in excitement. Using unravel dream later ejects a cool wind Gu he can grab, and a second injured Gu falls where he can refine both. When the cool air vanishes, the wild Gu leave with it, but he already holds five cool wind Gu in his aperture. He then uses those five to fight oasis beasts.",
        "chapters": [
          1492
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "capture",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_wild_gu"
        ]
      },
      {
        "text": "Those cool wind Gu and other Gu he had gathered are gone afterward.",
        "chapters": [
          1494
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "loss",
        "text_origin": "source_excerpt"
      }
    ]
