  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "They expend little primeval essence. Gu Masters only need to stuff items into them; after the items are swallowed, the bodies expand and the thirty slugs become five times their original size, and even a myriad beast king is not half as large. Blue Farm Slug Gu has no attacking capabilities. Even then a small portion of Zheng tribe resources cannot be carried and has to be left in the camp. Ge tribe’s army then brings the thirty slugs and large numbers of captives onward.",
        "chapters": [
          484
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
