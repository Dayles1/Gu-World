  "history": {
    "claims": [
      {
        "text": "During the Wan clan immortal battlefield trap, Fang Yuan secretly activates Immortal Gu Distracting Thoughts to prepare an immortal killer move.",
        "chapters": [
          1800
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "fac_wan_clan",
          "char_fang_yuan"
        ]
      },
      {
        "text": "When he disguises as Suan Bu Jin he specially prepares a set of wisdom path Immortal Gu and methods for that identity. Activating this Gu is the step that begins distracting thoughts generation against Wan Hao Guang, Wan Xiao, and Wan Liang Han.",
        "chapters": [
          1800
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "suan-bu-jin-kit",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_immortal_gu",
          "char_wan_hao_guang",
          "char_wan_xiao",
          "char_wan_liang_han"
        ]
      },
      {
        "text": "Fang Di Chang later tells a junior to get used to three wisdom path Immortal Gu, naming Senior Suan Bu Jin’s distracting thoughts Immortal Gu among them and saying that although he died, the inheritance must be passed on.",
        "chapters": [
          1861
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "inheritance-mention",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_fang_di_chang"
        ]
      }
    ]
