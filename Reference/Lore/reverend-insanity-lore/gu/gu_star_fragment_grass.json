  "history": {
    "claims": [
      {
        "text": "While buying starlight fireflies in treasure yellow heaven, Fang Yuan also buys star fragment grass and planting knowledge from Starlord Wan Xiang, Fairy Yao Guang, and Di Yuan.",
        "chapters": [
          467
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "loc_treasure_yellow_heaven",
          "char_fang_yuan",
          "char_star_lord_wan_xiang",
          "char_fairy_yao_guang",
          "char_di_yuan"
        ]
      },
      {
        "text": "It can only be planted in the sky and grows on clouds, so high quality cloud soil is a recommended medium. It favors yin energy and loathes yang energy: too much sunlight can kill it, but it still needs some light. Starlight fireflies living among the grass aid seed spread and can raise both area and quality.",
        "chapters": [
          467
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
