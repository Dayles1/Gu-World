    "claims": [
      {
        "text": "At San Cha mountain, Fang Yuan judges that if he rashly charges the purple qi barrier holding Bai Ning Bing, the four old-timers can use this Gu to suppress both of them easily.",
        "chapters": [
          353
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "loc_san_cha_mountain",
          "char_bai_ning_bing"
        ]
      },
      {
        "text": "He names their combination killer move limitless search and lock. If they plant the lock Gu on a Gu Master, they can find that person no matter where he goes, and he calls it the number one capturing method. He again recalls Kong Ri Tian as a previous-life victim of that move. Even with Bone Wings Gu, he judges that a planted lock Gu would still capture him wherever he flew.",
        "chapters": [
          362
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "combination-killer-move",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_bone_wings_gu"
        ]
      },
      {
        "text": "Infinite search and lock can seal rank five Gu, but it cannot restrict rank six Immortal Gu.",
        "chapters": [
          399
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "sealing-limit",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_immortal_gu"
        ]
      }
    ]
  },
