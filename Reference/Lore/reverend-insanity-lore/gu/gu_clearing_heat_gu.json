  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "It is a rank two healing Gu used to cure poison.",
        "chapters": [
          217
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_healing_gu"
        ]
      },
      {
        "text": "Bai Lian visits Fang Yuan at night to borrow the Gu for her poisoned friend. It is rare and would be very effective on a poisoned friend of Bai Lian. Fang Yuan lends it without objection, and Bai Sheng Jing recovers quickly after that cure. She later cites the loan when quarreling with Bai Zhan Lie, and Bai Sheng Jing joins Fang Yuan’s hunting group already grateful for the cure.",
        "chapters": [
          218
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_bai_lian",
          "char_bai_sheng_jing",
          "char_bai_zhan_lie"
        ]
      }
    ]
