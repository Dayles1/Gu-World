  "history": {
    "claims": [
      {
        "text": "Bai clan leader rewards Fang Yuan with it after he brings back an earth horn rhino horn on the second day of the hunting competition. Holding it, he feels a cool air pass into his hand. He treats the gift as fixing his greatest weakness at that time.",
        "chapters": [
          217
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "fac_bai_clan_bai_gu_mountain",
          "char_fang_yuan"
        ]
      },
      {
        "text": "After the Bai Gu mountain inheritance, Fang Yuan and Bai Ning Bing still count clearing heat Gu among gains taken from Bai clan.",
        "chapters": [
          228
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "continued-possession",
        "text_origin": "source_excerpt",
        "mentions": [
          "loc_bai_gu_mountain",
          "char_bai_ning_bing"
        ]
      },
      {
        "text": "After a zombie fight wound, Fang Yuan tells companions the corpse poison is troublesome but that he can detoxify it with clearing heat Gu.",
        "chapters": [
          257
        ],
        "certainty": "canon",
