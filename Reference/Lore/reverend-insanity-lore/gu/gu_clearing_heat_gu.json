  "appearance": {
    "claims": [
      {
        "text": "It is like an armored worm fossil with a half transparent jade rock texture, and cool air passes into the hand that holds it.",
        "chapters": [
          217
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "appearance",
        "text_origin": "source_excerpt"
      },
      {
        "text": "In the aperture it appears again as a jade pendant-like beetle fossil, half transparent and jade green, giving off cooling air.",
        "chapters": [
          273
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
