    "price_claims": [
      {
        "text": "A host at a large scale auction in Shang clan city puts Frost Breath Gu on the block with a starting bid of twenty-three thousand primeval stones. After bidding it sells for thirty-eight thousand. Fang Yuan later rates that sale, with Flame Heart Gu, as about thirty to forty thousand and low next to other goods at that auction.",
        "chapters": [
