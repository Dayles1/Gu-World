  "history": {
    "claims": [
      {
        "text": "A Hei tribe Gu Master once took a portion of true inheritance from Eighty-Eight True Yang Building that included this Gu. That line later sat on Immortal Succession Mountain, and Feng Jun obtained it with the inheritance. Feng Jun relies on the immortal killer move luck whirlwind as his most practised method.",
        "chapters": [
          1126
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "fac_hei_tribe",
          "sys_gu_master",
          "house_eighty_eight_true_yang_building",
          "loc_immortal_succession_mountain",
          "char_feng_jun"
        ]
      },
      {
        "text": "Fang Yuan forces Feng Jun to hand over his Immortal Gu and the luck path true inheritance details, then takes and suppresses those Gu.",
        "chapters": [
          1127
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_fang_yuan",
          "sys_immortal_gu"
        ]
      },
      {
        "text": "Qi Luck Sensation comes from Feng Jun’s inheritance. It lets a Gu Immortal sense people closely connected to them by luck, and the effect is clearer at shorter distance.",
        "chapters": [
          1150
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "qi-luck-sensation",
        "text_origin": "source_excerpt",
        "mentions": [
          "move_qi_luck_sensation",
          "sys_gu_immortal"
        ]
      },
      {
        "text": "Fang Yuan rebuilds Qi Luck Sensation with Unravel Mystery as a second core beside this Gu.",
        "chapters": [
          1239
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "unravel-mystery-rebuild",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_unravel_mystery"
        ]
      }
    ]
