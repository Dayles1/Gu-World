  "history": {
    "claims": [
      {
        "text": "Long Hair Ancestor extracted apertures from tens of thousands of Gu Masters by a secret technique, used those aperture walls as material, and refined with profound ice Gu, ice wall Gu, grand jade Gu, slow down Gu, vitality Gu, and others. Fang Yuan knows that origin from information given by Lang Ya land spirit when he walks the crystal hallway in the treasure room of Eighty-Eight True Yang Building.",
        "chapters": [
          558
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
