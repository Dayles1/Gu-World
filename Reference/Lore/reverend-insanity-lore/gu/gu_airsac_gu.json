  "appearance": {
    "claims": [
      {
        "text": "It resembles a ladybug about the size of a large bowl. Its head is extremely small, and its stomach occupies ninety-nine percent of its body. That stomach is round like a lamp bulb and translucent. It has no carapace on its back and no wings. Another Gu sits inside the translucent stomach.",
        "chapters": [
          701
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "appearance",
        "text_origin": "source_excerpt"
      }
    ],
    "visual_confidence": "text_described"
  },
  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "It belongs with common storage Gu worms made to store Gu worms, such as Earth Treasury Flower. Guts Gu dissipate once taken out of Dang Hun Mountain, so control of the mountain meant control of guts Gu until Airsac Gu let them be stored and carried out.",
        "chapters": [
          701
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
