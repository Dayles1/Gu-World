  "history": {
    "claims": [
      {
        "text": "Inside Inquiry Dock, Fang Di Chang offers a rank seven treasury from Fang clan headquarters and tells Suan Bu Jin to pick one. When Fang Yuan chooses, Fang Di Chang is surprised: rank seven great thief Gu, a theft path Immortal Gu, while Suan Bu Jin is a wisdom path Gu Immortal. Fang Di Chang accepts, retrieves it from headquarters into Inquiry Dock, and helps Fang Yuan refine it. Fang Yuan is a theft path great grandmaster lacking theft path Immortal Gu. He treats this Gu as the key to drawing out a portion of ghostly concealment’s power once he adds mortal Gu and spends some time.",
        "chapters": [
          1524
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
