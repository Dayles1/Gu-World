  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "Luck inspection, as the name suggests, inspects luck. In his vision, luck appears as smoke-like strands; Hei Lou Lan shows a thick azure pillar, and Tai Bai Yun Sheng shows sunset-flame luck above his house. Used on Fang Yuan himself, the same Gu shows black ink-like luck gathered into a coffin shape with dense death energy. He holds only this one Gu and lacks the wider luck path inheritance details behind it.",
        "chapters": [
          604
        ],
        "certainty": "inferred",
        "confidence": "C",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_hei_lou_lan",
          "char_tai_bai_yun_sheng",
          "path_luck"
        ]
      },
      {
        "text": "Later, without luck inspection Immortal Gu, he still uses luck inspection mortal Gu on Ye Fan, Han Li, and Hong Yi while their luck stays linked to his, because those three are still mortals.",
        "chapters": [
          823
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
