  "economy": {
    "canonical_prices": [],
    "price_claims": [
      {
        "text": "At Qin Bai Sheng’s auction of luck path true inheritance essence, Fang Yuan notes that he already has one luck inspection Gu and that mortal Gu are not effective against Immortals. Luck inspection Gu is an investigative Gu that can detect formless luck when ordinary methods cannot, and it is one of the main foundations of that true inheritance. Qin Bai Sheng auctions mortal Gu recipes from rank one to rank five together with a remnant rank seven Immortal Gu recipe; Fang Yuan stops bidding because those mortal recipes give him no benefit.",
        "chapters": [
          760
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
