    "claims": [
      {
        "text": "Gu tribe’s spirit spring had dried, and Tai Bai Yun Sheng restored it with this Gu so the spring could create primeval stones again; Gu tribe later calls him their benefactor for that help.",
        "chapters": [
          524
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
