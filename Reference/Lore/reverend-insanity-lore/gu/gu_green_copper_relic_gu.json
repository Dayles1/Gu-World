    "claims": [
      {
        "text": "The mortal line runs rank one to rank five as green copper, red steel, white silver, yellow gold, and purple crystal Relic Gu, and Relic Gu are mortal Gu with no rank six or higher Immortal Gu form. Green copper, red steel, and white silver Relic Gu are widely sold; yellow gold and purple crystal Relic Gu are tightly controlled in the mortal market. Relic Gu can directly increase the foundation of the aperture, raising a Gu Master’s cultivation realm.",
        "chapters": [
          469
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "series-limits",
