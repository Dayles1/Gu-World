        ]
      }
    ]
  },
  "appearance": {
    "claims": [
      {
        "text": "When Bai clan offers one as a hunting reward, it is a finger-sized round ball shaped Gu.",
        "chapters": [
          216
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "appearance",
        "text_origin": "source_excerpt",
        "mentions": [
