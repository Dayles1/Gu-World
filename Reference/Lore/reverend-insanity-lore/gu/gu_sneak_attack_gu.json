    "activation_raw": null,
    "claims": [
      {
        "text": "On activation it turns into a blue baby phantom, exits the aperture, and charges the target. Against a stone stool it passes inside, returns, and leaves the stool whole until touch collapses it from within. Sha Xiao calls it top tier among rank two Gu for that internal strike and notes it spends only ten percent of rank one green copper primeval essence per use. Against rank one and rank two Gu Masters it is hard to dodge once distance closes; rank three Gu Masters might dodge with difficulty.",
        "chapters": [
          1500
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "fac_gu_masters"
        ]
      },
      {
        "text": "Young Thieving Heaven uses it openly in the clan competition. Matches end quickly when the phantom strikes and the opponent faints, and the clan’s higher-ups covet mass production through the recipe more than the single worm.",
        "chapters": [
          1501
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "competition-use",
        "text_origin": "source_excerpt"
      }
    ]
  },
