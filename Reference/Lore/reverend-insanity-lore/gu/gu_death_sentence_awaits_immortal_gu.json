  "history": {
    "claims": [
      {
        "text": "Shark Demon holds it when Tai Bai Yun Sheng bargains for deepsea lightning eels after leaving Hai Shi blessed land. Tai Bai Yun Sheng accepts the Gu’s use to gain Shark Demon’s trust, and Shark Demon then sells him those eels for help repairing a secret blessed land entrance rather than for immortal essence stones.",
        "chapters": [
          683
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
