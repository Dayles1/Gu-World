  "history": {
    "claims": [
      {
        "text": "When Blood Sea Ancestor caused chaos in the five regions, Heavenly Court sensed danger. A Heavenly Court predecessor followed fate Gu’s revelation and found a wild blood relation Immortal Gu.",
        "chapters": [
          1886
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
