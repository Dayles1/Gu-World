  "history": {
    "claims": [
      {
        "text": "Blazing Heaven Demoness takes out a mortal Gu so valuable that even rank nine venerables look for it painstakingly, and Fang Yuan cannot look away from it. It is a lifespan Gu, and she tells Fang Yuan it can give him sixty years of life, so that he will not be old after he changes back. It is the third of the three conditions she gives, and the narration calls it a treasure Fang Yuan had been looking for.",
        "chapters": [
          947
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_blazing_heaven_demoness",
          "sys_mortal_gu",
          "char_fang_yuan",
          "gu_lifespan_gu"
        ]
      },
      {
        "text": "While Fang Yuan modifies the nirvana fire killer move, he has gathered enough strength path immortal zombies and refined enough exert strength Gu, and he even has a sixty year lifespan Gu. With all three he could activate the life-and-death immortal aperture revival method, become a living Gu Immortal and obtain a high grade blessed land.",
        "chapters": [
          951
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "revival-plans",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_strength_gu",
          "sys_gu_immortal"
        ]
      },
      {
        "text": "Fang Yuan recalls that he had obtained a lifespan Gu from Blazing Heaven Demoness, and that after his rebirth he lost that opportunity and has no lifespan Gu.",
        "chapters": [
          1074
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "fate-of-the-gu",
        "text_origin": "source_excerpt"
      }
    ]
  },
