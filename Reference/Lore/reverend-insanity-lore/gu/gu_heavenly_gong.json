  "appearance": {
    "claims": [
      {
        "text": "Qin Bai Sheng presents it as a sound path rank six Immortal Gu and asks for a transformation path related Immortal Gu in trade. The projected image is cicada-like, with a large head and shining silver light, less exquisite than Spring Autumn Cicada.",
        "chapters": [
          751
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
