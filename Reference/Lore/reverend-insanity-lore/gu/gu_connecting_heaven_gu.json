  "appearance": {
    "claims": [
      {
        "text": "When activated, the Gu worm’s body grows into a round mirror that floats in the air.",
        "chapters": [
          465
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "appearance",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_gu_worms"
        ]
      },
      {
        "text": "Connecting Heaven Gu and divine sense Gu are both rank five Gu with an extremely huge demand for primeval essence. A rank five peak stage Gu Master might last only several breaths, so Gu Immortals or land spirits usually spend immortal essence to use them.",
        "chapters": [
          465
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "form-and-rank",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_gu_master",
          "sys_gu_immortal"
        ]
      },
      {
        "text": "When activated, Connecting Heaven Gu turns into a round mirror that floats above the user. Lang Ya land spirit uses that mirror with divine sense Gu to browse and buy materials in treasure yellow heaven. Fang Yuan later sends his copy into Hu Immortal blessed land by Moving Perspective Cup Gu.",
        "chapters": [
          465
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "form-and-rank",
        "text_origin": "source_excerpt",
        "mentions": [
          "loc_hu_immortal_blessed_land",
          "gu_moving_perspective_cup_gu"
        ]
      }
    ],
    "visual_confidence": "text_described"
  },
  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "Connecting Heaven Gu and hole earth Gu are only mortal Gu. They can connect blessed lands or grotto-heavens because the two small worlds silently consume heavenly power, and both sides must consent. They cannot be used if set up outside in the five regions, and immortal zombies cannot use them because dead apertures cannot expend heavenly power.",
        "chapters": [
          739
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "heavenly-power-and-setup",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_mortal_gu"
        ]
      },
      {
        "text": "Cited chapters do not state what Connecting Heaven Gu eats.",
