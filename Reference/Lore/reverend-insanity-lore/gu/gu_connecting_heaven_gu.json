  "history": {
    "claims": [
      {
        "text": "After deals with Immortal Crane Sect open, Fang Yuan sets aside his plan to go to Lang Ya blessed land and snatch Connecting Heaven Gu.",
        "chapters": [
          420
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "fac_immortal_crane_sect",
          "char_fang_yuan",
          "loc_lang_ya_blessed_land"
        ]
      },
      {
        "text": "At Lang Ya blessed land he exchanges a rank five recipe for Connecting Heaven Gu and refines it on the spot. Lang Ya land spirit names hole earth Gu and Connecting Heaven Gu as popular classics of the same type as stargate Gu, and Fang Yuan’s stated aim is to use Connecting Heaven Gu with divine sense Gu so he can trade in treasure yellow heaven without relying on Immortal Crane Sect.",
        "chapters": [
          462
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "exchange-at-lang-ya",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_lang_ya_land_spirit",
          "gu_hole_earth_gu"
        ]
      },
      {
        "text": "Connecting Heaven Gu is one of four rank five mortal Gu Fang Yuan had borrowed from Huo Kong Dong, together with flying smoke Gu, fire cape Gu, and divine sense Gu.",
        "chapters": [
          1027
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "borrowed-from-huo-kong-dong",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_huo_kong_dong",
          "gu_fire_cape_gu"
        ]
      }
    ]
