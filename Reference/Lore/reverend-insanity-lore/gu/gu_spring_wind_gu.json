    "activation_raw": null,
    "claims": [
      {
        "text": "Spring star rain forms a jade colored rain that falls for three days and three nights. That rain is rich like oil, feeds crops, raises productivity, and is used to nurture plants and manage a blessed land. Star Lord Wan Xiang’s will says his main body created the move, and he sells it for one and a half immortal essence stones. Fang Yuan buys spring star rain with enough star shoot Gu for ten activations.",
        "chapters": [
          667
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "killer-move-role",
