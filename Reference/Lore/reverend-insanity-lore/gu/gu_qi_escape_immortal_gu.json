  "history": {
    "claims": [
      {
        "text": "Fairy Li Shan offers Fang Yuan the movement killer move Kong Sheng Tian, named for the Gu Immortal who created it. At that stretch Spring Autumn Cicada was still ranked seventh on the list of Top Ten Mystical Gu.",
        "chapters": [
          678
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_fairy_li_shan",
          "char_fang_yuan",
          "char_kong_sheng_tian",
          "sys_gu_immortal",
          "gu_spring_autumn_cicada",
          "sys_ten_big_mystical_gu"
        ]
      },
      {
        "text": "Sword Escape Immortal Gu is nearly on par with this Gu at the same rank. In Bo Qing’s recorded chase, a rank seven Gu Immortal flees with this Gu and Bo Qing pursues with Sword Escape Immortal Gu without catching up, though the gap does not shrink.",
        "chapters": [
          995
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "same-rank-comparisons",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_sword_escape_immortal_gu",
          "char_bo_qing"
        ]
      },
      {
        "text": "In linear speed Sword Escape Immortal Gu can compare with similarly ranked qi escape Gu.",
        "chapters": [
          1062
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "linear-speed-compare",
        "text_origin": "source_excerpt"
      },
      {
        "text": "After the battle of Yi Tian Mountain exposes Fang Yuan as a person from the future who used Spring Autumn Cicada to rebirth, Spring Autumn Cicada rises from seventh to third on the List of Mystical Gu, and qi escape Gu sits fifth.",
        "chapters": [
          1175
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "mystical-gu-list-place",
        "text_origin": "source_excerpt",
        "mentions": [
          "loc_yi_tian_mountain"
        ]
      }
    ]
