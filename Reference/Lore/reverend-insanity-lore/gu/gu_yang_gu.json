  "appearance": {
    "claims": [
      {
        "text": "After Yin Gu is used, the remaining Yang Gu is white armored and still counts among Fang Yuan’s rank four Gu. If Yin Gu and Yang Gu are intact and form a complete Taiji light sphere, they feed on the transformation of yin and yang qi and are self-sufficient. With only Yang Gu left, Fang Yuan must release it to absorb yang qi in the air. Without yang qi, as in some caves or underground places, Yang Gu can starve, and Fang Yuan’s hold over Bai Ning Bing would fail with it.",
        "chapters": [
          202
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "appearance-and-feeding",
        "text_origin": "source_excerpt"
      }
    ],
    "visual_confidence": "text_described"
  },
  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "Yang Gu used on a female body turns yin into yang and makes the target a man. After Yin Gu lowers a ten extreme physique by ten percent aptitude, cultivation can restore the extreme again. Yang Gu is then needed to turn the user around and cut aptitude by ten percent once more.",
        "chapters": [
          199
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Destroying the pair would leave Bai Ning Bing unable to return to a male body.",
        "chapters": [
          201
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt"
      }
    ]
  },
