  "history": {
    "claims": [
      {
        "text": "After Fang Yuan uses Yin Gu from Yin Yang Rotation Gu on Bai Ning Bing, only Yang Gu remains. He keeps it refined in his aperture and can order it to self-destruct with a thought. Yin Yang Rotation Gu comes in pairs: with Yin Gu already used, only this Yang Gu can reverse Bai Ning Bing.",
        "chapters": [
          199
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_fang_yuan",
          "gu_yin_gu",
          "gu_yin_yang_rotation_gu",
          "char_bai_ning_bing"
        ]
      },
      {
        "text": "The pair as a whole is covered on Yin Yang Rotation Gu. The spent half is covered on Yin Gu.",
        "chapters": [],
        "certainty": "inferred",
        "confidence": "C",
        "verification": "no_citation",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt"
      },
      {
        "text": "In Shang clan city, Doctor Su Shou states that returning Bai Ning Bing to a male body needs the corresponding Yang Gu, or a high chance of help from a rank six Gu Immortal.",
        "chapters": [
          271
        ],
        "certainty": "canon",
        "confidence": "B",
