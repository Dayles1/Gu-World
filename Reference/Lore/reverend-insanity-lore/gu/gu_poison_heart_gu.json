  "history": {
    "claims": [
      {
        "text": "In captivating sea of Jade Pool blessed land, Fairy Li Shan warns Fang Yuan about tens of thousands of poisonous purple heart flowers close to blooming under the illusory peach trees.",
        "chapters": [
          799
        ],
        "certainty": "canon",
