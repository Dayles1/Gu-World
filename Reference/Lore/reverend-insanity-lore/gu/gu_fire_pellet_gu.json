  "history": {
    "claims": [
      {
        "text": "On the Shang clan city battle stage, Yan Tu opens against Bai Ning Bing with Fire Pellet Gu while Bai Ning Bing answers with Icicle Gu. Three fire pellets meet four white icicles; a surviving pellet keeps flying after an icicle melts and loses power.",
        "chapters": [
          312
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "loc_shang_clan_city",
          "char_yan_tu",
          "char_bai_ning_bing",
          "gu_icicle_gu"
        ]
      },
      {
        "text": "Fang Yuan notes that Yan Tu is also draining primeval essence through Fire Pellet Gu, and that Bai Ning Bing leans on A grade recovery against Yan Tu’s B grade rank four cultivation. When Bai Ning Bing pressures the twin fiery snakes, Yan Tu shoots fire pellets both at her and into the snakes. Pellets that fuse into the snakes restore vigor. That pairing is the combination battle tactic of Fire Pellet Gu and fiery snake Gu, refined across hundreds of battle stage fights.",
        "chapters": [
          313
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "aptitude-note-and-fiery-snake-combo",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_fang_yuan",
          "gu_fiery_snake_gu"
        ]
      },
      {
        "text": "Tang Fang pours primeval essence into Fire Pellet Gu and shoots a fist-sized orange fireball that burns a night wolf to death.",
        "chapters": [
          509
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "tang-fangs-copy",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_tang_fang"
        ]
      },
      {
        "text": "Later narration treats Fire Pellet Gu as a very common Gu that can summon one fireball.",
        "chapters": [
          783
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "common-fireball-gu",
        "text_origin": "source_excerpt"
      }
    ]
