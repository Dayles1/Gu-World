  "history": {
    "claims": [
      {
        "text": "Fang Yuan fuses Sky Canopy Gu on Qing Mao Mountain after he becomes a rank three elder, on his second try at that fusion.",
        "chapters": [
          155
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_fang_yuan",
          "loc_qing_mao_mountain"
        ]
      },
      {
        "text": "Later chapters also call the same Gu canopy Gu while it still forms the same white armor.",
        "chapters": [
          207
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt"
      },
      {
        "text": "After Fang Yuan’s cultivation falls to rank one initial stage, he cannot properly power rank three Gu even with A grade recovery and Heavenly Essence Treasure Lotus, so he lends Sky Canopy Gu and Chainsaw Golden Centipede to rank three Bai Ning Bing.",
        "chapters": [
          201
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "lending-to-bai-ning-bing",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_chainsaw_golden_centipede",
          "char_bai_ning_bing"
        ]
      },
      {
        "text": "She places it in her aperture, pours white silver primeval essence into it, and gains the white light armor.",
        "chapters": [
          202
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "lending-to-bai-ning-bing",
        "text_origin": "source_excerpt"
      },
      {
        "text": "It stays the rank three defensive Gu he has lent her while he looks for other defense for himself.",
        "chapters": [
          205
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "lending-to-bai-ning-bing",
        "text_origin": "source_excerpt"
      },
      {
        "text": "During later fighting on Bai Gu mountain he lends the canopy Gu to her again so she can stack it with other defenses.",
        "chapters": [
          227
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "lending-to-bai-ning-bing",
        "text_origin": "source_excerpt",
        "mentions": [
          "loc_bai_gu_mountain"
        ]
      }
    ]
