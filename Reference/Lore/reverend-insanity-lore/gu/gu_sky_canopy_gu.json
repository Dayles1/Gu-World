    "claims": [
      {
        "text": "Sky Canopy Gu is refined from rank two White Jade Gu and an aqua defense Gu. Fang Yuan’s first try used Water Shield Gu with White Jade Gu and failed, killing the Water Shield Gu. The aqua defense Gu used on the successful second try came from battle-merit exchange.",
        "chapters": [
          155
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "fusion",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_white_jade_gu",
          "gu_water_shield_gu"
        ]
      }
    ]
  },
  "economy": {
    "canonical_prices": [],
    "price_claims": [
      {
        "text": "Spectators call canopy Gu and golden shield Gu great defensive rank three Gu, and Bai Ning Bing judges that golden shield Gu suits Fang Yuan’s strength path methods slightly better.",
        "chapters": [
          300
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "sale-in-shang-clan-city",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_golden_shield_gu"
        ]
      },
      {
        "text": "Fang Yuan has already sold the canopy Gu because it overlapped with golden shield Gu and did not suit his fighting style; the text does not name the buyer.",
        "chapters": [
          301
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "sale-in-shang-clan-city",
        "text_origin": "source_excerpt"
