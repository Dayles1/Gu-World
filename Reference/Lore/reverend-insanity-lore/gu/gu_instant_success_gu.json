  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "Instant success Gu looks like a palm-size dragonfly with three pairs of wings and four shining colors: jade green, sapphire blue, gold, and bright red. Its body holds the Dao mark of time. As the name suggests, it speeds the flow of time, and it is a rank four consumable Gu. With rank three initial stage cultivation, Fang Yuan must refill his primeval sea several times before he can fill and activate it. Once activated it cannot be stopped; dimming the light only prolongs what remains. Using it for a short span costs him three months of lifespan, and the full activation costs half a year’s lifespan. He spends that time removing a boar phantom and gaining bull, horse, and half a turtle strength.",
        "chapters": [
          297
        ],
        "certainty": "inferred",
        "confidence": "C",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "form-and-lifespan-cost",
        "text_origin": "source_excerpt"
      }
    ]
  },
