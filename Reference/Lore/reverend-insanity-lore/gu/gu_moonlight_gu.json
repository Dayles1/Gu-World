  "history": {
    "claims": [
      {
        "text": "Fang Yuan first names it as the clan’s Moonlight Gu when he is weighing what to take as a vital Gu after the Awakening Ceremony. He judges it a far worse vital Gu than the Liquor worm he has been hunting at night with wine as bait, if only he can catch it before April runs out.",
        "chapters": [
          7
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_fang_yuan",
          "sys_vital_gu",
          "sys_awakening_ceremony"
        ]
      },
      {
        "text": "At the end of that same day’s class he takes one from the academy Gu room on Qing Mao Mountain.",
        "chapters": [
          8
        ],
        "certainty": "canon",
        "confidence": "B",
