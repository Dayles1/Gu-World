  "history": {
    "claims": [
      {
        "text": "Fang Yuan and Bai Ning Bing find Spiral Bone Spear Gu in the milk-spring vat of the Bai Gu mountain white bone inheritance, mixed among a much larger number of rank one Bone Spear Gu.",
        "chapters": [
          222
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_fang_yuan",
          "char_bai_ning_bing",
          "loc_bai_gu_mountain",
          "gu_bone_spear_gu"
        ]
      },
      {
        "text": "Bai clan elders later recognize both kinds when the inheritance is disturbed.",
        "chapters": [
          223
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "fac_bai_clan_bai_gu_mountain"
        ]
      },
      {
        "text": "Fang Yuan refines over twenty Spiral Bone Spear Gu into his aperture on the spot, while Bai Ning Bing takes one to refine later.",
        "chapters": [
          222
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "fang-yuan-and-bai-ning-bing",
        "text_origin": "source_excerpt"
      },
      {
        "text": "They still hold large numbers when they leave the inheritance.",
        "chapters": [
          228
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "fang-yuan-and-bai-ning-bing",
        "text_origin": "source_excerpt"
      },
      {
        "text": "In Shang clan city he bargains twenty of them to eight hundred primeval stones each at Tong Ou shop, as part of a forty thousand six hundred and twenty stone Gu package with bone spear and bone spike Gu.",
        "chapters": [
          262
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "fang-yuan-and-bai-ning-bing",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_bone_spike_gu"
        ]
      },
      {
        "text": "After Shang Ya Zi blocks other buyers, Fang Yuan later sells the spiral bone spear Gu with those other white bone Gu to Shang Ya Zi under that original agreement for the same total.",
        "chapters": [
          268
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "fang-yuan-and-bai-ning-bing",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_shang_ya_zi"
        ]
      }
    ]
  },
