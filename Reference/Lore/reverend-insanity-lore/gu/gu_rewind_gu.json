  "history": {
    "claims": [
      {
        "text": "Hong Yi names it among the Gu worms that make his battle strength first-rate among rank two Gu Masters at Universal Life Academy, and says he obtained it by chance.",
        "chapters": [
          676
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_hong_yi",
          "sys_gu_worms",
          "fac_gu_masters",
          "loc_universal_life_academy"
        ]
      },
      {
        "text": "He plans to use it against an opponent’s defensive Gu in the academy competition: if only one defensive Gu is active, one strike after the rewind can heavily injure that opponent; if two defensive Gu stay active, he means to drag the fight so the enemy spends primeval essence faster. He also treats rewind Gu as the only valuable thing on him when a brief empty feeling hits him the night Fang Yuan connects luck to him.",
        "chapters": [
          680
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
