  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "It is an extremely rare time path Gu worm that can attack and defend. Its ability rewinds an enemy’s Gu worm to the state before activation, so a condensed fire ball vanishes when the worm returns to that earlier state.",
        "chapters": [
          679
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "path_time"
        ]
      },
      {
        "text": "It demands an extremely large amount of primeval essence. Even Hong Yi, with an A-grade aperture and over ninety percent primeval essence, can activate it only once.",
        "chapters": [
          679
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "cost",
        "text_origin": "source_excerpt"
      }
