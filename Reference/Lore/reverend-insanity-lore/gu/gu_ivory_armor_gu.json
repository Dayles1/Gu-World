  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "After the battle ends the Gu Master must break the shell off themself. As Ju Kai Bei keeps moving, the armor thickens and his skin becomes monstrously thick. Alone it can compete with Fang Yuan’s steel tendons, iron bones, and bronze skin combination. Fang Yuan repeatedly breaks the growing armor with iron fists so it cannot reach a complete form early on.",
        "chapters": [
          316
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_gu_master"
        ]
      },
      {
        "text": "Ju Kai Bei’s whole body is covered in ivory armor with many scars and cracks, yet he stands straight like an iron tower.",
        "chapters": [
          317
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "battle-stage-coverage",
        "text_origin": "source_excerpt"
      },
      {
        "text": "The ivory armor keeps being broken and keeps repairing itself as the fight turns desperate. Many defensive Gu cannot stretch with the user, and Ivory Armor Gu is one of them: when Ju Kai Bei enlarges his body with his killer move, the armor covering him breaks and must grow again to reseal him.",
        "chapters": [
          319
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "killer-move-strain",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_defensive_gu"
        ]
      }
    ]
  },
