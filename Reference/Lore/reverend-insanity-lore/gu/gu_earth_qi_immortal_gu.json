    "claims": [
      {
        "text": "Qin Ding Ling temporarily lends all three qi Immortal Gu for the qi path formation against Heavenly Court’s qi harvest fruit, with Heavenly Court able to reclaim them and strip control if needed. Disguised as Qi Sea Ancestor, Fang Yuan tosses Earth Qi Immortal Gu first while instilling immortal essence as the opening foundation of a formation that involves the earth vein; the Gu flies into the ground below the qi harvest fruit and earth qi rises from the shaken ground. Red Heart Traveler reads the resulting earth-vein disturbance as that first foundation taking effect on a main earth vein.",
        "chapters": [
          2025
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
