    "claims": [
      {
        "text": "Blood Asset was originally only rank six. Fang Yuan uses the Long Hair refinement path formation to refine it to rank seven, and it becomes one of the four main cores of Four Elements Square Regret Blood Refinement Pool beside rank eight Advance Refinement, Water Refinement, and Regret.",
        "chapters": [
          2077
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "rank-seven-and-the-refinement-pool",
