  "distribution": {
    "locations": [
      "loc_luo_po_valley"
    ],
    "factions": [],
    "origin": "unknown",
    "claims": [
      {
        "text": "Fang Yuan did not know this Immortal Gu beforehand. The previous Lang Ya land spirit innovated it from blood path Gu recipes bought in treasure yellow heaven, and that prior land spirit treasured it so deeply he would not exchange it. After the land spirit’s personality change, the new Lang Ya land spirit cared more about promoting hairy men than Gu refinement, and the Gu passed to Fang Yuan in their transaction.",
        "chapters": [
          1058
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "origin-and-ownership",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_lang_ya_land_spirit",
          "sys_gu_recipe"
        ]
      },
      {
        "text": "Fang Yuan sells Luo Po Valley for three rank six Immortal Gu: Dog Shit Luck, Blood Asset, and dark limit Immortal Gu.",
        "chapters": [
          1063
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "origin-and-ownership",
        "text_origin": "source_excerpt",
        "mentions": [
          "loc_luo_po_valley",
          "gu_dog_shit_luck",
          "gu_dark_limit_immortal_gu"
        ]
      }
    ]
  },
