  "history": {
    "claims": [
      {
        "text": "Inside the sovereign immortal aperture, Fang Yuan brings a rank six Immortal Gu out of his body while healing in a lake of blood: a round pearl as large as a goose egg, covered in moving markings. It is the blood path Immortal Gu Blood Asset.",
        "chapters": [
          1058
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_fang_yuan",
          "sys_immortal_gu",
          "path_blood"
        ]
      },
      {
        "text": "Fang Yuan finishes arranging a Gu formation for the coiling thread caves, and Blood Asset joining its jade light turns the light blood red as the arrangement reaches its most crucial step. The brand new coiling thread Gu formation he deduces after reaching formation path grandmaster still uses Blood Asset, and it only doubles his gains rather than delivering the eightfold of his original concept, which could not be set up.",
        "chapters": [
          1334
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "coiling-thread-cave-gu-formation",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_gu_formation"
        ]
      }
    ]
