  "appearance": {
    "claims": [
      {
        "text": "On Qing Mao Mountain during the three-clan wolf tide, more than a dozen sit on the village square battle merit board banner.",
        "chapters": [
          127
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "form-and-rank",
        "text_origin": "source_excerpt",
        "mentions": [
          "loc_qing_mao_mountain"
        ]
      }
    ],
    "visual_confidence": "text_described"
  },
  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "Ranking symbols move and act out a climb to first place as a Gu Master drives the Gu, so the board updates in public view. Support Gu Masters at rank one freely convert the writings on the banner while they manipulate it.",
        "chapters": [
          127
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_gu_master",
          "sys_support_gu"
        ]
      },
      {
        "text": "Days later, a giant resource flag in the square also has words formed by Swimword Gu. That flag lists goods the three clans supply against merit costs, from supply food to Gu worms and primeval stones. Fang Yuan reads Three Step Fragrant Grass Gu among those listings.",
        "chapters": [
          132
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_gu_worms",
          "char_fang_yuan",
          "gu_three_step_fragrant_grass_gu"
        ]
      },
      {
        "text": "Large numbers of Swimword Gu sit on the complete battle merit list erected in fifteen large tents. That list is as large as defense walls. The characters on the list flicker as battle merits change.",
        "chapters": [
          516
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "battlefield-merit-lists",
        "text_origin": "source_excerpt"
      }
    ]
