  "feeding": {
    "known": true,
    "food_raw": null,
    "foods": [],
    "claims": [
      {
        "text": "Mirror willow leaves are the food of beggar moths. Mirror willows are ordinary plants about the size of ordinary willow trees, with leaves like pieces of mirrors. Fang Yuan had purchased a batch from Immortal Crane Sect during rockmen transactions and planted them in Hu Immortal blessed land.",
        "chapters": [
          654
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "food",
        "text_origin": "source_excerpt",
        "mentions": [
          "res_mirror_willow_leaves",
          "fac_immortal_crane_sect"
        ]
      },
      {
        "text": "Later, when that small batch of mirror willows dies, the beggar moths that ate those leaves no longer have any use and are sold off.",
        "chapters": [
          827
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "food",
        "text_origin": "source_excerpt"
      }
    ]
  },
