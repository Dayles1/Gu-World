  "economy": {
    "canonical_prices": [],
    "price_claims": [
      {
        "text": "At Qin Bai Sheng’s Immortal Gu auction, Feng Jiu Ge offers Eat Strength while bidding for delight in water and mountain Immortal Gu, and after hearing that description Fang Yuan finds the Gu too suitable for him.",
        "chapters": [
          758
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_qin_bai_sheng",
          "sys_immortal_gu",
          "char_feng_jiu_ge",
          "move_eat_strength",
          "gu_delight_in_water_and_mountain",
          "char_fang_yuan"
        ],
        "needs_review": true
      },
      {
        "text": "After Eighty-Eight True Yang Building collapsed, a formless hand flew out near Prince Feng Xian’s grotto-heaven. Prince Feng Xian broke that hand and captured Eat Strength, then sent it to Feng Jiu Ge when asked for help.",
        "chapters": [
          758
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "auction-and-ownership",
        "text_origin": "source_excerpt",
        "mentions": [
          "house_eighty_eight_true_yang_building",
          "char_prince_feng_xian"
        ]
      },
      {
        "text": "Feng Jiu Ge lets the Gu go in the completed trade, and Fang Yuan refines it into his immortal aperture.",
        "chapters": [
          760
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "auction-and-ownership",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Fang Yuan later lends the Gu to Hei Lou Lan so she can digest strength path flesh after cooking.",
        "chapters": [
          778
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "auction-and-ownership",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_hei_lou_lan"
        ]
      },
      {
        "text": "He then sets immortal materials as the price for future borrowing.",
        "chapters": [
          779
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "auction-and-ownership",
        "text_origin": "source_excerpt"
      }
    ],
    "game_proposals": []
