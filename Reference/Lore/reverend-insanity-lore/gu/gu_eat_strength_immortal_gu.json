  "history": {
    "claims": [
      {
        "text": "In Fang Yuan’s accounting of his transactions with Sixth Hair, Eat Strength is listed among Immortal Gu that self-detonated under Fang Yuan’s special will.",
        "chapters": [
          1079
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "loss-and-aftermath",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_sixth_hair"
        ]
      },
      {
        "text": "Fang Yuan treats the Gu as destroyed when he obtains a walking meat tree he had wanted for that cultivation method.",
        "chapters": [
          1133
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "loss-and-aftermath",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Fang Yuan deduces an immortal killer move eat strength with snack Immortal Gu as the core to replace the lost Immortal Gu; one session can outpace rank six Eat Strength, but costs more immortal essence and is less convenient than using the Immortal Gu alone.",
        "chapters": [
          1465
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "loss-and-aftermath",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_snack_immortal_gu"
        ]
      }
    ]
