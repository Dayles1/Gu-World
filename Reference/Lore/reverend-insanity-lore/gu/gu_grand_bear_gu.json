    "origin": "unknown",
    "claims": [
      {
        "text": "Wei Yang warns Fang Yuan that Tang Xiong is coming for revenge, capable of the strength of three bears.",
        "chapters": [
          280
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "shang-clan-battle-stage",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_wei_yang",
          "char_fang_yuan"
        ]
      },
      {
        "text": "On the Shang clan city battle stage, Tang Xiong already holds the strength of two bears before he activates grand bear Gu. His muscles expand, his body grows larger, and he temporarily gains the strength of a third bear on top of that base. Onlookers say grand bear Gu has a time limit, and that once the effect ends he will be disadvantaged. After Fang Yuan’s third victory, the stage rules let him take that grand bear Gu. It is called the most valuable Gu in Tang Xiong’s possession. Without it Tang Xiong is left with the strength of two bears, and his battle strength falls by about thirty percent.",
        "chapters": [
          281
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "shang-clan-battle-stage",
        "text_origin": "source_excerpt",
        "mentions": [
          "loc_shang_clan_city",
          "char_tang_xiong"
        ]
      },
      {
        "text": "The novel does not later show Fang Yuan activating or selling that copy.",
        "chapters": [],
        "certainty": "inferred",
        "confidence": "C",
        "verification": "no_citation",
        "source_id": "src_sagaofgu",
        "section": "shang-clan-battle-stage",
        "text_origin": "source_excerpt"
      }
    ]
