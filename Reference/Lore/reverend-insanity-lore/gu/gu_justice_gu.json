    "activation_raw": null,
    "claims": [
      {
        "text": "To activate justice Gu, other than primeval essence, the Gu Master also needs to believe that they are on the side of justice. Shan clan claims woman’s heart Gu can brew poisoned wine that counters justice Gu, but the wine matters only once justice Gu stops working. When Fang Yuan’s words make Chen clan’s leader suspect himself and feel ashamed, he cannot activate justice Gu anymore, and the wine then takes effect. Shan clan later tries to force the imprisoned clan leader to hand over justice Gu. Clearing the final scene requires restoring his understanding so he can use justice Gu once more and break out of the prison.",
        "chapters": [
          1820
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
