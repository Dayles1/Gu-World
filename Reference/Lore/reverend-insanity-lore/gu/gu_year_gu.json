  "history": {
    "claims": [
      {
        "text": "Inside Hei Fan’s true inheritance, Fang Yuan pulls an ice seal that holds Immortal Gu Year. The Gu looks like a thumb-sized black ladybug with bright golden shell markings that show a fierce beast. It is a famous Gu among time path Immortal Gu. Immortal Bing Ren created the sealing ice for Hei Fan, and the ice keeps year Gu hibernating without leaking aura.",
        "chapters": [
          1129
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
