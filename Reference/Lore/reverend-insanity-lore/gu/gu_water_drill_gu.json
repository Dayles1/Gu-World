  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "Bai Bing Yi gathers his fingers, forms a water droplet that expands into a fast current, and coils that water around his palm into a light-blue spiral drill that rotates on his fist. It can drill through rocks and steel with very strong attack power, and barely any Gu worm could defend against it.",
        "chapters": [
          125
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_gu_worms"
        ]
      },
      {
        "text": "Xiong Jiang offers three attacking chances while he defends. Bai Bing Yi warns that Xiong Jiang cannot block Water Drill Gu. The first blow hits Xiong Jiang’s raised arms under Roaming Zombie Gu; water splatters, the drill’s rotation intensifies, and Xiong Jiang is driven back with both arms torn to the bone. Shadow Bond Gu then returns a share of that injury, and Bai Bing Yi vomits blood and admits defeat.",
        "chapters": [
          125
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "alliance-slope-use",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_roaming_zombie_gu",
          "gu_shadow_bond_gu"
        ]
      },
      {
        "text": "Bai Bing Yi has attacking methods besides Water Drill Gu, and Xiong Jiang’s Shadow Bond Gu only reaches about ten meters, so their spar does not show either man’s full combat strength.",
        "chapters": [
          127
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "spar-limits",
        "text_origin": "source_excerpt"
      }
    ]
  },
