    "related_variants": [],
    "claims": [
      {
        "text": "Ying Wu Xie analyzes that the Immortal Gu belonged to Shadow Sect and perished with Jiang Yu, and that Lang Ya land spirit, having founded Lang Ya Sect, refined dark limit Immortal Gu to let the sect’s members move about more easily. That analysis also states the Gu can conceal aura and hide from heaven’s will.",
        "chapters": [
          1042
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "refinement-and-ownership",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_ying_wu_xie",
          "fac_shadow_sect",
          "char_lang_ya_land_spirit",
          "fac_lang_ya_sect"
        ]
      },
      {
        "text": "Fang Yuan later obtains dark limit Immortal Gu from Lang Ya land spirit as one of three rank six Immortal Gu in the Luo Po Valley sale, together with dog shit luck Immortal Gu and blood asset Immortal Gu.",
        "chapters": [
          1063
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "refinement-and-ownership",
        "text_origin": "source_excerpt",
        "mentions": [
          "loc_luo_po_valley",
          "gu_blood_asset_immortal_gu"
        ]
      }
    ]
  },
