  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "Wei Yang states two weaknesses himself: the speed is so fast the Gu Master cannot react in time without lightning thoughts Gu, flash of inspiration Gu, or similar; and primeval essence expenditure is middle-high among rank three Gu. He withholds a third weakness and invites them to guess. Bai Ning Bing names it as the inability to use a strength Gu to raise physical strength, and Wei Yang confirms that body-altering strength Gu make Rainbow light Gu hard to use, raising expenditure drastically or risking failed light transformation that destroys the Gu. He also holds light source Gu, which halves primeval essence expenditure when using light type Gu.",
        "chapters": [
          266
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
