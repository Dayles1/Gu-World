    "claims": [
      {
        "text": "The two bodies share the same aura and look identical, with nothing to tell them apart, and they fly in different directions. Investigative methods find no flaw, so the pursuers have to split up. Shortly after Fang Yuan picks one target, Dong Fang Chang Fan creates another split shadow and sends another figure aside, then creates yet another clone that flies in two directions.",
        "chapters": [
          804
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Dong Fang Chang Fan states that his immortal killer move could create thirty split shadows.",
        "chapters": [
          806
        ],
        "certainty": "canon",
        "confidence": "B",
