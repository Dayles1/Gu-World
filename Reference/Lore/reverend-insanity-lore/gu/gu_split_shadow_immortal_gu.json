  "history": {
    "claims": [
      {
        "text": "While Fang Yuan and Pi Shui Han chase Dong Fang Chang Fan after the Jade Pool raid, Dong Fang Chang Fan’s body flickers and a second figure appears. Pi Shui Han recognizes the method and names split shadow Immortal Gu.",
        "chapters": [
          804
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_fang_yuan",
          "char_pi_shui_han",
          "char_dong_fang_chang_fan",
          "sys_immortal_gu"
        ]
      },
      {
        "text": "Fang Yuan watches the body gradually fade and vanish; in its place is a lump of Gu worms. He collects that lump. Split shadow Immortal Gu is not inside; the lump holds only rank five Gu worms mixed with a heavy Immortal Gu aura. Dong Fang Chang Fan later says he gave up split shadow Immortal Gu to escape successfully.",
        "chapters": [
          805
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "gu-lump",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_gu_worms"
        ]
      },
      {
        "text": "A later review of Dong Fang Chang Fan at his peak lists eight Immortal Gu in his possession, including split shadow Immortal Gu, and states that this Gu was not of wisdom path.",
        "chapters": [
          820
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "peak-holdings",
        "text_origin": "source_excerpt"
      }
    ]
  },
