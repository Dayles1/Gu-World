  "history": {
    "claims": [
      {
        "text": "After Bai Ning Bing kills Chen Cui Hua, Fang Yuan uses Plunder Gu and pulls three Gu from the aperture: Rice Bag Grass Gu, Iron Thorn Thistle Gu, and a charred thunder bean mother Gu.",
        "chapters": [
          211
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_bai_ning_bing",
          "char_chen_cui_hua",
          "char_fang_yuan",
          "gu_plunder_gu",
          "gu_rice_bag_grass_gu",
          "gu_iron_thorn_thistle_gu"
        ]
      },
      {
        "text": "Preparing pits against grass-skirt monkey kings, Fang Yuan summons Charred Thunder Potato Mother Gu. It looks like a potato with an uneven surface and tiny holes, yet it is a genuine rank three Gu. His primeval essence is not enough, so he hands the Gu to Bai Ning Bing; she pours essence in, green sprouts grow from the holes, blossom, and bear dark green finger-thick fruit in several breaths. After he filters out bad, dead, or empty shells, the remaining fruits are Charred Thunder Potato Gu. Bai Ning Bing keeps producing those fruits while Fang Yuan buries them in layered pits.",
        "chapters": [
          213
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "form-and-fruiting",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_charred_thunder_potato_gu"
        ]
      },
      {
        "text": "Charred Thunder Potato Mother Gu and Charred Thunder Potato Gu share the same mother-and-product pattern as Zombie Heart Gu and Running Corpse Gu. Fang Yuan still holds the potato mother Gu but has no zombie heart Gu.",
        "chapters": [
          256
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "zombie-lineage-comparison",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_zombie_heart_gu",
          "gu_running_corpse_gu"
        ]
      },
      {
        "text": "Tie Dao Ku has heard from Bai clan leader that Fang Yuan has Charred Thunder Potato Mother Gu.",
        "chapters": [
          293
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "tie-dao-ku-proof",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_tie_dao_ku",
          "char_bai_clan_female_leader"
        ]
      },
      {
        "text": "On the battle stage he treats that Gu as proof Fang Yuan dug explosive pitfalls that destroyed Tie clansmen’s corpses, and he refuses Fang Yuan’s denials.",
        "chapters": [
          294
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "tie-dao-ku-proof",
        "text_origin": "source_excerpt"
      }
    ]
  },
