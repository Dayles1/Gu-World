  "economy": {
    "canonical_prices": [],
    "price_claims": [
      {
        "text": "Fusion success rate for this Gu is extremely low, so few people use it and supply stays thin. Fang Yuan plans to buy one at Shang clan city’s large auction, or refine it himself if buying fails.",
        "chapters": [
          296
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "seeking-and-obtaining",
        "text_origin": "source_excerpt",
        "needs_review": true
      },
      {
        "text": "At the auction Fang Yuan bids hard, then stops and leaves Shang Ya Zi holding the winning bid at eight hundred and ten thousand primeval stones.",
        "chapters": [
          307
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "seeking-and-obtaining",
        "text_origin": "source_excerpt",
        "needs_review": true
      }
    ],
    "game_proposals": []
  },
  "distribution": {
    "locations": [],
    "factions": [],
    "origin": "unknown",
    "claims": []
  },
