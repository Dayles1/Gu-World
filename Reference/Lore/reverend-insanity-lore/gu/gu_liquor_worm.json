    "claims": [
      {
        "text": "Compared with the Liquor worm, there is not much change in its external form, except that it is slightly bigger. It also resembles a silkworm and has a tiny pair of shiny black eyes. The Liquor worm’s body is completely white, but this Four Flavours Liquor worm’s body continuously flickers with four colors: red for spicy, blue for bitter, green for sour, and yellow for sweet.",
        "chapters": [
          121
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "fusion",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_four_flavors_liquor_worm"
        ]
      }
    ]
  },
