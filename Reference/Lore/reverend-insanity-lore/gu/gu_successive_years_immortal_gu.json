  "history": {
    "claims": [
      {
        "text": "Successive Years is one of five time path Immortal Gu that Lang Ya land spirit hands to Fang Yuan, counting those from Lang Ya Sect’s treasury and those exchanged from the variant humans. The five are part of what Fang Yuan takes instead of refinement path true meaning.",
        "chapters": [
          1751
        ],
