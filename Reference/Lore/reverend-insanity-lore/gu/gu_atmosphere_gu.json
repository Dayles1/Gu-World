  "appearance": {
    "claims": [
      {
        "text": "It is shaped like a butterfly, having a pair of blue wings. Each time it flutters, sparkling dust is created in the air.",
        "chapters": [
          308
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
