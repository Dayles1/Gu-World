  "history": {
    "claims": [
      {
        "text": "During the final round against the flying bear phantom in Eighty-Eight True Yang Building, Sun Shi Han warns the Gu Masters not to forget this Gu still on the bear.",
        "chapters": [
          583
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
