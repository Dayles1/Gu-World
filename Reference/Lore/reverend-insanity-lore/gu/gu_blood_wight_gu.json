  "history": {
    "claims": [
      {
        "text": "On Qing Mao Mountain, Fang Yuan names rank five Blood Wight Gu when First gen Gu Yue rises from a sealed coffin during the clash with Tie Xue Leng.",
        "chapters": [
          185
        ],
        "certainty": "canon",
