    "claims": [
      {
        "text": "The mortal line runs from rank one to rank five as green copper, red steel, white silver, yellow gold, and purple crystal Relic Gu, and they are mortal Gu with no rank six or higher Immortal Gu form. Green copper, red steel, and white silver Relic Gu are widely sold; yellow gold and purple crystal Relic Gu are tightly controlled in the mortal market. In treasure yellow heaven, rank one to three Relic Gu sell in batches, while yellow gold Relic Gu stay few.",
        "chapters": [
          469
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "series-limits",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_immortal_gu",
          "char_green"
        ]
      }
    ]
  },
  "appearance": {
    "claims": [
      {
        "text": "It is a thumb-sized round pearl, golden all over, giving off a faint golden luster.",
        "chapters": [
          358
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "appearance",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Relic Gu are sphere-shaped mortal Gu, thumb-sized, with an ordinary appearance; rank four yellow gold Relic Gu is in that series.",
        "chapters": [
          1796
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "appearance",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_mortal_gu"
        ]
      },
      {
        "text": "In Fang Yuan’s hand it is a thumb-sized round pearl, golden all over, giving off a faint golden luster in a dusky cave.",
        "chapters": [
          358
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "form-and-rank",
        "text_origin": "source_excerpt"
      },
      {
        "text": "It is a rank four Gu.",
        "chapters": [
          358
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "form-and-rank",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Relic Gu are a series: rank one green copper, rank two red steel, rank three white silver (also called Silver Relic Gu there), and rank four yellow golden Relic Gu.",
        "chapters": [
          111
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "form-and-rank",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_white_silver_relic_gu"
        ]
      },
      {
        "text": "Later market talk uses the name yellow gold Relic Gu.",
        "chapters": [
          278
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "form-and-rank",
        "text_origin": "source_excerpt"
      },
      {
        "text": "No cited chapter shows a shop-floor idle display of yellow gold Relic Gu before that King Xin Inheritance copy.",
        "chapters": [],
        "certainty": "inferred",
        "confidence": "C",
        "verification": "no_citation",
        "source_id": "src_sagaofgu",
        "section": "form-and-rank",
        "text_origin": "source_excerpt"
      }
    ],
    "visual_confidence": "text_described"
  },
  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "It can directly raise a rank four Gu Master’s cultivation by a small realm. Fang Yuan’s activation turns the Gu into a golden ray of light that enters his aperture; after Spring Autumn Cicada conceals itself, golden light covers the aperture and cleanses the walls, and by dawn he is at rank four middle stage.",
        "chapters": [
          358
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_gu_master",
          "gu_spring_autumn_cicada"
        ]
      }
    ]
  },
