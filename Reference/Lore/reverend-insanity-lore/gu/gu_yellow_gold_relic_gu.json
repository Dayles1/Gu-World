  "economy": {
    "canonical_prices": [],
    "price_claims": [
      {
        "text": "Market talk in Shang clan city prices yellow gold Relic Gu at close to three hundred thousand primeval stones, above green copper, red steel, and white silver Relic Gu. Relic Gu are natural Gu and cannot be refined by Gu Masters. Even with four hundred and twenty thousand stones on hand, Fang Yuan could not afford two of them.",
        "chapters": [
          278
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "price-and-fang-yuans-use",
        "text_origin": "source_excerpt",
        "mentions": [
          "loc_shang_clan_city",
          "fac_gu_masters"
        ]
      },
      {
        "text": "In Shang clan city the supply is heavily controlled: white silver Relic Gu sell normally, while yellow gold Relic Gu stay rare and often with higher-ups; Shang Yan Fei keeps clan stock out of the open market.",
        "chapters": [
          351
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "price-and-fang-yuans-use",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_shang_yan_fei"
        ]
      },
      {
        "text": "No cited chapter names a food for yellow gold Relic Gu.",
        "chapters": [],
        "certainty": "inferred",
        "confidence": "C",
        "verification": "no_citation",
        "source_id": "src_sagaofgu",
        "section": "price-and-fang-yuans-use",
        "text_origin": "source_excerpt"
      },
      {
        "text": "At rank four he wants a yellow gold Relic Gu, but Shang clan city stock stays out of reach even with a purple thorn token.",
        "chapters": [
          351
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "price-and-fang-yuans-use",
        "text_origin": "source_excerpt"
      },
      {
        "text": "He receives one as a reward in King Xin Inheritance and activates it on San Cha Mountain, advancing to rank four middle stage overnight.",
        "chapters": [
          358
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "price-and-fang-yuans-use",
        "text_origin": "source_excerpt"
      }
    ],
    "game_proposals": []
