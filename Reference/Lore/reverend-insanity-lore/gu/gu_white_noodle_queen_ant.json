  "history": {
    "claims": [
      {
        "text": "It is small as a thumb, with an extremely long body like a soft white noodle. Fang Yuan obtains it as one of three Immortal Gu, the other two being a heavily injured fire path Immortal Gu and red copper fire ant. Fang Yuan can still barely see its origin: it should be a queen ant, which has no offensive methods but can rapidly produce worker ants, soldier ants, armor ants, arrow ants and others.",
        "chapters": [
          2108
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_fang_yuan",
          "sys_immortal_gu"
        ]
      },
      {
        "text": "The lingering poisonous ant plague gave birth to two Immortal Gu, red copper immortal ant Gu and white noodle immortal ant Gu. With a slight change there might be another kind of Immortal Gu, such as dark-gold immortal ant or black noodle immortal ant.",
        "chapters": [
          2136
        ],
        "certainty": "canon",
