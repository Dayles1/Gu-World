  },
  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "Three fit on one palm. Fang Yuan refines a hundred and fifty-nine in one pass and keeps them for refinement rather than sale.",
        "chapters": [
          422
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "form-and-use",
        "text_origin": "source_excerpt"
      },
      {
        "text": "A Gu Immortal created Silver Cup Gu three hundred and eighty years into Fang Yuan’s previous life. Continuing that line of refinement up to rank five is the Gu he needs in this stretch.",
        "chapters": [
          422
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
