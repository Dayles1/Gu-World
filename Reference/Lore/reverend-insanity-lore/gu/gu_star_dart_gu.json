  "appearance": {
    "claims": [
      {
        "text": "Star dart Gu is the most commonly seen among star type Gu, and rank one. Because of that Gu, a stellar stone fossil often becomes the shape of a dart. Starlight type Gu contain the law of the stars, so those fossils develop markings that resemble shining stars.",
        "chapters": [
          276
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "form-and-rank",
        "text_origin": "source_excerpt"
      }
    ],
    "visual_confidence": "text_described"
  },
  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "The Shang clan city gambling-den talk introduces Star Dart Gu by fossil shape and star type label only. Later named uses keep it as a bulk star path mortal resource and as material inside the killer move spiral drill star spear, without a solo activation effect for the Gu itself.",
        "chapters": [
          276
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt"
      }
    ]
  },
