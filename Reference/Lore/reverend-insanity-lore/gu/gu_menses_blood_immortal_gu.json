          "char_blood_sea_ancestor",
          "sys_immortal_gu"
        ]
      },
      {
        "text": "Among the eight Immortal Gu Chang Fan holds at his peak, menses blood Immortal Gu and split shadow Immortal Gu are named as Immortal Gu that are not of wisdom path.",
        "chapters": [
          820
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
