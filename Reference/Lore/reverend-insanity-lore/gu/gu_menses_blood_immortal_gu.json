  "history": {
    "claims": [
      {
        "text": "Demonic path Gu Immortals facing Dong Fang Chang Fan’s blood veil name the mortal effect of menses blood Gu as drawing out blood, then state that the rumor of Chang Fan obtaining that Blood Sea Ancestor blood path inheritance is true and that he raised the Gu to Immortal Gu level.",
        "chapters": [
          789
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
