  "history": {
    "claims": [
      {
        "text": "While refining control over Water Pavilion, Fang Yuan finds no less than three thousand Gu worms in its assembly, with two assisting Immortal Gu: rank six movement Immortal Gu Worldly Wave Trace and wisdom path Immortal Gu Delight in Water and Mountain. Water Pavilion is a symbol of Spirit Affinity House and was wielded by Mo Yao. After she refined Calamity Beckoning Gu, the house is ownerless. Fang Yuan cannot refine Immortal Gu at that time. He refines rank one and rank two mortal Gu until he holds ten percent control, then thirteen percent.",
        "chapters": [
          568
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "house_water_pavilion",
          "char_fang_yuan",
          "sys_gu_worms",
          "sys_immortal_gu",
          "gu_worldly_wave_trace",
          "path_wisdom",
          "gu_delight_in_water_and_mountain",
          "fac_spirit_affinity_house",
          "char_mo_yao",
          "gu_calamity_beckoning_gu",
          "sys_mortal_gu"
        ]
      },
      {
        "text": "Mo Yao’s will sends Water Pavilion at a seven fingered formless hand. That hand takes Water Harmony Gu, the house’s one core, and Water Pavilion breaks at once. The formless fist carries the Gu into the sky.",
        "chapters": [
          641
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "pavilion-seizure",
        "text_origin": "source_excerpt",
        "mentions": [
          "move_formless_hand"
        ]
      },
      {
        "text": "Mo Yao later says she meant to sacrifice rank seven Calamity Beckoning Gu in Water Pavilion instead.",
        "chapters": [
          645
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
