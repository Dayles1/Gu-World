  "appearance": {
    "claims": [
      {
        "text": "The snakes start about necklace sized, then rapidly expand into pythons several meters long and as thick as a bucket.",
        "chapters": [
          313
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
