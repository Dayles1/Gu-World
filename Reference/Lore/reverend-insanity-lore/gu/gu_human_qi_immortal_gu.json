  "history": {
    "claims": [
      {
        "text": "Qin Ding Ling shows Fang Yuan a qi path rank eight Immortal Gu that he recognizes as Human Qi Immortal Gu. Fang Yuan calls it a Gu related to human path with immense potential for development. She groups it with earth qi and heaven qi Immortal Gu as the core of the killer move triple qi retraction and as a Heavenly Court treasure limited to members.",
        "chapters": [
          2025
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "heavenly-court",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_fang_yuan",
          "sys_immortal_gu",
          "gu_heaven_qi_immortal_gu",
          "fac_heavenly_court"
        ]
      },
      {
        "text": "Later she refuses to give Human Qi Immortal Gu away, calling it Heavenly Court’s bottom line, while still using the missing piece as leverage because triple qi retraction needs all three.",
        "chapters": [
          2037
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "heavenly-court",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Giant Sun Immortal Venerable had once asked Heavenly Court for Human Qi Immortal Gu and failed.",
        "chapters": [
          2151
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "heavenly-court",
        "text_origin": "source_excerpt",
