  "appearance": {
    "claims": [
      {
        "text": "These chapters do not describe the worm’s appearance, and they do not name Fish Scale Gu’s own rank. Gu Yue Qing Shu says it can be fused into the rank two Scale Armor Gu for good defense.",
        "chapters": [
          123
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "form-and-rank",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_gu_yue_qing_shu"
        ]
      }
    ],
    "visual_confidence": "text_described"
  },
  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "Qing Shu treats Fish Scale Gu as a defensive Gu worm Fang Yuan still lacks, and points to the Scale Armor Gu line as the known use.",
        "chapters": [
          123
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_gu_worms"
        ]
      },
      {
        "text": "The text does not spell out a standalone activation effect for Fish Scale Gu itself in these chapters.",
        "chapters": [],
        "certainty": "inferred",
        "confidence": "C",
        "verification": "no_citation",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Bai clan produces Fish Scale Gu. Gu Yue clan also has them, though fewer. Fang Yuan expects the three-clan battle merit board after the formal alliance to list Fish Scale Gu among exchangeable resources, unlike clan signature Gu such as Moonlight Gu, Bear Strength Gu, or Stream Gu.",
        "chapters": [
          123
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "availability-on-qing-mao-mountain",
        "text_origin": "source_excerpt",
        "mentions": [
          "fac_bai_clan",
          "gu_moonlight_gu",
          "gu_bear_strength_gu",
          "gu_stream_gu"
        ]
      }
    ]
  },
