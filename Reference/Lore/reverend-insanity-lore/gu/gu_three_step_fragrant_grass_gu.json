  "economy": {
    "canonical_prices": [],
    "price_claims": [
      {
        "text": "It is the only one of its kind on that board, and the merit points needed to exchange for it are very high. Fang Yuan wants it above the other new Gu worms listed there, but he refuses to show his true hunting strength to earn the points quickly, because that would draw clan suspicion. Selling a large run of rank one vitality leaves for merit is another path he considers, then rejects as too slow: someone else might take the Gu first.",
        "chapters": [
          132
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "resource-board-listing",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_gu_worms"
        ]
      },
      {
        "text": "He instead plans to reclaim Gu worms from fallen Gu Masters on the battlefield, judging that two or three such returns would cover the exchange.",
        "chapters": [
          133
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
