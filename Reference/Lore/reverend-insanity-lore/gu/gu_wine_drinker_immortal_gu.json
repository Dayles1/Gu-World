  "history": {
    "claims": [
      {
        "text": "Qin Ding Ling rates the human path wine drinker Immortal Gu recipe above the killer move golden bottle drunken wine inside the inheritance Green Ant Ascetic and Wine Fairy created together. The recipe is for Wine drinker Gu: like hero Gu, scholar Gu, craftsman Gu, and farmer Gu in kind, except it is Immortal Gu rather than mortal level.",
        "chapters": [
          2110
        ],
