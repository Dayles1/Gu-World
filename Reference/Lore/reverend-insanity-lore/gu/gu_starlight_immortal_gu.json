  "appearance": {
    "claims": [
      {
        "text": "It is like a prismatic crystal, about the size of a fist.",
        "chapters": [
          852
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "appearance",
        "text_origin": "source_excerpt"
      },
      {
        "text": "It is a prismatic crystal about the size of a fist, and it lies still on a desk when Fang Yuan first sees it. Star Form land spirit names that crystal starlight Immortal Gu.",
        "chapters": [
          852
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "form",
        "text_origin": "source_excerpt"
      }
    ],
    "visual_confidence": "text_described"
  },
  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "During a fight under the sea, Fang Yuan finishes activating starlight Immortal Gu in his immortal aperture until bright light bursts from it. Countless fire path mortal Gu surround it, and he uses the star path immortal killer move star fire escape to burn with deep blue flames and flee upward at high speed.",
        "chapters": [
          895
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "escape-use",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_mortal_gu"
        ]
      }
    ]
  },
  "feeding": {
    "known": true,
    "food_raw": null,
    "foods": [],
    "claims": [
      {
        "text": "Starlight Immortal Gu feeds on the bodies of rockmen. Star Lord Wan Xiang had brought a small rockman tribe into Star Form blessed land for that feeding burden.",
        "chapters": [
          852
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "food",
        "text_origin": "source_excerpt"
      }
    ]
  },
  "refinement": {
    "recipes": [],
    "used_in_recipes": [],
    "refinement_materials": [],
    "confirmed_evolutions": [],
    "related_variants": [],
    "claims": [
      {
        "text": "Mortal starlight Gu is a necessary material for producing wisdom path Star Thought Gu. With starlight Immortal Gu, Fang Yuan can imitate how Strength Qi Immortal Gu supplies material for airsac Gu, and refine star thought Gu faster and on a larger scale without buying mortal starlight Gu. Using it still needs a modified star thought Gu recipe and spends immortal essence.",
        "chapters": [
          852
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "star-thought-refinement",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_starlight_gu",
          "gu_star_thought_gu",
          "gu_strength_qi_immortal_gu",
          "gu_airsac_gu"
        ]
      },
      {
        "text": "After that modification, he activates the Gu over a Fang Yuan stone nest. A mild starlight pillar enters the nest, splits into blue starlight rays for the hairy men, and one activation supplies enough starlight for eight to nine days of their work. That route replaces the older purchase of mortal starlight Gu for the same refinement line.",
        "chapters": [
          862
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "star-thought-refinement",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_stone_nest"
        ]
      },
      {
        "text": "Fang Yuan later credits the successful recipe change to the presence of starlight Immortal Gu, not because of his own abilities.",
        "chapters": [
          916
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "recipe-credit",
        "text_origin": "source_excerpt"
      }
    ]
  },
