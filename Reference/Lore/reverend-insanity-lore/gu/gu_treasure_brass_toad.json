  "appearance": {
    "claims": [
      {
        "text": "The toad is two and a half meters tall with an entire body orange-yellow. Its back is thick with warts and knots, like the bronze nail lumps on ancient city gates.",
        "chapters": [
          39
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "appearance",
        "text_origin": "source_excerpt"
      },
      {
        "text": "The toad is two and a half meters tall and orange-yellow over its whole body. Its back is thick with warts and knots, compared in the text to the bronze nail lumps on ancient city gates. Thick ropes bind goods to that back so that, at a glance, it looks as if the toad carries a giant backpack. Jia Fu sits cross-legged on its head or back and stays steady while it hops; at the peak of a hop his height levels with second-floor windows, and on the ground he still sits higher than the first floor of the bamboo houses. The streets that were spacious for people become packed and narrow around it, as if a beast has pushed into the bamboo houses.",
        "chapters": [
          39
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "form",
        "text_origin": "source_excerpt"
      },
      {
        "text": "It has the same height and orange-yellow body when Jia Fu rides it into the village again.",
        "chapters": [
          109
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "form",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Smaller caravan toads follow behind. They look similar but are cow- or horse-sized and also carry people and merchandise.",
        "chapters": [
          39
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "form",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Those lesser toads are not named Treasure Brass Toads.",
        "chapters": [],
        "certainty": "inferred",
        "confidence": "C",
        "verification": "no_citation",
        "source_id": "src_sagaofgu",
        "section": "form",
        "text_origin": "source_excerpt"
      }
    ],
    "visual_confidence": "text_described"
  },
  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "On the mountain road the Treasure Brass Toad covers about a hundred meters with every hop. That leaping gait is what lets it ignore precipitous and narrow path limits that would hinder ordinary travel. Jia Fu and his crew ride it when they leave Gu Yue village after the Jia Jin Sheng investigation, keeping to the mountain trail rather than cutting through Qing Mao Mountain, because a monster horde could still threaten even a rank four Gu Master. Wind and a rising-and-falling view mark the ride as the toad hops away until trees cover the party.",
        "chapters": [
          59
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "mount-use",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_jia_jin_sheng",
          "sys_gu_master"
        ]
      }
    ]
  },
