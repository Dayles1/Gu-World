    "activation_raw": null,
    "claims": [
      {
        "text": "It is a suicidal technique. Bai Zhan Wen chooses to sacrifice his life to gain that immense power.",
        "chapters": [
          227
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt"
      },
      {
        "text": "After the change he becomes a human shaped fire. His pupils transform into a dark purple color. Fire burns around him and raises the surrounding temperature. He can no longer hear the clan leader’s words. He feels unprecedented power, completely free and unbound, and flies by the propulsion of the flames, with no wings to help him change direction quickly.",
        "chapters": [
          227
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt"
      }
    ]
  },
