    "claims": [
      {
        "text": "During the public refinement he takes out a Gu with a plain appearance like a grey stone disc. It is a rank five expenditure Gu: once used, it allows a Gu Master’s refinement to succeed for sure. He uses it, the Immortal Gu’s aura stabilizes, and a green butterfly flies out, Fixed Immortal Travel.",
        "chapters": [
          405
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
