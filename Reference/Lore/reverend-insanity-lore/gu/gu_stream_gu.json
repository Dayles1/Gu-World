    "claims": [
      {
        "text": "Later, while studying clan recipes, Fang Yuan states that a clan keeps one or a few unique Gu that are not rare natural species, but new species made by reverse fusion, and that on that basis the clan can develop a strength unique to itself. He then names Gu Yue Moonlight Gu, Xiong Bear Strength Gu, and Bai Stream Gu as the same kind of case.",
        "chapters": [
          157
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "unique-reverse-fusion-clan-gu",
        "text_origin": "source_excerpt"
      }
    ]
  },
