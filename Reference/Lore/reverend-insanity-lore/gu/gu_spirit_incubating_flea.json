  "history": {
    "claims": [
      {
        "text": "Near death, Lord Sky Crane spends his lifetime savings and Gu worms to exchange for a spirit incubating flea and takes Fang Zheng as a pupil in Immortal Crane Sect. He plans to teach Fang Zheng, refine the bloodkin worm, and push him to kill his brother so the sect can retrieve Blood Skull Gu.",
        "chapters": [
          211
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_lord_sky_crane",
          "sys_gu_worms",
          "char_fang_zheng",
          "fac_immortal_crane_sect",
          "gu_bloodkin_worm_gu",
          "gu_demonic_blood_skull_gu"
        ]
      },
      {
        "text": "Lord Sky Crane says that after death his soul resides in the spirit incubating flea and that he can talk to Fang Zheng because of Immortal Crane Sect’s supreme elder He Feng Yang. He Feng Yang used secret methods to resuscitate the flea; Lord Sky Crane will then use his soul to support Fang Zheng toward the peak of Dang Hun Mountain.",
        "chapters": [
          366
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "soul-residence-and-dang-hun-support",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_he_feng_yang",
          "loc_dang_hun_mountain"
        ]
      },
      {
        "text": "A Gu worm lies motionless on Fang Zheng’s chest, then moves its wings and flies up when He Feng Yang appears; that Gu is the spirit incubating flea containing Lord Sky Crane’s soul. Lord Sky Crane had intended to possess Fang Zheng and had placed the flea in Fang Zheng’s aperture, so the long contact already met the possession condition, but he refuses to possess his disciple. The flea flaps its wings while speaking, and later flutters toward Fang Zheng’s eyes when he wakes.",
        "chapters": [
          827
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "wings-and-possession",
        "text_origin": "source_excerpt"
      }
    ]
  },
