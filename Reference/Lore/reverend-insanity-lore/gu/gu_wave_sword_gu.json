  "appearance": {
    "claims": [
      {
        "text": "It has no fixed form: a snake at times and a sword at others. Its entire body is pale blue, resembling translucent liquid like water. When it forms a blade, the blade looks soft and slippery while still giving a sense of extreme sharpness.",
        "chapters": [
          995
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "appearance",
        "text_origin": "source_excerpt"
      }
    ],
    "visual_confidence": "text_described"
  },
  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "In his immortal aperture, he activates immortal killer move triple layered sword wave with wave sword Immortal Gu as the core, together with water path Immortal Gu borrowed from Lang Ya land spirit.",
