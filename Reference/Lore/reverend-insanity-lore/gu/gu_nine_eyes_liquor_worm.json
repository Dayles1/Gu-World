  "appearance": {
    "claims": [
      {
        "text": "It is like a silkworm and is pure white like a pearl. There are no eyes on its head. It has nine colors that resemble eyes, red, orange, yellow, green, blue and so on, as if they were precious gems embedded on its body. It is the rank four liquor worm in the ladder that starts from rank one Liquor worm.",
        "chapters": [
          326
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "appearance-and-rank",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_liquor_worm"
        ]
      }
    ],
    "visual_confidence": "text_described"
  },
  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "After refining charging crash Gu, Fang Yuan counts nine eyes liquor worm among six rank four Gu he already holds, with bitter strength Gu, charging crash Gu, yang Gu of yin-yang rotation Gu, expend strength Gu, and blood skull Gu.",
        "chapters": [
          345
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "role-among-rank-four-gu",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_charging_crash_gu",
          "gu_bitter_strength_gu",
          "gu_yang_gu",
          "gu_yin_yang_rotation_gu",
          "gu_expend_strength_gu",
          "gu_demonic_blood_skull_gu"
        ]
      },
      {
        "text": "A month of cleansing with the worm’s help lets Fang Yuan advance to rank four peak stage.",
        "chapters": [
          422
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "role-among-rank-four-gu",
        "text_origin": "source_excerpt"
      },
      {
        "text": "At rank four peak stage the worm has lost its use, because liquor worm only purifies by a small realm and he already holds peak stage true gold primeval essence. He seals it, noting the line from rank one liquor worm to this rank four form can retire.",
        "chapters": [
          424
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "role-among-rank-four-gu",
        "text_origin": "source_excerpt"
      }
    ]
  },
