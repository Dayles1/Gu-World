    "confirmed_evolutions": [],
    "related_variants": [],
    "claims": [
      {
        "text": "Fang Yuan plans to fuse Pulling Mountain and Pulling Water into the immortal killer move myriad self. He finishes fusing Pulling Mountain into myriad self.",
        "chapters": [
          817
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "killer-move-fusion",
        "text_origin": "source_excerpt"
      },
      {
        "text": "After that fusion, the killer move’s core becomes Self Strength and Pulling Mountain together, and lifting Dang Hun Mountain with myriad self giant hand becomes much easier.",
        "chapters": [
          822
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "killer-move-fusion",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_self_strength"
        ]
      },
      {
        "text": "After the merge, myriad self giant hand gains more power against earth path desolate beasts such as hidden sand spider queens.",
        "chapters": [
          837
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "killer-move-fusion",
        "text_origin": "source_excerpt"
      }
    ]
  },
  "economy": {
    "canonical_prices": [],
    "price_claims": [
      {
        "text": "Feng Jiu Ge, speaking as Swordmaster You Lan, offers it in Qin Bai Sheng’s auction while bidding for Worldly Wave Trace, and adds one hundred and fifty kilograms of heaven metal.",
        "chapters": [
          752
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_feng_jiu_ge",
          "char_swordmaster_you_lan",
          "char_qin_bai_sheng",
          "gu_worldly_wave_trace"
        ],
        "needs_review": true
      },
      {
        "text": "Fang Yuan sells Worldly Wave Trace to Fairy You Lan. On the spot he receives two strength path Immortal Gu, fully refines them, and holds them as his own. Pulling Mountain and Pulling Water belong to the atmospheric heaven and earth branch of strength path.",
        "chapters": [
          754
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "trade-and-path-branch",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_fang_yuan",
          "sys_immortal_gu",
          "gu_pulling_water",
          "path_strength"
        ]
      },
      {
        "text": "The Gu can break a mountain’s connection to earth qi without damaging the mountain body, and after the mountain is set down the earth qi link can form again. That short lift of Dang Hun Mountain costs him three beads of green grape immortal essence. He later lists Pulling Mountain among the Immortal Gu gained from the auction.",
        "chapters": [
          769
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "dao-mark-resonance",
        "text_origin": "source_excerpt",
        "needs_review": true
      }
    ],
    "game_proposals": []
  },
