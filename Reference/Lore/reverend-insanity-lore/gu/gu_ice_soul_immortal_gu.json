  "history": {
    "claims": [
      {
        "text": "Ying Wu Xie sends Bai Ning Bing to take the wild Immortal Gu from a wall of ice without defensive methods. Frost nearly kills Bai Ning Bing; the Gu then flies over on its own and enters the phantom aperture.",
        "chapters": [
          1186
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_ying_wu_xie",
          "char_bai_ning_bing",
          "sys_wild_immortal_gu"
        ]
      },
      {
        "text": "Bai Ning Bing’s Northern Dark Ice Soul Physique has an intense attraction to ice soul Immortal Gu. Ying Wu Xie kept Bai Ning Bing without defenses so that physique aura would show fully, and only when Bai Ning Bing was near death would the wild Gu judge Bai Ning Bing no threat and approach on its own. Once it is inside the aperture, Ying Wu Xie says refining it will be extremely easy.",
        "chapters": [
          1186
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
