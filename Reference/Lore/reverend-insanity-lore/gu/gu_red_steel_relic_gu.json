  "economy": {
    "canonical_prices": [],
    "price_claims": [
      {
        "text": "On Qing Mao Mountain the treehouse marks the caravan copy at three thousand primeval stones; Fang Yuan expects the final price to cross five thousand and possibly reach eight thousand.",
        "chapters": [
          111
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "price",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Later market talk prices red steel Relic Gu at eight thousand, between cheaper green copper and dearer white silver and yellow gold Relic Gu. That market stretch also states Relic Gu are natural Gu and cannot be refined by Gu Masters.",
        "chapters": [
          278
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "price",
        "text_origin": "source_excerpt"
      },
      {
        "text": "He sells family assets to fund the bid.",
        "chapters": [
          112
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "fang-yuans-use",
        "text_origin": "source_excerpt",
        "needs_review": true
      }
    ],
