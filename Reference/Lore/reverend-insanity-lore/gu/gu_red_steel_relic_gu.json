  "history": {
    "claims": [
      {
        "text": "On the Jia clan caravan treehouse’s second floor on Qing Mao Mountain, Fang Yuan finds a red steel Relic Gu for sale and later buys it.",
        "chapters": [
          111
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "fac_jia_family",
          "loc_qing_mao_mountain",
          "char_fang_yuan"
        ]
      },
      {
        "text": "He uses that copy to advance, then takes a second one from Bai Ning Bing.",
        "chapters": [
          115
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_bai_ning_bing"
        ]
      },
      {
        "text": "Relic Gu is a sphere-shaped mortal Gu, thumb-sized, with an ordinary appearance, and red steel Relic Gu is the rank two entry in the same rank list. Relic Gu are human path Gu worms, which is why they form naturally and why Gu Immortals cannot create them.",
        "chapters": [
          1796
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "relic-gu-form-and-human-path",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_gu_worms",
          "sys_gu_immortal"
        ]
      }
    ]
