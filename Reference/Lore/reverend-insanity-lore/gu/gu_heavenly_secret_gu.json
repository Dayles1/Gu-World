    "origin": "unknown",
    "claims": [
      {
        "text": "Fang Yuan recalls that within wisdom path there is an Immortal Gu that lets a Gu Immortal obtain answers directly without colliding thoughts or making deductions, as long as they grab onto that strand of heavenly secret: Heavenly Secret Gu. Historical record names it as created by Paradise Earth Immortal Venerable, who possessed a rank eight heavenly secret Immortal Gu that disappeared without news after his death. Fang Yuan treats that Gu as able to question heaven and earth, and as a threat that could expose his secrets if used against him.",
        "chapters": [
          657
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "origin-and-earlier-record",
        "text_origin": "source_excerpt",
        "mentions": [
          "path_wisdom",
          "sys_gu_immortal",
          "char_paradise_earth_immortal_venerable"
        ]
      }
    ]
  },
