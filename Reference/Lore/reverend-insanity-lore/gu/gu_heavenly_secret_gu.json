  "history": {
    "claims": [
      {
        "text": "From Shadow Sect blessed land, Old Man Yan Shi weighs whether to spend his vital Gu on Fang Yuan’s bulk wolf buying in treasure yellow heaven. When he summons the Gu, traces of cloud smoke flow out of him and the white cloud smoke rises and gathers above his head into a rumbling cloud, misty, with a thick Immortal Gu aura bursting out of it. The aura of the rank seven Immortal Gu itself is indiscernible, and there is no way to locate it.",
        "chapters": [
          492
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "loc_shadow_sect_blessed_land",
          "char_old_man_yan_shi",
          "sys_vital_gu",
          "char_fang_yuan",
          "loc_treasure_yellow_heaven",
          "sys_immortal_gu"
        ]
      },
      {
        "text": "Heavenly secret Immortal Gu is the core of the immortal killer move heaven’s will dissipation, which can eliminate heaven’s will. Fang Yuan had already used it against Spring Autumn Cicada before using it on a dream realm for the first time.",
        "chapters": [
          1490
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "heavens-will-dissipation",
        "text_origin": "source_excerpt"
      }
    ]
  },
