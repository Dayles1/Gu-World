  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "Pressed under Bai Ning Bing’s ice after the First Generation fight, Lord Sky Crane activates Life-retaining Jade Burial Gu. Green jade light covers him and hardens into a transparent jade coffin Bai Ning Bing cannot scratch, so he buries the coffin under more ice. Two days later a jade light bursts from within the ice and hovers in the air, turning into a jade coffin. The coffin explodes as Lord Sky Crane frees himself. Life-retaining Jade Burial Gu is a rank five Gu: if the Gu Master still has one breath of life, it can suspend life and delay injuries, and the jade coffin is strong enough to count as a defensive weapon.",
        "chapters": [
          199
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "jade-coffin-effect",
        "text_origin": "source_excerpt",
