    "origin": "unknown",
    "claims": [
      {
        "text": "From those memories, Ma Hong Yun suffers badly against the killer move, is captured, and learns its secrets from Dong Fang Qing Yu. He returns and, with his wife Sheng Ling Er, a refinement path master, creates Nauseous Crying Baby Gu to counter it. The Gu wins him a great victory and Dong Fang tribe loses consecutively, until the killer move is phased out.",
        "chapters": [
          507
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "origin-in-fang-yuans-memories",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_ma_hong_yun",
          "char_dong_fang_qing_yu",
          "char_sheng_ling_er"
        ]
      },
      {
        "text": "During the battle of the five regions, central continent Gu Masters steal and improve three hearts combination soul. Ma Hong Yun then releases the recipe, and others modify it to answer that improved move, until the killer move loses its use. Fang Yuan knows the recipe from those memories.",
        "chapters": [
          507
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "origin-in-fang-yuans-memories",
        "text_origin": "source_excerpt"
      }
    ]
  },
