  "history": {
    "claims": [
      {
        "text": "While Night Temptress and Immortal Concubine Qing Lan seal a red dream realm in Western Desert, Qing Lan takes out a crucial Immortal Gu for the formation. Feng Jiu Ge, watching in secret, recognizes rule path Immortal Gu Pass and notes that Thousand Transformations Ancestor holds it.",
        "chapters": [
          1423
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_night_temptress",
          "char_immortal_concubine_qing_lan",
          "reg_western_desert",
          "sys_immortal_gu",
          "char_feng_jiu_ge",
          "char_thousand_transformations_ancestor"
        ]
      },
      {
        "text": "Feng Jiu Ge has sought this rule path Immortal Gu for a long time. With pass Gu he could extend immortal killer move yang pass tune, remove most of that move’s mortal Gu, and cut the difficulty and time needed to use it. Pass Gu is the core of the orange-brown sand formation around the dream realm; once activated it enters the yellow sand and the formation settles into a light yellow cloud.",
        "chapters": [
          1423
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
