    "claims": [
      {
        "text": "Bright Pearl Gu is a rank four storage Gu. Its main use is to seal Gu into deep slumber so they can be stored more easily. Fang Yuan injects primeval essence so Bright Pearl Gu becomes a warm white light that covers Fixed Immortal Travel. After the seal, the Immortal Gu sits in a fist-sized pearl and its leaking aura is much weaker, though not gone.",
        "chapters": [
          429
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
