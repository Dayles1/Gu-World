    "claims": [
      {
        "text": "In Ba Gui’s hall, divine travel Gu can send a Gu Master to any place in the world, but activation needs a drunken state and the destination cannot be controlled. It may be one of the four great movement Gu, yet the flaw is so severe that Verdant Great Sun refined it into Fixed Immortal Travel, while the blessed land’s original master planned to refine it into Second Aperture Gu.",
        "chapters": [
          378
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "refinement-plans",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_gu_master",
