  "history": {
    "claims": [
      {
        "text": "In The Legends of Ren Zu, divine travel Gu speaks to Verdant Great Sun and says that drinking four different top-tier wines in the world gives birth to it in a person’s heart. Verdant Great Sun blames it for harm during drunk stretches, and the Gu answers that he used its strength after becoming drunk, while also claiming one rescue from tiger-striped honey bees.",
        "chapters": [
          357
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_the_legends_of_ren_zu",
          "char_verdant_great_sun"
        ]
      },
      {
        "text": "Verdant Great Sun fears drinking because getting drunk may leave him transported to a dangerous land by divine travel Gu. Earlier drunk uses sent him into the ordinary abyss and into the cauldron of the hairy men. The Gu offers a method to become Fixed Immortal Travel so it will no longer send him to random places when he is drunk.",
        "chapters": [
          371
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "destination-flaw",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_fixed_immortal_travel"
        ]
      }
    ]
  },
