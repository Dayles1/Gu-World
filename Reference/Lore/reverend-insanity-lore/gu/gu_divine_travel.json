  "appearance": {
    "claims": [
      {
        "text": "It is like a round gem. The gem’s whole body is yellow and hollow inside, with a ball of purple smoke in it. The smoke transforms constantly, turning into a pegasus, an immortal crane, a moving cloud, or pure thunderbolt.",
        "chapters": [
          378
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "appearance",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Ba Gui introduces a rank six Immortal Gu as Divine Travel. It looks like a round yellow gem, hollow inside, with a ball of purple smoke that shifts forms such as a pegasus, crane, cloud, or thunderbolt. A strong wine fragrance spreads when it appears; Fang Yuan takes a few breaths, feels drunk, and grows dizzy until he holds his breath.",
        "chapters": [
          378
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "form-and-rank",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_ba_gui",
          "sys_immortal_gu",
          "char_fang_yuan"
        ]
      }
    ],
    "visual_confidence": "text_described"
  },
