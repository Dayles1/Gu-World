  "appearance": {
    "claims": [
      {
        "text": "It is a phasmid, long and slim, jade coloured, its body looking like a bamboo tube. It is normally longer than a palm, but this copy is only fingernail size. A white glow sits on its surface: green jade for a body, white light around its form. It is sealed in a translucent emerald jade piece inside a jade box. In an aperture it emits a faint green glow over the primeval sea.",
        "chapters": [
          57
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "appearance",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Jia Fu keeps it sealed in a translucent emerald jade piece inside a jade box. The Gu is a phasmid shaped like a bamboo tube, jade coloured, normally longer than a palm but here only fingernail size, with a white glow on its surface. Elders describe it as green jade for a body with white light around its form.",
        "chapters": [
          57
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "form-and-rank",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Gu Yue Bo and Fang Yuan’s own later recollection both call this specimen rank four.",
        "chapters": [
          57
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "form-and-rank",
        "text_origin": "source_excerpt"
      }
    ],
    "visual_confidence": "text_described"
  },
  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "The test Jia Fu runs is to place the Gu in the subject’s aperture, ask questions, then show the Gu again. A colour change away from green means a lie. While it sits in Fang Yuan’s aperture it gives off a faint green glow over the primeval sea, and Fang Yuan senses that a single lie would turn it from green to another colour.",
        "chapters": [
          57
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Bamboo Gentleman can only be used by a Gu Master who has never lied.",
        "chapters": [
          186
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_gu_master"
        ]
      }
    ]
  },
  "feeding": {
    "known": true,
    "food_raw": null,
    "foods": [],
    "claims": [
      {
        "text": "It lives in an honest gentleman’s aperture. Failed refinement kills the Bamboo Gentleman on the spot.",
        "chapters": [
          57
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "feeding-and-refinement",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Jia Fu obtained his copy through rock gambling when young. The rock was opened only halfway and the Gu could not be extracted fully until he had Fang Yuan open the jade for the interrogation.",
        "chapters": [
          57
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "feeding-and-refinement",
        "text_origin": "source_excerpt"
      }
    ]
  },
