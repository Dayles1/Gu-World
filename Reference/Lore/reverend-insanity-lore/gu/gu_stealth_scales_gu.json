    "related_variants": [],
    "claims": [
      {
        "text": "Fish Scale Gu is used with Stealth Rock Gu to create Stealth Scales Gu. Fang Yuan first lacks the Fish Scale Gu,",
        "chapters": [
          123
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "recipe-and-refinement",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_fish_scale_gu"
        ]
      },
      {
        "text": "then gains it by trading his Black Boar Gu with Gu Yue Qing Shu.",
        "chapters": [
          127
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "recipe-and-refinement",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_black_boar_gu",
          "char_gu_yue_qing_shu"
        ]
      },
      {
        "text": "The text says that Fish Scale plus Stealth Rock recipe would only be discovered two hundred years later, so Qing Shu has no clue why Fang Yuan wants the Fish Scale Gu.",
        "chapters": [
          123
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "recipe-and-refinement",
        "text_origin": "source_excerpt"
      },
      {
        "text": "The Fish Scale Gu trade is settled.",
        "chapters": [
          123
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "recipe-and-refinement",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Fang Yuan had already refined Stealth Scales Gu before the Gu battle tournament, though the refinement moment itself goes unnarrated.",
        "chapters": [
          127
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "recipe-and-refinement",
        "text_origin": "source_excerpt"
      }
    ]
  },
