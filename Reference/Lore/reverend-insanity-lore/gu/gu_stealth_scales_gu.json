  "history": {
    "claims": [
      {
        "text": "On Qing Mao Mountain, Fang Yuan plans to fuse Stealth Rock Gu into Stealth Scales Gu so he can enter his secret cave unseen and fight through the wolf tide with a clean way to attack and retreat.",
        "chapters": [
          121
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "loc_qing_mao_mountain",
          "char_fang_yuan",
          "gu_stealth_rock_gu"
        ]
      },
      {
        "text": "During a hunt, Fang Yuan hands the Stealth Scales Gu to Bai Ning Bing, who hides and closes in for a kill.",
        "chapters": [
          211
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "loan-and-destruction",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_bai_ning_bing"
        ]
      },
      {
        "text": "Later, while fleeing Bai clan forces, Fang Yuan activates it again and turns invisible. A clan elder stretches out a hand and grabs toward him; the Stealth Scales Gu, still hiding in Fang Yuan’s aperture, breaks into pieces and perishes.",
        "chapters": [
          227
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "loan-and-destruction",
        "text_origin": "source_excerpt",
        "mentions": [
          "fac_bai_clan_bai_gu_mountain"
        ]
      },
      {
        "text": "Stealth scales Gu is among the Gu destroyed in that pursuit.",
        "chapters": [
          228
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "loan-and-destruction",
        "text_origin": "source_excerpt"
      }
    ]
  },
