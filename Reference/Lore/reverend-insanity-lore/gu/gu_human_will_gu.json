  "history": {
    "claims": [
      {
        "text": "Fang Di Chang’s body in the painting world is formed from a beggar Gu and holds only a will, with no soul. When that will weakens, he takes out human will Gu, places it in front of his nose, and breathes in deeply. A gust of human will merges with his own will. The painting world of Divine Emperor City has human will Gu. Human will Gu produces human will, which can change into any form of will, and with its help Fang Di Chang’s will can continue to exist and stay active.",
        "chapters": [
          2082
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
