  "history": {
    "claims": [
      {
        "text": "Jia Fu names Suspicion Gu when he continues the Ren Zu net story after Rules and Regulation Gu have given Ren Zu strength and cost him wisdom. The three Gu still in the net are Attitude Gu, Belief Gu, and Suspicion Gu.",
        "chapters": [
          59
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_jia_fu",
          "gu_rules_and_regulation_gu",
          "char_ren_zu",
          "gu_attitude_gu",
          "gu_belief_gu"
        ]
      },
      {
        "text": "They bet that when Ren Zu opens the net they will run in three directions, and that only the one he captures will be subdued. Jia Fu’s aide answers that Ren Zu captures Attitude Gu.",
        "chapters": [
          59
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
