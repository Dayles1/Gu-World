  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "After Mo Yao’s will enters his mind, Fang Yuan obtains the killer move Six Arm Heavenly Zombie King. Finding this Gu in the treasure room had already let four arm wind king improve, and the new move uses Borrow Strength Gu as the core, six types of flying zombie Gu as supplement, and another thirty-six Gu in a specialized structure.",
        "chapters": [
          569
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "killer-move-core",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_mo_yao",
          "move_six_arm_heavenly_zombie_king",
          "gu_six_flying_zombie_gu"
        ]
      },
      {
        "text": "Mo Yao says this Gu borrows the strength of natural phenomena in heaven and earth, and that even a rank five strength path expert cannot use it casually, so a zombie body complements it by surpassing living flesh and regenerating well.",
        "chapters": [
          574
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "killer-move-core",
        "text_origin": "source_excerpt",
        "mentions": [
          "path_strength"
        ]
      },
      {
        "text": "In later testing, the move uses that core to borrow a steady torrent of natural strength from heaven, earth, fire, water, and similar sources.",
        "chapters": [
          586
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "killer-move-core",
        "text_origin": "source_excerpt"
      }
    ]
  },
