  "economy": {
    "canonical_prices": [],
    "price_claims": [
      {
        "text": "Auction talk pairs it with conceal luck Immortal Gu: luck path has luck inspection Gu to inspect another person’s luck, and conceal luck Gu to hide one’s own. Conceal luck Immortal Gu is said to have value mainly against someone who holds luck inspection Immortal Gu, and a rank six conceal luck Immortal Gu can defend from rank six luck inspection Gu.",
        "chapters": [
          751
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_immortal_gu",
          "path_luck",
          "gu_luck_inspection_gu"
        ],
        "needs_review": true
      },
      {
        "text": "At the auction of luck path true inheritance essence, Qin Bai Sheng states that a rank six luck inspection Immortal Gu is with him and that he will not sell it. He places mortal luck inspection Gu recipes and a remnant rank seven Immortal Gu recipe on the block instead, and says everything related to luck inspection Gu is being auctioned apart from that Immortal Gu.",
        "chapters": [
          760
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "qin-bai-shengs-copy",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_qin_bai_sheng",
          "sys_gu_recipe"
        ],
        "needs_review": true
      }
    ],
