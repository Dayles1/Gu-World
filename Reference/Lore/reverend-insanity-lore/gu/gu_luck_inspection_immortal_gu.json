  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "Not long before, Fang Yuan and Ying Wu Xie had met: Ying Wu Xie used luck inspection Immortal Gu to observe Fang Yuan’s luck and discern his identity, then retreated immediately. Just rank six luck inspection Immortal Gu is enough to make familiar face ineffective, since every Immortal Gu has its natural predator as every living being does.",
        "chapters": [
          1154
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "familiar-face-made-ineffective",
        "text_origin": "source_excerpt"
      }
    ]
  },
