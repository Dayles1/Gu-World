  "appearance": {
    "claims": [
      {
        "text": "It resembles a centipede: thin and long like an arm, black like iron. It flies in a zigzag, and the short horizontal segments on its body light up like blue fireflies now and then.",
        "chapters": [
          852
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "appearance",
        "text_origin": "source_excerpt"
      }
    ],
    "visual_confidence": "text_described"
  },
  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "Star Form land spirit names it rank six Immortal Gu Star Mark and states that it can temporarily add six hundred star path dao marks onto master’s body. Fang Yuan reckons that two hundred dao marks raise power by twenty percent, so six hundred would raise it by sixty percent. With those temporary dao marks, Fang Yuan can disguise himself as a star path Gu Immortal even though he is a strength path Gu Immortal.",
        "chapters": [
          852
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_gu_immortal"
        ]
      },
      {
        "text": "Fang Yuan’s star cloud grindstone, star snake rope, and six illusion star bodies all use Star Mark, Star Shoot, and Starlight as their cores.",
        "chapters": [
          877
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "killer-moves",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Fang Yuan creates the immortal battlefield killer move star soul battlefield with Cleanse Soul, Star Mark, Star Shoot, Starlight, and Star Thought as its cores; it has no explosive strength but can drain an enemy’s battle strength without end.",
        "chapters": [
          984
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "battlefield-killer-move",
        "text_origin": "source_excerpt",
        "mentions": [
          "move_star_soul_battlefield",
          "gu_cleanse_soul"
        ]
      }
    ]
  },
  "feeding": {
    "known": true,
    "food_raw": null,
    "foods": [],
    "claims": [
      {
        "text": "Its food is the fresh meat of spinefin star dragonfish. It is one of three Immortal Gu left in Star Form blessed land from Star Lord Wan Xiang, together with starlight Immortal Gu and Star Shoot.",
        "chapters": [
          852
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "food-and-origin",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_star_lord_wan_xiang",
          "gu_starlight_immortal_gu"
        ]
      }
    ]
  },
