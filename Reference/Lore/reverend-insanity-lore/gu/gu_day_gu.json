  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "Wild day Gu are common across the five regions and two heavens. The River of Time itself holds vast numbers of day Gu, month Gu, and year Gu. A rank three day Gu holds three days of time. With the right refinement path method, expending it can shorten Gu refinement by three days. Time path lifespan methods can also use day Gu, month Gu, and year Gu, but those methods carve time path dao marks that can block later lifespan Gu use.",
        "chapters": [
          1400
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "mortal-uses",
        "text_origin": "source_excerpt",
