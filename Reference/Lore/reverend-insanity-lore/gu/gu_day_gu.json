  "history": {
    "claims": [
      {
        "text": "Hei Fan’s true inheritance ties day Gu to time path killer moves that use immortal level year Gu as core with large numbers of supplementary day Gu. Fang Yuan notes he must buy the mortal day Gu and month Gu himself, and Hei Fan’s own record adds that immortal level day Gu or month Gu would cut that mortal Gu spend and raise the moves’ effect greatly.",
        "chapters": [
          1130
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "inh_hei_fan_true_inheritance",
          "gu_year_gu",
          "char_fang_yuan",
          "gu_month_gu",
          "char_hei_fan",
          "sys_mortal_gu"
        ]
      },
      {
        "text": "He later holds mortal Gu recipes that let him refine mortal level day Gu, month Gu, and year Gu.",
        "chapters": [
          1132
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt"
      },
      {
        "text": "At an Eastern Sea trading convention Wu Ma Yang offers a rank six time path day Gu in trade for bone spike Immortal Gu. Observers call it day Immortal Gu. Fang Yuan takes the trade because Hei Fan’s inheritance stresses immortal level day Gu for moves such as days pass like years. Wu Ma Yang says his day Gu consumes the water of the River of Time and has no feeding problems, but that he cannot use the Immortal Gu himself.",
        "chapters": [
          1299
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "immortal-day-gu",
        "text_origin": "source_excerpt",
        "mentions": [
          "reg_eastern_sea",
          "sys_immortal_gu",
          "loc_river_of_time"
        ]
      },
      {
        "text": "Fang Yuan judges that adding day Immortal Gu alongside perseverance Immortal Gu into bountiful year could raise the killer move’s effect further, but his time path attainment level has reached its limit and he does not pursue it.",
        "chapters": [
          1313
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "bountiful-year-potential",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_perseverance_gu"
        ]
      }
    ]
  },
