    "claims": [
      {
        "text": "Ge Yao states that many Ghost Cry Gu live in ghost face sunflowers grown where many people died and ghosts wandered.",
        "chapters": [
          428
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "habitat",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Fang Yuan judges the wild Ghost Cry Gu there decent Gu, but he lacks the specialized Gu needed to catch them. Catching them needs peculiar methods because they are soul path Gu.",
        "chapters": [
          429
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "habitat",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Gui Wang descends on that sea of ghost face sunflowers. Numerous Ghost Cry Gu shriek as he scoops them up with nether ghost claw alongside Ghost Face Gu.",
