  "history": {
    "claims": [
      {
        "text": "Fang Yuan weighs Ding Qi blessed land’s ownership condition, which requires completing the blood path Immortal Gu recipe of Blood Revenge. At that time blood revenge Immortal Gu is less than ten percent complete, and without the light of wisdom the work is not worth the cost to him.",
        "chapters": [
          1187
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_fang_yuan",
          "char_ding_qi",
          "sys_gu_recipe"
        ]
      },
      {
        "text": "After Immortal Crane Sect and Heavenly Court support his revenge path, Fan Xi Liu presents a blood path Immortal Gu. When Fang Zheng asks its name, Fan Xi Liu answers Blood Revenge.",
        "chapters": [
          1642
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "named-for-fang-zheng",
        "text_origin": "source_excerpt",
        "mentions": [
          "fac_immortal_crane_sect",
          "fac_heavenly_court",
          "char_fan_xi_liu",
          "sys_immortal_gu",
          "char_fang_zheng"
        ]
      },
      {
        "text": "During immortal ascension Fang Zheng places blood revenge Immortal Gu into his immortal aperture first among his vital Gu and important Gu worms, followed by many blood path mortal Gu.",
        "chapters": [
          1646
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "vital-gu-at-ascension",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_vital_gu",
          "sys_gu_worms",
          "sys_mortal_gu"
        ]
      },
      {
        "text": "Later narration restates that after Feng Jiu Ge saved him and returned him to Central Continent, Heavenly Court support gave him blood revenge Immortal Gu, and he also obtained cold blood Immortal Gu during immortal ascension.",
        "chapters": [
          1685
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
