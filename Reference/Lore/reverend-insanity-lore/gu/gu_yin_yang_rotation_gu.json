  "history": {
    "claims": [
      {
        "text": "First gen Gu Yue treats Yin Yang Rotation Gu as crucial to a plan that stretched through a millennium.",
        "chapters": [
          194
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_first_gen_gu_yue"
        ]
      },
      {
        "text": "Fang Yuan later seizes the sealed pair along with Blood Skull Gu and uses Spring Autumn Cicada’s aura to tame and refine them.",
        "chapters": [
          197
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_fang_yuan",
          "gu_demonic_blood_skull_gu",
          "gu_spring_autumn_cicada"
        ]
      },
      {
        "text": "In Shang clan city, Fang Yuan tells Bai Ning Bing to ask Doctor Su Shou about Yin Yang Rotation Gu, and Bai Ning Bing does ask about it rather than ask for healing.",
        "chapters": [
          271
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "bai-ning-bings-reversal-effort",
        "text_origin": "source_excerpt",
        "mentions": [
          "loc_shang_clan_city",
          "char_doctor_su_shou"
        ]
      },
      {
        "text": "Bai Ning Bing states that she already has yin yang rotation Gu, but needs to advance it to immortal level before she can reverse the female body, and that it is not her vital Gu so she lacks confidence in that refinement.",
        "chapters": [
          1380
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "bai-ning-bings-reversal-effort",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_vital_gu"
        ]
      },
      {
        "text": "She later allies with Fang Yuan toward refining immortal level yin yang rotation Gu, including a plan to use Lang Ya Sect contribution points for a refinement mission.",
        "chapters": [
          1462
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "bai-ning-bings-reversal-effort",
        "text_origin": "source_excerpt",
        "mentions": [
          "fac_lang_ya_sect"
        ]
      }
    ]
