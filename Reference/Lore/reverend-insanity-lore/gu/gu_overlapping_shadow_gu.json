  "history": {
    "claims": [
      {
        "text": "Dong Fang Yu Liang offers Bian Si Xuan rank four overlapping shadow Gu as her promised reward. She already has multiple Sword Shadow Gu, but those attacks stay dispersed against strong defense. With overlapping shadow Gu she could stack the sword shadows into one strong attack. She leaves the Gu with him for now and says she will take it after Wolf King dies.",
        "chapters": [
          505
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_dong_fang_yu_liang",
          "char_bian_si_xuan",
          "gu_sword_shadow_gu"
        ]
      },
      {
        "text": "She accumulates battle merits in small battles and exchanges them for overlapping shadow Gu from Hei tribe supply camp. Under its effect, the merged multiple sword shadows can match the offensive prowess of a rank five attack Gu.",
        "chapters": [
          526
        ],
        "certainty": "canon",
