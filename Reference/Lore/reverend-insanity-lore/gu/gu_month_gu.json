  "history": {
    "claims": [
      {
        "text": "Hei Fan’s true inheritance treats day Gu, month Gu, and year Gu as closely related time path Gu worms. The immortal killer move months pass like years still uses immortal level year Gu as core, but its supplementary Gu are month Gu, stretching one month in the immortal aperture toward the duration of a year. Fang Yuan must buy huge numbers of mortal day Gu and month Gu because the inheritance leaves none behind. Hei Fan notes that immortal level day Gu or month Gu would reduce that mortal consumption and raise the four aperture-time killer moves’ effect. Fang Yuan judges immortal level month Gu out of reach after already obtaining immortal level year Gu.",
        "chapters": [
          1130
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "inh_hei_fan_true_inheritance",
          "gu_day_gu",
          "gu_year_gu",
          "sys_gu_worms",
          "char_fang_yuan",
          "char_hei_fan"
        ]
      },
      {
        "text": "Hei Fan wanted immortal level day Gu and month Gu so days pass like years and similar moves would not spend so many mortal day Gu and month Gu.",
        "chapters": [
          1200
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "immortal-level-note",
        "text_origin": "source_excerpt"
      },
      {
        "text": "The same inheritance line is restated when Fang Yuan later faces a trade for immortal day Gu while still lacking immortal month Gu.",
        "chapters": [
          1299
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "immortal-level-note",
        "text_origin": "source_excerpt"
      }
    ]
