    "activation_raw": null,
    "claims": [
      {
        "text": "The River of Time holds vast numbers of day Gu, month Gu, and year Gu. Time path lifespan methods can use day Gu, month Gu, and year Gu to increase lifespan, but they carve time path dao marks that can block later lifespan Gu use.",
        "chapters": [
          1400
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "natural-abundance-and-uses",
        "text_origin": "source_excerpt",
        "mentions": [
          "loc_river_of_time",
          "path_time",
          "gu_lifespan_gu"
        ]
      },
      {
        "text": "In the river, wild mortal Gu that gather on Fang Yuan are mostly day Gu and month Gu, with no year Gu in that haul. Month beasts feed on month Gu the way year beasts feed on year Gu.",
        "chapters": [
          1431
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "natural-abundance-and-uses",
        "text_origin": "source_excerpt"
      }
    ]
  },
