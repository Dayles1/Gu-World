    "claims": [
      {
        "text": "After he makes sufficient preparations for the recipe, two days later Fang Yuan succeeds in refining Charging Crash Gu from horizontal charge Gu and vertical crash Gu as the main materials. The fused rank four Gu doubles the charging distance to two hundred steps and halves the delay between repeated use, at a slightly higher primeval essence cost.",
        "chapters": [
          345
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "fusion-into-charging-crash-gu",
        "text_origin": "source_excerpt"
      },
      {
        "text": "In Northern Plains, when Hei tribe exchange goods have no Charging Crash Gu, he buys two pairs of rank three horizontal charge Gu and vertical crash Gu, intending to fuse them himself.",
        "chapters": [
          517
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "fusion-into-charging-crash-gu",
        "text_origin": "source_excerpt",
        "mentions": [
          "reg_northern_plains",
          "fac_hei_tribe"
        ]
      }
    ]
  },
