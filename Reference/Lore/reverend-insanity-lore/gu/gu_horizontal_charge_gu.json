  "history": {
    "claims": [
      {
        "text": "Fang Yuan trains with Horizontal Charge Gu in Shang clan city after selling jumping grass and buying it with vertical crash Gu as his movement Gu. He already plans that, once he reaches rank four, he will fuse the pair into Charging Crash Gu and keep using that fused Gu.",
        "chapters": [
          288
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_fang_yuan",
          "loc_shang_clan_city",
          "gu_vertical_crash_gu",
          "sys_movement_gu",
          "gu_charging_crash_gu"
        ]
      },
      {
        "text": "While sorting the Hei tribe’s resources, Fang Yuan finds a rank four Charging Crash Gu but passes it over, because he bought the rank three pair earlier under the names vertical charge and horizontal crash Gu and has already refined them into his own Charging Crash Gu.",
        "chapters": [
          522
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
