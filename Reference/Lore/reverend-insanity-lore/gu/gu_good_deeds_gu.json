  "history": {
    "claims": [
      {
        "text": "Shen Cong Sheng sees it among the obelisk rewards and has never seen such a Gu worm before. The obelisk does not write the Gu worm’s effect, so he knows nothing about what it does, yet he judges it unique for Paradise Earth Immortal Venerable to offer it as a reward.",
        "chapters": [
          1891
        ],
