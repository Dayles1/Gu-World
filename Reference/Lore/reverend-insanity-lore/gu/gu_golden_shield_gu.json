    "used_in_recipes": [],
    "refinement_materials": [],
    "confirmed_evolutions": [],
    "related_variants": [],
    "claims": [
      {
        "text": "Against Xue San Si, Fang Yuan activates Golden Shield Gu while questioning whether rank three armor can stop her strongest attack.",
        "chapters": [
          342
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "defense-and-upgrade-plan",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_xue_san_si"
        ]
      },
      {
        "text": "Xue San Si already treats Golden Bell Shield Gu as the advanced form of rank three Golden Shield Gu, and she sneers when she sees the golden light cover his body.",
        "chapters": [
          343
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "defense-and-upgrade-plan",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_golden_bell_shield_gu"
        ]
      },
      {
        "text": "Golden Shield Gu is among rank three Gu that are slowly failing to keep up after Fang Yuan reaches rank four, and his plan is to advance it into rank four Golden Bell Shield Gu.",
        "chapters": [
          345
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "defense-and-upgrade-plan",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Fang Yuan still activates rank three Golden Shield Gu through the San Cha Mountain stretch; no cited chapter confirms that he finished the advance.",
        "chapters": [
          360
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "defense-and-upgrade-plan",
        "text_origin": "source_excerpt",
        "mentions": [
          "loc_san_cha_mountain"
        ]
      },
      {
        "text": "Its defensive light resists attacks that get through his dodges while he fights in the air.",
        "chapters": [
          361
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "defense-and-upgrade-plan",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Combined with ancient bronze skin, essence iron bones, and golden steel tendons, Golden Shield Gu is later judged enough to handle the full strength of a rank four peak stage Gu Master.",
        "chapters": [
          368
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "defense-and-upgrade-plan",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_gu_master"
        ]
      }
    ]
  },
