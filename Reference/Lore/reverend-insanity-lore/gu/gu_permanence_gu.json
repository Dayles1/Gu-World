  "history": {
    "claims": [
      {
        "text": "Heavenly Court rank eight rule path Gu Immortal Cong Yan takes out Permanence Gu for the final step of constructing Eternal Yacht. The text names it rule path Immortal Gu Permanence. Cong Yan had used it in Heavenly Court’s Eternal Sand Cave before bringing it out for the yacht.",
        "chapters": [
          1795
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "fac_heavenly_court",
          "sys_gu_immortal",
          "char_cong_yan",
          "house_eternal_yacht",
          "sys_immortal_gu",
          "loc_eternal_sand_cave"
        ]
      },
      {
        "text": "He sends permanence Gu into the incomplete Eternal Yacht Immortal Gu House. The incomplete house absorbs it, its aura rises and falls, then runs out of control and shatters. Many mortal Gu die and many supplementary Immortal Gu are damaged. Only permanence Gu suffers no damage, because Cong Yan protects it at the cost of heavy injuries. Permanence Gu is the core and cannot be harmed, unlike supplementary Immortal Gu that can be replaced if destroyed.",
        "chapters": [
          1795
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
