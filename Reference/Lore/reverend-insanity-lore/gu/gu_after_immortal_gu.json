  "appearance": {
    "claims": [
      {
        "text": "Compared with the surrounding black ant mortal Gu, it is many times larger. It has the form of an ant, with feelers, small legs, and a large abdomen, and it looks very chubby.",
        "chapters": [
          1128
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
