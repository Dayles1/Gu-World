      }
    ],
    "visual_confidence": "text_described"
  },
  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "The immortal killer move Endless Trouble uses after Immortal Gu as its core. When activated, it delays the current calamity or tribulation to the time of the next one so the Gu Immortal faces them together. Hei Fan warns not to use it excessively: delaying a tribulation angers heaven’s will, and later calamities grow much stronger. He used the move once and never again, and named it Endless Trouble to warn descendants.",
        "chapters": [
          1130
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "hei-fans-single-use",
        "text_origin": "source_excerpt",
        "mentions": [
          "move_endless_trouble",
          "sys_gu_immortal"
        ]
      }
    ]
  },
  "feeding": {
    "known": true,
    "food_raw": null,
    "foods": [],
    "claims": [
      {
        "text": "After Immortal Gu can eat any immortal material, but it does not feed itself. It produces black ant mortal Gu, sends them out to devour immortal materials and hold the nutrients, then takes those nutrients for itself. The black ant mortal Gu are tough, yet still mortal. If too many are destroyed, After starves. It can produce only one black ant mortal Gu each month, and without enough of them After dies of hunger.",
        "chapters": [
          1129
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "feeding",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Three Breaths Future Vision is a time path investigative killer move from Hei Fan’s true inheritance. It uses after Immortal Gu as the core and lets the Gu Immortal see a future situation that will manifest within three breaths.",
        "chapters": [
          1136
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "three-breaths-future-vision",
        "text_origin": "source_excerpt",
        "mentions": [
          "move_three_breaths_future_vision"
        ]
      }
    ]
  },
