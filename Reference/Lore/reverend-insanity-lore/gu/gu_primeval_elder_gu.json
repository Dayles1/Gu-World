  "history": {
    "claims": [
      {
        "text": "Fang Yuan reviews the Gu in his aperture. Near blood skull Gu sits a crystal ball with thick mist forming an old man who carries a walking cane and shows a calm expression after half the stones are taken out. Fang Yuan decides Spring Autumn Cicada, primeval elder Gu, and bone flesh unity Gu are definitely going to be kept.",
        "chapters": [
          273
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "kept-in-the-aperture",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_demonic_blood_skull_gu",
          "gu_spring_autumn_cicada",
          "gu_bone_flesh_unity_gu"
        ]
      },
      {
        "text": "Wei Yang passes Fang Yuan a primeval elder Gu as spare money to use for now, calling it a loan rather than a gift and naming himself Fang Yuan’s creditor. The elderly figure’s cheerful expression shows this one had nearly a million primeval stones. Shang Xin Ci also takes out a primeval elder Gu. In hers the cloud elder is frowning and upset, from which one can deduce around a hundred to three hundred thousand primeval stones. Fang Yuan accepts both and says he will repay them later.",
        "chapters": [
          306
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "wei-yangs-loan",
        "text_origin": "source_excerpt",
