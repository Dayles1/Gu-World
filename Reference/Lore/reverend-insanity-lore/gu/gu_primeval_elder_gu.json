  "economy": {
    "canonical_prices": [],
    "price_claims": [
      {
        "text": "Shang Ya Zi tosses Fang Yuan this Gu while paying for recipes. It can seal up to a million primeval stones. After Fang Yuan receives it, they refine it together. The Gu changes owners: the old man in the clouds had been looking at Shang Ya Zi, and then smiles toward Fang Yuan instead, following him no matter which way the Gu is turned. If the stones inside are few, the old man frowns and looks bitter. If the amount is just nice, he is expressionless. The closer the stones get to the limit, the more he smiles. Shang Ya Zi says he bought this one at auction for six thousand six hundred primeval stones, and Fang Yuan treats that as a fair price for a rare rank three Gu.",
        "chapters": [
          268
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_shang_ya_zi",
          "char_fang_yuan"
        ],
        "needs_review": true
      },
      {
        "text": "Bai Ning Bing asks whether a shop sells the primeval elder Gu. The shopkeeper says it would only be sold in auctions, but with a purple thorn token they can pre-order it. They spend sixty-seven hundred primeval stones to purchase one. Fang Yuan later places half of more than nine hundred thousand primeval stones into her primeval elder Gu under a new agreement.",
        "chapters": [
          272
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "second-purchase",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_bai_ning_bing"
        ],
        "needs_review": true
      }
    ],
