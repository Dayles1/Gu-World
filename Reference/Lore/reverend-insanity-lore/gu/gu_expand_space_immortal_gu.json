  "history": {
    "claims": [
      {
        "text": "On Tian Ti mountain, He Feng Yang takes out Expand Space Immortal Gu when Immortal Crane Sect forces entry into Hu Immortal blessed land. Fairy Cang Yu names the Gu, and the text states it belongs to Immortal Crane Sect’s second supreme elder, with the ability to expand a blessed land’s space. He Feng Yang has borrowed it to serve as the core of an immortal killer move.",
        "chapters": [
          699
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
