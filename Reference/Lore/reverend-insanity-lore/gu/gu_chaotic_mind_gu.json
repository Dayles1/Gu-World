  "history": {
    "claims": [
      {
        "text": "On a peak of San Cha Mountain, Tie Ruo Nan spends about seven to eight days becoming proficient in four golden needle Gu battle tactics, then defeats close to a thousand mountain apes alone.",
        "chapters": [
          374
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
