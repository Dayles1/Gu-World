          "sys_gu_worms"
        ]
      },
      {
        "text": "Xiong Jiang says that on Qing Mao Mountain only his cousin Xiong Zhan has this Gu.",
        "chapters": [
          135
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
