  "history": {
    "claims": [
      {
        "text": "At the Man and Ge tribe banquet, Ge Guang presses for the Gu as proof against Fang Yuan, arguing that Ge Yao would leave the marked worms for her killer.",
        "chapters": [
          447
        ],
        "certainty": "canon",
        "confidence": "B",
