  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "Taken out, the Gu is fist-sized and shaped like a black spider with eight hairy black legs. When Ge tribe leader injects primeval essence, its body gives a faint white light. Within five hundred li, Gu worms he marked emit a red light and point toward their direction. If those Gu are hidden inside an aperture, the range falls to a thousand steps. At the banquet test the Gu shows no change in his hand, so no marked Ge Yao Gu are found on Fang Yuan within range.",
        "chapters": [
          448
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_gu_worms"
        ]
      },
      {
        "text": "Fang Yuan later treats it as able to scout or track people, and as a means to track Gu worms when capturing wild Gu so they cannot escape.",
        "chapters": [
          449
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
