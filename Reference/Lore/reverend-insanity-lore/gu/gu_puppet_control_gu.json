  "history": {
    "claims": [
      {
        "text": "On a peak of San Cha Mountain, Tie Mu Bai teaches Tie Ruo Nan after she practices golden needle Gu against mountain apes.",
        "chapters": [
          374
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
