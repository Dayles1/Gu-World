  "economy": {
    "canonical_prices": [],
    "price_claims": [
      {
        "text": "On Qing Mao Mountain, Yao Ji expects a final price of at least fifty thousand primeval stones for the caravan copy shown at thirty thousand.",
        "chapters": [
          111
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "price-and-refinement",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Market talk elsewhere places white silver Relic Gu beside cheaper green copper and red steel Relic Gu and a much dearer yellow gold Relic Gu. Relic Gu are natural Gu and cannot be refined by Gu Masters.",
        "chapters": [
          278
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "price-and-refinement",
        "text_origin": "source_excerpt",
