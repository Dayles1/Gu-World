  "appearance": {
    "claims": [
      {
        "text": "It resembles a leech, though much cuter than one, and its whole body has a light-blue luster like glimmering water.",
        "chapters": [
          111
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "appearance",
        "text_origin": "source_excerpt"
      },
      {
        "text": "On the caravan treehouse counter it resembles a leech, with a whole body of light-blue luster like glimmering water.",
        "chapters": [
          111
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
