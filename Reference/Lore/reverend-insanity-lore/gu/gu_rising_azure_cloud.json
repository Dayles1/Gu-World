  "history": {
    "claims": [
      {
        "text": "At Lang Ya blessed land, while Fang Yuan displays Immortal Gu taken from True Yang Building, Lang Ya land spirit names this one Rising Azure Cloud.",
        "chapters": [
          663
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "loc_lang_ya_blessed_land",
          "char_fang_yuan",
          "sys_immortal_gu",
          "house_eighty_eight_true_yang_building",
          "char_lang_ya_land_spirit"
        ]
      },
      {
        "text": "Fang Yuan leaves Rising Azure Cloud in Lang Ya blessed land as collateral for his recipe-deduction deal. He already holds Worldly Wave Trace, so he ranks Rising Azure Cloud as less useful to him. He judges Worldly Wave Trace stronger for ordinary travel, especially near rivers, lakes, or the sea, while Rising Azure Cloud’s strong point is ascending and descending.",
        "chapters": [
          664
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
