  "economy": {
    "canonical_prices": [],
    "price_claims": [
      {
        "text": "Fang Yuan lists Rising Azure Cloud among four Immortal Gu put up through Fairy Li Shan’s channel. He treats it as a cloud path movement Immortal Gu incompatible with his strength path, and he also judges it unsuitable for Tai Bai Yun Sheng, who cultivates cloud path but is a time path Gu Immortal.",
        "chapters": [
          748
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "auction-listing",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_fairy_li_shan",
          "char_tai_bai_yun_sheng"
        ]
      },
      {
        "text": "Qin Bai Sheng announces Immortal Gu Rising Azure Cloud as rank six cloud path, specialized in ascending and descending in the air, with the seller wanting a strength path Immortal Gu. Fang Yuan chooses the bid that offers iron crown eagle strength Gu plus immortal materials from Lang Ya land spirit’s list, and the buyer receives Rising Azure Cloud.",
        "chapters": [
          752
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
