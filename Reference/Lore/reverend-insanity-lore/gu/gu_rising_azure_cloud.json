  "feeding": {
    "known": true,
    "food_raw": null,
    "foods": [],
    "claims": [
      {
        "text": "Rising azure cloud Gu needs the dragon scale of the desolate beast cloud dragon, as well as tens of thousands of eyeballs from wind scythe birds. Those foods are covered on cloud dragon scales and wind scythe bird eyeballs. Fang Yuan notes that he passed it to Lang Ya land spirit so that feeding would keep it from dying of hunger. In the same feeding survey, Worldly Wave Trace needs underworld jellyfish and deepsea lightning eels, and Calamity Beckoning needs six headed snake blood; those peer foods are covered on underworld jellyfish, deepsea lightning eels, and six headed snake blood.",
        "chapters": [
          672
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "hunger-and-food",
