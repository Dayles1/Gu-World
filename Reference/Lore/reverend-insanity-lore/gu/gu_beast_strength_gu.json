    "claims": [
      {
        "text": "A rank four strength of ten jun Gu is weaker than a rank four beast strength Gu, but jun strength can stack. Similar beast strength Gu can also stack if an additional beast fetus Gu is used.",
        "chapters": [
          443
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "stacking-and-later-use",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_strength_of_ten_jun_gu"
        ]
      },
      {
        "text": "Jin strength Gu and jun strength Gu recipes are easier and cheaper than traditional beast strength Gu, which is why they become widespread in the north.",
        "chapters": [
          500
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
