  "history": {
    "claims": [
      {
        "text": "In a Northern Plains Gu shop, the shopkeeper offers beast strength Gu after listing jin strength Gu and jun strength Gu, and names wolf strength Gu and horse strength Gu as examples a customer can buy. Fang Yuan had been using beast strength Gu to walk the ancient strength path before those newer recipes spread.",
        "chapters": [
          442
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "reg_northern_plains",
          "gu_strength_gu",
          "gu_wolf_strength_gu",
          "char_fang_yuan"
        ]
      },
      {
        "text": "The name covers several distinct Gu, such as wolf strength Gu and horse strength Gu, rather than one shared worm.",
        "chapters": [
          442
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "a-family-of-named-gu",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Ancient strength path used beast strength Gu such as green bull strength Gu, Biao strength Gu, and dragon strength Gu. By Fang Yuan’s time in Northern Plains, materials from those ancient recipes are already extremely rare, so the cost of refining them is huge. Domination Immortal Chu Du’s jin and jun recipes are easier to find materials for, cost less, and have a higher success rate than beast strength Gu. Strength path Gu worms in that market mainly consist of jin strength Gu, jun strength Gu, and beast strength Gu, mostly for attacking.",
        "chapters": [
          442
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "ancient-strength-path",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_biao_strength_gu",
          "gu_dragon_strength_gu",
          "char_chu_du",
          "path_strength",
          "sys_gu_worms"
        ]
      }
    ]
  },
