    "claims": [
      {
        "text": "Spectators name it a rare rank four Gu, and add that Hao Ji Liu used other methods to make the water image look lifelike. When the image fails, it turns into a pool of water and disperses.",
        "chapters": [
          497
        ],
        "certainty": "canon",
        "confidence": "B",
