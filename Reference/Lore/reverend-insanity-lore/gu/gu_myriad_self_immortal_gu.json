    "related_variants": [],
    "claims": [
      {
        "text": "The recipe needs an enormous amount of edge Gu, plus drinking blade wine from under autumn blade plain.",
        "chapters": [
          1563
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "materials",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_edge_immortal_gu"
        ]
      },
      {
        "text": "Fang Yuan steals hundreds of edge Gu there while taking drinking blade wine.",
        "chapters": [
          1565
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "materials",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Drinking blade wine, edge Gu, front-back divine obstruction needles, and floating life fire are named as the four main immortal materials gathered for the work.",
        "chapters": [
          1569
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "materials",
        "text_origin": "source_excerpt",
        "mentions": [
          "res_drinking_blade_wine"
        ]
      },
      {
        "text": "Several hundred rank three self reliance Gu, a strength path Gu whose healing grows with its user’s strength, are the first Gu into the formation, in a strictly calculated quantity because the numbers of dao marks have to be precise when refining an Immortal Gu. In the Long Hair refinement, Third Hair pours drinking blade wine over rock fragments, floating life fire fuses with all-out effort Gu and grey smoke, and front-back divine obstruction needles go in with other immortal materials and mortal Gu.",
        "chapters": [
          1570
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "materials",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_self_reliance_gu",
          "char_third_hair",
          "gu_all_out_effort_gu"
        ]
      }
    ]
