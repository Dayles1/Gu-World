  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "When he injects immortal essence, the Gu shines and countless Fang Yuan strength path phantoms appear from the light, like using the killer move Myriad Self. Fang Yuan feels the effect is only slightly weaker than the killer move, while immortal essence cost falls greatly and activation needs only one thought instead of the preparation time and mental energy the move demanded.",
        "chapters": [
          1570
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "move_myriad_self"
        ]
      },
      {
        "text": "With Myriad Self Immortal Gu, Myriad Self Giant Hand becomes much easier: the new version uses this Immortal Gu as core with group strength Gu and fewer than thirty Gu in total, and no longer needs Self Strength Immortal Gu as core. Reverse Flow Protection Seal also becomes simpler with Myriad Self Immortal Gu among its cores. Fang Yuan’s deeper aim is to use the Gu as a bridge toward Luo Po Seal, and narration says condensing Myriad Self into an Immortal Gu raises the room for creating a new path along that line.",
        "chapters": [
          1571
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "killer-move-cores",
        "text_origin": "source_excerpt",
        "mentions": [
          "move_myriad_self_giant_hand",
          "gu_group_strength_gu",
          "gu_self_strength",
          "move_reverse_flow_protection_seal",
          "move_luo_po_seal"
        ]
      }
    ]
  },
