    "claims": [
      {
        "text": "Blood Frenzy Gu belongs to the Blood Sea Ancestor’s blood path legacy: after naming bladewing blood bat, blood frenzy Gu, and blood guillotine as his fusion recipes, the Ancestor’s dying line is that the blood path is not alone and that the legacy will continue for all eternity.",
        "chapters": [
          183
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "path",
        "text_origin": "source_excerpt",
        "mentions": [
          "path_blood"
        ]
      }
    ]
  },
  "appearance": {
    "claims": [
      {
        "text": "It is formless: a ball of blood essence that survives by attaching itself to other beings.",
        "chapters": [
          183
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "appearance",
        "text_origin": "source_excerpt"
      },
      {
        "text": "It is a rank four Gu that is formless: a ball of blood essence that survives by attaching itself to other beings. Like bladewing blood bat Gu and blood guillotine, it is easy to raise and multiply, and leftover copies can turn up in Blood Sea Ancestor inheritance grounds from valleys and villages to deserts and mountain paths.",
        "chapters": [
          183
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "form-and-rank",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_bladewing_blood_bat_gu"
        ]
      }
    ],
    "visual_confidence": "text_described"
  },
  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "Every Gu worm infected by its aura can absorb natural primeval essence every now and then. The same infection has a hard downside: affected Gu gradually leave the Gu Master’s control and, after a period of time, turn into a pool of blood.",
        "chapters": [
          183
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_gu_worms"
        ]
      }
    ]
  },
