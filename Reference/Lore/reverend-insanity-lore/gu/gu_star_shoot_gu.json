  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "Spring star rain forms a jade colored rain that falls for three days and three nights, feeds crops, raises productivity, and is used to nurture plants and manage a blessed land. Star shoot Gu is a consumable Gu in that move, so each use spends more of it, and only Star Lord Wan Xiang sells it in that market stretch. The text names it a rank three mortal Gu and a star path Gu.",
        "chapters": [
          667
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "killer-move-role",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_mortal_gu"
        ]
      },
      {
        "text": "Fang Yuan judges that each activation uses about five hundred at most.",
        "chapters": [
          667
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "killer-move-role",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Star Lord Wan Xiang refuses to sell a recipe. He says the Gu forms naturally in his blessed land, has no recipe, is produced slowly, cannot be bought outside, and is a unique product of Myriad Star blessed land.",
        "chapters": [
          667
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "killer-move-role",
        "text_origin": "source_excerpt",
        "mentions": [
          "loc_myriad_star_blessed_land"
        ]
      }
    ]
  },
