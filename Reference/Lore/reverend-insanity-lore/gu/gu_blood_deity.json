  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "Working on the recipe, Fang Yuan finds that a refined Blood Deity still needs a blood relation: killing one yields a blood deity from the Immortal Gu’s power, bound closely to the user if the relative gives their life willingly, and liable to turn on the owner if they die in hatred. This is why Fang Yuan is trying to win over his brother Fang Zheng.",
        "chapters": [
          846
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "blood-kin-and-battle-strength",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_fang_zheng"
        ]
      },
      {
        "text": "A blood deity fights at the level of a Gu Immortal.",
        "chapters": [
          847
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "blood-kin-and-battle-strength",
        "text_origin": "source_excerpt"
      }
    ]
  },
