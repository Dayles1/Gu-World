    "related_variants": [],
    "claims": [
      {
        "text": "Fang Yuan writes the recipe for rank six Blood Deity. The copy he obtained was a remnant piece, repaired through research and other Gu Immortals, and he still knows it is not accurate; that inaccuracy was a main reason he did not refine Blood Deity in his previous life, later abandoning it when he gained an accurate Spring Autumn Cicada recipe. Among the Immortal Gu recipes he knows, most are remnants, and Blood Deity’s recipe is already the best of those remnants.",
        "chapters": [
          463
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "remnant-recipe",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_gu_immortal",
          "sys_gu_recipe"
        ]
      },
      {
        "text": "Fang Yuan obtains Vicious Lightning Fiend’s seventy percent Blood Deity remnant recipe and judges that, with his previous life’s accumulations and wisdom Gu’s power, he can likely complete the recipe. In his previous life he had schemed for this same remnant recipe and failed, fleeing heavily injured.",
        "chapters": [
          706
        ],
        "certainty": "inferred",
        "confidence": "C",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "recipe-acquisition",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_vicious_lightning_fiend",
          "rcp_blood_deity_immortal_gu_recipe",
          "gu_wisdom_gu"
        ]
      }
    ]
  },
