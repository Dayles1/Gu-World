  "history": {
    "claims": [
      {
        "text": "Fang Yuan finds the Footless Bird as a quail-egg-sized black-and-white striped bone ball on a scarlet tongue inside the Grey Bone Scholar inheritance on Bai Gu mountain, after Bai Hua knocks the correct teeth from a wall mouth.",
        "chapters": [
          225
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_fang_yuan",
          "char_grey_bone_scholar",
          "loc_bai_gu_mountain",
          "char_bai_hua"
        ]
      },
      {
        "text": "He and Bai Ning Bing later ride it to escape the Bai clan pursuit.",
        "chapters": [
          227
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_bai_ning_bing",
          "fac_bai_clan_bai_gu_mountain"
        ]
      },
      {
        "text": "Fang Yuan pulls Bai Ning Bing onto the bird as they fall from the cliff, then forces it to climb and outrun Bai clan pursuers, including an elder who burns himself with Human Torch Gu. The bird’s bone body helps it survive fire, but cracks spread through its wings and body during the chase.",
        "chapters": [
          227
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "escape-from-bai-gu-mountain",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_human_torch_gu"
        ]
      },
      {
        "text": "After flying most of a day it can no longer continue; Fang Yuan lands it in a forest, and it is counted among the Gu destroyed in that pursuit.",
        "chapters": [
          228
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "escape-from-bai-gu-mountain",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Bai and Tie pursuers later treat that landing site as a search landmark when they split into groups tracking the pair toward Shang clan city.",
        "chapters": [
          293
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "escape-from-bai-gu-mountain",
        "text_origin": "source_excerpt",
        "mentions": [
          "loc_shang_clan_city"
        ]
      }
    ]
  },
