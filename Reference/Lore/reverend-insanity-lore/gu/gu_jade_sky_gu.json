  "appearance": {
    "claims": [
      {
        "text": "It is like a dark green bamboo stem, palm-sized and hollow in the middle, with a smooth jade-like texture when held.",
        "chapters": [
          400
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "appearance",
        "text_origin": "source_excerpt"
      },
      {
        "text": "When summoned, a ray of green light lands as a jade-green hollow bamboo.",
        "chapters": [
          404
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "appearance",
        "text_origin": "source_excerpt"
      },
      {
        "text": "It is Long Qing Tian’s sole rank five poison Gu and core trump card, a Gu from the immemorial times that is fundamentally extinct, and he uses it to poison countless people across Southern Border.",
        "chapters": [
          387
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "form-and-rank",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_poison_gu",
          "reg_southern_border"
        ]
      }
    ],
    "visual_confidence": "text_described"
  },
  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "The Gu carries a special poison from the immemorial era. In southern border, only the four great doctors can cleanse it. A poisoned Gu Master can fade into green light in under two hours, and very few survive the poison. Long Qing Tian also uses it to poison a weakened zone of the three kings blessed land so the land rots into green-blue light and forms a loophole.",
        "chapters": [
          388
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_gu_master"
        ]
      }
    ]
  },
  "feeding": {
    "known": false,
    "food_raw": null,
    "foods": [],
    "claims": []
  },
  "refinement": {
    "recipes": [],
    "used_in_recipes": [],
    "refinement_materials": [],
    "confirmed_evolutions": [],
    "related_variants": [],
    "claims": [
      {
        "text": "Fang Yuan summons Jade sky Gu as a jade-green hollow bamboo, then has Divine Travel swallow Fixed star Gu and enter the hollow Jade sky Gu to form a cocoon.",
        "chapters": [
          404
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "refinement-vessel",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_divine_travel",
          "gu_fixed_star_gu"
        ]
      },
      {
        "text": "Among the materials for that refinement it is the azure heaven’s jade bamboo, and the conditions fulfilled are Divine travel Gu, jade sky Gu, fixed star Gu, and the light of the immemorial era.",
        "chapters": [
          405
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "material-naming",
        "text_origin": "source_excerpt"
      }
    ]
  },
