  "history": {
    "claims": [
      {
        "text": "Iron Wall Gu is a defensive Gu worm Fang Yuan takes from Lang Ya Sect’s inventory. Once it is activated, three thousand mortal Gu of various types follow it, fire path and metal path the most numerous among them, and all of them rank five. It stays fixed at the center while the mortal Gu surround it and move like a wave, and a wave of black light envelops all the Gu worms into a black ball of light that turns smooth and completely round once the worms inside fly fast enough. Fang Yuan then activates three fire path Immortal Gu and more mortal Gu to create a flame that coils around the black ball, burning continuously.",
        "chapters": [
          1823
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
