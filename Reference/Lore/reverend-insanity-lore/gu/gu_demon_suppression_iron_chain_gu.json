  "history": {
    "claims": [
      {
        "text": "During the Qing Mao Mountain clash, iron-chain shadows appear around First gen Gu Yue, turn real, and coil around him like snakes and pythons, binding his hands and feet. Lord Sky Crane names the binding as the Demon Suppression Iron Chain Gu, paired with the Problem Nipped in the Bud Gu on First gen Gu Yue’s forehead.",
        "chapters": [
          193
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "loc_qing_mao_mountain",
          "char_first_gen_gu_yue",
          "char_lord_sky_crane",
          "gu_problem_nipped_in_the_bud_gu"
        ]
      },
      {
        "text": "When Fang Yuan rebirths into the same crisis, the Demon Suppression Iron Chain Gu again binds First gen Gu Yue with Problem Nipped in the Bud Gu.",
        "chapters": [
          196
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "second-loop-after-rebirth",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Fang Yuan expects both this Gu and Problem Nipped in the Bud Gu to be corrupted by Blood Frenzy Gu, turn into blood water, and die. The iron chains then turn into a puddle of blood water, freeing First gen Gu Yue a second time.",
        "chapters": [
          197
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "second-loop-after-rebirth",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_fang_yuan",
          "gu_blood_frenzy_gu"
        ]
      }
    ]
