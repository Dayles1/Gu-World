  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "The Demon Suppression Iron Chain Gu can restrict a Gu Master’s movement so others can trample them. It binds the whole body, and a phantom black iron chain also appears inside the aperture and seals it. Gu worms in the aperture then burn primeval essence resisting that suppression. Once that essence is spent, Problem Nipped in the Bud Gu can extract and seal the captive’s Gu. The chains can tighten until they pierce skin and flesh and stress the bones.",
        "chapters": [
          193
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_gu_master",
          "sys_gu_worms"
        ]
      },
      {
        "text": "The text calls both Gu main Gu worms of the Tie family. Tie Xue Leng had captured countless demonic path Gu Masters with them, and he left this set on First gen Gu Yue with his dying strike. After Tie Xue Leng’s death the Gu should not still draw essence from its Master, yet infection by the berserk blood Gu lets it absorb primeval essence from the air, and Tie Xue Leng’s will on the Gu keeps driving the suppression.",
        "chapters": [
          193
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "tie-xue-lengs-use",
        "text_origin": "source_excerpt",
        "mentions": [
          "fac_tie_clan",
          "char_tie_xue_leng",
          "fac_gu_masters"
        ]
      },
      {
        "text": "Demon Suppression Iron Chain Gu traps First gen Gu Yue again, with the yellow talisman of both Gu on him as Tie Xue Leng’s backup plan.",
        "chapters": [
          196
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "tie-xue-lengs-use",
        "text_origin": "source_excerpt"
      }
    ]
  },
