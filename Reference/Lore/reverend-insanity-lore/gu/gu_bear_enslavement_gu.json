  "history": {
    "claims": [
      {
        "text": "During the wolf tide, one of Xiong Jiao Man’s giant bears dies to lightning wolves, and a Gu worm shoots from the corpse back to her hand. That worm is Bear Enslavement Gu, rank two; it cannot enslave a bear king.",
        "chapters": [
          146
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_xiong_jiao_man",
          "sys_gu_worms"
        ]
      },
      {
        "text": "Fang Yuan demands one Bear Enslavement Gu and seven hundred primeval stones to pull her group out of the valley. She withdraws her consciousness from the Gu and cooperates in refining it over to him.",
        "chapters": [
          147
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_fang_yuan"
        ]
      },
      {
        "text": "Gu Yue Yao Le recalls that Fang Yuan took a Bear Enslavement Gu from Xiong Jiao Man when she sees a large black bear with him. Even without his control of the Gu, the bear begins eating once food is before it.",
        "chapters": [
          151
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "fang-yuans-bear",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_gu_yue_yao_le"
        ]
      }
    ]
