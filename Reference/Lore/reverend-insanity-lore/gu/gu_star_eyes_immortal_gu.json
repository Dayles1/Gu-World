    "claims": [
      {
        "text": "Fang Yuan obtains Star Eyes Immortal Gu as a reward in Yu Lu blessed land.",
        "chapters": [
          988
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
