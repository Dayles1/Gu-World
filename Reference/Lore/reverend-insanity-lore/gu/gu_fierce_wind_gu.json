  "history": {
    "claims": [
      {
        "text": "Bai Ning Bing activates Fierce Wind Gu with Swirl Gu while forming an iceblade, and the white iceblade storm appears again.",
        "chapters": [
          167
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
