  "history": {
    "claims": [
      {
        "text": "Bai Ning Bing tells Fang Yuan that the lava crocodile king’s flame stomach Gu stops Blood Moon Gu from breaking through, and that only Chainsaw Golden Centipede could destroy that defense if it closed to melee, at the cost of wrecking the centipede’s already worn razors.",
        "chapters": [
          207
        ],
