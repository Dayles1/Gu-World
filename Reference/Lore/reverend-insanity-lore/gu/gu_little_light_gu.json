    "related_variants": [],
    "claims": [
      {
        "text": "Moonlight Gu fused with two Little Light Gu produces rank two Moonglow Gu.",
        "chapters": [
          98
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "fusion-into-moonglow-gu",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_moonglow_gu"
        ]
      },
      {
        "text": "That attack is stated as three times a Moonlight Gu’s power, with range still ten meters. Fang Yuan fails one fusion attempt and loses one Little Light Gu, then succeeds later.",
        "chapters": [
          106
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "fusion-into-moonglow-gu",
        "text_origin": "source_excerpt"
