  "history": {
    "claims": [
      {
        "text": "Fang Yuan takes a Little Light Gu from a corner of the academy Gu storage room. He finds a Yellow Camel Longhorn Beetle Gu there and turns it down as incompatible with him, while Black Boar Gu, White Boar Gu, and Jade Skin Gu are simply not in stock. The room holds five Little Light Gu.",
        "chapters": [
          62
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_fang_yuan",
          "gu_yellow_camel_longhorn_beetle_gu",
          "gu_black_boar_gu",
          "gu_white_boar_gu",
          "gu_jade_skin_gu"
        ]
      },
      {
        "text": "Gu Yue Bo tells Gu Yue Fang Zheng that Fang Yuan chose it to assist Moonlight Gu and strengthen the moonblade.",
        "chapters": [
          63
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_gu_yue_bo",
          "char_fang_zheng",
          "gu_moonlight_gu"
        ]
      },
      {
        "text": "He refines the storage-room Gu with help from the Spring Autumn Cicada’s aura the same day he chooses it.",
        "chapters": [
          63
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "fang-yuans-early-holdings",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_spring_autumn_cicada"
        ]
      },
      {
        "text": "During the outdoor wild-boar exam he counts upper stage essence plus Moonlight Gu with Little Light Gu as the reason his hunting efficiency beats the other students.",
        "chapters": [
          73
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "fang-yuans-early-holdings",
        "text_origin": "source_excerpt"
      },
      {
        "text": "After the year-end duel the academy elder’s inspection finds Moonlight Gu and Little Light Gu on his palm and nothing else of note on the body.",
        "chapters": [
          86
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "fang-yuans-early-holdings",
        "text_origin": "source_excerpt"
      },
      {
        "text": "After placing first in the year-end exam he takes a second Little Light Gu free from the Gu hall,",
        "chapters": [
          91
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "fang-yuans-early-holdings",
        "text_origin": "source_excerpt"
      },
      {
        "text": "briefly holding two at once with Moonlight Gu, White Boar Gu, Jade Skin Gu, Liquor worm, and Spring Autumn Cicada.",
        "chapters": [
          98
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "fang-yuans-early-holdings",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_liquor_worm"
        ]
      }
    ]
  },
