  "history": {
    "claims": [
      {
        "text": "After months spent on Gu refinement, Fang Yuan next finishes dusty Gu, Bright Pearl Gu, Dark Toss Gu, and Earth Treasury Flower King Gu, after refining Moving Perspective Cup Gu from Gold and Silver Cup Gu, Another Perspective Gu, and Moving Form Gu.",
        "chapters": [
          425
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_fang_yuan",
          "gu_bright_pearl_gu",
          "gu_earth_treasury_flower_king_gu",
          "gu_moving_perspective_cup_gu",
          "gu_gold_and_silver_cup_gu",
          "gu_another_perspective_gu",
          "gu_moving_form_gu"
        ]
      },
      {
        "text": "Dark Toss Gu looks almost the same as dusty Gu: a silkworm-cocoon shape, but deep black. Fang Yuan feeds it primeval essence; ten tendrils twist out like snakes and climb onto Bright Pearl Gu, which already holds Fixed Immortal Travel with a fading Immortal Gu aura. In a short moment the bright pearl is wrapped in a black silkworm cocoon.",
        "chapters": [
          431
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "form-and-aura-seal",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_fixed_immortal_travel",
          "sys_immortal_gu"
        ]
      },
      {
        "text": "That method is called tossing pearls in the dark. It was developed during the battle of the five regions to completely conceal Gu aura, and after the wrap Fixed Immortal Travel’s aura grows even fainter.",
        "chapters": [
          431
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "form-and-aura-seal",
        "text_origin": "source_excerpt"
      }
    ]
