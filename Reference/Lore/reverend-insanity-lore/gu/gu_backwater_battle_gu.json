  "history": {
    "claims": [
      {
        "text": "At crescent lake, Water Demon Hao Ji Liu demands ten million primeval stones and this Gu from Yan tribe leader Yan Tian Ji in exchange for the kidnapped Yan Cui Er. Yan Tian Ji brings it out beside a rank five storage Gu.",
        "chapters": [
          470
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "intro",
