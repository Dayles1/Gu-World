  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "Whipping the empty air brings out marks. Those marks are dao marks that Gu Immortals and desolate beasts leave for a short time wherever they stop. The marks are extremely weak, and even Gu Immortals paying close attention cannot sense them without this Gu. From the manifested dao marks, an experienced observer can infer path color, rank concentration, how intensely the fight ran, and whether a figure only watched from the side. Gathering the marks shortens their already limited lifespan, and heavy use leaves the whip-like body cracked. After that battlefield use, Hei Lou Lan judges it can serve at least two more times.",
        "chapters": [
          719
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_gu_immortal"
        ]
      },
      {
        "text": "Manifested dao marks last only for a period of time and need plenty of experience to read. Activating Immortal Gu also leaves responding dao marks. In an intense battle many methods tangle those marks until inference fails. On this battlefield few methods were used, so Fang Yuan can roughly understand the situation. Shi Lei and Star Lord Wan Xiang had used mainstream investigative and counter-investigative methods on that field; Thread Trace Gu pierces the gap in those methods. Hei Lou Lan treats the invention as valuable and considers asking whether he will sell it.",
        "chapters": [
          719
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "limits",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_immortal_gu",
          "char_shi_lei",
          "char_star_lord_wan_xiang"
        ]
      }
    ]
  },
