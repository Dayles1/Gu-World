    "factions": [
      "fac_wu_clan"
    ],
    "origin": "unknown",
    "claims": [
      {
        "text": "Wu Yi Hai was Wu Du Xiu’s illegitimate son and had no life tablet Gu or soul lantern Gu; with them he would have been second young master instead.",
        "chapters": [
          1217
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "wu-clan-use",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_wu_yi_hai",
          "char_wu_du_xiu"
        ]
      },
      {
        "text": "After Wu clan accepts Fang Yuan under that identity, Wu Qiao takes out life tablet Gu and soul lantern Gu and asks him to refine them. Those Gu worms stay in Wu clan’s ancestral hall as the symbol of his acknowledgement into the clan.",
        "chapters": [
          1220
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "wu-clan-use",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_wu_qiao",
          "fac_wu_clan"
        ]
      },
      {
        "text": "When Wu Yi Hai goes missing and those Gu in the ancestral hall have not shattered, Wu Yong orders Wu Fa to assemble the life location searching Gu formation, put Wu Yi Hai’s life tablet Gu and soul lantern Gu into it, and deduce his location.",
        "chapters": [
          1378
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "wu-clan-use",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_wu_yong",
          "char_wu_fa",
          "sys_gu_formation"
        ]
      }
    ]
  },
  "ownership_history": [
    {
