  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "Used alone it is an offensive Immortal Gu that can mutate part of an enemy’s body, dominate rank sevens, and trouble immemorial desolate beasts. Used on oneself it can add further transformations onto an existing transformation, for better or worse, and mixed solo use is risky because rank eight mutations hit hard. Safer use needs supplementary Gu formed into killer moves. It can also manage an immortal aperture by driving mutations in lifeforms there until selection leaves stronger mutated species.",
        "chapters": [
          1877
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "effects",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_immortal_gu"
        ]
      }
    ]
  },
