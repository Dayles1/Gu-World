  "appearance": {
    "claims": [
      {
        "text": "After Fang Yuan takes it, he sees a peculiar body: longhorn beetle torso, eight spider-like legs, a rhinoceros beetle horn, cicada wings, two mantis arms, and a firefly-like rainbow tail light.",
        "chapters": [
