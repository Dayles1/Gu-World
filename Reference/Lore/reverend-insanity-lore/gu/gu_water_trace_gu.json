    "claims": [
      {
        "text": "Water Trace Gu sits in Ge Yao’s kit among Gu rated the best of rank three.",
        "chapters": [
          428
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "rank",
        "text_origin": "source_excerpt"
      },
      {
        "text": "The Gu can be nurtured upward. At rank four it can become wave trace Gu with a stronger effect. At rank five it has two refinement directions: wandering wave trace Gu with instant evasion, and river wave trace Gu that lets the Gu Master run quickly on water surfaces. At rank six it becomes worldly wave trace Gu.",
        "chapters": [
          428
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "advancement-series",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_gu_master",
          "gu_worldly_wave_trace"
        ]
      },
      {
        "text": "Feng Jin Huang proposes refining river wave trace Gu as a contest task. River wave trace Gu is a rank five water path Gu, and it forms a series with rank three water trace Gu, rank four wave trace Gu, and rank six worldly wave trace Immortal Gu.",
        "chapters": [
          853
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "contest-series-naming",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_feng_jin_huang",
          "sys_immortal_gu"
        ]
      }
    ]
  },
