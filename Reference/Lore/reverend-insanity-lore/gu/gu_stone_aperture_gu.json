  "economy": {
    "canonical_prices": [],
    "price_claims": [
      {
        "text": "It is an expenditure Gu, gone after one use. It turns a Gu Master’s aperture wall into a sturdy rock wall, fully squeezes the aperture’s potential and growth, and lets the Gu Master reach peak stage of the current rank at once. The price is loss of the path to the next rank and loss of natural primeval essence regeneration, so only primeval stones can refill essence. Gu Masters use it when an aperture is cracked beyond recovery, or when they have no hope of advancing and need a fast peak stage to survive. Refining cost is very high.",
        "chapters": [
          144
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_gu_master",
          "fac_gu_masters"
        ],
        "needs_review": true
      },
      {
        "text": "Fang Yuan later recalls paying a disastrous price of future prospects when he used stone aperture Gu on Qing Mao mountain to reach rank three peak stage.",
        "chapters": [
          312
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "blood-skull-clash",
        "text_origin": "source_excerpt",
