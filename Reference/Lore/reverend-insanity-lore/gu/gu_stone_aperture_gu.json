  "history": {
    "claims": [
      {
        "text": "Fang Yuan recognizes Stone Aperture Gu on Bai Ning Bing, refines it, and keeps it.",
        "chapters": [
          143
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_fang_yuan",
          "char_bai_ning_bing"
        ]
      },
      {
        "text": "Fang Yuan judges that Bai Ning Bing refined it to convert the aperture into a stone aperture and delay Northern Dark Ice Soul physique death, and that the method can only delay destruction, not stop it. At that time Fang Yuan finds the Gu useless to himself compared with the Relic Gu and Water Shield Gu taken from the same body.",
        "chapters": [
          144
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "bai-ning-bings-intent",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_northern_dark_ice_soul_physique",
          "gu_relic_gu",
          "gu_water_shield_gu"
        ]
      },
      {
        "text": "Blood Skull Gu is rank four while Stone Aperture Gu is rank three. When Blood Skull Gu raises aperture potential, it rules over the stone effect, turns the aperture from stone back to light, and the cultivation gain from the stone aperture disappears and even falls.",
        "chapters": [
          198
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "blood-skull-clash",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_demonic_blood_skull_gu"
        ]
      },
      {
        "text": "Later narration groups Relic Gu and Stone Aperture Gu among Gu that reduce the time needed to raise cultivation.",
        "chapters": [
          217
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "blood-skull-clash",
        "text_origin": "source_excerpt"
      }
    ]
  },
