  "appearance": {
    "claims": [
      {
        "text": "It is like a dice: cubic, grey white, and extremely sturdy.",
        "chapters": [
          144
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "appearance",
        "text_origin": "source_excerpt"
      },
      {
        "text": "When Fang Yuan later detonates it, the same square dice form is grey and firm before it becomes grey powder that pervades the primeval sea.",
        "chapters": [
          187
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "appearance",
        "text_origin": "source_excerpt"
      }
    ],
    "visual_confidence": "text_described"
  },
  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "Under Spring Autumn Cicada pressure he detonates Stone Aperture Gu. Grey powder sticks to the light membrane aperture wall, thickens it into heavy stone, and jumps his cultivation from rank three initial stage light silver essence to rank three peak stage snow silver essence. He accepts the cut advancement route and the firmer stone walls as temporary support against Spring Autumn Cicada, and notes Ten Extreme Aptitude apertures recover even from stone, unlike his case.",
        "chapters": [
          187
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "fang-yuans-use",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_spring_autumn_cicada"
        ]
      }
    ]
  },
