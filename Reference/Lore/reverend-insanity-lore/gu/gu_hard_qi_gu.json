  "appearance": {
    "claims": [
      {
        "text": "The Gu is like a beetle, black as iron, and fist sized.",
        "chapters": [
          315
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "appearance",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Yan Tu calls it precious and rare, says Ju Kai Bei’s defense falls when he uses his killer move, and says this Gu will make up for that weakness if raised carefully.",
        "chapters": [
          315
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "form",
        "text_origin": "source_excerpt"
      }
    ],
    "visual_confidence": "text_described"
  },
  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "During the arena clash with Fang Yuan, when ivory armor breaks as Ju Kai Bei’s body enlarges, he has already activated hard qi Gu. It turns into a ball of formless air covering his whole body, so he looks undefended while his defense is tight and solid like a boulder, covering that greatest weakness. Ju Kai Bei slows ivory armor regeneration to entice Fang Yuan, judges the Gu formless, notes he got it only recently, and believes he has never used it before that fight.",
        "chapters": [
          319
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
