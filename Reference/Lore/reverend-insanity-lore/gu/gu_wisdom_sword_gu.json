    "origin": "unknown",
    "claims": [
      {
        "text": "While Bo Qing was alive it was a trump card against wisdom path methods.",
        "chapters": [
          1000
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "original-purpose",
        "text_origin": "source_excerpt"
      },
      {
        "text": "In a grey memory scene, Purple says his wisdom path attainment has reached great grandmaster and that he has deduced an Immortal Gu recipe that can create wisdom sword Immortal Gu. He says wisdom sword can cut the threads of love, and that cutting love Gu’s dao marks on Azure’s body is enough even if the Gu cannot rival rank nine love Gu. The plan is for Azure to think he created the recipe himself. Mo Yao’s remnant soul, watching, knows her lover created wisdom sword Immortal Gu himself.",
        "chapters": [
          1016
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "original-purpose",
        "text_origin": "source_excerpt",
        "mentions": [
