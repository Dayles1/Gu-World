  "history": {
    "claims": [
      {
        "text": "Fang Yuan lures a rank eight sword path Immortal Gu out of the slumbering immortal zombie Bo Qing at Falling Heavenly River after a long wait. Its appearance is a simple floating bubble with an ordinary look, and its aura marks it as rank eight. After leaving the river he identifies it as the legendary wisdom sword Gu.",
        "chapters": [
          995
        ],
