      },
      {
        "text": "Gu Yue Bo later compares Jade Skin Gu to it as stronger defense for less primeval essence.",
        "chapters": [
          63
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_gu_yue_bo",
          "gu_jade_skin_gu"
        ]
      },
      {
        "text": "Fang Yuan, facing a small beehive while hunting, notes that with a Bronze Skin Gu he could risk bee stings to collect honey for Bear Strength Gu feed, and regrets not having one.",
        "chapters": [
          65
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_bear_strength_gu"
        ]
      }
    ]
  },
