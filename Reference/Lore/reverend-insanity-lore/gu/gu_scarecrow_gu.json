  "appearance": {
    "claims": [
      {
        "text": "It is a grass puppet rather than an ordinary scarecrow. In the academy demonstration its neck is about thirty centimeters thick.",
        "chapters": [
          22
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "appearance",
        "text_origin": "source_excerpt"
      },
      {
        "text": "The grass puppet is a rank one Scarecrow Gu. In academy practice it stands as a grass figure with a neck about thirty centimeters thick, set about ten meters from the thrower in the elder’s demonstration.",
        "chapters": [
          22
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "form-and-rank",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Beside the academy Gu room, Jiang Ya sells grass puppets made with Scarecrow Gu. He asks three primeval stones each while stock is low. Fang Yuan privately judges that even after including the primeval essence put in, the true cost should not exceed one and a half primeval stones.",
        "chapters": [
          23
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "form-and-rank",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_jiang_ya",
          "char_fang_yuan"
        ]
      },
      {
        "text": "Cited chapters never state what Scarecrow Gu eats, and they never give a Chinese-character name for it.",
        "chapters": [],
        "certainty": "inferred",
        "confidence": "C",
        "verification": "no_citation",
        "source_id": "src_sagaofgu",
        "section": "form-and-rank",
        "text_origin": "source_excerpt"
      }
    ],
    "visual_confidence": "text_described"
  },
  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "Scarecrow Gu has a nature-type ability of self-recovery. When a moonblade cuts deeply into the grassy body, the cut area can regrow, tangle together, and heal in a short while. Unless the puppet is cut into half at once, it recovers to normal.",
        "chapters": [
          22
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt"
      },
      {
        "text": "The academy elder uses a grass puppet as the live target while teaching moonblade form, then has each Moonlight Gu student take a grass puppet and practice the same throw.",
        "chapters": [
          22
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "academy-use",
        "text_origin": "source_excerpt"
      },
      {
        "text": "After class, students buy grass puppets from the store beside the Gu room so they can practice at home for the three-day moonblade check. Fang Yuan has no interest in buying one.",
        "chapters": [
          23
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "academy-use",
        "text_origin": "source_excerpt"
      }
    ]
  },
