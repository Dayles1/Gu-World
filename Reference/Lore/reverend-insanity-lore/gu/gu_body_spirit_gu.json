    "activation_raw": null,
    "claims": [
      {
        "text": "These Gu refine the soul, and each has its own use. The chapter’s examples for that set are ice soul, cloud spirit, and wind spirit: refining the soul that way later boosts matching Gu types. Dragon soul Gu is the example for boosting dragon-type Gu. Body spirit Gu is named in the same rank three set without a separate worked example.",
        "chapters": [
          442
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Fang Yuan does not buy body spirit Gu. He chooses wolf soul Gu instead, to aid wolf enslavement.",
