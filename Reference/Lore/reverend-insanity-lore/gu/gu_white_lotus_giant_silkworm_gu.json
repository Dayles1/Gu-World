  "history": {
    "claims": [
      {
        "text": "While sorting Immortal Gu food needs, Fang Yuan lists Cleanse Soul among Gu that must be fed. Cleanse Soul needs the flesh and blood of over ten thousand white lotus giant silkworm Gu, and that food is rarely listed in treasure yellow heaven.",
        "chapters": [
          672
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_immortal_gu",
          "char_fang_yuan",
          "gu_cleanse_soul",
          "loc_treasure_yellow_heaven"
        ]
      },
      {
        "text": "A hundred thousand years earlier, during the Late Antiquity Era when soul path flourished, this Gu was once very popular. By Fang Yuan’s time, treasure yellow heaven holds very few.",
        "chapters": [
          695
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "rarity",
