  "history": {
    "claims": [
      {
        "text": "When Fang Yuan annexes Lang Ya blessed land, he obtains the Long Hair refinement path true inheritance and a large number of Immortal Gu. There had originally been three rank eight Immortal Gu, Water Refinement, Forceful Refinement, and Advance Refinement, but Shadow Sect had stolen Forceful Refinement in an earlier battle. All three are refinement path Immortal Gu. Used alone they have no offensive power and are all support type. Advance refinement Immortal Gu, at rank eight, is the core of the Long Hair refinement path formation.",
        "chapters": [
          1767
        ],
        "certainty": "canon",
        "confidence": "B",
