    "claims": [
      {
        "text": "Fang Yuan decides the Immortal Gu he should refine next is Immortal Gu Advance Refinement, not Spring Autumn Cicada, Dog Shit Luck, Attitude, or Dream Token. Once advance refinement Gu becomes rank nine, it would be extremely useful for advancing the rest of his rank eight Immortal Gu. He already holds rank eight advance refinement Gu from Lang Ya Sect, originally the core of the Long Hair refinement path formation and currently the core of Four Elements Square Regret Blood Refinement Pool. Advance refinement Gu is a refinement path Immortal Gu, and refining it to rank nine is far purer than refining Heavenly Essence Treasure Imperial Lotus, with mostly refinement path immortal materials and some rule path ones.",
        "chapters": [
          2247
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "rank-nine-plan",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_spring_autumn_cicada",
          "gu_dog_shit_luck",
          "evt_legend_attitude",
          "gu_dream_token",
          "fac_lang_ya_sect",
          "house_four_elements_square_regret_blood_refinement_pool",
          "gu_heavenly_essence_treasure_lotus"
        ]
      },
      {
        "text": "Inside the sovereign immortal aperture, the refinement of rank nine Advance Refinement reaches the mid-late stage.",
        "chapters": [
          2250
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "rank-nine-plan",
        "text_origin": "source_excerpt"
      },
      {
        "text": "While teasing Heavenly Lord Bai Zu, Fang Yuan continues the refinement. He mainly uses the water refinement technique, with rank eight water refinement Immortal Gu activated from the start. Tens of rivers filled with immortal materials merge in the aperture, and a completely new advance refinement Gu rises from the vast river. Advance Refinement reaches rank nine.",
        "chapters": [
          2252
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "rank-nine-completion",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_heavenly_lord_bai_zu"
        ]
      }
    ]
  },
