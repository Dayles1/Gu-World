  "history": {
    "claims": [
      {
        "text": "After a night spent weighing whether to raise a force around bone flesh unity Gu, Fang Yuan plows an old lady’s field under the sun until his head hurts, then names lightning thoughts Gu with creative thinking Gu, intelligent heart Gu, and tactful Gu, and says even a bookworm would help.",
        "chapters": [
          231
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "intro",
