    "claims": [
      {
        "text": "Sources conflict:",
        "chapters": [],
        "certainty": "inferred",
        "confidence": "C",
        "verification": "no_citation",
        "source_id": "src_sagaofgu",
        "section": "bai-gu-mountain-refinement",
        "text_origin": "source_excerpt"
      },
      {
        "text": "The question is open.",
        "chapters": [],
        "certainty": "inferred",
        "confidence": "C",
        "verification": "no_citation",
        "source_id": "src_sagaofgu",
        "section": "bai-gu-mountain-refinement",
        "text_origin": "source_excerpt"
      },
      {
        "text": "The Bai Gu mountain hall holds unfinished materials and a scroll: refinement needs two blood-related Gu Masters, and Gray Bone Scholar dies before finishing the experiment himself. Fang Yuan and Bai Ning Bing run the forge steps there. At the final flesh step Fang Yuan throws in the Bai clan twins Bai Sheng and Bai Hua first; the twins burn to death, and the fire turns scarlet but fails to reach reddish-purple, so that step fails. Fang Yuan and Bai Ning Bing then cut their own flesh into the fire. When Bai Ning Bing’s flesh lands, the fire turns reddish-purple; they pour primeval essence together, and a linked green-and-red jade bracelet pair forms. Fang Yuan alone takes the pair and instantly refines it into his aperture before they flee.",
        "chapters": [
          226
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "bai-gu-mountain-refinement",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_grey_bone_scholar",
          "char_bai_ning_bing",
          "fac_bai_clan_bai_gu_mountain",
          "char_bai_sheng",
          "char_bai_hua"
        ]
      },
      {
        "text": "The bracelet pair still sits in Fang Yuan’s aperture.",
        "chapters": [
          229
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "bai-gu-mountain-refinement",
        "text_origin": "source_excerpt"
      }
    ]
  },
