  "appearance": {
    "claims": [
      {
        "text": "It is around a metre long and as wide as two fists. It coils and slithers. On both sides of its body is a row of sharp saw-like teeth that move as it moves.",
        "chapters": [
          129
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "appearance",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Under firelight its exoskeleton gives off an eerie light, and the sawteeth at its sides are silver. As it moves closer, the sawteeth move like a slowed chainsaw. When it lunges it moves like a golden line.",
        "chapters": [
          162
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "appearance",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Fang Yuan judges that even White Jade Gu defense cannot endure its attack, and that a wild specimen will burrow and escape if something seems amiss.",
        "chapters": [
          129
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "form",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_white_jade_gu"
        ]
      }
    ],
    "visual_confidence": "text_described"
  },
  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "He calls it out so it coils around his right arm, opens its mouth to swallow his fist and forearm, shrinks its body and feet into an exoskeleton with two rows of razors, and injects primeval essence so the razors spin. Its dark golden exoskeleton shows as it fights. He can will it to extend, detach, and burrow into the ground. The same fight names rank four Chainsaw Killer Centipede as one advancement path of rank three Chainsaw Golden Centipede, later used by Chainsaw Mad Demon.",
        "chapters": [
          166
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "combat-use",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_chainsaw_killer_centipede",
          "char_chainsaw_mad_demon"
        ]
      },
      {
        "text": "Fang Yuan lends Sky Canopy Gu and Chainsaw Golden Centipede to Bai Ning Bing. She copies his method, waves it like a greatsword, and from time to time wills it to lengthen or shorten while waving it around like a whip.",
        "chapters": [
          202
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "borrowed-use",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_sky_canopy_gu",
          "char_bai_ning_bing"
        ]
      }
    ]
  },
