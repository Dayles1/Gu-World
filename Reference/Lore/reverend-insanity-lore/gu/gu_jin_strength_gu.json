  "history": {
    "claims": [
      {
        "text": "A Man tribe market shopkeeper sells it for two hundred and twenty primeval stones per Gu. Domination Immortal Chu Du, a famous rank seven Gu Immortal of northern plains, invents Jin Strength Gu and Jun Strength Gu.",
        "chapters": [
          442
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
