    "activation_raw": null,
    "claims": [
      {
        "text": "Activating Monolith Gu grows rock skin over the body. Man Shi’s limbs thicken into deep grey rock, his weight rises sharply, and even with thick rock skin Fang Yuan’s stomps still press his chest wound.",
        "chapters": [
          108
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Later full activation bulks his muscles and turns his whole appearance into a rock man.",
        "chapters": [
          134
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Two years before the tavern fight, Bai Ning Bing spared Man Shi in a bamboo forest and told him to refine Monolith Gu and fight again. In that memory Man Shi had not yet refined it.",
        "chapters": [
          108
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_bai_ning_bing"
        ]
      }
    ]
  },
