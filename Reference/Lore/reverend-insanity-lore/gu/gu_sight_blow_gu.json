    "activation_raw": null,
    "claims": [
      {
        "text": "The gaze attack can bypass defensive measures and hit the Gu Master’s soul directly. At rank three it mainly serves as a surprise attack, and in that fight it does little damage to a Yan tribe elder.",
        "chapters": [
          471
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_gu_master"
        ]
      },
      {
        "text": "It can attack anyone the user can see. The further the distance, the weaker the attack. Three hundred steps is the limit, and past that distance it has zero threat. Sight based attacks compete the souls of both Gu Masters, so Hao Ji Liu judges that an enslavement path Gu Master such as Chang Shan Yin would be a poor target.",
        "chapters": [
          471
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_chang_shan_yin"
        ]
      }
    ]
  },
