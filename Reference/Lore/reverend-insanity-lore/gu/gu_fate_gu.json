    "claims": [
      {
        "text": "Yuan Qiong Du reports to Fairy Zi Wei that he has bought a batch of year beasts in treasure yellow heaven that are filled with heaven’s will, and that he can use these year beasts as immortal materials to repair fate Immortal Gu, saving time and strengthening the effect.",
        "chapters": [
          1401
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "year-beasts-as-repair-material",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_yuan_qiong_du",
          "char_fairy_zi_wei"
        ]
      }
    ]
  },
