  "appearance": {
    "claims": [
      {
        "text": "Longhorn Beetle Gu as a group have long, circular cylinder figures with many outlines on the back, much of the body black with metallic luster, a pair of feelers longer than the body, a strong chin, and a screech like timber being sawed. The Yellow Camel Longhorn Beetle Gu is a tiny bit thinner and longer than the Brute Force Longhorn Beetle Gu, the entire body coated in dark yellow. Its pair of long feelers have no bamboo joints. The roots are yellow, fading into black at the tip.",
        "chapters": [
          62
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "appearance",
        "text_origin": "source_excerpt"
      }
    ],
    "visual_confidence": "text_described"
  },
  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "It grants the Gu Master durability and greatly reduces stamina expenditure for fifteen minutes, with no repercussions. Among rank one Gu worms it has high market value, comparable to Moonlight Gu and only losing to Jade Skin Gu and Liquor worm.",
