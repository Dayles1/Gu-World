  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "Ying Wu Xie tells Hei Lou Lan that stargate Gu is effective on rank six bottom tier Gu Immortals at best and cannot even transport a single Immortal Gu, judging that Fang Yuan’s high count of dao marks now leaves him unable to use it.",
        "chapters": [
