    "claims": [
      {
        "text": "It is a rank five expendable Gu, invented during the chaotic battle of the five regions in his past life. Activation is stricter than hole earth Gu: it needs the power of the stars in black heaven, and only at night when many stars fill the sky. Its range can traverse the five regions. Fang Yuan already holds the recipe, but the materials are rare and the refinement success rate is extremely low.",
        "chapters": [
          459
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "rank-and-effect",
        "text_origin": "source_excerpt"
      }
    ]
  },
  "appearance": {
    "claims": [
      {
        "text": "It is an oval blue gemstone-like Gu worm, also described as an oval sapphire.",
