    "claims": [
      {
        "text": "Fang Yuan completes the refinement at San Cha Mountain. Under the light of glory of the immemorial era, the cocooned divine travel Gu changes, an Immortal Gu aura leaks from the cocoon, and when it breaks open a green butterfly flies out, the finished fixed immortal travel Gu.",
        "chapters": [
          405
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "refined-at-san-cha-mountain",
        "text_origin": "source_excerpt",
        "mentions": [
          "loc_san_cha_mountain",
          "sys_immortal_gu"
        ]
      },
      {
        "text": "Lang Ya land spirit tells Fang Yuan that no fixed immortal travel recipe avoids the light of the immemorial era, that he holds two full recipes and has read more than ten remnant ones, and that they differ only in how much light each needs. He adds that the Gu would have been refined long ago if the material were easier to get.",
        "chapters": [
          1039
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "no-recipe-avoids-the-light",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_lang_ya_land_spirit"
        ]
      }
    ]
  },
  "economy": {
    "canonical_prices": [],
    "price_claims": [
      {
        "text": "At an auction, Fang Yuan passes on chasing wind Gu and notes that fairy wind Gu, seven shining stars Gu, and other materials can refine fixed star Gu, the main ingredient for fixed immortal travel Gu. The refinement success rate is extremely low and he lacks materials, so he sets the project aside for now.",
        "chapters": [
          307
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_fang_yuan",
          "gu_chasing_wind_gu",
          "gu_fairy_wind_gu",
          "gu_seven_shining_stars_gu",
          "gu_fixed_star_gu"
        ],
        "needs_review": true
      },
      {
        "text": "Ying Wu Xie has no choice but to pay a steep price to Feng Chan Zi’s grass puppet avatar for the light of the immemorial era. He states that the portion of the light of the immemorial era he obtains can last for nine refinement attempts.",
        "chapters": [
          1060
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "ying-wu-xie-buys-the-light",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_ying_wu_xie",
          "char_feng_chan_zi"
        ]
      }
    ],
