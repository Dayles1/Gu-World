  "history": {
    "claims": [
      {
        "text": "Fang Yuan recalls that Verdant Great Sun refined Divine Travel into fixed immortal travel Gu after divine travel’s drunken, uncontrolled destinations proved too dangerous to keep using. Activation needs a concrete impression of the destination. If that place changes hugely, the Gu fails.",
        "chapters": [
          378
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "destination-rules",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_verdant_great_sun",
          "gu_divine_travel"
        ]
      },
      {
        "text": "At Yi Tian Mountain, fixed immortal travel is ineffective inside Shadow Sect’s ten extreme immortal zombie lifeless formation, as it was in Fang Yuan’s previous life.",
        "chapters": [
          1003
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
