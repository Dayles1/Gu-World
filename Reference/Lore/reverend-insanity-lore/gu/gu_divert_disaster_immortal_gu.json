  "history": {
    "claims": [
      {
        "text": "Ink text in Mo Yao’s inheritance calls it a rank seven Immortal Gu and one of the essence of Giant Sun Immortal Venerable’s luck path. Calamity beckoning Gu was refined by interaction with this Gu of Eighty-Eight True Yang Building; the two are luck path Gu worms and two sides of the same coin, one attracting calamities and the other diverting disaster.",
        "chapters": [
          567
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_mo_yao",
