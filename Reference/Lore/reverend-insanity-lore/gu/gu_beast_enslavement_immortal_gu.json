  "history": {
    "claims": [
      {
        "text": "Fang Yuan already knows Lang Ya blessed land holds a rank seven beast enslavement Gu when he tries to trade Immortal Gu recipes there.",
        "chapters": [
          463
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_fang_yuan",
          "loc_lang_ya_blessed_land",
          "sys_gu_recipe"
        ]
      },
      {
        "text": "Fang Yuan knows Lang Ya land spirit has beast enslavement Immortal Gu and keeps twelve enslaved desolate beasts in the twelve cloud buildings.",
        "chapters": [
          661
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "borrowed-beasts-at-hu-immortal",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_lang_ya_land_spirit"
        ]
      },
      {
        "text": "He later borrows Lang Ya land spirit’s rank seven beast enslavement Gu and brings eight desolate beasts against Immortal Crane Sect invaders at Hu Immortal blessed land.",
        "chapters": [
          701
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "borrowed-beasts-at-hu-immortal",
        "text_origin": "source_excerpt",
        "mentions": [
          "fac_immortal_crane_sect",
          "loc_hu_immortal_blessed_land"
        ]
      },
      {
        "text": "There is only one beast enslavement Immortal Gu in the world,",
        "chapters": [
          796
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "only-one-immortal-gu",
        "text_origin": "source_excerpt"
      },
      {
        "text": "kept in Lang Ya blessed land, and it enslaves a desolate beast with instantaneous effect under the user’s thoughts.",
        "chapters": [
          797
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "only-one-immortal-gu",
        "text_origin": "source_excerpt"
      },
      {
        "text": "The current Lang Ya land spirit gives beast enslavement Immortal Gu to Twelfth Hair to nurture enslavement path battle strength.",
        "chapters": [
          1080
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "only-one-immortal-gu",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_twelfth_hair"
        ]
      },
      {
        "text": "Twelfth Hair says the beast enslavement Immortal Gu is not his own and that he still needs to pay to use it.",
        "chapters": [
          1081
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "only-one-immortal-gu",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Proposing that Lang Ya Sect develop Earth Trench for the hairy man Gu Immortals, Fang Yuan tells Lang Ya land spirit that captured desolate beasts there could also be enslaved with beast enslavement Immortal Gu to aid the hairy man Gu Immortals and increase the blessed land’s defense.",
        "chapters": [
          1082
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "only-one-immortal-gu",
        "text_origin": "source_excerpt",
        "mentions": [
          "reg_earth_earth_trench",
          "sys_gu_immortal"
        ]
      },
      {
        "text": "Fang Yuan then borrows the rank six beast enslavement Immortal Gu from Twelfth Hair and injects green grape immortal essence to try enslaving a desolate beast snow monster.",
        "chapters": [
          1094
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "only-one-immortal-gu",
        "text_origin": "source_excerpt"
      },
      {
        "text": "After lifespan Gu compensation talks, Fang Yuan exchanges one Dang Hun Mountain compensation for a huge amount of Lang Ya Sect contribution points as well as beast enslavement Immortal Gu.",
        "chapters": [
          1551
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "only-one-immortal-gu",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_lifespan_gu",
          "loc_dang_hun_mountain"
        ]
      }
    ]
  },
