  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "White silver Relic Gu can only be used once and can instantly raise a rank three Gu Master’s cultivation by a small realm.",
        "chapters": [
          111
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_gu_master"
        ]
      },
      {
        "text": "Fang Yuan’s red steel activation shows one use: red light pours into the aperture wall, the Gu exhausts itself and disappears, and cultivation advances by a small realm because the aperture foundation is strengthened.",
        "chapters": [
          115
        ],
        "certainty": "canon",
