  "history": {
    "claims": [
      {
        "text": "Gu Yue villagers name Relic Gu when guessing how Fang Yuan reached rank one middle stage so quickly: once used, it enhances the aperture walls and helps cultivation rise by a small realm, as the easiest breakthrough method in that talk.",
        "chapters": [
          53
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "fac_gu_yue_clan",
          "char_fang_yuan"
        ]
      },
      {
        "text": "Relic Gu is a sphere-shaped mortal Gu, thumb-sized, with an ordinary appearance. Its effect is to enhance the aperture walls and advance cultivation by a small realm. Rank one through five still runs green copper, red steel, white silver, yellow gold, and purple crystal. Relic Gu form naturally and Gu Immortals cannot create them, because they are human path Gu worms with a fundamental effect on humans and variant humans.",
        "chapters": [
          1796
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "form-and-human-path",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_gu_immortal"
        ]
      }
    ]
