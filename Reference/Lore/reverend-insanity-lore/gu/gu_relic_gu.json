    "claims": [
      {
        "text": "Relic Gu is a series Gu worm listing rank one Green Copper Relic Gu, rank two Red Steel Relic Gu, rank three White Silver Relic Gu (also called Silver Relic Gu there), and rank four Yellow Gold Relic Gu. Each rank is specially targeted toward Gu Masters of the matching rank.",
        "chapters": [
          111
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "series-members",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_gu_worms",
          "gu_green_copper_relic_gu",
          "gu_red_steel_relic_gu",
          "gu_white_silver_relic_gu",
          "gu_yellow_gold_relic_gu",
          "fac_gu_masters"
        ]
      },
      {
        "text": "Relic Gu directly increase the aperture foundation and raise a Gu Master’s cultivation realm, and the line runs rank one through five as green copper, red steel, white silver, yellow gold, and Purple Crystal Relic Gu. Relic Gu are mortal Gu; there are no rank six or higher Immortal Gu for the line. Green copper, red steel, and white silver Relic Gu are widely sold; yellow gold and purple crystal Relic Gu are restricted by large organisations in the mortal market, though treasure yellow heaven still sells them.",
        "chapters": [
          469
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "rank-five-and-mortal-limit",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_purple_crystal_relic_gu",
          "sys_immortal_gu",
          "char_green"
        ]
      }
    ]
  },
