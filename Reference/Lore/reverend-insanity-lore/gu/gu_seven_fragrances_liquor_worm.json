    "claims": [
      {
        "text": "Refining Seven Fragrances Liquor Worm requires two Four Flavors Liquor Worm and seven types of spices. In Shang clan city, Fang Yuan already holds one Four Flavors Liquor Worm, buys two more Liquor worms and fuses them into a second Four Flavors Liquor Worm, then fuses the two Four Flavors Liquor Worm into a Seven Fragrances Liquor Worm. That step goes smoothly, but a fusion fails while he is refining the third Four Flavors Liquor Worm and the second Seven Fragrances Liquor Worm, wasting the primeval stones spent and forcing him to buy the supplementary materials and start again. All his failures fall in these early four flavors and seven fragrances stages.",
        "chapters": [
          326
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "refined-in-shang-clan-city",
