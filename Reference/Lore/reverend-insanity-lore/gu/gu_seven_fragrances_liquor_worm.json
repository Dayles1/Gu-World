  "history": {
    "claims": [
      {
        "text": "Gu Yue Qing Shu tells Fang Yuan that the clan has a recipe raising Liquor worm to rank two Moon Harbinger Gu and then to rank three Seven Fragrances Liquor Worm, which has the ability to refine primeval essence. Fang Yuan already holds a different route in his prior-life memory: advancing the Liquor worm to rank two Four Flavors Liquor Worm and then to that same rank three Seven Fragrances Liquor Worm, and either Gu at that step can refine primeval essence.",
        "chapters": [
          105
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_gu_yue_qing_shu",
          "char_fang_yuan",
          "gu_liquor_worm",
          "gu_four_flavors_liquor_worm"
        ]
      },
      {
        "text": "Fusing two Seven Fragrances Liquor Worm together, with the eyeballs of nine different hundred beast kings, produces rank four Nine Eyes Liquor Worm; three days after that final fusion Fang Yuan obtains the worm, and no rank five form exists on the liquor worm line.",
        "chapters": [
          326
        ],
