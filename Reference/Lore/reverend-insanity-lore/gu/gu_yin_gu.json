  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "Yin Gu used on a male body turns yang into yin and makes the target a woman. Fang Yuan calls it a rank four healing Gu with the effect of bringing the dead to life. Using it lowers the Gu Master’s aptitude by ten percent. For a ten extreme physique that drop is not permanent: as cultivation continues, aptitude recovers toward the extreme again, and Yang Gu is then needed to turn the user around and cut aptitude by ten percent once more.",
        "chapters": [
          199
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_healing_gu",
          "sys_gu_master"
        ]
      },
      {
        "text": "The Gu that saves Bai Ning Bing does not resurrect the Gu worms lost when those worms froze to death.",
        "chapters": [
          200
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_gu_worms"
        ]
      }
    ]
  },
  "feeding": {
    "known": true,
    "food_raw": null,
    "foods": [],
    "claims": [
      {
        "text": "Yin Yang Rotation Gu all come in pairs. After Yin Gu is used, only Yang Gu remains to reverse the change.",
        "chapters": [
          199
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "pair-and-feeding",
        "text_origin": "source_excerpt"
      },
      {
        "text": "If Yin Gu and Yang Gu are intact and form a complete Taiji light sphere, they feed on the transformation of yin and yang qi and are self-sufficient.",
        "chapters": [
          202
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "pair-and-feeding",
        "text_origin": "source_excerpt"
      },
      {
        "text": "The sealed pair was rank four when Problem Nipped in the Bud Gu pulled it from First gen Gu Yue, and Fang Yuan later seizes and refines it.",
        "chapters": [
          194
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
