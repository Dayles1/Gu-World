    "claims": [
      {
        "text": "A rank two Digital Shade Gu in the clan secret room stores the recipe under the spelling Moonscar Gu. That record lists increased attack distance, twice that of Moonlight Gu, as the strength, and subpar attack as the weakness. Moonscar Gu is refined by fusing Moonlight Gu and Scar Rock Gu. If jade rock is added during refinement, or if the fusion is done at night under abundant moonlight, the chance of success is higher. The same record also stores almost ten thousand words of Gu Masters’ fusion experience.",
        "chapters": [
          156
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "digital-shade-recipe",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_digital_shade_gu",
          "fac_gu_masters"
        ]
      },
      {
        "text": "Most rank three fusion recipes Fang Yuan browses in that secret room do not suit him, because they need a Gu such as Moonwhirl Gu or Moonscar Gu as the base.",
        "chapters": [
          156
        ],
        "certainty": "canon",
