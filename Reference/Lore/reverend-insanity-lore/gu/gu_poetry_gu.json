  "history": {
    "claims": [
      {
        "text": "Inside a book house in Profound Literature grotto-heaven, Li Xiao Bai changes his vital Gu to Poetry Gu after deciding poem work suits him better than other routes offered there.",
        "chapters": [
          2023
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "loc_profound_literature_grotto_heaven",
          "char_li_xiao_bai",
          "sys_vital_gu"
        ]
      },
      {
        "text": "The Gu looks like a heart with red jade texture covered by light gold radiance. It is in a side-branch of information path cultivation, apart from the more common oath, letter, and reading or writing lines.",
        "chapters": [
          2023
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "form-and-path",
        "text_origin": "source_excerpt"
      },
      {
        "text": "After the vital Gu change, Li Xiao Bai plans to practice poetic Gu and Emotion Poetry Gu, use gather poem Gu to gather poems externally and advance poem wall Gu, and also practice poem boundary Gu, which he rates as similar in effect to a battlefield killer move.",
        "chapters": [
          2023
        ],
