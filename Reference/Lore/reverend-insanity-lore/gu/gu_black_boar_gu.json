        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "feeding",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_black_and_white_boar_gu"
        ]
      },
      {
        "text": "After Fang Yuan buys one, clan talk reports him buying pork to nurture it while he trains strength.",
        "chapters": [
          119
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "feeding",
        "text_origin": "source_excerpt"
      }
    ]
  },
