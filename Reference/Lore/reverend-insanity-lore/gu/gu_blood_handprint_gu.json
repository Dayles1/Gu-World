  "appearance": {
    "claims": [
      {
        "text": "On Shang Yan Fei’s right palm it sits as a tiny tattoo in the shape of a palm, blood red in color. When he activates it, the tattoo flies out and turns into a giant bright red hand. The Gu he offers in exchange looks like a baby’s palm, tender and plump, clear as crystal, with red blood veins inside that give the palm a ghostly aura.",
        "chapters": [
          274
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "appearance",
        "text_origin": "source_excerpt"
      },
      {
        "text": "On Shang Yan Fei it shows as a tiny blood-red palm tattoo on his right palm, then as a giant bright red hand when activated. The copy he offers Living Treasure Door looks like a baby’s palm, tender and plump, clear as crystal, with red blood veins inside that give the palm a ghostly aura.",
        "chapters": [
          274
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "form",
        "text_origin": "source_excerpt"
      }
    ],
    "visual_confidence": "text_described"
  },
  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "Whoever that palm hits, bird, beast, worm, or fish, turns into a puddle of blood if blood still flows in them. The Gu has great strength and a threatening effect, and Shang Yan Fei used it to dominate the southern border and build his fierce name.",
        "chapters": [
          274
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt"
      }
    ]
  },
