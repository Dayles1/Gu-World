  "history": {
    "claims": [
      {
        "text": "At Living Treasure Door, Shang Yan Fei activates a tiny blood-red palm tattoo on his right hand, and the tattoo flies out so he can dig into the door’s nostrils with Blood Handprint Gu.",
        "chapters": [
          274
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "fac_living_treasure_door",
          "char_shang_yan_fei"
        ]
      },
      {
        "text": "Living Treasure Door calls blood handprint Gu one of Shang Yan Fei’s most useful Gu and asks if he is giving up his blood sea inheritance aspiration. Shang Yan Fei says blood sea inheritances are almost uncountable, true inheritances are hard to find, and that even with Shang clan investigation he has only gotten two after years. He temporarily sacrifices blood handprint Gu to exchange for Man Triumphing Heaven Gu, hoping to redeem it someday. Living Treasure Door swallows the Gu into the treasure realm.",
        "chapters": [
          274
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "exchange-and-blood-sea",
        "text_origin": "source_excerpt",
        "mentions": [
          "fac_shang_clan",
          "gu_man_triumphing_heaven_gu"
        ]
      },
      {
        "text": "Elders say Blood Sea has nine true inheritances, naming blood handprint Gu among them, and that blood handprint Gu is with Southern Border’s current Shang clan leader.",
        "chapters": [
          407
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "blood-sea-true-inheritance",
        "text_origin": "source_excerpt",
        "mentions": [
          "loc_blood_sea",
          "reg_southern_border"
        ]
      },
      {
        "text": "Wu Yuan Ju says a Shang clan Gu Master entered a Blood Sea true inheritance pit and obtained blood handprint Gu, and that this person was Shang clan’s previous clan leader Shang Yan Fei.",
        "chapters": [
          1339
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "shang-yan-fei-obtainment",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_gu_master",
          "inh_blood_sea_true_inheritance"
        ]
      },
      {
        "text": "Narration lists Blood Sea Ancestor’s nine Gu Immortal level true inheritances, naming blood handprint Gu among them. It says Southern Border’s Gu Immortal Shang Yan Fei obtained the most true inheritances, and that in his younger days he found blood handprint Immortal Gu in Southern Border’s blood tide pit.",
        "chapters": [
          2246
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "immortal-gu-inheritance",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_blood_sea_ancestor",
          "sys_gu_immortal",
          "sys_immortal_gu"
        ]
      }
    ]
