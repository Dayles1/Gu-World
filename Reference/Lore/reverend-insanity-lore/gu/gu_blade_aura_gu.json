    "claims": [
      {
        "text": "When Zhu Ba rolls as a meatball, pale black blade aura wraps the ball. The crushing roll fuses with that sharp aura, splitting stone slabs and raising the attack’s might.",
        "chapters": [
          300
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt"
      },
      {
        "text": "When Fang Yuan drives a fist into the meatball, blade aura moves rampantly and slashes him like a dark waterfall until the aura is expended. After Zhu Ba cancels the meatball form, blade aura forms again and flies toward Fang Yuan.",
        "chapters": [
          300
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_fang_yuan"
        ]
      },
      {
        "text": "Zhu Ba must concentrate to manipulate Blade Aura Gu. When he tries to activate other Gu at the same time while his mind is already in disarray from long control work, that split focus helps open a flaw Fang Yuan exploits.",
        "chapters": [
          300
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "concentration-cost",
        "text_origin": "source_excerpt"
      }
    ]
