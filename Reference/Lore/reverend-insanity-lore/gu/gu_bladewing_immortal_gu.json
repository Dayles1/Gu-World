  "history": {
    "claims": [
      {
        "text": "During the autumn blade plain fight Fang Yuan’s great thief ghost hand takes the core Immortal Gu of Meng Tu’s heaven and earth blade, and the move fails with backlash.",
        "chapters": [
          1564
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_fang_yuan",
          "sys_immortal_gu",
          "char_meng_tribe_meng_tu"
        ]
      },
      {
        "text": "Fang Yuan then holds the stolen rank seven Immortal Gu and names it bladewing Immortal Gu.",
        "chapters": [
          1565
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Meng Tu had raised it from rank five mortal Gu, failing dozens of times and spending huge resources and time. It was not his vital Gu. Fang Yuan stores it in his immortal aperture and seals it in Heaven Sealing Mountain in front of him.",
        "chapters": [
          1565
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "theft-and-sealing",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_mortal_gu",
          "sys_vital_gu",
          "loc_heaven_sealing_mountain"
        ]
      },
      {
        "text": "A later summary says the modified great thief ghost hand stole Soul Beast Token and rank seven bladewing Immortal Gu, and that Meng Tu’s loss of this Gu turned the fight.",
        "chapters": [
          1572
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "theft-and-sealing",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_soul_beast_token"
        ]
      }
    ]
  },
