  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "The poison is extremely strong and deadly, but the Gu does not have strong attacking abilities and is only usable as a sneak attack. Wang Da’s kit in that fight is only Love Life Separation and Shadow Follower Gu.",
        "chapters": [
          76
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_shadow_follower_gu"
        ]
      },
      {
        "text": "Jade Skin Gu, a rank one Gu, cannot block the nails. The nails pierce one centimetre into jade skin, and even without piercing through all of it the poison already invades the body. Fang Zheng collapses after that stab. Gu Yue Yao Ji later reports that his situation has stabilized, his life is in no danger, he is still sleeping, and his talent did not drop.",
        "chapters": [
          76
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_jade_skin_gu",
          "char_fang_zheng",
          "char_gu_yue_yao_ji"
        ]
      },
      {
        "text": "The same poison kills three Gu Yue Gu Masters before the clan identifies the assassin.",
        "chapters": [
          77
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "fac_gu_yue_clan",
          "fac_gu_masters"
        ]
      }
    ]
  },
