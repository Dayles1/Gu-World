    "origin": "unknown",
    "claims": [
      {
        "text": "In the Gu Yue clan underground room of precious Gu, among the few rank two worms is a Love Separation Gu, still called the number 1 poison Gu among the Rank twos. Injuries caused by it cannot be healed even by a rank three healing Gu. The text says this Love Separation is the one Wang Er owned back then, and that after obtaining it the clan kept it here. Fang Yuan sees it and does not choose it; he takes Tusita flower instead.",
        "chapters": [
          160
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "clan-stock",
        "text_origin": "source_excerpt",
