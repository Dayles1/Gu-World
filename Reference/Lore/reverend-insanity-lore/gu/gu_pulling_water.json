    "price_claims": [
      {
        "text": "Feng Jiu Ge, bidding as Swordmaster You Lan for Worldly Wave Trace, adds the strength path Immortal Gu Pulling Water to his offer.",
        "chapters": [
          753
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_feng_jiu_ge",
          "char_swordmaster_you_lan",
          "gu_worldly_wave_trace",
          "sys_immortal_gu"
        ],
        "needs_review": true
      },
      {
        "text": "Fang Yuan sells Worldly Wave Trace to Feng Jiu Ge for two strength path Immortal Gu and refines both on the spot, so Pulling Water becomes his. Pulling Mountain and Pulling Water belong to the atmospheric heaven and earth branch of strength path.",
        "chapters": [
          754
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
