  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "In Hu Immortal blessed land, Fang Yuan activates pulling water Immortal Gu over a lake. A formless force lifts the lake water into the air, keeps fish and other life inside, and lets him reshape the water mass before setting it back down. One of the two Gu is targeted at mountain ranges, while the other is for water.",
        "chapters": [
          769
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect-in-use",
        "text_origin": "source_excerpt",
        "mentions": [
          "loc_hu_immortal_blessed_land"
        ]
      },
      {
        "text": "Fang Yuan uses Immortal Gu Pulling Water to lift lake water and pour dragonfish into his immortal aperture.",
        "chapters": [
          800
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect-in-use",
        "text_origin": "source_excerpt"
      },
      {
        "text": "After fusing Pulling Water into strength path giant hand, the lake water aids capture instead of blocking it, and he again pulls up water to take ordinary dragonfish.",
        "chapters": [
          910
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "effect-in-use",
        "text_origin": "source_excerpt"
      },
      {
        "text": "In Hei Fan grotto-heaven, Fang Yuan uses Pulling Water to move the grotto-heaven’s rivers and pools into the sovereign immortal aperture as well.",
        "chapters": [
          1133
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "effect-in-use",
        "text_origin": "source_excerpt",
        "mentions": [
          "loc_hei_fan_grotto_heaven"
        ]
      }
    ]
  },
