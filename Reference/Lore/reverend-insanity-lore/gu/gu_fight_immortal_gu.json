  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "Soaring fighting spirit is a non-mainstream wisdom path killer move from Purple Mountain True Monarch’s inheritance. It has only one core Immortal Gu: the rule path rank seven Immortal Gu Fight that Fang Yuan obtained from Corpse City’s defensive Gu formation. The other supplementary Gu are mortal Gu, mostly wisdom path. Fang Yuan instills red date immortal essence into fight Immortal Gu; expenditure is only three beads, then the Gu flies and draws its silver trace into the profound light. The first activation fails, destroys many mortal Gu, and drops fight Gu to the ground under backlash.",
        "chapters": [
          1396
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "first-activation-fails",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_purple_mountain_true_monarch"
        ]
      }
    ]
  },
