  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "That light has no attack power of its own, but it can pass through everything and shine on every corner of the world. Even this blessed land cannot cut it off.",
        "chapters": [
          389
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Xiao Mang activates Extreme Light Gu with Heaven’s Will Gu and Empty Fist Gu as the killer move Immemorial Light Fist, forming a mountain-sized fist of light that pierces the blessed land’s membrane and opens a passage to the outside world. Alone the Gu has no attacking power, but with those other two Gu it can form an intense attack.",
        "chapters": [
          389
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "use-at-san-cha-mountain",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_heavens_will_gu",
          "gu_empty_fist_gu",
          "move_immemorial_light_fist"
        ]
      }
    ]
  },
  "feeding": {
    "known": true,
    "food_raw": null,
    "foods": [],
    "claims": [
      {
        "text": "Fang Yuan later recalls that the light of the immemorial era used when he refined Fixed Immortal Travel came from Extreme Light Gu in Xiao Mang’s hands. Once Xiao Mang dies, Extreme Light Gu is destroyed as well. Fang Yuan considers searching Xiao clan graves for clues because that Gu was found in a graveyard.",
        "chapters": [
          1039
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "loss-after-xiao-mangs-death",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_fixed_immortal_travel",
          "fac_xiao_clan"
        ]
      }
    ]
  },
