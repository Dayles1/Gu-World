  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "After the link, both parties share fortune and disaster together. Lang Ya land spirit also describes linking luck to mountains, rivers, blessed lands, grotto-heavens, or immemorial desolate beasts when other luck path Immortal Gu are used with it.",
        "chapters": [
          663
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt",
        "mentions": [
          "path_luck"
        ]
      },
      {
        "text": "Fang Yuan instead plans to bind his luck to living targets whose future success he already knows from rebirth.",
        "chapters": [
          664
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "effect",
        "text_origin": "source_excerpt"
      }
    ]
  },
  "feeding": {
    "known": true,
    "food_raw": null,
    "foods": [],
    "claims": [
      {
        "text": "It needs five thousand kilograms of sand from the resting area of the ancient desolate beast worldly sand gull.",
        "chapters": [
          672
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "food-and-early-targets",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Fang Yuan intends Ma Hong Yun as a prime target, stronger than Han Li or Hong Yi, but at that time Ma Hong Yun is reported captured by Qin Bai Sheng and is not yet available for the link.",
        "chapters": [
          678
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "food-and-early-targets",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_ma_hong_yun",
          "char_han_li",
          "char_hong_yi",
          "char_qin_bai_sheng"
        ]
      },
      {
        "text": "He succeeds in connecting luck to Hong Yi, and earlier to Han Li.",
        "chapters": [
          680
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "food-and-early-targets",
        "text_origin": "source_excerpt"
      },
      {
        "text": "After those links he also connects to Ye Fan, so four portions of luck are equally distributed among them.",
        "chapters": [
          681
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "food-and-early-targets",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_ye_fan"
        ]
      }
    ]
  },
