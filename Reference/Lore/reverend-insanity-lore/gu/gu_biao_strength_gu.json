  "history": {
    "claims": [
      {
        "text": "Fang Yuan had been interested in the Biao Strength Gu of Xue San Si on San Cha mountain, but he turned her into minced meat and the Gu worms on her body were destroyed with her.",
        "chapters": [
          345
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_fang_yuan",
          "char_xue_san_si",
          "loc_san_cha_mountain",
          "sys_gu_worms"
        ]
      },
      {
        "text": "When Xue San Si uses it, a beast phantom appears behind her: a fierce tiger with brownish-yellow fur, a tough muscular body, and a pair of wings on its back. That winged tiger is a Biao.",
        "chapters": [
          342
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "phantom",
        "text_origin": "source_excerpt"
      },
      {
        "text": "His own eight phantoms come from ordinary beasts. He judges that only by replacing them with a Biao strength phantom, a mastiff strength phantom, and similar phantoms can he show the strongest fighting strength in the rank four realm.",
        "chapters": [
          345
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "phantom",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Ancient strength path used beast strength Gu such as green bull strength Gu, Biao Strength Gu, dragon strength Gu, and so on. By the present age those ancient materials are already extremely rare, so the cost of refining such Gu is huge.",
        "chapters": [
          442
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "ancient-strength-path",
        "text_origin": "source_excerpt",
        "mentions": [
          "path_strength",
          "gu_beast_strength_gu",
          "gu_strength_gu",
          "gu_dragon_strength_gu"
        ]
      }
    ]
  },
