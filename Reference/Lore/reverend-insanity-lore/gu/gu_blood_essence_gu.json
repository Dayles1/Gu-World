    "claims": [
      {
        "text": "The recipe uses rank two Moonglow Gu and Blood Essence Gu to combine into the rank three Blood Moon Gu. When Fang Yuan memorizes that recipe he already holds Moonglow Gu, and he notes that Blood Essence Gu is slightly harder to get a hold of.",
        "chapters": [
          157
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "blood-moon-gu-material",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_moonglow_gu"
        ]
      },
      {
        "text": "He later refines Blood Moon Gu during the wolf tide, failing once and succeeding on the second try. He takes the refinement ingredients from Gu Yue Chi Lian. The recipe’s only named materials are Moonglow Gu, which he already holds, and Blood Essence Gu.",
        "chapters": [
          157
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "blood-moon-gu-material",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_gu_yue_chi_lian"
        ]
      }
    ]
  },
