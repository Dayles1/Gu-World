    "claims": [
      {
        "text": "Fang Yuan identifies the stolen sovereign immortal fetus Gu as a human path Gu worm.",
        "chapters": [
          1774
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "path-and-body-traits",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_gu_worms"
        ]
      },
      {
        "text": "It is a human path rank nine Immortal Gu.",
        "chapters": [
          2237
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "path-and-body-traits",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Fang Yuan’s main body was made from sovereign immortal fetus Gu. The Gu is consumable, it can turn any life form into a pure bred human, and because the body is not created by normal birth it has the trait of being half an otherworldly demon.",
        "chapters": [
          1940
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "path-and-body-traits",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Activation turns it into a human body without providing a soul, and the sovereign immortal body is created with the most compatibility with the cultivator’s soul.",
        "chapters": [
          2168
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "path-and-body-traits",
        "text_origin": "source_excerpt"
      }
    ]
  },
  "appearance": {
    "claims": [
      {
        "text": "After the ten extreme immortal zombies are sacrificed, only one round ball is left, shining in the light of nine different colors.",
        "chapters": [
          1018
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "appearance",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Spectral Soul Demon Venerable’s remaining soul condenses into a soul ball the size of a face and floats toward the ball-like Gu inside the ten extreme formation at Yi Tian Mountain. Spectral Soul names the success as refining rank nine sovereign immortal fetus Gu, meant to obtain the body of an otherworldly demon.",
        "chapters": [
          1018
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "form",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_spectral_soul_demon_venerable",
          "loc_yi_tian_mountain"
        ]
      }
    ],
    "visual_confidence": "text_described"
  },
  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "After a terrible injury heals in three days, Fang Yuan credits the body sovereign immortal fetus Gu made him: his dao marks span every path without interfering, so healing methods of any path display their full effect.",
        "chapters": [
          1058
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "every-paths-healing-at-full-effect",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Because of that same trait, Fang Yuan can alternate the blood path killer move blood torrent with the sword path sword escape Immortal Gu without either losing strength, making up for sword escape’s single-direction weakness.",
        "chapters": [
          1061
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "alternating-blood-and-sword-path-moves",
        "text_origin": "source_excerpt"
      }
    ]
  },
  "feeding": {
    "known": false,
