    "confirmed_evolutions": [],
    "related_variants": [],
    "claims": [
      {
        "text": "During a refinement attempt hidden in Northern Plains’ Earth Trench, Green refuses to flee and points to the still-living Immortal Fetus Gu as his entire life’s work, until Yellow forces him to abandon the try after heaven’s will fills the remaining rank eight immortal materials.",
        "chapters": [
          1017
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "failed-refinement-attempt",
        "text_origin": "source_excerpt",
        "mentions": [
          "reg_northern_plains",
          "reg_earth_earth_trench",
          "char_green",
          "char_yellow"
        ]
      },
      {
        "text": "Refining this Gu left Spectral Soul no choice but to give up all of Zombie Alliance, its countless immortal zombies spent as immortal material to push the refinement further.",
        "chapters": [
          1256
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "immortal-material-from-zombie-alliance",
        "text_origin": "source_excerpt"
      }
    ]
  },
  "economy": {
    "canonical_prices": [],
    "price_claims": [
      {
        "text": "To refine it, Shadow Sect had emptied almost all of its treasuries and had even spent Zombie Alliance as immortal material for the ten extreme formation.",
        "chapters": [
          1066
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
