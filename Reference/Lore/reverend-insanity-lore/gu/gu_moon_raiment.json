      }
    ],
    "visual_confidence": "text_described"
  },
  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "It is a rank two Gu with defensive properties. Its defense sits slightly lower than White Jade Gu, but it can assist others in defending and has greater use in small group fights. With it active, Fang Yuan judges that bare fists cannot break Fang Zheng’s defense, and that Moonlight Gu also cannot break through unless the attacker holds Moonglow Gu.",
        "chapters": [
          104
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "defense",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_white_jade_gu",
          "char_fang_yuan",
          "gu_moonglow_gu"
        ]
      },
      {
        "text": "By the time Fang Zheng confronts Fang Yuan on the stairs, he has already refined Moon Raiment and treats it as the defense Fang Yuan cannot break with fists. Fang Yuan confirms the rank two label on sight.",
        "chapters": [
          104
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "defense",
        "text_origin": "source_excerpt"
      }
    ]
  },
