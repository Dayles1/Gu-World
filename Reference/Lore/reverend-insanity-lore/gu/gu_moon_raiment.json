  "appearance": {
    "claims": [
      {
        "text": "When Fang Zheng activates it, a vague light blue fog gathers around his body. In the mist it forms a long floating ribbon that loops around his waist and coils around his limbs, with the middle section drifting above his head.",
        "chapters": [
          104
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
