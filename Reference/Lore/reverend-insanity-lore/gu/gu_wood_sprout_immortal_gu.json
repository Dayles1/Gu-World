  "history": {
    "claims": [
      {
        "text": "Light fungus radiance uses perseverance Immortal Gu, self love Immortal Gu, and wood sprout Immortal Gu as cores, with snack Immortal Gu supplementing them, to turn green light shine fungi into pure white light shine fungi suited to the sky. Wood sprout Immortal Gu is borrowed from Lang Ya Sect for that move.",
        "chapters": [
          1458
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
