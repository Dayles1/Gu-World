  "history": {
    "claims": [
      {
        "text": "In Shang clan city, after Bai clan agrees to hand over five hundred thousand primeval stones within a day, Bai Feng says he can borrow three hundred thousand as a clan elder and must pawn Small Tornado Gu for the remaining two hundred thousand.",
        "chapters": [
