  "history": {
    "claims": [
      {
        "text": "Near San Cha Mountain, Tie Ba Xiu is a famous righteous path Gu Master whose battle strength, with earth overlord Gu, surpasses ordinary rank four peak stage.",
        "chapters": [
          359
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "loc_san_cha_mountain",
          "char_tie_ba_xiu",
          "sys_gu_master"
        ]
      },
      {
        "text": "Earth overlord Gu lets him absorb an endless amount of strength from the earth and make his tyrant strength Gu stronger. He keeps activating earth overlord Gu so formless strength from the earth empowers tyrant strength Gu and his power keeps rising.",
        "chapters": [
          360
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "with-tyrant-strength-gu",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_tyrant_strength_gu"
        ]
      },
      {
        "text": "Against Fang Yuan, that continuous empowerment pushes tyrant strength Gu past Fang Yuan’s limits even while Tie Ba Xiu cannot show his full strength.",
        "chapters": [
          363
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "with-tyrant-strength-gu",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_fang_yuan"
        ]
      },
      {
        "text": "Narration ranks him, because of earth overlord Gu, as Fang Yuan’s most powerful foe after leaving Qing Mao Mountain.",
        "chapters": [
          362
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "with-tyrant-strength-gu",
        "text_origin": "source_excerpt",
