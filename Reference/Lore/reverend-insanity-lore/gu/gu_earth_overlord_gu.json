    "claims": [
      {
        "text": "Fang Yuan finds rank five earth overlord Gu among the Gu worms in his aperture, and he builds the killer move four arm earth king from research inspired by three heads six arms.",
        "chapters": [
          539
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "move-creation",
        "text_origin": "source_excerpt",
        "mentions": [
          "sys_gu_worms"
        ]
      },
      {
        "text": "He later sees that the killer move was based on ground fighting, so flying exposes heavy repercussions tied to rank five earth overlord Gu.",
        "chapters": [
          543
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "move-creation",
        "text_origin": "source_excerpt"
      },
      {
        "text": "He then changes earth overlord Gu to wind overlord Gu and adjusts the other supplementary Gu worms so he can fight best in the wind.",
        "chapters": [
          546
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "move-creation",
        "text_origin": "source_excerpt",
