  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "After subduing the night wolf king, Fang Yuan breathes out large amounts of wolf smoke that covers the beast, stabilizing its critical injuries.",
        "chapters": [
          458
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "battlefield-healing",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Later, Wolf Smoke Gu floats above the surface of Fang Yuan’s primeval sea as a dark cloud shaped like a wolf, used specifically to heal wolves.",
        "chapters": [
          459
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "battlefield-healing",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Fang Yuan follows Wolf Howl Gu with Wolf Smoke Gu, emitting dense smoke that engulfs the battlefield and heals the wolves’ injuries in front of the shocked Yan tribe.",
        "chapters": [
          473
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "battlefield-healing",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_wolf_howl_gu",
          "fac_yan_tribe"
        ]
      },
      {
        "text": "In the assault on Pei tribe’s walls, Fang Yuan uses wolf smoke Gu to heal the wolf group’s wounds and recover their battle strength.",
        "chapters": [
          482
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "battlefield-healing",
        "text_origin": "source_excerpt",
        "mentions": [
          "fac_pei_tribe"
        ]
      },
      {
        "text": "Against the water wolves of crescent lake he makes his move from the back several times with both Wolf Howl Gu and Wolf Smoke Gu, firmly grasping control of the battle.",
        "chapters": [
          485
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "battlefield-healing",
        "text_origin": "source_excerpt"
      },
      {
        "text": "In Fang Yuan’s first aperture the purple crystal primeval sea still carries wolf smoke Gu above its surface, with large numbers of wolf enslavement Gu at the bottom.",
        "chapters": [
          504
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "battlefield-healing",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_wolf_enslavement_gu"
        ]
      }
    ]
  },
