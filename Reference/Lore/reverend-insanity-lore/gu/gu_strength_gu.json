    "claims": [
      {
        "text": "When Fang Yuan thinks about what a completed Eighty-Eight True Yang Building would mean as a rank nine Immortal Gu house, the text groups legend Gu such as strength Gu, wisdom Gu, and fate Gu as rank nine Immortal Gu that have already vanished and are only revered in The Legends of Ren Zu.",
        "chapters": [
          561
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "rank-nine-immortal-gu",
        "text_origin": "source_excerpt",
        "mentions": [
          "house_eighty_eight_true_yang_building",
          "sys_immortal_gu_house",
          "gu_fate_gu"
        ]
      },
      {
        "text": "Hearing about heaven path Immortal Gu that take lifespan when they resonate with emotion, Su Qi Han asks whether strength Gu and wisdom Gu in The Legends of Ren Zu are also heaven path Gu worms. Imperial Minister Su answers that he is not sure.",
        "chapters": [
          2121
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "path-talk-left-unsettled",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_su_qi_han",
          "sys_gu_worms",
          "char_imperial_minister_su"
        ]
      }
    ]
  },
