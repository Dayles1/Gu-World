  "history": {
    "claims": [
      {
        "text": "During the Qing Mao Mountain clash, a yellow talisman appears on First gen Gu Yue’s forehead while iron chains bind him. Lord Sky Crane names that talisman as the Problem Nipped in the Bud Gu, set beside Demon Suppression Iron Chain Gu.",
        "chapters": [
          193
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "loc_qing_mao_mountain",
          "char_first_gen_gu_yue",
          "char_lord_sky_crane",
          "gu_demon_suppression_iron_chain_gu"
        ]
      },
      {
        "text": "Tie Xue Leng leaves both Gu on First gen Gu Yue with his dying strike. Sky Crane Lord says Tie Xue Leng had captured countless demonic path Gu Masters through that pair. The Problem Nipped in the Bud Gu waits while Demon Suppression Iron Chain Gu burns the captive’s primeval essence. Once that essence is gone, the forehead Gu begins to work.",
        "chapters": [
          193
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "on-qing-mao-mountain",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_tie_xue_leng",
          "fac_gu_masters"
        ]
      },
      {
        "text": "It lets out faint yellow light and draws a fist-sized yellow ball from First gen Gu Yue’s aperture. That ball becomes Blood Skull Gu on the ground.",
        "chapters": [
          193
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "on-qing-mao-mountain",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_demonic_blood_skull_gu"
        ]
      },
      {
        "text": "Further yellow lights pull Yin Yang Rotation Gu and other Gu the same way.",
        "chapters": [
          194
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "on-qing-mao-mountain",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_yin_yang_rotation_gu"
        ]
      },
      {
        "text": "A Gu held under that yellow imprint cannot be activated by the owner’s thoughts. Only Tie Xue Leng or certain special Gu can unseal it. The imprint itself has no defense; ordinary attacks can collapse it and destroy a sealed expendable Gu with it.",
        "chapters": [
          194
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "on-qing-mao-mountain",
        "text_origin": "source_excerpt"
      }
    ]
  },
