    "claims": [
      {
        "text": "Wu clan has been gathering immortal materials for eight-faced prestige wind Immortal Gu for many years, and only lacked one main material: dry clear qi. Wu Bei finds a large amount of dry clear qi while exploring Space Comprehension Pit, enough for the clan to refine the Gu. Wu Yong names eight-faced prestige wind Gu a rank eight Immortal Gu and a major clan matter, and says the clan must prepare carefully, because refining rank eight Immortal Gu is difficult. He puts the refinement aside for now so Wu clan can pressure Ba clan after Chi Bang agrees to ally.",
        "chapters": [
          2079
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "dry-clear-qi-materials",
        "text_origin": "source_excerpt",
        "mentions": [
          "fac_wu_clan",
          "char_wu_yong",
          "sys_immortal_gu",
          "fac_ba_clan",
          "char_chi_bang"
        ]
      },
      {
        "text": "When Ke Xin Hong asks which Gu to refine next, Wu Yong weighs whether to pass seven-faced prestige wind Gu. If he could refine eight-faced prestige wind Gu, his strength would rise sharply, but seven-faced prestige wind Gu is extremely important, and handing it to Fang Yuan risks it being snatched.",
        "chapters": [
          2151
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "refinement-choice",
        "text_origin": "source_excerpt"
      }
    ]
  },
  "economy": {
    "canonical_prices": [],
    "price_claims": [
      {
        "text": "A trade with Fang Yuan gives Wu Yong a rank nine wind path immortal material, and that trade is a significant breakthrough in preparatory work for refining eight-faced prestige wind Immortal Gu.",
        "chapters": [
          2101
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "preparatory-work-trade",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_fang_yuan"
        ]
      },
      {
        "text": "Through Ke Xin Hong, Fang Yuan offers to personally refine the rank eight Immortal Gu Eight-faced Prestige Wind as the price for Hu Land.",
        "chapters": [
          2134
        ],
        "certainty": "canon",
        "confidence": "B",
