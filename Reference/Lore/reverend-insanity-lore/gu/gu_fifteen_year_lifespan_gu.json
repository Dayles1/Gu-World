  "history": {
    "claims": [
      {
        "text": "When the fifty-fifth floor of Eighty-Eight True Yang Building has condensed, Hei Lou Lan tells Tai Bai Yun Sheng he has found a Fifteen-year Lifespan Gu, and later pins it as the reward for clearing the eighty-fifth round.",
        "chapters": [
          591
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "house_eighty_eight_true_yang_building",
          "char_hei_lou_lan",
          "char_tai_bai_yun_sheng"
        ]
      },
      {
        "text": "That Gu is the reward for passing the eighty-fifth round on the fifty-fifth floor.",
        "chapters": [
          591
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "round-reward",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Tai Bai Yun Sheng states that it can increase his lifespan by fifteen years, and he presses that floor in order to take it. Fang Yuan moves to keep him from securing the Gu and skipping immortal advancement.",
        "chapters": [
          591
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "round-reward",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_fang_yuan"
        ]
      },
      {
        "text": "Fang Yuan tosses a Fifteen-year Lifespan Gu to Tai Bai Yun Sheng and tells him to use it, saying True Yang Building has only a single lifespan Gu and that Fang Yuan used his glass owner token to obtain it. Tai Bai Yun Sheng keeps it in his pocket instead of using it at once.",
        "chapters": [
          615
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "reward-transfer",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_lifespan_gu"
        ]
      }
    ]
  },
