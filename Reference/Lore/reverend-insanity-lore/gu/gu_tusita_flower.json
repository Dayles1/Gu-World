  "history": {
    "claims": [
      {
        "text": "Fang Yuan finds it in Gu Yue village’s underground cavern among the clan’s stored Gu, from rank two through rank four, and takes it at once to cover his lack of storage.",
        "chapters": [
          160
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_fang_yuan",
          "loc_gu_yue_village"
        ]
      },
      {
        "text": "He had handed up a Nine Leaf Vitality Grass, and that exchange is how he obtains this copy.",
        "chapters": [
          161
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_nine_leaf_vitality_grass"
        ]
      },
      {
        "text": "Fang Yuan still holds a rank three Tusita flower in Northern Plains. He groups it with other Southern Border Gu that are under region suppression there.",
        "chapters": [
          516
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "northern-plains-copies",
        "text_origin": "source_excerpt",
        "mentions": [
          "reg_northern_plains",
          "reg_southern_border"
        ]
      },
      {
        "text": "Hei tribe exchange goods later include a rank four Tusita flower among many rank four Gu.",
        "chapters": [
          517
        ],
