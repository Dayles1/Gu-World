  "history": {
    "claims": [
      {
        "text": "At Ge tribe’s camp in Northern Plains, Fang Yuan first sees House Lizard Gu as the ordinary Gu Master dwelling after the mortal tent ring.",
        "chapters": [
          439
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "cross_checked_chapter_summary",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "fac_ge_tribe",
          "reg_northern_plains",
          "char_fang_yuan",
          "sys_gu_master"
        ]
      },
      {
        "text": "Large lizard house Gu is advanced from the rank two lizard house Gu. The lizard house Gu is already large as a bus and like a four-legged lizard on the outside. Large lizard house Gu is like a two-storey building, its body five times the size of a lizard house Gu.",
        "chapters": [
          507
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "large-lizard-body",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_large_lizard_house_gu"
        ]
      },
      {
        "text": "Large lizard house Gu is rank three, advanced from the rank two form. The rank two body is already bus-sized with a central passage and side rooms; the large form is about five times that size, built like a two-storey building with more rooms and space.",
        "chapters": [
          507
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "larger-form",
        "text_origin": "source_excerpt"
      }
    ]
