  "claims": [
    {
      "text": "At a Zombie Alliance mission meeting, Yin Liu Gong notes that the remuneration for the request is quite a sum. Yao Huang is one of the five great rank eight Gu Immortals in Northern Plains.",
      "chapters": [
        742
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "mission-meeting",
      "text_origin": "source_excerpt",
      "mentions": [
        "fac_zombie_alliance",
        "char_yin_liu_gong",
        "char_yao_huang",
        "sys_gu_immortal",
        "reg_northern_plains"
      ]
    },
    {
      "text": "Yao Huang is a healing Gu Immortal of the righteous path with pure Huang Jin bloodline, first supreme elder of the super force Yao tribe, and holds the highest reputation among Northern Plains’ five rank eight Gu Immortals. Among those five he is a rank eight of the righteous path; Old Ancestor Xue Hu is the demonic path leader of Snowy Mountain; Prince Feng Xian is also righteous, so two of the five are righteous, one demonic, and two neutral. At the auction he thanks Yin Liu Gong that an immortal zombie has come to Yao tribe.",
      "chapters": [
        749
      ],
      "certainty": "canon",
      "confidence": "B",
