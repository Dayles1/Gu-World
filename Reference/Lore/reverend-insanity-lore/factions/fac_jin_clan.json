  "claims": [
    {
      "text": "Jin clan Gu Masters wear uniforms like Qing Mao mountain attire: short sleeves, long pants, belts, leg wrappings, and green bamboo shoes. Some use golden rope as leg wrappings, and belts, cloth cuffs, or pants are rimmed in gold as Huang Jin mountain’s characteristic mark. In the temporary market, Jin clansmen also sell golden statues and tools, and people on the mountain even poor slaves wear golden rings and necklaces, with girls’ hairpins, earrings, and bracelets shining with golden luster.",
      "chapters": [
        242
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "appearance",
