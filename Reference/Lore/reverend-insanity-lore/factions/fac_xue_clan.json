  "claims": [
    {
      "text": "Qi Zai says that among the Heaven Surveying Five Xiangs’ descendants over the last few thousand years, Xue Xiang’s descendants cultivate blood path and are almost wiped out, while Qi clan is the most prosperous of those lines.",
      "chapters": [
        1035
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "blood-path-line",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_qi_zai",
        "fac_heaven_surveying_five_xiangs",
        "char_xue_xiang",
        "fac_qi_clan"
      ]
    },
    {
      "text": "Fang Yuan later assigns Xue Xiang blood path among the Five Xiangs’ paths, with Qi Xiang, Bai Xiang, Ni Xiang, and Chi Xiang in qi path, ice path, earth path, and food path.",
      "chapters": [
        1637
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "blood-path-line",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_fang_yuan",
        "char_qi_xiang",
        "char_ni_xiang",
        "char_chi_xiang"
      ]
    },
    {
      "text": "When the Five Xiangs gatehouse shines in five colors, the red light is Xue Xiang’s Xue clan. Because that line cultivated blood path and had been wiped out, the red light fades after shining around the place.",
      "chapters": [
        1636
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "gatehouse-red-light",
      "text_origin": "source_excerpt"
    },
    {
      "text": "When Hei Lou Lan approaches the gatehouse, red light surrounds her and fades rapidly, acknowledging her identity. Qi clan Gu Immortals ask whether she is really a descendant of Xue Xiang’s Xue clan.",
      "chapters": [
        1814
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
