  "claims": [
    {
      "text": "No chapter describes an alliance banner or seat of its own. Members step forward under drum sounds and accept information path dao marks to join.",
      "chapters": [
        1146
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
