  "claims": [
    {
      "text": "Shen Cong Sheng weighs whether to cooperate with Fang Yuan against the risk of facing an equivalent Eastern Sea super force, naming Xie clan with Cai clan, Hua clan, Tang clan, and even Song clan as examples of such neighbors.",
      "chapters": [
        1910
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "shen-clan-rival-list",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_shen_cong_sheng",
        "char_fang_yuan",
        "reg_eastern_sea",
        "fac_hua_clan",
        "fac_tang_clan",
        "fac_song_clan"
      ]
    },
    {
      "text": "Xia clan sits at the easternmost area of Eastern Sea. Toward its northeast is Xie clan. Xia clan treats Xie clan and Tang clan as poor targets for help because those two clans have conflict with Xia clan in ordinary times, and Xia clan Gu Immortals do not want to face their mockery.",
      "chapters": [
        1985
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "seat-beside-xia-clan",
      "text_origin": "source_excerpt",
      "mentions": [
        "fac_xia_clan",
        "sys_gu_immortal"
      ]
    },
    {
      "text": "When an Eastern Sea alliance army moves against the variant human alliance, Xie clan’s first supreme elder personally takes part in the battle alongside Shen clan’s first supreme elder Shen Cong Sheng and Tang clan’s first supreme elder.",
      "chapters": [
        2069
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "alliance-army-elder",
      "text_origin": "source_excerpt",
      "mentions": [
        "fac_shen_clan"
      ]
    },
    {
      "text": "To resolve an ant plague under Qi Sea Ancestor, Eastern Sea clans contribute true inheritances. Xie clan takes out remnant leaves true inheritance.",
      "chapters": [
        2105
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "contributes-a-true-inheritance",
