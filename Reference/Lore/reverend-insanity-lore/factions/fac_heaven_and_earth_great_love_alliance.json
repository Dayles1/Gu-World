  "claims": [
    {
      "text": "Fang Yuan names himself Great Love Immortal Venerable. Eastern Sea’s righteous path Gu Immortals, led by Shen Shang and Lu Wei Yin, are told they have already joined and will receive greater preferential treatment as the first batch.",
      "chapters": [
        2219
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "first-members",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_fang_yuan",
        "fac_eastern_sea_righteous_path",
        "sys_gu_immortal",
        "char_shen_shang",
        "char_lu_wei_yin"
      ]
    },
    {
      "text": "Under Fang Di Chang’s suggestion, Western Desert’s Fang clan declares that it is joining.",
      "chapters": [
        2245
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "super-force-members",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_fang_di_chang",
        "reg_western_desert",
        "fac_fang_clan"
      ]
    },
    {
      "text": "Fang Yuan allows any super force to join, and members can transact secretly for benefits.",
      "chapters": [
        2250
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "membership-access",
      "text_origin": "source_excerpt"
    },
    {
      "text": "Eastern Sea Gu Immortals accept strict alliance agreements on entry, while Gu Immortals of the other four regions receive extremely relaxed agreements with almost no bindings.",
      "chapters": [
        2251
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "regional-agreements",
      "text_origin": "source_excerpt",
      "mentions": [
        "reg_eastern_sea"
      ]
    },
    {
      "text": "Fang Yuan declares the alliance open to everyone, abolishes restrictive agreements, and lets people join or leave at any time. Joining requires a membership fee, which converts into contribution points. Members receive a twenty percent discount on Gu refinement requests. He still refines Gu for those who do not join, with fair transactions.",
      "chapters": [
        2275
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "membership-terms",
      "text_origin": "source_excerpt"
    },
    {
      "text": "Han Cai Xin asks Bai Qing whether they can join. Membership fees are resource points, and a single person’s fee differs from a super force’s fee.",
      "chapters": [
        2276
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "membership-fees",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_han_cai_xin",
        "char_fairy_bai_qing"
      ]
    }
  ],
