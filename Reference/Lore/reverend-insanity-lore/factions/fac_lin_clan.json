      "mentions": [
        "char_chen_shuang_jin"
      ]
    },
    {
      "text": "After the white feather flying elephant rampage, survivors gather: Jia clan and Chen Clan are the strongest groups and still deep in losses, while Lin clan has only three Gu Masters left and some other clans’ groups are wiped out entirely.",
      "chapters": [
        248
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
