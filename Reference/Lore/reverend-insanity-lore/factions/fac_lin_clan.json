  "claims": [
    {
      "text": "When Jia Long and Chen vice leader Chen Shuang Jin argue over who must hold the first line of defense, Lin clan’s vice leader walks over and advises that it is not the time for arguments.",
      "chapters": [
        247
      ],
      "certainty": "canon",
