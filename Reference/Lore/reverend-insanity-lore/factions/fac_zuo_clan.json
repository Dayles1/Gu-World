  "claims": [
    {
      "text": "San Cha Mountain sits between Zuo clan ground and Che Clan’s Fei Lai mountain. Zuo clan has six hundred years of history. Che and Zuo are mortal enemies with centuries of hatred, and for the past hundred years both have expanded and fought to occupy San Cha mountain.",
      "chapters": [
        323
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "battle-over-san-cha-mountain",
      "text_origin": "source_excerpt",
      "mentions": [
        "loc_san_cha_mountain",
        "fac_che_clan",
        "loc_fei_lai_mountain"
      ]
    },
    {
      "text": "Sources conflict:",
      "chapters": [],
      "certainty": "inferred",
      "confidence": "C",
      "verification": "no_citation",
      "source_id": "src_sagaofgu",
