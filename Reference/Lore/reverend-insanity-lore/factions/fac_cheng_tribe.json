  "claims": [
    {
      "text": "At a Ma tribe higher-ups discussion for Tian Chuan’s heroes assembly, Ma Ying Jie argues that subjugating Cheng tribe would give Ma tribe a strong lead. The same talk turns to surveying Yu Tian, Meng Qiu, and Cao Fu assemblies as well.",
      "chapters": [
        489
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "heroes-assembly-council",
      "text_origin": "source_excerpt",
