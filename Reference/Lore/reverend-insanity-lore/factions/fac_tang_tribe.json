  "claims": [
    {
      "text": "Tang Fang pours primeval essence into fire pellet Gu as night wolves press in, but a Tang tribe elder blocks his charge and pulls him back, naming him the tribe’s third young master and a rank three genius at twenty two. The elder then tells him to flee when Wang Jiang appears, recalling that Tang tribe took Wang Jiang’s fiance Luo Yu Feng.",
      "chapters": [
        509
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "wang-jiang-on-the-field",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_tang_fang",
        "gu_fire_pellet_gu",
        "char_wang_jiang",
        "char_luo_yu_feng"
      ]
    },
    {
      "text": "Before Hei tribe can send Pan Ping, Dong Fang Yu Liang sends Tang Miao Ming forward to challenge Wolf King. She means to force a small fox-group duel, then loses focus when Pan Ping charges; her rotating round fox formation collapses and he captures her.",
      "chapters": [
        509
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "fox-challenge",
      "text_origin": "source_excerpt",
      "mentions": [
        "fac_hei_tribe",
        "char_dong_fang_yu_liang",
        "char_tang_miao_ming",
        "char_pan_ping"
      ]
    },
    {
      "text": "Tang tribe always prioritized fire path Gu worms, which is why Wang Jiang bought rank four swallow fire Gu to use against them.",
      "chapters": [
        510
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "fire-path-gu",
      "text_origin": "source_excerpt",
      "mentions": [
        "sys_gu_worms"
      ]
    },
    {
      "text": "Tang tribe leader Tang You had been bedridden after two Hei tribe Gu Masters wounded him while he protected tribesmen. Dong Fang Yu Liang orders him to fight; Tang You accepts for the tribe’s standing and meets Pan Ping, who beheads him and raises the head as Tang You.",
      "chapters": [
        518
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "challenge-at-the-wall",
      "text_origin": "source_excerpt",
      "mentions": [
        "fac_gu_masters"
      ]
    },
    {
      "text": "Inside Imperial Court blessed land, Tang Miao Ming names Tang Fang Tang tribe’s tribe leader, says the tribe suffered heavily in the contest and was almost swallowed, and presses him to rebuild through Eighty-Eight True Yang Building.",
      "chapters": [
        567
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "true-yang-building-talk",
      "text_origin": "source_excerpt",
      "mentions": [
        "loc_imperial_court_blessed_land",
        "house_eighty_eight_true_yang_building"
      ]
    }
  ],
