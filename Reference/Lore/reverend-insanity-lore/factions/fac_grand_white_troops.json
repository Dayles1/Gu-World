      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "appearance",
      "text_origin": "source_excerpt"
    },
    {
      "text": "Liu Wen Wu pairs his tribe’s grand white troops with Hei tribe’s black banner as forces of similar fame whose competition has run for hundreds of years. Early in the same battle only the black banner elite troops and grand white elite are left controlling the area as each side’s remaining trump cards.",
      "chapters": [
        532
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
