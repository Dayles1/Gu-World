  "claims": [
    {
      "text": "On a collapsing battlefield, Luo tribe’s higher ranked Gu Masters beg alliance leader Luo Bo Jun to retreat, but he answers that there is nowhere left to withdraw because this is already the tribe’s last defense line. Since the fight with Liu Wen Wu began, none of Luo tribe’s defense lines had held for more than three days, and Luo Bo Jun himself remained heavily injured from an earlier clash with Liu Wen Wu, Mo Shi Kuang, and others.",
      "chapters": [
        523
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
