  "claims": [
    {
      "text": "Bei Cao Sheng tells Wang tribe that Ge tribe has exterminated Yan Tribe.",
      "chapters": [
        477
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "three-tribe-alliance",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_bei_cao_sheng",
        "fac_wang_tribe",
        "fac_ge_tribe",
        "fac_yan_tribe"
      ]
    },
    {
      "text": "Survivors who escaped Yan tribe go to Bei tribe for protection, so Bei tribe learns how the larger force was swallowed.",
      "chapters": [
        478
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "three-tribe-alliance",
      "text_origin": "source_excerpt"
    },
    {
      "text": "Bei Cao Sheng is Bei tribe’s political advisor in that talk. He also names Bei tribe’s forest soldier corps as a known enslavement-path force that can face Chang Shan Yin. Wang De Dao classes Bei, Pei, and Zheng tribe as three mid scale tribes.",
      "chapters": [
        478
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "three-tribe-alliance",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_chang_shan_yin",
        "char_wang_de_dao",
        "fac_zheng_tribe"
      ]
    },
    {
      "text": "Ge tribe elders later call Bei tribe middle-sized with two enslavement path Gu Masters.",
      "chapters": [
        479
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "three-tribe-alliance",
      "text_origin": "source_excerpt",
      "mentions": [
        "fac_gu_masters"
      ]
    },
    {
      "text": "Night assault on Bei tribe camp and Ge tribe’s onward move.",
      "chapters": [],
      "certainty": "inferred",
      "confidence": "C",
      "verification": "no_citation",
      "source_id": "src_sagaofgu",
      "section": "camp-assault",
      "text_origin": "source_excerpt"
    },
    {
      "text": "Fang Yuan chooses Bei tribe first because its camp is closest, then means to strike Zheng tribe and Pei tribe after. Bei tribe camp sits on a cleared mound behind a tall wall with lit observation towers and wooden spikes.",
      "chapters": [
        479
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "camp-assault",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_fang_yuan",
        "fac_pei_tribe"
      ]
    },
    {
      "text": "Ge tribe crushes Bei tribe and keeps moving toward Zheng tribe without stopping.",
      "chapters": [
        480
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "camp-assault",
      "text_origin": "source_excerpt"
    },
    {
      "text": "Remnant Bei tribe higher-ups escape and watch Zheng tribe fall. Their leader is Bei Cao Chuan, a rank four Gu Master who had expanded Bei tribe after becoming tribe leader. He refuses a quick raid to reclaim the camp or burn Ge tribe rations, arguing that only killing Chang Shan Yin can overturn the situation while captives still live under Ge tribe.",
      "chapters": [
        481
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "remaining-leadership",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_bei_cao_chuan",
        "sys_gu_master"
      ]
    }
  ],
