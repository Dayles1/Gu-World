  "claims": [
    {
      "text": "On San Cha Mountain, the three kings inheritance opens again and draws southern border Gu Masters as experts gather. Talk spreads that Li Fei Le arrived the day before, and listeners know him by the title sturdy as a mountain.",
      "chapters": [
        375
      ],
      "certainty": "canon",
