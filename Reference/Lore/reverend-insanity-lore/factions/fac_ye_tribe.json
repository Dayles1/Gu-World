  "claims": [
    {
      "text": "The two camps at Yu Tian pull apart carefully toward their main camps because other powers still sit outside the assembly.",
      "chapters": [
        499
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "camp-split-at-yu-tian",
      "text_origin": "source_excerpt",
      "mentions": [
        "loc_yu_tian"
      ]
    },
    {
      "text": "After Fang Yuan teams with Hei Lou Lan under the Chang Shan Yin name, undecided large tribes speak in turn. Wang tribe asks to join, Fang tribe bets on Hei Lou Lan, and Ye tribe answers that it is willing to submit to Hei Tribe. With the wolf group as vanguard, a large portion of Yu Tian heroes assembly takes Hei’s side.",
      "chapters": [
        499
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "choice-cascade",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_fang_yuan",
        "char_hei_lou_lan",
        "char_chang_shan_yin",
        "fac_wang_tribe",
        "fac_fang_tribe",
        "fac_hei_tribe"
      ]
    },
    {
      "text": "In the alliance main tent, after Fang Yuan’s seat, the leaders of the large tribes Wang tribe, Fang tribe, and Ye tribe sit next.",
      "chapters": [
        500
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "alliance-seat",
      "text_origin": "source_excerpt"
    },
    {
      "text": "Ye tribe leader rides with Hei Lou Lan, Fang Yuan, and other experts on the twin-headed rhino that carries the main tent.",
      "chapters": [
        508
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "marching-tent",
      "text_origin": "source_excerpt"
    },
    {
      "text": "When Dong Fang Yu Liang’s star thought cloud breaks Hei tribe’s blue butterfly elite troop, Ye tribe leader cries out for that elite troop as his own.",
      "chapters": [
        513
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
