      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "court-as-actor",
      "text_origin": "source_excerpt"
    },
    {
      "text": "Duke Long tells Purple Mountain True Monarch that his Heavenly Court was guided by Star Constellation heaven’s will to learn the condition and location of Spectral Soul’s main body.",
      "chapters": [
        1372
      ],
      "certainty": "canon",
