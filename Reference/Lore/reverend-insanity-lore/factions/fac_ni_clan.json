  "claims": [
    {
      "text": "At Ni clan village, Ni Jian names earth path as the clan specialty when he resists his grandfather’s push away from sword path. That grandfather is Ni Kun, the current leader and a rank five Gu Master.",
      "chapters": [
        1034
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "earth-path-specialty",
      "text_origin": "source_excerpt",
      "mentions": [
        "loc_ni_clan_village",
        "char_ni_jian",
        "char_ni_kun",
        "sys_gu_master"
      ]
    },
    {
      "text": "Qi Zai places Ni Xiang’s descendants among several Southern Border branches and says Ni clan no longer has Gu Immortals. He names Ni Ren as the last Ni clan Gu Immortal, a refinement path talent who refined chosen Immortal Gu into descendants’ bloodlines.",
      "chapters": [
        1035
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "immortal-status",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_qi_zai",
        "char_ni_xiang",
        "reg_southern_border",
        "sys_gu_immortal",
        "char_ni_ren",
        "sys_immortal_gu"
      ]
    },
    {
      "text": "Once in a while a Ni clan Gu Master who survives bloodline awakening grows an Immortal Gu inside the body. The first such Immortal Gu is the information path Immortal Gu Yes or No. It answers only yes or no from heaven and earth, and each answer costs the user fifty years of lifespan. The mortal who bears it is called the current generation Ni Xiang.",
      "chapters": [
        1036
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "bloodline-awakening",
      "text_origin": "source_excerpt",
      "mentions": [
        "gu_yes_or_no_immortal_gu"
      ]
    }
  ],
