  "claims": [
    {
      "text": "No chapter describes a guild hall or uniform. Membership is bought by registration after a Gu Master fuses with a wild beast or plant and becomes a Combat Beast Envoy candidate.",
      "chapters": [
        1824
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "appearance",
      "text_origin": "source_excerpt",
      "mentions": [
        "sys_gu_master"
      ]
    },
    {
      "text": "Inside Beast Calamity grotto-heaven, the Combat Beast Guild is the largest and sole super force. The lowest ranking membership is Combat Beast Disciple. Above that are Combat Beast Envoys, the guild’s main forces. Above Envoy is Combat Beast Warrior, which needs Gu Immortal cultivation and is mostly held by city lords. Above Warrior is the one and only Combat Beast King. The structure is simple and crude. Zhan Bu Du plans to join it to receive missions and raise strength rapidly.",
      "chapters": [
        1824
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "appearance",
      "text_origin": "source_excerpt",
      "mentions": [
        "loc_beast_calamity_grotto_heaven",
        "sys_gu_immortal",
        "char_combat_beast_king",
        "char_zhan_bu_du"
      ]
    },
    {
      "text": "Little Du has just become a Gu Immortal and is a new Combat Beast Warrior, the youngest one in the Combat Beast Guild.",
