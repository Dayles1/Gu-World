  "claims": [
    {
      "text": "During the Refinement Path Convention, Fang Yuan throws a boar soul, a goat soul, and a human soul into ghost fire while refining ghost fire Gu. Burning a human soul in public to refine Gu draws outrage from the righteous Flying Frost Sect, which still cannot stop him under convention rules.",
      "chapters": [
        831
      ],
