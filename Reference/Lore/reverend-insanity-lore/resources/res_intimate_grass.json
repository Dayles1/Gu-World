  "claims": [
    {
      "text": "At Qing Mao Mountain’s temporary market, vendors sell Intimate Grass at two primeval stones per catty, hawking it as fresh and high quality. Each blade is about a meter long and slender, roughly a fingernail wide, with red heart-shaped flower buds on some pointed tips. It is a Gu worm’s supplementary food type, used to pair with other feeds. Mixed with Moonlight Gu’s meal, one blade of Intimate Grass lets the Gu be full from a single moon orchid petal instead of two, which is cheaper than feeding petals alone. Fang Yuan has stones enough to buy it but no time, as the stall is crowded with Gu Masters and students.",
      "chapters": [
        39
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "caravan-stalls",
      "text_origin": "source_excerpt",
      "mentions": [
        "loc_qing_mao_mountain",
        "sys_gu_worms",
        "gu_moonlight_gu",
        "char_fang_yuan",
        "fac_gu_masters"
      ]
    },
    {
      "text": "The next day the Intimate Grass cart is empty. Fang Yuan regrets missing a few catty that would have saved primeval stones.",
      "chapters": [
        44
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
