  "claims": [
    {
      "text": "In Dragon Whale Paradise, Fang Yuan asks Shen Cong Sheng for a portion of constant wave sound in exchange for explaining how he gained many merit points. Shen Cong Sheng tosses him a palm-sized conch that is itself a desolate beast.",
      "chapters": [
        1895
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "shen-clan-specialty",
      "text_origin": "source_excerpt",
      "mentions": [
        "loc_dragon_whale_paradise",
        "char_fang_yuan",
        "char_shen_cong_sheng"
      ]
    },
    {
      "text": "A wave sound stored in the conch is a sound path rank seven immortal material and a specialty product of Shen clan; it can produce sounds for years without stopping. Fang Yuan inspects it, finds nothing suspicious, and places the immortal material in his sovereign immortal aperture.",
      "chapters": [
        1895
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "shen-clan-specialty",
      "text_origin": "source_excerpt",
      "mentions": [
        "fac_shen_clan"
      ]
    },
    {
      "text": "Shen clan’s constant wave sound is unique in the world. After Fang Yuan’s answer, Shen Xiao notes that one answer earned him a rank seven immortal material unique to Shen clan, and Shen Cong Sheng later says Fang Yuan obtained the constant wave sound through his wits.",
      "chapters": [
        1895
      ],
