  "claims": [
    {
      "text": "Central Continent’s earth qi rock forest produces a vast amount of earth path cultivation resources, including round kun stone. Round kun stone has never been sold in large numbers in treasure yellow heaven, because the site belongs to one of Central Continent’s ten great ancient sects and they need the stone themselves.",
      "chapters": [
        1705
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "earth-qi-rock-forest",
      "text_origin": "source_excerpt",
      "mentions": [
        "reg_central_continent",
        "fac_ten_great_ancient_sects"
      ]
    },
    {
      "text": "Western Desert earth path Gu Immortal Shi Gan Dang fails to buy it even at raised prices, then destroys the forest’s protecting formation and takes all of the immortal materials there, including round kun stones, into his immortal aperture.",
      "chapters": [
        1705
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "earth-qi-rock-forest",
      "text_origin": "source_excerpt",
      "mentions": [
        "reg_western_desert",
        "sys_gu_immortal"
      ]
    },
    {
      "text": "Shi Gan Dang’s destruction of the earth qi rock forest and haul of round kun stones is recalled when Western Desert’s actions against Central Continent resources are listed.",
      "chapters": [
        1921
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "shi-gan-dang-haul",
      "text_origin": "source_excerpt"
    },
    {
      "text": "Round kun stone appears among earth path immortal materials such as diamond soil, impermanence rock, smoky warm jade, and eight-parts jade.",
