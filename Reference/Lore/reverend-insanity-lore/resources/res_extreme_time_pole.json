  "claims": [
    {
      "text": "Extreme time pole is a rank eight time path immortal material, extremely rare. Miao Ming Shen obtained it long ago at great cost and could not bear to sell it. Immortal materials at rank eight are usually exclusively traded with each other.",
      "chapters": [
        1648
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "rank-eight-time-material",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_miao_ming_shen",
        "sys_immortal_material"
      ]
    },
    {
      "text": "When Heavenly Court and Southern Border buy out time path immortal materials, those materials rise sharply in price. Offering the extreme time pole draws Heavenly Court’s notice and can secure underworld yellow water in trade.",
      "chapters": [
        1648
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "rank-eight-time-material",
      "text_origin": "source_excerpt",
      "mentions": [
        "fac_heavenly_court",
        "reg_southern_border"
      ]
    },
    {
      "text": "Miao Ming Shen uses the extreme time pole in treasure yellow heaven to exchange for underworld yellow water to cleanse ice poison starfish poison. The trade succeeds more readily than in the previous life because Heavenly Court buys time path immortal materials frantically after losses in the River of Time.",
