  "claims": [
    {
      "text": "Like the spring dream fruit tree, luck path immortal materials have a special trait: if the material is living, it must stay alive, and refining the luck path Immortal Gu then requires a living refinement.",
      "chapters": [
        1284
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "living-refinement-trait",
      "text_origin": "source_excerpt",
      "mentions": [
        "sys_immortal_gu"
      ]
    },
    {
      "text": "Luck path immortal materials are rare and hard to gather. Fang Yuan turns to Southern Border’s righteous path to obtain them, and once gathered he has hairy man Gu Immortals begin refining luck path Immortal Gu.",
      "chapters": [
        1809
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "rare-and-hard-to-gather",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_fang_yuan",
        "reg_southern_border",
        "sys_gu_immortal"
      ]
    },
    {
      "text": "While sorting immortal materials from variant human Gu Immortals, Fang Yuan finds luck path immortal materials at an astonishing scale. He judges them highly valuable for advancing luck path Immortal Gu beyond Cooking Luck Pot.",
      "chapters": [
        2073
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "variant-human-haul",
      "text_origin": "source_excerpt",
      "mentions": [
        "house_cooking_luck_pot"
      ]
    },
    {
      "text": "Because luck path is not prosperous, luck path immortal materials are difficult to gather. Fang Yuan notes that looting so many from the two heavens’ grotto-heavens is not something that happens frequently. A higher refinement success rate lowers expenditure and saves large amounts of those materials.",
      "chapters": [
        2080
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "scarcity-of-the-path",
      "text_origin": "source_excerpt"
    }
  ],
