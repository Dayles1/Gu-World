  "claims": [
    {
      "text": "Lang Ya land spirit processes over ten rank eight immortal materials that are all of information path, including elephant armor mountain crushed to fine powder by rank eight slumbering lightning python. Under his methods that powder gathers with the other processed materials and forms a constantly rotating multicolored whirlpool.",
      "chapters": [
        1562
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
