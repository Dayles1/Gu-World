  "claims": [
    {
      "text": "One of the four entry tasks for a Refinement Path Convention requires refining earth treasury flower Gu. The third last step uses upstream grass matched with zen lion’s mane, together with the Gu refinement method.",
      "chapters": [
        828
      ],
      "certainty": "canon",
