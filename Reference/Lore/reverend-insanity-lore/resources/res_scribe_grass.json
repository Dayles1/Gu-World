  "claims": [
    {
      "text": "Inside a giant space-path Gu formation with yellow sky and purple sand ground, Fang Yuan names scribe grass among dozens of immortal materials at a glance, together with nutrient peaches, immortal beans, and blood tide flowers.",
      "chapters": [
        934
      ],
      "certainty": "canon",
