    },
    {
      "text": "When the Evil Dragon shatters them, they turn into strong qi currents that intertwine and attack from all directions. Sharp blade qi, black hard qi, dark death qi, and other sorts of qi currents there are all at rank eight level.",
      "chapters": [
        1999
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "rank-eight-currents",
