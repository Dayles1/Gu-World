  "claims": [
    {
      "text": "Doctor Yin Xuan first offers warehouse earth shell snail mucus: fluid left as the desolate beast earth shell snail crawls, with two or three portions in stock. Fang Yuan rejects that stock and names what he needs as earth shell snail star night mucus, not ordinary mucus.",
      "chapters": [
        930
      ],
