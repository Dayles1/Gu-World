  "claims": [
    {
      "text": "After sword lights cut Falling Heavenly River, Fairy Bai Qing gathers branches and roots of ancient desolate plants and immemorial desolate plants along with beast corpses. Those gathers are excellent Gu refinement materials until more beasts drive her off.",
      "chapters": [
        957
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "harvested-with-ancient-plants",
      "text_origin": "source_excerpt",
      "mentions": [
        "loc_falling_heavenly_river",
        "char_fairy_bai_qing"
      ]
    },
    {
      "text": "Floating immortal materials on Falling Heavenly River are mostly from ancient desolate beasts and desolate plants, with a few of immemorial desolate level among them. Those immemorial desolate level pieces are rank eight immortal materials, small in quantity and of immense value.",
      "chapters": [
        994
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "rank-eight-material-tier",
      "text_origin": "source_excerpt"
    },
    {
      "text": "The thousand snakes haze tree in Tai Qiu is an immemorial desolate plant with battle strength rivaling rank eight Gu Immortals. Even the weakest rank eight being is beyond Fang Yuan’s strength at that time, so the living tree blocks Lang Ya Sect’s planned formation site.",
      "chapters": [
        1088
      ],
