  "claims": [
    {
      "text": "Perceivable Dao is an information path Immortal Gu. When it inspects purely information path immortal materials, immortal essence expenditure is lower than for other immortal materials, because other types carry conflicting dao marks.",
      "chapters": [
        1161
      ],
      "certainty": "canon",
      "confidence": "B",
