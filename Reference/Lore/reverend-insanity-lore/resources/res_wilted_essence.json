  "claims": [
    {
      "text": "Gu Ye, the hollow Old Earth City Lord posted at old earth wood, names wilted essence as the wood path resource that still draws interest to the ruined wooden city. Divine Lord Tian Du and Shi Hou coerce him into selling one hundred and fifty kilograms of wilted essence for one immortal essence stone.",
      "chapters": [
        738
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "extortion-forces-a-sale",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_gu_ye",
        "char_divine_lord_tian_du",
        "char_shi_hou"
      ]
    },
    {
      "text": "That single immortal essence stone is recorded as the price paid for the hundred and fifty kilograms of wilted essence.",
      "chapters": [
        739
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "coerced-price",
      "text_origin": "source_excerpt"
    },
    {
      "text": "The same forced purchase is remembered later: the lightning path immortal and Shi Hou once coerced a Zombie Alliance immortal zombie into selling one hundred and fifty kilograms of wilted essence for one immortal essence stone.",
