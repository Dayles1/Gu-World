  "claims": [
    {
      "text": "Feng Jiu Ge writes to Chu Du offering to fund a bid for cauldron strength Immortal Gu if Chu Du will sell the immortal material true heaven silver. Chu Du obtained three hundred kilograms of true heaven silver while exploring white heaven, and judges it extremely rare even in treasure yellow heaven. He agrees to give detailed information on the exact location of true heaven silver after the event.",
      "chapters": [
        755
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "white-heaven-haul",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_feng_jiu_ge",
        "char_chu_du",
        "sys_immortal_gu"
      ]
    },
    {
      "text": "Feng Jiu Ge’s claim that he wants Chu Du’s true heaven silver is a lie used to explain the help; Chu Du and others still read the funding as tied to that three hundred kilograms.",
      "chapters": [
        756
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "cover-for-funding",
      "text_origin": "source_excerpt"
    },
    {
      "text": "Chu Du does not freely tell outsiders the silver’s location, partly because the matter would cost reputation and partly because he believes Feng Jiu Ge truly wants the true heaven silver.",
      "chapters": [
        757
      ],
