  "claims": [
    {
      "text": "Doctor Yin Xuan identifies the fluid as what the desolate beast earth shell snail leaves while it slowly crawls on the ground. Dark Flow Giant City’s warehouse number six holds two or three portions in stock, and he offers that warehouse mucus for Fang Yuan’s request. The fluid must be sealed and stored within ten breaths, or it dries up and loses its effect.",
      "chapters": [
        930
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "ordinary-crawl-fluid",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_doctor_yin_xuan",
        "loc_dark_flow_giant_city",
        "char_fang_yuan"
      ]
    },
    {
      "text": "Fang Yuan rejects the warehouse stock because he needs earth shell snail star night mucus, not ordinary mucus. Star night mucus is produced by processing ordinary mucus on the spot with his special methods: processing takes seven breaths, and sealing after that must finish within three breaths. Because of that window, he insists on entering Earth Trench rather than relying on stored ordinary mucus.",
      "chapters": [
        930
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "not-star-night-mucus",
      "text_origin": "source_excerpt",
      "mentions": [
        "res_star_night_mucus",
        "reg_earth_earth_trench"
      ]
    },
    {
      "text": "Earth shell snails are desolate beasts that live only in the depths of Earth Trench. Collecting the processed star night mucus means finding a snail, trailing it, and handling mucus on the spot under a short collection window.",
      "chapters": [
        931
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
