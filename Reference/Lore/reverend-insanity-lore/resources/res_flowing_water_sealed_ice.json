  "claims": [
    {
      "text": "Fang Yuan draws from Hei Fan’s true inheritance a piece of almost transparent ice that seals year Gu in its upper portion so the Gu hibernates without leaking aura. At the bottom of the ice he finds flowing water: when he shakes it he sees the water move and hears a soft sound. The ice is large; year Gu occupies only a small portion, while the flowing water takes more than half the space below, as if the ice seals the water more than the Gu. Fang Yuan briefly guesses that the flowing water is a rank nine immortal material.",
      "chapters": [
        1129
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "sealed-flowing-water",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_fang_yuan",
