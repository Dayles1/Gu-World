  "claims": [
    {
      "text": "After Fang Yuan’s rank six strength path dead aperture crumbles, the strength path dao marks move into his physical body. From that perspective his strength path immortal zombie is a genuine rank six strength path immortal material.",
      "chapters": [
        1446
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "body-as-material",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_fang_yuan"
      ]
    },
    {
      "text": "Immortal killer move eat strength expends strength path immortal materials, with snack Immortal Gu as the core, to increase the user’s strength path dao marks.",
      "chapters": [
        1465
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "eat-strength-expenditure",
      "text_origin": "source_excerpt",
      "mentions": [
        "move_eat_strength",
        "gu_snack_immortal_gu"
      ]
    },
    {
      "text": "Fang Yuan melts a rank six strength path immortal material with that move and transfers a small portion of its dao marks into himself.",
      "chapters": [
        1467
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "eat-strength-expenditure",
      "text_origin": "source_excerpt"
    },
    {
      "text": "Divine strength water contains strength path dao marks and is a rank six strength path immortal material in the market, even though it is a type of water.",
      "chapters": [
        1779
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "divine-strength-water",
      "text_origin": "source_excerpt",
      "mentions": [
        "res_divine_strength_water"
      ]
    },
    {
      "text": "Longevity Heaven supports Hei Lou Lan with an endless stream of strength path immortal materials while raising her aperture time flow. That abundant supply naturally attracts strength path calamities and tribulations.",
      "chapters": [
        2079
      ],
      "certainty": "canon",
