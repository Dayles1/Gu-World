  "claims": [
    {
      "text": "Electrolytic iron starflower is an information path and lightning path immortal material, personally grown by Central Continent Gu Immortal Mi Lan Guang, and something that had never appeared before. It is a special rank seven immortal material.",
      "chapters": [
        1744
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "grown-in-the-valley",
      "text_origin": "source_excerpt",
      "mentions": [
        "reg_central_continent",
        "sys_gu_immortal",
        "char_mi_lan_guang"
      ]
    },
    {
      "text": "Great Treasury Immortal, an Eastern Sea information path Gu Immortal, steals one flower to research it during Central Continent chaos, tipped off by Jian Yi Sheng. Mi Lan Guang says there are thirteen electrolytic iron starflowers in his valley; Great Treasury Immortal stole one, Jian Yi Sheng plucked three, and the rest were destroyed by sword path methods. Great Treasury Immortal digs one out along with its roots so it can be planted again.",
      "chapters": [
        1744
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "grown-in-the-valley",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_great_treasury_immortal",
        "reg_eastern_sea",
        "char_jian_yi_sheng"
      ]
    },
    {
      "text": "The starflower later serves as bait in a conspiracy that lures Great Treasury Immortal into a trap of Central Continent lone immortals and a formation.",
      "chapters": [
        1744
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "grown-in-the-valley",
      "text_origin": "source_excerpt"
    },
    {
      "text": "In a prior life recollection, an information path Gu Immortal invades Central Continent and steals Mi Lan Guang’s rank seven immortal material electrolytic iron starflower.",
      "chapters": [
        1884
      ],
      "certainty": "canon",
