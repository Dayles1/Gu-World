  "claims": [
    {
      "text": "In a star thought Immortal Gu refinement step, green beetle water lotuses are a water path immortal material while pale flame white bones are a fire path immortal material.",
      "chapters": [
        926
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "named-against-fire-path",
      "text_origin": "source_excerpt",
      "mentions": [
        "gu_star_thought_immortal_gu"
      ]
    },
    {
      "text": "Pearl thread water is a rank eight water path immortal material: clear water from which water threads and pearls can be pulled.",
      "chapters": [
        1791
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "rank-eight-example",
      "text_origin": "source_excerpt",
      "mentions": [
        "res_pearl_thread_water"
      ]
    },
    {
      "text": "Water path killer moves once used a large number of water path immortal materials in huge quantities. Because of the absurd cost, Gu Immortals later chose Gu worms instead and abandoned that method.",
      "chapters": [
        1817
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "former-killer-move-cost",
      "text_origin": "source_excerpt",
      "mentions": [
        "path_water",
        "sys_gu_immortal",
        "sys_gu_worms"
      ]
    },
    {
      "text": "Growing divine bean soldiers in Divine Bean Palace expends water path immortal materials and wood path immortal materials: water path to moisten the soil, wood path to raise growth speed.",
      "chapters": [
        1868
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "bean-soldier-expenditure",
      "text_origin": "source_excerpt",
      "mentions": [
        "house_divine_bean_palace"
      ]
    },
    {
      "text": "As Qi Sea Ancestor, Fang Yuan gives Song Yi Shi a rank eight water path immortal material at their first meeting, and she places it in her immortal aperture.",
      "chapters": [
        1882
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "rank-eight-gift",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_qi_sea_ancestor",
        "char_fang_yuan",
        "char_song_yi_shi"
      ]
    },
    {
      "text": "Interior Rain Mountain produces rank six immortal material interior rain and is a resource point that produces water path immortal materials until a myriad tribulation leaves it in ruins.",
      "chapters": [
        2050
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "resource-point-yield",
      "text_origin": "source_excerpt",
      "mentions": [
        "res_interior_rain"
      ]
    },
    {
      "text": "A water path formation with a rank seven water path Immortal Gu as core expends a batch of water path immortal materials in the main formation while placing a jade green water flow resource point.",
