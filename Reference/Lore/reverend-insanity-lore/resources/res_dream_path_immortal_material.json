  "claims": [
    {
      "text": "Ying Wu Xie treats nightmare demonic colts as dream path immortal materials and says they cannot be taken so easily after he sacrifices them.",
      "chapters": [
        1265
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "nightmare-demonic-colts",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_ying_wu_xie"
      ]
    },
    {
      "text": "Fang Yuan captures many nightmare demonic colts and uses these natural dream path immortal materials with persistent refinement to obtain very many dream path mortal Gu.",
      "chapters": [
        1324
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "natural-materials",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_fang_yuan",
        "sys_dream_path_mortal_gu"
      ]
    },
    {
      "text": "While exploring a dream realm, Fang Yuan has already expended his stock of nightmare demonic colt dream path immortal materials, so his uses of Unravel Dream are limited in number.",
      "chapters": [
        1335
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "nightmare-demonic-colt-material-exhausted",
      "text_origin": "source_excerpt",
      "mentions": [
        "move_unravel_dream"
      ]
    },
    {
      "text": "Dream path immortal materials are very rare, often buried in some corner and completely inconspicuous. Wu Shuai travels the five regions and two heavens searching for them after learning Dream Token is the core of rank eight Dragon Palace.",
      "chapters": [
        1844
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "rare-and-inconspicuous",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_wu_shuai",
        "gu_dream_token",
        "house_dragon_palace"
      ]
    },
    {
      "text": "Fang Yuan judges Meng Qiu Zhen’s dream path blessed land the best location to nurture dream path immortal material, with huge potential for development. A severe lack of dream path immortal materials has always troubled him.",
      "chapters": [
        2090
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "nurturing-ground",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_meng_qiu_zhen"
      ]
    },
    {
      "text": "Meng Zhen immortal aperture is the number one dream path Gu material production ground in the world, yet it can only produce rank six dream path immortal materials, and the quantity is pitifully small. Without sufficient dream path immortal materials, Fang Yuan cannot raise the ranks of his dream path Immortal Gu.",
      "chapters": [
        2097
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "rank-six-production-limit",
      "text_origin": "source_excerpt",
      "mentions": [
        "sys_immortal_gu"
      ]
    }
