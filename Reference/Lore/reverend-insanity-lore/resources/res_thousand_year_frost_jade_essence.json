  "claims": [
    {
      "text": "Frost jade essence inside frost jades is a rank six immortal material. Some essences are bigger, and thousand year frost jade essences are rank seven Gu materials. At Frosty Peak, almost every frost jade holds essence at its center; Fang Yuan takes the giant jades without first extracting it. Wu clan had preserved those frost jades as the peak’s foundation so the resource point would remain special.",
      "chapters": [
        1312
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "rank-seven-essence",
      "text_origin": "source_excerpt",
      "mentions": [
        "res_frost_jade_essence",
        "loc_frosty_peak",
        "char_fang_yuan",
        "fac_wu_clan"
      ]
    },
    {
      "text": "Fang Yuan obtains a large haul of frost jades and frost jade essence from Frosty Peak and considers building a Mini Frosty Peak in Mini Southern Border. He later sells frost jades and frost jade essences from that plunder, along with ice path mortal Gu, when funding dragonfish expansion.",
      "chapters": [
        1313
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
