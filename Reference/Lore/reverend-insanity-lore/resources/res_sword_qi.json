  "claims": [
    {
      "text": "In Qi Sea grotto-heaven, Bai Ning Bing sees life qi, death qi, sword qi, blade qi, dusk qi, and dawn qi gather into countless forms like plants, blades, swords, halberds, beasts, and birds before charging into battle. Life qi, death qi, blade qi, dusk qi, and dawn qi from that same naming are covered on life qi, death qi, blade qi, dusk qi, and dawn qi.",
      "chapters": [
        1643
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "qi-sea-forms",
      "text_origin": "source_excerpt",
