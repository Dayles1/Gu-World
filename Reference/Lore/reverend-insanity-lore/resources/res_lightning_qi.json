  "claims": [
    {
      "text": "Lightning qi can only be collected during stormy weather. Gathering it is not hard, but high ranked lightning qi immortal materials are very rare, and rank eight lightning qi is even rarer.",
      "chapters": [
        1999
      ],
      "certainty": "canon",
