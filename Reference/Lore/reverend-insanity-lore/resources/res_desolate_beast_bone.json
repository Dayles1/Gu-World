  "claims": [
    {
      "text": "Treasure yellow heaven occasionally sells the flesh, bones, and other parts of desolate beasts, but those lots appear infrequently and sell out within moments.",
      "chapters": [
        672
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "treasure-yellow-heaven-parts",
      "text_origin": "source_excerpt"
    },
    {
      "text": "In Northern Plains’ Bone Burial Field, most skeletons are pale white after flesh has decomposed, leaving the strong and tough bones of desolate beasts and ancient desolate beasts. Some bones show special colors, including yellow and purple stocks that emit poisonous gas. The field holds large numbers of desolate beast and ancient desolate beast corpses, and Liu tribe develops it as a production base for bone path Gu worms. Liu Yong picks suitable bones there to replenish the bone armor of his six desolate beast bone armor hounds, including a bone he judges to be from a desolate beast steel skin giant lizard.",
      "chapters": [
        1208
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "bone-burial-field-stock",
      "text_origin": "source_excerpt",
      "mentions": [
        "reg_northern_plains",
        "loc_bone_burial_field",
        "fac_liu_tribe",
        "sys_gu_worms",
        "char_liu_yong"
      ]
    },
    {
      "text": "Fang Yuan’s Bone Burial Field site holds a mountain of skeletons of many types, with lots of valuable immortal materials among them.",
      "chapters": [
        1291
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "immortal-material-corpses",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_fang_yuan"
      ]
    },
    {
      "text": "After annexing Han Dong’s blessed land, Fang Yuan’s Mini Northern Plains holds a bone burial field with lots of bone immortal materials.",
      "chapters": [
        1461
      ],
      "certainty": "canon",
      "confidence": "B",
