  "claims": [
    {
      "text": "Fan door wind is a rank seven immortal material. It does not grow in deep forests, mountains, or the sky; it grows in the doors of mortal homes. When it forms, the mortal’s door cannot close and can only stay open. That phenomenon draws Gu Masters and Gu Immortals to collect it. At first nobody understood its use, but later methods and plans make it usable.",
      "chapters": [
        1403
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "mortal-doorway-growth",
      "text_origin": "source_excerpt",
      "mentions": [
        "fac_gu_masters",
        "sys_gu_immortal"
      ]
    },
    {
      "text": "Lang Ya land spirit calls for five traces of fan door wind from inventory while refining Self Love Immortal Gu. Sixth Hair sends them into the center of ice fire, where they circle melting profound ice like five delicate hands until the attempt fails and the traces vanish with the broken profound ice.",
      "chapters": [
        1403
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "self-love-refinement",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_lang_ya_land_spirit",
        "gu_self_love_immortal_gu",
        "char_sixth_hair"
      ]
    },
    {
      "text": "Fan door wind is named as a special immortal material produced by humans and variant humans rather than wilderness nature. The rank seven material only grows on doors of mortal houses, and such material cannot be found in the wilderness.",
      "chapters": [
        1489
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "human-linked-specialty",
      "text_origin": "source_excerpt"
    },
    {
      "text": "Fang Yuan lists fan door wind among named winds when identifying what another wind is not.",
      "chapters": [
        1546
      ],
