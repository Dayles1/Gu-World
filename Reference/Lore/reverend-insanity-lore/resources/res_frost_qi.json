  "claims": [
    {
      "text": "Inside the sovereign immortal aperture’s Mini Northern Plains, Xue Er stands in the snow crystal formation and observes tens of frost qi lumps. After Fang Yuan annexes Qi Sea grotto-heaven, rising qi path dao marks drive a surge in frost qi at the snowman tribe, so every few months Xue Er must manipulate the formation and maintain it. If frost qi gathers beyond the limit, it turns into a frost tide that is a calamity for physically weak snowmen and can heavily damage Mini Northern Plains; regional walls keep that tide from the other mini regions.",
      "chapters": [
        1919
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
