  "claims": [
    {
      "text": "Heaven flying jade is a type of jade that can allow a person to fly in azure heaven of the immemorial nine heavens. The jade has mystical senses like a bird or beast and can avoid capture on its own.",
      "chapters": [
        753
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "azure-heaven-jade",
      "text_origin": "source_excerpt"
    },
    {
      "text": "An Eastern Sea Gu Immortal once entered a large azure heaven fragment world, obtained more than four hundred heaven flying jades while getting injured, and later offered three hundred and sixty of them at once in a bid for worldly wave trace Immortal Gu. That single offer fulfilled the amount on the seller’s list and marked him as a wealthy, determined rival.",
      "chapters": [
        753
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
