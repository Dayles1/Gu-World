  "claims": [
    {
      "text": "The immemorial desolate beast myriad eyes clear bull surfaces from Falling Heavenly River, named by Fairy Bai Qing as a riverbed overlord.",
      "chapters": [
        955
      ],
      "certainty": "canon",
      "confidence": "B",
