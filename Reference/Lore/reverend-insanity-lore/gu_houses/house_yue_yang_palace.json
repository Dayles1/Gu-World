        "house_frost_dragon_manor",
        "char_bai_ning_bing",
        "char_fang_yuan",
        "house_wind_sweeping_building"
      ]
    },
    {
      "text": "Ye Fan later names Yue Yang Palace among Immortal Gu Houses floating over Emperor City.",
      "chapters": [
        1931
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "emperor-city-listing",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_ye_fan"
      ]
    },
    {
      "text": "On Central Continent’s side, Yue Yang Palace shoots grand profound light that pierces the skies while Frost Dragon Manor and Wind Sweeping Building press the field.",
      "chapters": [
        1932
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
