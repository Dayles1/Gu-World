  "claims": [
    {
      "text": "Fairy Zi Wei says Reckless Savage Demon Venerable created the central path. It passes Immortal Emperor Court, Hidden Space Pavilion, Sumeru Lake, Eternal Sand Cave, Million Heavenly King Gallery, Embroidered Tower, Central Great Hall, and ends at Heaven Overseeing Tower.",
      "chapters": [
        1710
      ],
