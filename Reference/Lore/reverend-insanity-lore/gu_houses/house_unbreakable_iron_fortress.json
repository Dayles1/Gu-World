  "claims": [
    {
      "text": "At Yi Tian Mountain, after Fang Yuan in Graceful Chaotic Duel Stage repels Sacred Feather City, a second Immortal Gu House blocks his charge: entirely black with metallic luster, shaped as a fortress and treated as a battle fort forged with steel, less grand than Sacred Feather City. The houses deadlock; Fang Yuan judges the iron fortress house likely rank seven and specialized in defense, and that the delay costs him the Great Strength True Martial immortal zombie. Heaven Overseeing Tower Lord later names Unbreakable Iron Fortress among seven Shadow Sect Immortal Gu Houses forced onto the field by one Heaven Overseeing Tower move.",
      "chapters": [
        1004
      ],
      "certainty": "inferred",
      "confidence": "C",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
