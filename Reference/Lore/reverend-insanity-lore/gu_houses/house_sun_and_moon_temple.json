  "claims": [
    {
      "text": "At Spirit Affinity House headquarters in Central Continent, the temple floats on the clouds with Immortal Gu aura around it. Archway, main hall, and side halls form one body, and the house is one of the sect’s foundations. For Feng Jin Huang’s master-disciple ceremony with Duke Long it is taken out, set in the air, and activated so every corner and tile alternates between sun light and moon light on the surrounding clouds. In the main hall, Spirit Affinity House supreme elders gather with Feng Jiu Ge, Fairy Bai Qing, and others while Feng Jin Huang kowtows and offers golden jade dew tea as Duke Long’s second disciple.",
      "chapters": [
        1442
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "cross_checked_chapter_summary",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "fac_spirit_affinity_house",
