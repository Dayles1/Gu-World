  "claims": [
    {
      "text": "Lu Wei Yin places Emperor City as the greatest congregation of Central Continent’s human vein under the sect system, and ties absorbing that vein to becoming a child of humanity. He plans to use Hong Yi’s help so Ye Fan can quietly gain the human vein’s recognition, then borrow Fang Yuan’s strength toward more of the true inheritance.",
      "chapters": [
        1947
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
