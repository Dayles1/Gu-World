      "mentions": [
        "house_divine_bean_palace",
        "char_shen_shang",
        "char_fang_di_chang",
        "sys_immortal_gu_house"
      ]
    },
    {
      "text": "Deviation (recorded): this page is filed under gu-houses because Divine Emperor Palace is a named Immortal Gu House. It is an amalgamation house tied to Emperor City and Divine Bean Palace, not a five-region map seat.",
      "chapters": [],
      "certainty": "inferred",
      "confidence": "C",
      "verification": "no_citation",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt"
    },
    {
      "text": "Later speakers use Divine Emperor City for the same amalgamation.",
      "chapters": [],
      "certainty": "inferred",
      "confidence": "C",
      "verification": "no_citation",
      "source_id": "src_sagaofgu",
