  "claims": [
    {
      "text": "The pine tree itself is the Gu House. Later, erected in a courtyard, the book house is a mortal Gu House in the form of a tree house covered with green leaves and branches.",
      "chapters": [
        2008
      ],
      "certainty": "canon",
