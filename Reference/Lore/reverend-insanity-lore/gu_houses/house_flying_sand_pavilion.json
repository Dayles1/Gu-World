    {
      "text": "Deviation (recorded): this page is filed under gu-houses because Flying Sand Pavilion is a named Immortal Gu House. It is mobile equipment of Hou clan, not a five-region map seat.",
      "chapters": [],
      "certainty": "inferred",
      "confidence": "C",
      "verification": "no_citation",
