  "claims": [
    {
      "text": "Lady White Rabbit takes Rising Cloud City from her immortal aperture first in the named set with Profound Frost House, Unbreakable Golden Fortress, Dragon Soul Dark Castle, Red River Pavilion, Red Heavenly Altar, and Scarlet Palace. The houses were assembled after Immortal Gu were refined through the time path clone He Chun Qiu and Four Elements Square Regret Blood Refinement Pool, then used to arm subordinates for the Book Mountain fight. They are modified on the basis of Cloud City, Dark Flow Giant City, Profound Ice House, Unbreakable Iron Fortress, Blood River Chariot, Nightmare Castle, Green Wave Pavilion, Weaving Cocoon Manor, Golden Altar, and other Immortal Gu Houses, treated as partial innovations.",
      "chapters": [
        2178
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
