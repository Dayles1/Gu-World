  "claims": [
    {
      "text": "Fang Yuan combines rank four golden and silver cup Gu with rank four another perspective Gu and rank four moving form Gu, refining the set into rank five Moving Perspective Cup Gu before he leaves Hu Immortal blessed land.",
      "chapters": [
        425
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_fang_yuan",
        "gu_silver_cup_gu",
        "gu_another_perspective_gu",
        "gu_moving_form_gu",
        "gu_moving_perspective_cup_gu",
        "loc_hu_immortal_blessed_land"
      ]
    },
    {
      "text": "Thieving Heaven Demon Venerable discovers the recipe. His aim is to send a cup into the space cave and draw wild Gu worms out of it, and he never reaches that goal. Four hundred years later, his blessed land is excavated and Gu Immortals compete for it; the recipe spreads as they recommend it, becoming famous throughout the five regions.",
      "chapters": [
        434
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "thieving-heavens-discovery",
      "text_origin": "source_excerpt",
      "mentions": [
        "char_thieving_heaven_demon_venerable",
        "sys_wild_gu",
        "sys_gu_immortal"
      ]
    },
    {
      "text": "Lang Ya land spirit already holds the Moving Perspective Cup Gu recipe by the time Fang Yuan deals Immortal Gu at treasure yellow heaven. He got it from Fang Yuan earlier, along with the Stargate Gu recipe. When Fang Yuan asks him to send Southern Border Gu worms, Lang Ya land spirit sends an already-refined cup straight from Lang Ya blessed land’s stock as the second batch. Watching Gu Immortals recognize it is not a normal sale but a transfer of Gu worms through treasure yellow heaven, and Lang Ya land spirit turns away the ones who ask to buy it.",
      "chapters": [
        1032
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "passed-to-lang-ya-land-spirit",
