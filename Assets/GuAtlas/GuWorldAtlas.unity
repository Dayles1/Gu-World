    value: "[\"\u043F\u043E\u0440\u0442\u043E\u0432\u044B\u0435 \u0433\u043E\u0440\u043E\u0434\u0430\",\"\u043E\u0441\u0442\u0440\u043E\u0432\u043D\u044B\u0435 \u043A\u043B\u0430\u043D\u044B\"]"
