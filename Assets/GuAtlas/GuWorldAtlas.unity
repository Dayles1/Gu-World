  - key: powers
    type: objectArray
    value: "[{\"force\":\"\u041E\u0441\u0442\u0440\u043E\u0432\u043D\u044B\u0435 \u043A\u043B\u0430\u043D\u044B\",\"share\":60},{\"force\":\"\u041C\u043E\u0440\u0441\u043A\u0438\u0435 \u0441\u043E\u044E\u0437\u044B\",\"share\":30},{\"force\":\"\u041F\u0438\u0440\u0430\u0442\u044B\",\"share\":10}]"
  - key: description
    type: string
    value: "\u041D\u0435 \u0437\u0435\u043C\u043B\u044F, \u0430 \u0432\u043E\u0434\u0430, \u043F\u043E\u0434\u0435\u043B\u0451\u043D\u043D\u0430\u044F \u043D\u0430 \u0438\u043C\u0435\u043D\u043E\u0432\u0430\u043D\u043D\u044B\u0435 \u043C\u043E\u0440\u0441\u043A\u0438\u0435 \u0440\u0430\u0439\u043E\u043D\u044B. \u041E\u0441\u0442\u0440\u043E\u0432\u0430, \u0440\u0438\u0444\u044B \u0438 \u0442\u0440\u0443\u0434\u043D\u043E\u0434\u043E\u0441\u0442\u0443\u043F\u043D\u044B\u0435 \u043D\u0430\u0441\u043B\u0435\u0434\u0438\u044F."
