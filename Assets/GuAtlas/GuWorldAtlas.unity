  - key: ecosystems
    type: list
    value: "[\"\u0430\u0440\u0445\u0438\u043F\u0435\u043B\u0430\u0433\u0438\",\"\u0440\u0438\u0444\u044B\",\"\u0433\u043B\u0443\u0431\u043E\u043A\u043E\u0432\u043E\u0434\u044C\u0435\",\"\u043F\u0440\u0438\u0431\u0440\u0435\u0436\u043D\u044B\u0435 \u043C\u0430\u043D\u0433\u0440\u044B\"]"
  - key: settlement_types
