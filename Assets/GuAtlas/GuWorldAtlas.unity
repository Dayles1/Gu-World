  - key: powers
    type: objectArray
    value: "[{\"force\":\"\u0414\u0435\u0441\u044F\u0442\u044C \u0432\u0435\u043B\u0438\u043A\u0438\u0445 \u0434\u0440\u0435\u0432\u043D\u0438\u0445 \u0441\u0435\u043A\u0442\",\"share\":60},{\"force\":\"\u0414\u0435\u043C\u043E\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0435 \u043A\u0443\u043B\u044C\u0442\u0438\u0432\u0430\u0442\u043E\u0440\u044B\",\"share\":20},{\"force\":\"\u041E\u0434\u0438\u043D\u043E\u0447\u043A\u0438\",\"share\":20}]"
  - key: description
    type: string
    value: "\u0421\u0435\u0440\u0435\u0434\u0438\u043D\u0430 \u043F\u044F\u0442\u0438 \u0440\u0435\u0433\u0438\u043E\u043D\u043E\u0432. \u0421\u043E\u0432\u043E\u043A\u0443\u043F\u043D\u0430\u044F \u0441\u0438\u043B\u0430 \u0437\u0434\u0435\u0441\u044C \u0432\u044B\u0448\u0435, \u0447\u0435\u043C \u0433\u0434\u0435-\u043B\u0438\u0431\u043E: \u0434\u0435\u0441\u044F\u0442\u044C \u0432\u0435\u043B\u0438\u043A\u0438\u0445 \u0441\u0435\u043A\u0442 \u0434\u0435\u0440\u0436\u0430\u0442 \u043F\u043E\u0440\u044F\u0434\u043E\u043A, \u0431\u0435\u0441\u0441\u043C\u0435\u0440\u0442\u043D\u044B\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u044E\u0442 \u043A\u0430\u043A \u0432\u043B\u0430\u0441\u0442\u044C \u0440\u0435\u0433\u0438\u043E\u043D\u0430."
