    type: objectArray
    value: "[{\"force\":\"\u0413\u043E\u0440\u043D\u044B\u0435 \u043A\u043B\u0430\u043D\u044B\",\"share\":70},{\"force\":\"\u041F\u0440\u0430\u0432\u0435\u0434\u043D\u044B\u0435 \u0430\u043B\u044C\u044F\u043D\u0441\u044B\",\"share\":20},{\"force\":\"\u0414\u0435\u043C\u043E\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0435 \u0441\u0442\u0440\u0430\u043D\u043D\u0438\u043A\u0438\",\"share\":10}]"
